    2189.  00:4D8F                      TEXTO_CINEMATICA_1_1:
    2190.  00:4D8F                      		db		"The story of Gamourla isn't exactly as ",0
    2190.  00:4D8F  54 68 65 20 73 74 6F 72 79 20 6F 66 20 47 61 6D 
    2190.  00:4D9F  6F 75 72 6C 61 20 69 73 6E 27 74 20 65 78 61 63 
    2190.  00:4DAF  74 6C 79 20 61 73 20 00 
    2191.  00:4DB7                      TEXTO_CINEMATICA_1_2:
    2192.  00:4DB7                      		db		"you were told. Although it's a ",0
    2192.  00:4DB7  79 6F 75 20 77 65 72 65 20 74 6F 6C 64 2E 20 41 
    2192.  00:4DC7  6C 74 68 6F 75 67 68 20 69 74 27 73 20 61 20 00 
    2193.  00:4DD7                      TEXTO_CINEMATICA_1_3:
    2194.  00:4DD7                      		db		"prosperous village, the fear of the past",0
    2194.  00:4DD7  70 72 6F 73 70 65 72 6F 75 73 20 76 69 6C 6C 61 
    2194.  00:4DE7  67 65 2C 20 74 68 65 20 66 65 61 72 20 6F 66 20 
    2194.  00:4DF7  74 68 65 20 70 61 73 74 00 
    2195.  00:4E00                      TEXTO_CINEMATICA_1_4:
    2196.  00:4E00                      		db		"still lingers.",0
    2196.  00:4E00  73 74 69 6C 6C 20 6C 69 6E 67 65 72 73 2E 00 
    2197.  00:4E0F                      
    2198.  00:4E0F                      TEXTO_CINEMATICA_2_1:
    2199.  00:4E0F                      		db		"And Deph Kurgan, hero of past ",0
    2199.  00:4E0F  41 6E 64 20 44 65 70 68 20 4B 75 72 67 61 6E 2C 
    2199.  00:4E1F  20 68 65 72 6F 20 6F 66 20 70 61 73 74 20 00 
    2200.  00:4E2E                      TEXTO_CINEMATICA_2_2:
    2201.  00:4E2E                      		db		"adventures, feels in his bones how",0
    2201.  00:4E2E  61 64 76 65 6E 74 75 72 65 73 2C 20 66 65 65 6C 
    2201.  00:4E3E  73 20 69 6E 20 68 69 73 20 62 6F 6E 65 73 20 68 
    2201.  00:4E4E  6F 77 00 
    2202.  00:4E51                      TEXTO_CINEMATICA_2_3:
    2203.  00:4E51                      		db		"evil is approaching once more.",0
    2203.  00:4E51  65 76 69 6C 20 69 73 20 61 70 70 72 6F 61 63 68 
    2203.  00:4E61  69 6E 67 20 6F 6E 63 65 20 6D 6F 72 65 2E 00 
    2204.  00:4E70                      TEXTO_CINEMATICA_2_4:
    2205.  00:4E70  20 20 20 00         		db		"   ",0
    2206.  00:4E74                      
    2207.  00:4E74                      TEXTO_CINEMATICA_3_1:
    2208.  00:4E74                      		db		"And one night, his worst nightmares come",0
    2208.  00:4E74  41 6E 64 20 6F 6E 65 20 6E 69 67 68 74 2C 20 68 
    2208.  00:4E84  69 73 20 77 6F 72 73 74 20 6E 69 67 68 74 6D 61 
    2208.  00:4E94  72 65 73 20 63 6F 6D 65 00 
    2209.  00:4E9D                      TEXTO_CINEMATICA_3_2:
    2210.  00:4E9D                      		db		"true. Lord Adder floods the sky,",0
    2210.  00:4E9D  74 72 75 65 2E 20 4C 6F 72 64 20 41 64 64 65 72 
    2210.  00:4EAD  20 66 6C 6F 6F 64 73 20 74 68 65 20 73 6B 79 2C 
    2210.  00:4EBD  00 
    2211.  00:4EBE                      TEXTO_CINEMATICA_3_3:
    2212.  00:4EBE                      		db		"threatening the crops and the lives of",0
    2212.  00:4EBE  74 68 72 65 61 74 65 6E 69 6E 67 20 74 68 65 20 
    2212.  00:4ECE  63 72 6F 70 73 20 61 6E 64 20 74 68 65 20 6C 69 
    2212.  00:4EDE  76 65 73 20 6F 66 00 
    2213.  00:4EE5                      TEXTO_CINEMATICA_3_4:
    2214.  00:4EE5                      		db		"the villagers.",0
    2214.  00:4EE5  74 68 65 20 76 69 6C 6C 61 67 65 72 73 2E 00 
    2215.  00:4EF4                      
    2216.  00:4EF4                      TEXTO_CINEMATICA_4_1:
    2217.  00:4EF4                      		db		"But Deph isn't intimidated by this",0				  	
    2217.  00:4EF4  42 75 74 20 44 65 70 68 20 69 73 6E 27 74 20 69 
    2217.  00:4F04  6E 74 69 6D 69 64 61 74 65 64 20 62 79 20 74 68 
    2217.  00:4F14  69 73 00 
    2218.  00:4F17                      TEXTO_CINEMATICA_4_2:
    2219.  00:4F17                      		db		"apocalyptic vision. He knows what he has",0
    2219.  00:4F17  61 70 6F 63 61 6C 79 70 74 69 63 20 76 69 73 69 
    2219.  00:4F27  6F 6E 2E 20 48 65 20 6B 6E 6F 77 73 20 77 68 61 
    2219.  00:4F37  74 20 68 65 20 68 61 73 00 
    2220.  00:4F40                      TEXTO_CINEMATICA_4_3:
    2221.  00:4F40                      		db		"to do. He's done it before.",0
    2221.  00:4F40  74 6F 20 64 6F 2E 20 48 65 27 73 20 64 6F 6E 65 
    2221.  00:4F50  20 69 74 20 62 65 66 6F 72 65 2E 00 
    2222.  00:4F5C                      TEXTO_CINEMATICA_4_4:
    2223.  00:4F5C  20 20 20 00         		db		"   ",0
