     268.  00:70A6                      
     269.  00:70A6  ED 79               		OUT [C],A
     270.  00:70A8  0C                  		INC C
     271.  00:70A9  ED A3               		OUTI 
     272.  00:70AB  0D                  		DEC C
     273.  00:70AC  3C                  		INC A
     274.  00:70AD  FE 0D               		CP 13
     275.  00:70AF  20 F5               		JR NZ,ROUT_A0.LOUT
     276.  00:70B1  ED 79               		OUT [C],A
     277.  00:70B3  7E                  		LD A,[HL]
     278.  00:70B4                      	
     279.  00:70B4  A7                  		AND A
     280.  00:70B5  F8                  		RET M
     281.  00:70B6  0C                  		INC C
     282.  00:70B7  ED 79               		OUT [C],A
