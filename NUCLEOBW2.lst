    2465.  00:52AF                      		; Animación de muerte:
    2466.  00:52AF                      		; copiamos siempre desde el primer recuadro de la page fuente
    2467.  00:52AF                      		; hacia page 2, recortando altura y bajando destino.
    2468.  00:52AF                      		;
    2469.  00:52AF                      		; derecha  -> page 3
    2470.  00:52AF                      		; izquierda -> page 1
    2471.  00:52AF                      
