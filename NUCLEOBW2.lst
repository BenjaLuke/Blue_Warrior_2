     499.  00:428F  11 E0 43            		ld		de,PATRONES_SPRITES_VRAM_BOSS_5+COVID_PATRON_INICIAL_BOSS_5*8
     500.  00:4292  01 40 00            		ld		bc,8*4*COVID_PATRON_CANT_BOSS_5
     501.  00:4295  CD 58 5F            		call	PON_COLOR_2.sin_bc_impuesta
     502.  00:4298                      
     503.  00:4298                      		; El color de sprites en SCREEN 7 va por NUMERO DE SPRITE,
     504.  00:4298                      		; no por patron. Los proyectiles usan los sprites 22-29,
     505.  00:4298                      		; asi que sus colores deben arrancar en #4800 + 22*16 = #4960.
