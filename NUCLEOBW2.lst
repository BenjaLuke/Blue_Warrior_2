    2533.  00:52EB  3E 02               		ld		a,PAGE_2_VRAM_Y_BOSS_1 / 256
    2534.  00:52ED  FD 77 07            		ld		(iy+7),a							; destino page 2
    2535.  00:52F0                      
    2536.  00:52F0                      
    2537.  00:52F0                      		; Tamaño destino/fuente:
    2538.  00:52F0                      		; ancho fijo, altura decreciendo.
    2539.  00:52F0                      
    2540.  00:52F0  78                  		ld		a,b
    2541.  00:52F1  FD 77 0A            		ld		(iy+10),a							; alto low = B
    2542.  00:52F4  AF                  		xor		a
    2543.  00:52F5  FD 77 0B            		ld		(iy+11),a							; alto high = 0
