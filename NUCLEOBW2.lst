    1726.  00:4BBF                      .Y_CRECE_CHUMINIX_PELEA_BOSS_3:
    1727.  00:4BBF                      
    1728.  00:4BBF                      ; Y crece: delta = Y nueva - Y anterior.
    1729.  00:4BBF                      ; Rectangulo: X menor entre anterior/nueva, Y anterior,
    1730.  00:4BBF                      ; ancho 128 + delta X, alto delta Y.
    1731.  00:4BBF                      
    1732.  00:4BBF  4F                  		ld		c,a				; C = Y anterior / Y destino del relleno
    1733.  00:4BC0  78                  		ld		a,b
    1734.  00:4BC1  91                  		sub		c
    1735.  00:4BC2  5F                  		ld		e,a				; E = alto / delta Y
