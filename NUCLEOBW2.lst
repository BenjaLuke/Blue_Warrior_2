       1.  00:6F2A                      ; ROMAN: PAR
       2.  00:6F2A                      													; --- ayFX REPLAYER v2.0M ---
       3.  00:6F2A                      
       4.  00:6F2A                      													; --- v2.0T  New ayFX replayer routine. T -> Triple FX replayer
       5.  00:6F2A                      
       6.  00:6F2A                      ;ayFX_SETUP:											; ---          ayFX replayer setup          ---
       7.  00:6F2A                      													; --- INPUT: HL -> pointer to the ayFX bank ---
       8.  00:6F2A  22 BF C2            		ld	[ayFX_BANK],hl							; Current ayFX bank
       9.  00:6F2D                      ;ayFX_STOP:	
      10.  00:6F2D                      		
      11.  00:6F2D  3E FF               		ld	a,255									; Lowest ayFX priority
      12.  00:6F2F  32 C1 C2            		ld	[ayFX_C1],a								; First channel minimum priority
      13.  00:6F32  32 C4 C2            		ld	[ayFX_C2],a								; First channel minimum priority
      14.  00:6F35  32 C7 C2            		ld	[ayFX_C3],a								; First channel minimum priority
      15.  00:6F38  C9                  		ret											; Return
      16.  00:6F39                      ;ayFX_END:											; --- End of an ayFX stream ---
      17.  00:6F39                      
      18.  00:6F39  DD 36 00 FF         		ld	[IX],255								; Priority saved (not playing ayFX stream)
      19.  00:6F3D  C9                  		ret											; Return
      20.  00:6F3E                      
      21.  00:6F3E                      ;ayFX_INIT:											; ---     INIT A NEW ayFX STREAM     ---
      22.  00:6F3E                      													; --- INPUT: A -> sound to be played ---
      23.  00:6F3E                      													; ---        C -> sound priority     ---
      24.  00:6F3E                      													; --- Checks the priorities of playing ayFX streams to place ---
      25.  00:6F3E                      													; --- the new one on the channel with lowest priority        ---
      26.  00:6F3E  C5                  		push	bc									; Store bc in stack
      27.  00:6F3F  D5                  		push	de									; Store de in stack
      28.  00:6F40  E5                  		push	hl									; Store hl in stack
      29.  00:6F41  DD E5               		push	IX									; Store IX in stack
      30.  00:6F43                      													; --- Check if the index is in the bank ---
      31.  00:6F43  47                  		ld	b,a										; b:=a (new ayFX stream index)
      32.  00:6F44  2A BF C2            		ld	hl,[ayFX_BANK]							; Current ayFX BANK
      33.  00:6F47  7E                  		ld	a,[hl]									; Number of samples in the bank
      34.  00:6F48  B7                  		or	a										; If zero (means 256 samples)...
      35.  00:6F49  CA 53 6F            		jp	z,ayFX_INIT.CHECK_PRI							; ...goto .CHECK_PRI
      36.  00:6F4C                      													; The bank has less than 256 samples
      37.  00:6F4C  78                  		ld	a,b										; a:=b (new ayFX stream index)
      38.  00:6F4D  BE                  		cp	[hl]									; If new index is not in the bank...
      39.  00:6F4E  3E 02               		ld	a,2										; a:=2 (error 2: Sample not in the bank)
      40.  00:6F50  D2 B2 6F            		jp	nc,ayFX_INIT.INIT_END							; ...we can't init it
      41.  00:6F53                      
      42.  00:6F53                      ;.CHECK_PRI:											; --- Places the data on the correct channel                  ---
      43.  00:6F53                      													; ---   Remember: 0 = highest priority, 15 = lowest priority  ---
      44.  00:6F53                      													; --- Checks channel 1 ---
      45.  00:6F53  3A C1 C2            		ld	a,[ayFX_C1]								; Priority of ayFX Stream being played on channel 1
      46.  00:6F56  FE FF               		cp	255										; If there's no Stream being played...
      47.  00:6F58  28 39               		jr	z,ayFX_INIT.TOC1									; ...place the new Stream on channel 1
      48.  00:6F5A  5F                  		ld	e,a										; Minimum priority of Streams being played
      49.  00:6F5B  16 01               		ld	d,1										; On channel 1
      50.  00:6F5D                      													; --- Checks channel 2 ---
      51.  00:6F5D  3A C4 C2            		ld	a,[ayFX_C2]								; Priority of ayFX Stream being played on channel 2
      52.  00:6F60  FE FF               		cp	255										; If there's no Stream being played...
      53.  00:6F62  28 29               		jr	z,ayFX_INIT.TOC2									; ...place the new Stream on channel 2
      54.  00:6F64  BB                  		cp	e										; Compare priority with minimum one
      55.  00:6F65  30 03               		jr	nc,ayFX_INIT.CHECKC3								; If P(C2) > min, go to .CHECKC3
      56.  00:6F67  5F                  		ld	e,a										; Minimum priority of Streams being played
      57.  00:6F68  16 02               		ld	d,2										; On channel 2
      58.  00:6F6A                      
      59.  00:6F6A                      ;.CHECKC3:											; --- Checks channel 3 ---
      60.  00:6F6A                      
      61.  00:6F6A  3A C7 C2            		ld	a,[ayFX_C3]								; Priority of ayFX Stream being played on channel 3
      62.  00:6F6D  FE FF               		cp	255										; If there's no stream being played
      63.  00:6F6F  28 16               		jr	z,ayFX_INIT.TOC3									; ...place the new Stream on channel 3
      64.  00:6F71  BB                  		cp	e										; Compare priority with minimum one
      65.  00:6F72  30 03               		jr	nc,ayFX_INIT.CHECKMIN							; If P(C3) > min, go to .CHECKMIN
      66.  00:6F74  5F                  		ld	e,a										; Minimum priority of Streams being played
      67.  00:6F75  16 03               		ld	d,3										; On channel 3
      68.  00:6F77                      
      69.  00:6F77                      ;.CHECKMIN:											; --- Checks if minimum priority is lower than priority of the new Stream ---
      70.  00:6F77                      
      71.  00:6F77  79                  		ld	a,c										; Priority of the new Stream
      72.  00:6F78  BB                  		cp	e										; Minimum priority of Streams being played
      73.  00:6F79  3E 01               		ld	a,1										; a:=1 (error 1: A sample with higher priority is being played)
      74.  00:6F7B  D2 B2 6F            		jp	nc,ayFX_INIT.INIT_END							; ...we can't play the new ayFX Stream
      75.  00:6F7E                      													; --- The new stream substitues the minimum priority Stream being played ---
      76.  00:6F7E  7A                  		ld	a,d										; Channel of minimum priority
      77.  00:6F7F  FE 01               		cp	1										; If it's 1...
      78.  00:6F81  28 10               		jr	z,ayFX_INIT.TOC1									; ...send Stream to channel 1
      79.  00:6F83  FE 02               		cp	2										; If it's 2...
      80.  00:6F85  28 06               		jr	z,ayFX_INIT.TOC2									; ...send Stream to channel 2
      81.  00:6F87                      
      82.  00:6F87                      ;.TOC3:												; --- Stream will be played on channel 3
      83.  00:6F87                      
      84.  00:6F87  DD 21 C7 C2         		ld	IX,ayFX_C3								; Pointer to the chanel data
      85.  00:6F8B  18 0A               		jr	ayFX_INIT.SETDATA								; Go to .SETDATA
      86.  00:6F8D                      
      87.  00:6F8D                      ;.TOC2:												; --- Stream will be played on channel 2
      88.  00:6F8D                      
      89.  00:6F8D  DD 21 C4 C2         		ld	IX,ayFX_C2								; Pointer to the channel data
      90.  00:6F91  18 04               		jr	ayFX_INIT.SETDATA								; Go to .SETDATA
      91.  00:6F93                      
      92.  00:6F93                      ;.TOC1:												; --- Stream will be played on channel 1
      93.  00:6F93                      		
      94.  00:6F93  DD 21 C1 C2         		ld	IX,ayFX_C1								; Pointer to the chanel data
      95.  00:6F97                      
      96.  00:6F97                      ;.SETDATA:											; --- Set data on the correct channel ---
      97.  00:6F97                      											
      98.  00:6F97  79                  		ld	a,c										; a:=New priority
      99.  00:6F98  E6 0F               		and	$0F										; We mask the priority
     100.  00:6F9A  DD 77 00            		ld	[IX],a									; new ayFX stream priority saved in RAM
     101.  00:6F9D                      													; --- Calculate the pointer to the new ayFX stream ---
     102.  00:6F9D  ED 5B BF C2         		ld	de,[ayFX_BANK]							; de:=Current ayFX bank
     103.  00:6FA1  13                  		inc	de										; de points to the increments table of the bank
     104.  00:6FA2  68                  		ld	l,b										; l:=b (new ayFX stream index)
     105.  00:6FA3  26 00               		ld	h,0										; hl:=b (new ayFX stream index)
     106.  00:6FA5  29                  		add	hl,hl									; hl:=hl*2
     107.  00:6FA6  19                  		add	hl,de									; hl:=hl+de (hl points to the correct increment)
     108.  00:6FA7  5E                  		ld	e,[hl]									; e:=lower byte of the increment
     109.  00:6FA8  23                  		inc	hl										; hl points to the higher byte of the correct increment
     110.  00:6FA9  56                  		ld	d,[hl]									; de:=increment
     111.  00:6FAA  19                  		add	hl,de									; hl:=hl+de (hl points to the new ayFX stream)
     112.  00:6FAB  DD 75 01            		ld	[IX+1],l								; Pointer lower byte saved in RAM
     113.  00:6FAE  DD 74 02            		ld	[IX+2],h								; Pointer higher byte saved in RAM
     114.  00:6FB1  AF                  		xor	a										; a:=0 (no errors)
     115.  00:6FB2                      
     116.  00:6FB2                      ;.INIT_END:	
     117.  00:6FB2                      
     118.  00:6FB2  DD E1               		pop	IX										; Retrieve IX from stack
     119.  00:6FB4  E1                  		pop	hl										; Retrieve hl from stack
     120.  00:6FB5  D1                  		pop	de										; Retrieve de from stack
     121.  00:6FB6  C1                  		pop	bc										; Retrieve bc from stack
     122.  00:6FB7  C9                  		ret											; Return
     123.  00:6FB8                      
     124.  00:6FB8                      ;ayFX_PLAY:											; --- Plays next frame of each ayFX Stream ---
     125.  00:6FB8                      			
     126.  00:6FB8  21 00 00            		ld	hl,0									; hl:=0
     127.  00:6FBB  22 D6 C2            		ld	[ayFX_REGS+7],hl						; Clears mixer and volume of channel A
     128.  00:6FBE  22 D8 C2            		ld	[ayFX_REGS+9],hl						; Clears volume of channels B and C
     129.  00:6FC1  DD 21 C1 C2         		ld	IX,ayFX_C1								; Channel 1
     130.  00:6FC5  3E 01               		ld	a,1										; a:=1
     131.  00:6FC7  CD D9 6F            		call	ayFX_PLAY.ayFX_PlayChannel					; Play Channel 1
     132.  00:6FCA  DD 21 C4 C2         		ld	IX,ayFX_C2								; Channel 2
     133.  00:6FCE  3E 02               		ld	a,2										; a:=2
     134.  00:6FD0  CD D9 6F            		call	ayFX_PLAY.ayFX_PlayChannel					; Play Channel 2
     135.  00:6FD3  DD 21 C7 C2         		ld	IX,ayFX_C3								; Channel 3
     136.  00:6FD7  3E 03               		ld	a,3										; a:=3
     137.  00:6FD9                      ;.ayFX_PlayChannel:									; --- Plays a channel stream ---
     138.  00:6FD9  32 CE C2            		ld	[ayFX_CHANNEL],a						; Sets current channel
     139.  00:6FDC  DD 7E 00            		ld	a,[IX]									; a:=Current ayFX stream priority
     140.  00:6FDF  B7                  		or	a										; If priority has bit 7 on...
     141.  00:6FE0  F8                  		ret	m										; ...return
     142.  00:6FE1                      													; --- Extract control byte from stream ---
     143.  00:6FE1  DD 6E 01            		ld	l,[IX+1]								; Pointer to the current ayFX stream (lower byte)
     144.  00:6FE4  DD 66 02            		ld	h,[IX+2]								; Pointer to the current ayFX stream (higher byte)
     145.  00:6FE7  4E                  		ld	c,[hl]									; c:=Control byte
     146.  00:6FE8  23                  		inc	hl										; Increment pointer
     147.  00:6FE9                      													; --- Check if there's new tone on stream ---
     148.  00:6FE9  CB 69               		bit	5,c										; If bit 5 c is off...
     149.  00:6FEB  CA F6 6F            		jp	z,ayFX_PLAY.CHECK_NN								; ...jump to .CHECK_NN (no new tone)
     150.  00:6FEE                      													; --- Extract new tone from stream ---
     151.  00:6FEE  5E                  		ld	e,[hl]									; e:=lower byte of new tone
     152.  00:6FEF  23                  		inc	hl										; Increment pointer
     153.  00:6FF0  56                  		ld	d,[hl]									; d:=higher byte of new tone
     154.  00:6FF1  23                  		inc	hl										; Increment pointer
     155.  00:6FF2  ED 53 CA C2         		ld	[ayFX_TONE],de							; ayFX tone updated
     156.  00:6FF6                      
     157.  00:6FF6                      ;.CHECK_NN:											; --- Check if there's new noise on stream ---
     158.  00:6FF6                      
     159.  00:6FF6  CB 71               		bit	6,c										; if bit 6 c is off...
     160.  00:6FF8  CA 05 70            		jp	z,ayFX_PLAY.SETPOINTER							; ...jump to .SETPOINTER (no new noise)
     161.  00:6FFB                      													; --- Extract new noise from stream ---
     162.  00:6FFB  7E                  		ld	a,[hl]									; a:=New noise
     163.  00:6FFC  23                  		inc	hl										; Increment pointer
     164.  00:6FFD  FE 20               		cp	$20										; If it's an illegal value of noise (used to mark end of stream)...
     165.  00:6FFF  CA 39 6F            		jp	z,ayFX_END								; ...jump to ayFX_END
     166.  00:7002  32 CC C2            		ld	[ayFX_NOISE],a							; ayFX noise updated
     167.  00:7005                      
     168.  00:7005                      ;.SETPOINTER:										; --- Update ayFX pointer ---
     169.  00:7005                      
     170.  00:7005  DD 75 01            		ld	[IX+1],l								; Pointer lower byte saved in RAM
     171.  00:7008  DD 74 02            		ld	[IX+2],h								; Pointer higher byte saved in RAM
     172.  00:700B                      													; --- Extract volume ---
     173.  00:700B  79                  		ld	a,c										; a:=Control byte
     174.  00:700C  E6 0F               		and	$0F										; lower nibble
     175.  00:700E  32 CD C2            		ld	[ayFX_VOLUME],a							; ayFX volume updated
     176.  00:7011  C8                  		ret	z										; Return if volume is zero (don't copy ayFX values in to ayFX_REGS)
     177.  00:7012                      													; -------------------------------------
     178.  00:7012                      													; --- COPY ayFX VALUES IN TO ayFX_REGS ---
     179.  00:7012                      													; -------------------------------------
     180.  00:7012                      													; --- Set noise channel ---
     181.  00:7012  CB 79               		bit	7,c										; If noise is off...
     182.  00:7014  C2 1D 70            		jp	nz,ayFX_PLAY.SETMASKS							; ...jump to .SETMASKS
     183.  00:7017  3A CC C2            		ld	a,[ayFX_NOISE]							; ayFX noise value
     184.  00:701A  32 D5 C2            		ld	[ayFX_REGS+6],a							; copied in to ayFX_REGS (noise channel)
     185.  00:701D                      
     186.  00:701D                      ;.SETMASKS:											; --- Set mixer masks ---
     187.  00:701D                      
     188.  00:701D  79                  		ld	a,c										; a:=Control byte
     189.  00:701E  E6 90               		and	$90										; Only bits 7 and 4 (noise and tone mask for psg reg 7)
     190.  00:7020  FE 90               		cp	$90										; If no noise and no tone...
     191.  00:7022  C8                  		ret	z										; ...return (don't copy ayFX values in to ayFX_REGS)
     192.  00:7023                      													; --- Copy ayFX values in to ayFX_REGS ---
     193.  00:7023  CB 0F               		rrc	a										; Rotate a to the right (1 TIME)
     194.  00:7025  CB 0F               		rrc	a										; Rotate a to the right (2 TIMES) (OR mask)
     195.  00:7027  16 DB               		ld	d,$DB									; d:=Mask for psg mixer (AND mask)
     196.  00:7029  21 CE C2            		ld	hl,ayFX_CHANNEL							; ayFX playing channel
     197.  00:702C  46                  		ld	b,[hl]									; Channel counter
     198.  00:702D                      
     199.  00:702D                      ;.CHK1:												; --- Check if playing channel was 1 ---
     200.  00:702D                      
     201.  00:702D  10 10               		djnz	ayFX_PLAY.CHK2								; Decrement and jump if channel was not 1
     202.  00:702F                      
     203.  00:702F                      ;.PLAY_C:											; --- Play ayFX stream on channel C ---
     204.  00:702F                      
     205.  00:702F  CD 69 70            		call	ayFX_PLAY.SETMIXER							; Set PSG mixer value (a:=ayFX volume)
     206.  00:7032  32 D9 C2            		ld	[ayFX_REGS+10],a						; Volume copied in to ayFX_REGS (channel C volume)
     207.  00:7035  CB 51               		bit	2,c										; If tone is off...
     208.  00:7037  C0                  		ret	nz										; ...return
     209.  00:7038  2A CA C2            		ld	hl,[ayFX_TONE]							; ayFX tone value
     210.  00:703B  22 D3 C2            		ld	[ayFX_REGS+4],hl						; copied in to ayFX_REGS (channel C tone)
     211.  00:703E  C9                  		ret											; Return
     212.  00:703F                      
     213.  00:703F                      ;.CHK2:												; --- Check if playing channel was 2 ---
     214.  00:703F                      
     215.  00:703F  CB 0A               		rrc	d										; Rotate right AND mask
     216.  00:7041  CB 0F               		rrc	a										; Rotate right OR mask
     217.  00:7043  10 10               		djnz	ayFX_PLAY.CHK3								; Decrement and jump if channel was not 2
     218.  00:7045                      
     219.  00:7045                      ;.PLAY_B:											; --- Play ayFX stream on channel B ---
     220.  00:7045                      
     221.  00:7045  CD 69 70            		call	ayFX_PLAY.SETMIXER							; Set PSG mixer value (a:=ayFX volume)
     222.  00:7048  32 D8 C2            		ld	[ayFX_REGS+9],a							; Volume copied in to ayFX_REGS (channel B volume)
     223.  00:704B  CB 49               		bit	1,c										; If tone is off...
     224.  00:704D  C0                  		ret	nz										; ...return
     225.  00:704E  2A CA C2            		ld	hl,[ayFX_TONE]							; ayFX tone value
     226.  00:7051  22 D1 C2            		ld	[ayFX_REGS+2],hl						; copied in to ayFX_REGS (channel B tone)
     227.  00:7054  C9                  		ret											; Return
     228.  00:7055                      
     229.  00:7055                      ;.CHK3:												; --- Check if playing channel was 3 ---
     230.  00:7055                      
     231.  00:7055  CB 0A               		rrc	d										; Rotate right AND mask
     232.  00:7057  CB 0F               		rrc	a										; Rotate right OR mask
     233.  00:7059                      
     234.  00:7059                      ;.PLAY_A:											; --- Play ayFX stream on channel A ---
     235.  00:7059                      
     236.  00:7059  CD 69 70            		call	ayFX_PLAY.SETMIXER							; Set PSG mixer value (a:=ayFX volume)
     237.  00:705C  32 D7 C2            		ld	[ayFX_REGS+8],a							; Volume copied in to ayFX_REGS (channel A volume)
     238.  00:705F  CB 41               		bit	0,c										; If tone is off...
     239.  00:7061  C0                  		ret	nz										; ...return
     240.  00:7062  2A CA C2            		ld	hl,[ayFX_TONE]							; ayFX tone value
     241.  00:7065  22 CF C2            		ld	[ayFX_REGS+0],hl						; copied in to ayFX_REGS (channel A tone)
     242.  00:7068  C9                  		ret											; Return
     243.  00:7069                      
     244.  00:7069                      ;.SETMIXER:											; --- Set PSG mixer value ---
     245.  00:7069                      
     246.  00:7069  4F                  		ld	c,a										; c:=OR mask
     247.  00:706A  3A D6 C2            		ld	a,[ayFX_REGS+7]							; a:=PSG mixer value
     248.  00:706D  A2                  		and	d										; AND mask
     249.  00:706E  B1                  		or	c										; OR mask
     250.  00:706F  32 D6 C2            		ld	[ayFX_REGS+7],a							; PSG mixer value updated
     251.  00:7072  3A CD C2            		ld	a,[ayFX_VOLUME]							; a:=ayFX volume value
     252.  00:7075  C9                  		ret											; Return
     253.  00:7076                      
     254.  00:7076                      ;AYfx_ROUT:	
     255.  00:7076                      
     256.  00:7076  AF                  		XOR A
     257.  00:7077                      	
