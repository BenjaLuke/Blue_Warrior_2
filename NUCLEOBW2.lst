    1602.  00:4B2F  3C                  		inc		a
    1603.  00:4B30  B8                  		cp		b
    1604.  00:4B31  38 10               		jr		c,.GUARDA_RELOJ_FRAME_CHUMINIX_BOSS_3
    1605.  00:4B33                      
    1606.  00:4B33  AF                  		xor		a
    1607.  00:4B34  32 76 C7            		ld		(COVID_BOSS_3_FOTOGRAMA_CHUMINIX),a
    1608.  00:4B37  3A F7 C6            		ld		a,(CHUMINIX_BOSS_3_FOTOGRAMA)
    1609.  00:4B3A  3C                  		inc		a
    1610.  00:4B3B  BA                  		cp		d
    1611.  00:4B3C  38 09               		jr		c,.GUARDA_FRAME_CHUMINIX_BOSS_3
    1612.  00:4B3E  28 07               		jr		z,.GUARDA_FRAME_CHUMINIX_BOSS_3
