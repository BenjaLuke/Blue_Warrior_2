     273.  00:7064  3C                  		INC A
     274.  00:7065  FE 0D               		CP 13
     275.  00:7067  20 F5               		JR NZ,ROUT_A0.LOUT
     276.  00:7069  ED 79               		OUT [C],A
     277.  00:706B  7E                  		LD A,[HL]
     278.  00:706C                      	
