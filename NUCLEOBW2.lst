    2443.  00:52F6                      REVISAMOS_COLISION_CON_ERRECENYX_Y_DEPH:
    2444.  00:52F6                      
    2445.  00:52F6                      		; Hitbox Errecenyx/Herrecenix reducido 20 px por cada lado.
    2446.  00:52F6                      		; Deph se sigue tratando como caja aproximada de 20x20.
    2447.  00:52F6                      		;
    2448.  00:52F6                      		; X original visible:
    2449.  00:52F6                      		;   izquierda = VARIABLE_UN_USO3
    2450.  00:52F6                      		;   ancho     = VARIABLE_UN_USO2
    2451.  00:52F6                      		;
    2452.  00:52F6                      		; X reducido:
    2453.  00:52F6                      		;   izquierda = VARIABLE_UN_USO3 + 20
    2454.  00:52F6                      		;   derecha   = VARIABLE_UN_USO3 + VARIABLE_UN_USO2 - 20
    2455.  00:52F6                      		;
    2456.  00:52F6                      		; Y original:
    2457.  00:52F6                      		;   arriba = ERRECENYX_MOVIMIENTO_Y_BOSS_4
    2458.  00:52F6                      		;   alto   = ERRECENYX_MOVIMIENTO_ALTO_BOSS_4
    2459.  00:52F6                      		;
    2460.  00:52F6                      		; Y reducido:
    2461.  00:52F6                      		;   arriba = ERRECENYX_MOVIMIENTO_Y_BOSS_4 + 20
    2462.  00:52F6                      		;   abajo  = ERRECENYX_MOVIMIENTO_Y_BOSS_4 + ERRECENYX_MOVIMIENTO_ALTO_BOSS_4 - 20
    2463.  00:52F6                      
    2464.  00:52F6  CD EE 4E            		call	CALCULA_RECORTE_ERRECENYX_BOSS_4
    2465.  00:52F9                      
    2466.  00:52F9                      		; Si el ancho visible es 40 o menos, al meter 20 por cada lado
    2467.  00:52F9                      		; no queda hitbox real.
    2468.  00:52F9  3A A9 C2            		ld		a,(VARIABLE_UN_USO2)
    2469.  00:52FC  FE 29               		cp		41
    2470.  00:52FE  D8                  		ret		c
    2471.  00:52FF                      
    2472.  00:52FF                      		; Comprueba borde izquierdo reducido:
    2473.  00:52FF                      		; Deph derecha >= Errecenyx izquierda + 20
    2474.  00:52FF  3A AA C2            		ld		a,(VARIABLE_UN_USO3)
    2475.  00:5302  C6 14               		add		20
    2476.  00:5304  4F                  		ld		c,a
    2477.  00:5305  3A 64 C0            		ld		a,(X_DEPH)
    2478.  00:5308  C6 14               		add		20
    2479.  00:530A  B9                  		cp		c
    2480.  00:530B  D8                  		ret		c
    2481.  00:530C                      
    2482.  00:530C                      		; Comprueba borde derecho reducido:
    2483.  00:530C                      		; Deph izquierda < Errecenyx derecha - 20
    2484.  00:530C  3A AA C2            		ld		a,(VARIABLE_UN_USO3)
    2485.  00:530F  4F                  		ld		c,a
    2486.  00:5310  3A A9 C2            		ld		a,(VARIABLE_UN_USO2)
    2487.  00:5313  81                  		add		c
    2488.  00:5314  D6 14               		sub		20
    2489.  00:5316  4F                  		ld		c,a
    2490.  00:5317  3A 64 C0            		ld		a,(X_DEPH)
    2491.  00:531A  B9                  		cp		c
    2492.  00:531B  D0                  		ret		nc
    2493.  00:531C                      
    2494.  00:531C                      		; Comprueba borde superior reducido:
    2495.  00:531C                      		; Deph abajo >= Errecenyx arriba + 20
    2496.  00:531C  3A 65 C0            		ld		a,(Y_DEPH)
    2497.  00:531F  C6 14               		add		20
    2498.  00:5321  FE 30               		cp		ERRECENYX_MOVIMIENTO_Y_BOSS_4+20
