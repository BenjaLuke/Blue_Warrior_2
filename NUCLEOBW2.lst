      45:  00:5412                      ; -----------------------------------------------------------------------------
      46:  00:5412                      ; Copys de la animacion de entrada de Chuminix.
      47:  00:5412                      ;
      48:  00:5412                      ; SCREEN 5 / DOCOPY:
      49:  00:5412                      ; Cuando hablamos de page N (x,y), aqui se traduce a coordenadas absolutas
      50:  00:5412                      ; de VDP: X=x, Y=PAGE_N_VRAM_Y_BOSS_3+y. No se corrigen los origenes por
      51:  00:5412                      ; tamanyo ni por centrado; se usan exactamente las coordenadas indicadas.
      52:  00:5412                      ;
      53:  00:5412                      ; Frame 0 se salva desde page 2 a page 0 (zona oculta en y=150).
      54:  00:5412                      ; Los demas fotogramas se leen desde page 1 y se copian centrados a page 2.
      55:  00:5412                      ; -----------------------------------------------------------------------------
      56:  00:5412                      BOSS_3_COPY_GUARDA_FRAME_0_CHUMINIX:
      57:  00:5412                      
      58:  00:5412                      		; Guarda el fondo visible donde aparecera Chuminix.
      59:  00:5412                      		; Origen:  page 2 (64,78)  -> X=#0040, Y=#0200+#004E = #024E
      60:  00:5412                      		; Destino: page 0 (0,150)  -> X=#0000, Y=#0096
      61:  00:5412  40 00 4E 02         		dw		#0040,#024E
      62:  00:5416  00 00 96 00         		dw		#0000,#0096
      63:  00:541A  80 00 30 00         		dw		CHUMINIX_APARICION_ANCHO_BOSS_3,CHUMINIX_APARICION_ALTO_BOSS_3
