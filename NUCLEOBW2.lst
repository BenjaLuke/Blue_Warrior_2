    2379.  00:5094                      
    2380.  00:5094                              ; Para HMMV el origen no importa.
    2381.  00:5094                      
    2382.  00:5094  DD 36 00 00                 ld      (ix+0),0
    2383.  00:5098  DD 36 01 00                 ld      (ix+1),0
    2384.  00:509C  DD 36 02 00                 ld      (ix+2),0
    2385.  00:50A0  DD 36 03 00                 ld      (ix+3),0
    2386.  00:50A4                      
    2387.  00:50A4                              ; Destino X = 254.
