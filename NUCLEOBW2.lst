    2964.  00:6F24  B7                  		or		a
    2965.  00:6F25  C0                  		ret		nz
    2966.  00:6F26                      
    2967.  00:6F26  3A 0E C1            		ld		a,(CORAZONES)
    2968.  00:6F29  3D                  		dec		a
    2969.  00:6F2A  32 0E C1            		ld		(CORAZONES),a
    2970.  00:6F2D  28 12               		jr		z,.MUERE_DEPH_EN_BOSS_COMUN
    2971.  00:6F2F                      
    2972.  00:6F2F  3E 03               		ld		a,3
    2973.  00:6F31  0E 01               		ld		c,1
    2974.  00:6F33  CD FF 6D            		call	A_31_DESDE_10
    2975.  00:6F36                      
