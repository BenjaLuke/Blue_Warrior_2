      80:  00:5BD3                      		; Destino: page 0 (0,150)  -> X=#0000, Y=#0096
      81:  00:5BD3  40 00 4E 02         		dw		#0040,#024E
      82:  00:5BD7  00 00 96 00         		dw		#0000,#0096
