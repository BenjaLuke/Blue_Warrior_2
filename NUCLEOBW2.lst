    3079.  00:57BA                      		include	"../ANIMACIONES/FINAL FASE 5 VAMOS A TERMINAR.asm"		
       1:  00:57BA                      ; -----------------------------------------------------------------------------
       2:  00:57BA                      ; FINAL FASE 5 VAMOS A TERMINAR.asm
       3:  00:57BA                      ;
       4:  00:57BA                      ; Include ejecutado desde BOSS 5.asm en la etiqueta FINAL_b5.
       5:  00:57BA                      ;
       6:  00:57BA                      ; Objetivo:
       7:  00:57BA                      ;   - Borrar visualmente la page 2 visible.
       8:  00:57BA                      ;   - Pintar bloques negros en orden pseudoaleatorio.
       9:  00:57BA                      ;   - No repetir nunca el mismo bloque.
      10:  00:57BA                      ;   - Al terminar, NO hacer ret ni jp: el flujo cae al codigo siguiente
      11:  00:57BA                      ;     del include, es decir, VOLVEMOS_b5.
      12:  00:57BA                      ;
      13:  00:57BA                      ; Nota:
      14:  00:57BA                      ;   La pantalla se divide en bloques de 4x4.
      15:  00:57BA                      ;   64 columnas x 53 filas = 3392 bloques.
      16:  00:57BA                      ;   Cada bloque se pinta una sola vez mediante HMMV.
      17:  00:57BA                      ; -----------------------------------------------------------------------------
      18:  00:57BA                      
      19:  00:57BA  C3 36 58            		jp		FINAL_FASE_5_VAMOS_A_TERMINAR_INICIO
      20:  00:57BD                      
      21:  00:57BD                      ; Buffer de comando VDP.
      22:  00:57BD                      ; Formato DOCOPY:
      23:  00:57BD                      ;   0-1   SX
      24:  00:57BD                      ;   2-3   SY
      25:  00:57BD                      ;   4-5   DX
      26:  00:57BD                      ;   6-7   DY
      27:  00:57BD                      ;   8-9   NX
      28:  00:57BD                      ;   10-11 NY
      29:  00:57BD                      ;   12    color
      30:  00:57BD                      ;   13    argumento
      31:  00:57BD                      ;   14    comando
      32:  00:57BD                      ;
      33:  00:57BD                      ; HMMV (#C0) rellena un rectangulo con un color.
      34:  00:57BD                      ; DY alto = 2 para pintar en la page 2.
      35:  00:57BD                      FINAL_FASE_5_VAMOS_A_TERMINAR_PLANTILLA_HMMV:
      36:  00:57BD                      
      37:  00:57BD  00 00 00 00         		db		0,0,0,0
      38:  00:57C1  00 00               		db		0,0
      39:  00:57C3  00 02               		db		0,PAGE_2_VRAM_Y_BOSS_5/256
      40:  00:57C5  04 00               		db		4,0
      41:  00:57C7  02 00               		db		2,0
      42:  00:57C9  00                  		db		#00
      43:  00:57CA  00                  		db		#00
      44:  00:57CB  C0                  		db		COPY_LOGICA_RELLENO_BOSS_5
      45:  00:57CC                      
      46:  00:57CC                      ; Filas en orden pseudoaleatorio.
      47:  00:57CC                      ; Son las 53 filas de bloques de 4 pixeles: 0,4,8,...,208,
      48:  00:57CC                      ; pero mezcladas. No hay repeticiones.
      49:  00:57CC                      
      50:  00:57CC                      FINAL_FASE_5_VAMOS_A_TERMINAR_TABLA_Y:
      51:  00:57CC                      
      52:  00:57CC                      		db		46,120,194,56,130,204,66,140,2,76,150,12,86,160,22,96
      52:  00:57CC  2E 78 C2 38 82 CC 42 8C 02 4C 96 0C 56 A0 16 60 
      53:  00:57DC                      		db		170,32,106,180,42,116,190,52,126,200,62,136,210,72,146,8
      53:  00:57DC  AA 20 6A B4 2A 74 BE 34 7E C8 3E 88 D2 48 92 08 
      54:  00:57EC                      		db		82,156,18,92,166,28,102,176,38,112,186,48,122,196,58,132
      54:  00:57EC  52 9C 12 5C A6 1C 66 B0 26 70 BA 30 7A C4 3A 84 
      55:  00:57FC                      		db		206,68,142,4,78,152,14,88,162,24,98,172,34,108,182,44
      55:  00:57FC  CE 44 8E 04 4E 98 0E 58 A2 18 62 AC 22 6C B6 2C 
      56:  00:580C                      		db		118,192,54,128,202,64,138,0,74,148,10,84,158,20,94,168
      56:  00:580C  76 C0 36 80 CA 40 8A 00 4A 94 0A 54 9E 14 5E A8 
      57:  00:581C                      		db		30,104,178,40,114,188,50,124,198,60,134,208,70,144,6,80
      57:  00:581C  1E 68 B2 28 72 BC 32 7C C6 3C 86 D0 46 90 06 50 
      58:  00:582C                      		db		154,16,90,164,26,100,174,36,110,184
      58:  00:582C  9A 10 5A A4 1A 64 AE 24 6E B8 
      59:  00:5836                      
      60:  00:5836                      FINAL_FASE_5_VAMOS_A_TERMINAR_INICIO:
      61:  00:5836                      
      62:  00:5836                      		; Lanzamos FX 34 al empezar la secuencia final.
      63:  00:5836  3E 22               		ld		a,34
      64:  00:5838  0E 01               		ld		c,1
      65:  00:583A  CD 66 57            		call	TIRA_FX_BOSS_5
      66:  00:583D                      
      67:  00:583D                      		; Aseguramos que la page visible es la 2, que es donde vamos a pintar.
      68:  00:583D  3E 02               		ld		a,2
      69:  00:583F  32 59 C0            		ld		(SET_PAGE),a
      70:  00:5842                      
      71:  00:5842                      		; Copiamos la plantilla ROM al buffer real en RAM.
      72:  00:5842  21 BD 57            		ld		hl,FINAL_FASE_5_VAMOS_A_TERMINAR_PLANTILLA_HMMV
      73:  00:5845  11 5E C6            		ld		de,FINAL_FASE_5_VAMOS_A_TERMINAR_DATAS_HMMV
      74:  00:5848  01 0F 00            		ld		bc,15
      75:  00:584B  ED B0               		ldir
      76:  00:584D                              
      77:  00:584D  06 6A               		ld		b,106
      78:  00:584F  FD 21 CC 57         		ld		iy,FINAL_FASE_5_VAMOS_A_TERMINAR_TABLA_Y
      79:  00:5853                      
      80:  00:5853                      .BUCLE_FILAS_FINAL_FASE_5:
      81:  00:5853                      
      82:  00:5853  C5                  		push	bc
      83:  00:5854                      
      84:  00:5854                      		; DY = fila actual en page 2.
      85:  00:5854  FD 7E 00            		ld		a,(iy)
      86:  00:5857  FD 23               		inc		iy
      87:  00:5859  32 64 C6            		ld		(FINAL_FASE_5_VAMOS_A_TERMINAR_DATAS_HMMV+6),a
      88:  00:585C                      
      89:  00:585C                      		; Semilla X distinta para cada fila.
      90:  00:585C                      		; Como la tabla Y ya esta mezclada, esto evita que todas las filas
      91:  00:585C                      		; se borren con el mismo orden horizontal.
      92:  00:585C  CB 3F               		srl		a
      93:  00:585E  CB 3F               		srl		a
      94:  00:5860  C6 07               		add		a,7
      95:  00:5862  E6 3F               		and		00111111b
      96:  00:5864  32 6D C6            		ld		(FINAL_FASE_5_VAMOS_A_TERMINAR_X_SEED),a
      97:  00:5867                      
      98:  00:5867  06 40               		ld		b,64
      99:  00:5869                      
     100:  00:5869                      .BUCLE_COLUMNAS_FINAL_FASE_5:
     101:  00:5869                      
     102:  00:5869  C5                  		push	bc
     103:  00:586A  FD E5               		push	iy
     104:  00:586C                      
     105:  00:586C                      		; DX = (semilla X modulo 64) * 4.
     106:  00:586C  3A 6D C6            		ld		a,(FINAL_FASE_5_VAMOS_A_TERMINAR_X_SEED)
     107:  00:586F  E6 3F               		and		00111111b
     108:  00:5871  87                  		add		a,a
     109:  00:5872  87                  		add		a,a
     110:  00:5873  32 62 C6            		ld		(FINAL_FASE_5_VAMOS_A_TERMINAR_DATAS_HMMV+4),a
     111:  00:5876                      
     112:  00:5876                      		; Pintamos bloque negro 4x4 en page 2.
     113:  00:5876  21 5E C6            		ld		hl,FINAL_FASE_5_VAMOS_A_TERMINAR_DATAS_HMMV
     114:  00:5879  CD 2A 5E            		call	DOCOPY
     115:  00:587C  CD 33 5E            		call	VDPREADY
     116:  00:587F                      
     117:  00:587F                      		; Siguiente X pseudoaleatoria.
     118:  00:587F                      		; 21 es coprimo con 64, asi que recorre las 64 columnas
     119:  00:587F                      		; sin repetir ninguna dentro de la misma fila.
     120:  00:587F  3A 6D C6            		ld		a,(FINAL_FASE_5_VAMOS_A_TERMINAR_X_SEED)
     121:  00:5882  C6 15               		add		a,21
     122:  00:5884  E6 3F               		and		00111111b
     123:  00:5886  32 6D C6            		ld		(FINAL_FASE_5_VAMOS_A_TERMINAR_X_SEED),a
     124:  00:5889                      
     125:  00:5889  FD E1               		pop		iy
     126:  00:588B  C1                  		pop		bc
     127:  00:588C  10 DB               		djnz	.BUCLE_COLUMNAS_FINAL_FASE_5
     128:  00:588E                      
     129:  00:588E  C1                  		pop		bc
     130:  00:588F                      
     131:  00:588F                      		; Pausa corta entre filas para que el borrado respire.
     132:  00:588F  C5                  		push	bc
     133:  00:5890  01 00 04            		ld		bc,#0400
     134:  00:5893                      
     135:  00:5893                      .PAUSA_ENTRE_FILAS_FINAL_FASE_5:
     136:  00:5893                      
     137:  00:5893  0B                  		dec		bc
     138:  00:5894  78                  		ld		a,b
     139:  00:5895  B1                  		or		c
     140:  00:5896  20 FB               		jr		nz,.PAUSA_ENTRE_FILAS_FINAL_FASE_5
     141:  00:5898                      
     142:  00:5898  C1                  		pop		bc
     143:  00:5899                      
     144:  00:5899  10 B8               		djnz	.BUCLE_FILAS_FINAL_FASE_5
     145:  00:589B                      
     146:  00:589B                      ; Fin del include.
