    3008.  00:6F06                      
    3009.  00:6F06  3A DA C0            		ld      a,(FASE)
    3010.  00:6F09  C6 0F               		add		15
    3011.  00:6F0B  CD 4C 5F            		call	CHANGE_BANK_2
    3012.  00:6F0E  21 00 80            		ld		hl,#8000
    3013.  00:6F11  11 00 C0            		ld		de,#C000
    3014.  00:6F14  01 00 40            		ld		bc,16384
