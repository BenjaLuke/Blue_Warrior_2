    2946.  00:6F08  CD 36 5F            		call	CHANGE_BANK_2
    2947.  00:6F0B  21 00 80            		ld		hl,#8000
    2948.  00:6F0E  11 00 C0            		ld		de,#C000
    2949.  00:6F11  01 00 40            		ld		bc,16384
