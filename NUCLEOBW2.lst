    1805.  00:4F5D                      REVISAMOS_COLISION_CON_AGONIX_Y_DEPH:
    1806.  00:4F5D                      
    1807.  00:4F5D                      		; Hitbox Agonix reducido 20 px por cada lado.
    1808.  00:4F5D                      		; Deph se sigue tratando como caja aproximada de 20x20.
    1809.  00:4F5D                      		;
    1810.  00:4F5D                      		; Agonix original:
    1811.  00:4F5D                      		; X = AGONIX_BOSS_1_X
    1812.  00:4F5D                      		; W = AGONIX_MOVIMIENTO_ANCHO_BOSS_1
    1813.  00:4F5D                      		; Y = AGONIX_MOVIMIENTO_Y_BOSS_1
    1814.  00:4F5D                      		; H = AGONIX_MOVIMIENTO_ALTO_BOSS_1
    1815.  00:4F5D                      		;
    1816.  00:4F5D                      		; Agonix reducido:
    1817.  00:4F5D                      		; X izquierda = X + 20
    1818.  00:4F5D                      		; X derecha   = X + ancho - 20
    1819.  00:4F5D                      		; Y arriba    = Y + 20
    1820.  00:4F5D                      		; Y abajo     = Y + alto - 20
    1821.  00:4F5D                      
    1822.  00:4F5D  3A 77 C6            		ld		a,(AGONIX_BOSS_1_X)
    1823.  00:4F60  C6 14               		add		20
    1824.  00:4F62  4F                  		ld		c,a
    1825.  00:4F63  3A 64 C0            		ld		a,(X_DEPH)
    1826.  00:4F66  C6 14               		add		20
    1827.  00:4F68  B9                  		cp		c
    1828.  00:4F69  D8                  		ret		c
    1829.  00:4F6A                      
    1830.  00:4F6A  3A 77 C6            		ld		a,(AGONIX_BOSS_1_X)
    1831.  00:4F6D  C6 6E               		add		AGONIX_MOVIMIENTO_ANCHO_BOSS_1-20
    1832.  00:4F6F  4F                  		ld		c,a
    1833.  00:4F70  3A 64 C0            		ld		a,(X_DEPH)
    1834.  00:4F73  B9                  		cp		c
    1835.  00:4F74  D0                  		ret		nc
    1836.  00:4F75                      
    1837.  00:4F75  3A 65 C0            		ld		a,(Y_DEPH)
    1838.  00:4F78  C6 14               		add		20
    1839.  00:4F7A  FE 56               		cp		AGONIX_MOVIMIENTO_Y_BOSS_1+20
    1840.  00:4F7C  D8                  		ret		c
    1841.  00:4F7D                      
    1842.  00:4F7D  3A 65 C0            		ld		a,(Y_DEPH)
    1843.  00:4F80  FE 5E               		cp		AGONIX_MOVIMIENTO_Y_BOSS_1+AGONIX_MOVIMIENTO_ALTO_BOSS_1-20
    1844.  00:4F82  D0                  		ret		nc
