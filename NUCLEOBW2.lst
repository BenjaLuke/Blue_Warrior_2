    2980.  00:6EF6  AF                  		xor		a
    2981.  00:6EF7  32 22 C1            		ld		(INMUNE),a
    2982.  00:6EFA  32 0F C1            		ld		(TIEMPO_DE_ADJUST),a
    2983.  00:6EFD  3C                  		inc		a
