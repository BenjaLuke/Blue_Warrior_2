    2949.  00:6F07  C6 0F               		add		15
    2950.  00:6F09  CD 36 5F            		call	CHANGE_BANK_2
    2951.  00:6F0C  21 00 80            		ld		hl,#8000
    2952.  00:6F0F  11 00 C0            		ld		de,#C000
    2953.  00:6F12  01 00 40            		ld		bc,16384
