       1:  00:5AC9                      ; -----------------------------------------------------------------------------
       2:  00:5AC9                      ; FINAL FASE 5 VAMOS A TERMINAR.asm
       3:  00:5AC9                      ;
       4:  00:5AC9                      ; Include ejecutado desde BOSS 5.asm en la etiqueta FINAL_b5.
       5:  00:5AC9                      ;
       6:  00:5AC9                      ; Objetivo:
       7:  00:5AC9                      ;   - Borrar visualmente la page 2 visible.
       8:  00:5AC9                      ;   - Pintar bloques negros en orden pseudoaleatorio.
       9:  00:5AC9                      ;   - No repetir nunca el mismo bloque.
      10:  00:5AC9                      ;   - Al terminar, NO hacer ret ni jp: el flujo cae al codigo siguiente
      11:  00:5AC9                      ;     del include, es decir, VOLVEMOS_b5.
      12:  00:5AC9                      ;
      13:  00:5AC9                      ; Nota:
      14:  00:5AC9                      ;   La pantalla se divide en bloques de 4x4.
      15:  00:5AC9                      ;   64 columnas x 53 filas = 3392 bloques.
      16:  00:5AC9                      ;   Cada bloque se pinta una sola vez mediante HMMV.
      17:  00:5AC9                      ; -----------------------------------------------------------------------------
      18:  00:5AC9                      
      19:  00:5AC9  C3 45 5B            		jp		FINAL_FASE_5_VAMOS_A_TERMINAR_INICIO
      20:  00:5ACC                      
      21:  00:5ACC                      ; Buffer de comando VDP.
      22:  00:5ACC                      ; Formato DOCOPY:
      23:  00:5ACC                      ;   0-1   SX
      24:  00:5ACC                      ;   2-3   SY
      25:  00:5ACC                      ;   4-5   DX
      26:  00:5ACC                      ;   6-7   DY
      27:  00:5ACC                      ;   8-9   NX
      28:  00:5ACC                      ;   10-11 NY
      29:  00:5ACC                      ;   12    color
      30:  00:5ACC                      ;   13    argumento
      31:  00:5ACC                      ;   14    comando
      32:  00:5ACC                      ;
      33:  00:5ACC                      ; HMMV (#C0) rellena un rectangulo con un color.
      34:  00:5ACC                      ; DY alto = 2 para pintar en la page 2.
      35:  00:5ACC                      FINAL_FASE_5_VAMOS_A_TERMINAR_PLANTILLA_HMMV:
      36:  00:5ACC                      
      37:  00:5ACC  00 00 00 00         		db		0,0,0,0
      38:  00:5AD0  00 00               		db		0,0
      39:  00:5AD2  00 02               		db		0,PAGE_2_VRAM_Y_BOSS_5/256
      40:  00:5AD4  04 00               		db		4,0
      41:  00:5AD6  02 00               		db		2,0
      42:  00:5AD8  00                  		db		#00
      43:  00:5AD9  00                  		db		#00
      44:  00:5ADA  C0                  		db		COPY_LOGICA_RELLENO_BOSS_5
      45:  00:5ADB                      
