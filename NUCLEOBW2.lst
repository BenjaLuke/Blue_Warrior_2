    2447.  00:5102                              ;
    2448.  00:5102                              ; Copiamos solo la parte visible de la letra:
    2449.  00:5102                              ;   repeticion 0 -> ancho 2
    2450.  00:5102                              ;   repeticion 1 -> ancho 4
    2451.  00:5102                              ;   repeticion 2 -> ancho 6
    2452.  00:5102                              ;
    2453.  00:5102                              ; Así respetamos la entrada progresiva sin escribir fuera de X=255.
