    3669.  00:5B6F                      FINAL_b5:
    3670.  00:5B6F                      
    3671.  00:5B6F                      		include	"../ANIMACIONES/FINAL FASE 5 VAMOS A TERMINAR.asm"		
       1:  00:5B6F                      ; -----------------------------------------------------------------------------
       2:  00:5B6F                      ; FINAL FASE 5 VAMOS A TERMINAR.asm
       3:  00:5B6F                      ;
       4:  00:5B6F                      ; Include ejecutado desde BOSS 5.asm en la etiqueta FINAL_b5.
       5:  00:5B6F                      ;
       6:  00:5B6F                      ; Objetivo:
       7:  00:5B6F                      ;   - Borrar visualmente la page 2 visible.
       8:  00:5B6F                      ;   - Pintar bloques negros en orden pseudoaleatorio.
       9:  00:5B6F                      ;   - No repetir nunca el mismo bloque.
      10:  00:5B6F                      ;   - Al terminar, NO hacer ret ni jp: el flujo cae al codigo siguiente
      11:  00:5B6F                      ;     del include, es decir, VOLVEMOS_b5.
      12:  00:5B6F                      ;
      13:  00:5B6F                      ; Nota:
      14:  00:5B6F                      ;   La pantalla se divide en bloques de 4x4.
      15:  00:5B6F                      ;   64 columnas x 53 filas = 3392 bloques.
      16:  00:5B6F                      ;   Cada bloque se pinta una sola vez mediante HMMV.
      17:  00:5B6F                      ; -----------------------------------------------------------------------------
      18:  00:5B6F                      
      19:  00:5B6F  C3 EB 5B            		jp		FINAL_FASE_5_VAMOS_A_TERMINAR_INICIO
      20:  00:5B72                      
      21:  00:5B72                      ; Buffer de comando VDP.
      22:  00:5B72                      ; Formato DOCOPY:
      23:  00:5B72                      ;   0-1   SX
      24:  00:5B72                      ;   2-3   SY
      25:  00:5B72                      ;   4-5   DX
      26:  00:5B72                      ;   6-7   DY
      27:  00:5B72                      ;   8-9   NX
      28:  00:5B72                      ;   10-11 NY
      29:  00:5B72                      ;   12    color
      30:  00:5B72                      ;   13    argumento
      31:  00:5B72                      ;   14    comando
      32:  00:5B72                      ;
      33:  00:5B72                      ; HMMV (#C0) rellena un rectangulo con un color.
      34:  00:5B72                      ; DY alto = 2 para pintar en la page 2.
      35:  00:5B72                      FINAL_FASE_5_VAMOS_A_TERMINAR_PLANTILLA_HMMV:
      36:  00:5B72                      
      37:  00:5B72  00 00 00 00         		db		0,0,0,0
      38:  00:5B76  00 00               		db		0,0
      39:  00:5B78  00 02               		db		0,PAGE_2_VRAM_Y_BOSS_5/256
      40:  00:5B7A  04 00               		db		4,0
      41:  00:5B7C  02 00               		db		2,0
      42:  00:5B7E  00                  		db		#00
      43:  00:5B7F  00                  		db		#00
      44:  00:5B80  C0                  		db		COPY_LOGICA_RELLENO_BOSS_5
      45:  00:5B81                      
      46:  00:5B81                      ; Filas en orden pseudoaleatorio.
      47:  00:5B81                      ; Son las 53 filas de bloques de 4 pixeles: 0,4,8,...,208,
      48:  00:5B81                      ; pero mezcladas. No hay repeticiones.
      49:  00:5B81                      
      50:  00:5B81                      FINAL_FASE_5_VAMOS_A_TERMINAR_TABLA_Y:
      51:  00:5B81                      
      52:  00:5B81                      		db		46,120,194,56,130,204,66,140,2,76,150,12,86,160,22,96
      52:  00:5B81  2E 78 C2 38 82 CC 42 8C 02 4C 96 0C 56 A0 16 60 
      53:  00:5B91                      		db		170,32,106,180,42,116,190,52,126,200,62,136,210,72,146,8
      53:  00:5B91  AA 20 6A B4 2A 74 BE 34 7E C8 3E 88 D2 48 92 08 
      54:  00:5BA1                      		db		82,156,18,92,166,28,102,176,38,112,186,48,122,196,58,132
      54:  00:5BA1  52 9C 12 5C A6 1C 66 B0 26 70 BA 30 7A C4 3A 84 
      55:  00:5BB1                      		db		206,68,142,4,78,152,14,88,162,24,98,172,34,108,182,44
      55:  00:5BB1  CE 44 8E 04 4E 98 0E 58 A2 18 62 AC 22 6C B6 2C 
      56:  00:5BC1                      		db		118,192,54,128,202,64,138,0,74,148,10,84,158,20,94,168
      56:  00:5BC1  76 C0 36 80 CA 40 8A 00 4A 94 0A 54 9E 14 5E A8 
      57:  00:5BD1                      		db		30,104,178,40,114,188,50,124,198,60,134,208,70,144,6,80
      57:  00:5BD1  1E 68 B2 28 72 BC 32 7C C6 3C 86 D0 46 90 06 50 
      58:  00:5BE1                      		db		154,16,90,164,26,100,174,36,110,184
      58:  00:5BE1  9A 10 5A A4 1A 64 AE 24 6E B8 
      59:  00:5BEB                      
      60:  00:5BEB                      FINAL_FASE_5_VAMOS_A_TERMINAR_INICIO:
      61:  00:5BEB                      
      62:  00:5BEB                      		; Lanzamos FX 34 al empezar la secuencia final.
      63:  00:5BEB  3E 22               		ld		a,34
      64:  00:5BED  0E 01               		ld		c,1
      65:  00:5BEF  CD 48 5B            		call	TIRA_FX_BOSS_5
      66:  00:5BF2                      
      67:  00:5BF2                      		; Aseguramos que la page visible es la 2, que es donde vamos a pintar.
      68:  00:5BF2  3E 02               		ld		a,2
      69:  00:5BF4  32 59 C0            		ld		(SET_PAGE),a
      70:  00:5BF7                      
      71:  00:5BF7                      		; Copiamos la plantilla ROM al buffer real en RAM.
      72:  00:5BF7  21 72 5B            		ld		hl,FINAL_FASE_5_VAMOS_A_TERMINAR_PLANTILLA_HMMV
      73:  00:5BFA  11 40 C6            		ld		de,FINAL_FASE_5_VAMOS_A_TERMINAR_DATAS_HMMV
      74:  00:5BFD  01 0F 00            		ld		bc,15
      75:  00:5C00  ED B0               		ldir
      76:  00:5C02                              
      77:  00:5C02  06 6A               		ld		b,106
      78:  00:5C04  FD 21 81 5B         		ld		iy,FINAL_FASE_5_VAMOS_A_TERMINAR_TABLA_Y
      79:  00:5C08                      
      80:  00:5C08                      .BUCLE_FILAS_FINAL_FASE_5:
      81:  00:5C08                      
      82:  00:5C08  C5                  		push	bc
      83:  00:5C09                      
      84:  00:5C09                      		; DY = fila actual en page 2.
      85:  00:5C09  FD 7E 00            		ld		a,(iy)
      86:  00:5C0C  FD 23               		inc		iy
      87:  00:5C0E  32 46 C6            		ld		(FINAL_FASE_5_VAMOS_A_TERMINAR_DATAS_HMMV+6),a
      88:  00:5C11                      
      89:  00:5C11                      		; Semilla X distinta para cada fila.
      90:  00:5C11                      		; Como la tabla Y ya esta mezclada, esto evita que todas las filas
      91:  00:5C11                      		; se borren con el mismo orden horizontal.
      92:  00:5C11  CB 3F               		srl		a
      93:  00:5C13  CB 3F               		srl		a
      94:  00:5C15  C6 07               		add		a,7
      95:  00:5C17  E6 3F               		and		00111111b
      96:  00:5C19  32 4F C6            		ld		(FINAL_FASE_5_VAMOS_A_TERMINAR_X_SEED),a
      97:  00:5C1C                      
      98:  00:5C1C  06 40               		ld		b,64
      99:  00:5C1E                      
     100:  00:5C1E                      .BUCLE_COLUMNAS_FINAL_FASE_5:
     101:  00:5C1E                      
     102:  00:5C1E  C5                  		push	bc
     103:  00:5C1F  FD E5               		push	iy
     104:  00:5C21                      
     105:  00:5C21                      		; DX = (semilla X modulo 64) * 4.
     106:  00:5C21  3A 4F C6            		ld		a,(FINAL_FASE_5_VAMOS_A_TERMINAR_X_SEED)
     107:  00:5C24  E6 3F               		and		00111111b
     108:  00:5C26  87                  		add		a,a
     109:  00:5C27  87                  		add		a,a
     110:  00:5C28  32 44 C6            		ld		(FINAL_FASE_5_VAMOS_A_TERMINAR_DATAS_HMMV+4),a
     111:  00:5C2B                      
     112:  00:5C2B                      		; Pintamos bloque negro 4x4 en page 2.
     113:  00:5C2B  21 40 C6            		ld		hl,FINAL_FASE_5_VAMOS_A_TERMINAR_DATAS_HMMV
     114:  00:5C2E  CD 2A 5E            		call	DOCOPY
     115:  00:5C31  CD 33 5E            		call	VDPREADY
     116:  00:5C34                      
     117:  00:5C34                      		; Siguiente X pseudoaleatoria.
     118:  00:5C34                      		; 21 es coprimo con 64, asi que recorre las 64 columnas
     119:  00:5C34                      		; sin repetir ninguna dentro de la misma fila.
     120:  00:5C34  3A 4F C6            		ld		a,(FINAL_FASE_5_VAMOS_A_TERMINAR_X_SEED)
     121:  00:5C37  C6 15               		add		a,21
     122:  00:5C39  E6 3F               		and		00111111b
     123:  00:5C3B  32 4F C6            		ld		(FINAL_FASE_5_VAMOS_A_TERMINAR_X_SEED),a
     124:  00:5C3E                      
     125:  00:5C3E  FD E1               		pop		iy
     126:  00:5C40  C1                  		pop		bc
     127:  00:5C41  10 DB               		djnz	.BUCLE_COLUMNAS_FINAL_FASE_5
     128:  00:5C43                      
     129:  00:5C43  C1                  		pop		bc
     130:  00:5C44                      
     131:  00:5C44                      		; Pausa corta entre filas para que el borrado respire.
     132:  00:5C44  C5                  		push	bc
     133:  00:5C45  01 00 04            		ld		bc,#0400
     134:  00:5C48                      
     135:  00:5C48                      .PAUSA_ENTRE_FILAS_FINAL_FASE_5:
     136:  00:5C48                      
     137:  00:5C48  0B                  		dec		bc
     138:  00:5C49  78                  		ld		a,b
     139:  00:5C4A  B1                  		or		c
     140:  00:5C4B  20 FB               		jr		nz,.PAUSA_ENTRE_FILAS_FINAL_FASE_5
     141:  00:5C4D                      
     142:  00:5C4D  C1                  		pop		bc
     143:  00:5C4E                      
     144:  00:5C4E  10 B8               		djnz	.BUCLE_FILAS_FINAL_FASE_5
     145:  00:5C50                      
     146:  00:5C50                      ; Fin del include.
     147:  00:5C50                      ; No hay ret.
     148:  00:5C50                      ; El ensamblador continua con la siguiente linea de BOSS 5.asm:
     149:  00:5C50                      ; VOLVEMOS_b5 -> jp CARGA_SLOT_REGRESO_A_JUEGO
    3672.  00:5C50                      
