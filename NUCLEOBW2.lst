      23   00:4000                      				
      24   00:4000  41 42               		db 		"AB"													; Cabecera para indicar que esto será una ROM
      25   00:4002  10 40               		word 	INICIO													; Etiqueta en la que comienza todo
      26   00:4004                      		word 	0,0,0,0,0,0
      26   00:4004  00 00 00 00 00 00 00 00 00 00 00 00 
