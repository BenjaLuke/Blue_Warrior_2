       1:  00:59F8                      ; -----------------------------------------------------------------------------
       2:  00:59F8                      ; FINAL FASE 5 VAMOS A TERMINAR.asm
       3:  00:59F8                      ;
       4:  00:59F8                      ; Include ejecutado desde BOSS 5.asm en la etiqueta FINAL_b5.
       5:  00:59F8                      ;
       6:  00:59F8                      ; Objetivo:
       7:  00:59F8                      ;   - Borrar visualmente la page 2 visible.
       8:  00:59F8                      ;   - Pintar bloques negros en orden pseudoaleatorio.
       9:  00:59F8                      ;   - No repetir nunca el mismo bloque.
      10:  00:59F8                      ;   - Al terminar, NO hacer ret ni jp: el flujo cae al codigo siguiente
      11:  00:59F8                      ;     del include, es decir, VOLVEMOS_b5.
      12:  00:59F8                      ;
      13:  00:59F8                      ; Nota:
      14:  00:59F8                      ;   La pantalla se divide en bloques de 4x4.
      15:  00:59F8                      ;   64 columnas x 53 filas = 3392 bloques.
      16:  00:59F8                      ;   Cada bloque se pinta una sola vez mediante HMMV.
      17:  00:59F8                      ; -----------------------------------------------------------------------------
      18:  00:59F8                      
      19:  00:59F8  C3 74 5A            		jp		FINAL_FASE_5_VAMOS_A_TERMINAR_INICIO
      20:  00:59FB                      
      21:  00:59FB                      
      22:  00:59FB  (00:0004)           FINAL_FASE_5_VAMOS_A_TERMINAR_ANCHO_BLOQUE:	equ	4
      23:  00:59FB  (00:0002)           FINAL_FASE_5_VAMOS_A_TERMINAR_ALTO_BLOQUE:	equ	2
      24:  00:59FB  (00:0040)           FINAL_FASE_5_VAMOS_A_TERMINAR_COLUMNAS:		equ	64
      25:  00:59FB  (00:006A)           FINAL_FASE_5_VAMOS_A_TERMINAR_FILAS:		equ	106
      26:  00:59FB  (00:0015)           FINAL_FASE_5_VAMOS_A_TERMINAR_SALTO_X:		equ	21
      27:  00:59FB  (00:000F)           FINAL_FASE_5_VAMOS_A_TERMINAR_BYTES_HMMV:	equ	15
      28:  00:59FB  (00:0400)           FINAL_FASE_5_VAMOS_A_TERMINAR_PAUSA_FILAS:	equ	#0400
      29:  00:59FB                      
      30:  00:59FB                      ; Buffer de comando VDP.
      31:  00:59FB                      ; Formato DOCOPY:
      32:  00:59FB                      ;   0-1   SX
      33:  00:59FB                      ;   2-3   SY
      34:  00:59FB                      ;   4-5   DX
      35:  00:59FB                      ;   6-7   DY
      36:  00:59FB                      ;   8-9   NX
      37:  00:59FB                      ;   10-11 NY
      38:  00:59FB                      ;   12    color
      39:  00:59FB                      ;   13    argumento
      40:  00:59FB                      ;   14    comando
      41:  00:59FB                      ;
      42:  00:59FB                      ; HMMV (#C0) rellena un rectangulo con un color.
      43:  00:59FB                      ; DY alto = 2 para pintar en la page 2.
      44:  00:59FB                      FINAL_FASE_5_VAMOS_A_TERMINAR_PLANTILLA_HMMV:
      45:  00:59FB                      
      46:  00:59FB  00 00 00 00         		db		0,0,0,0
      47:  00:59FF  00 00               		db		0,0
      48:  00:5A01  00 02               		db		0,PAGE_2_VRAM_Y_BOSS_5/256
      49:  00:5A03  04 00               		db		FINAL_FASE_5_VAMOS_A_TERMINAR_ANCHO_BLOQUE,0
      50:  00:5A05  02 00               		db		FINAL_FASE_5_VAMOS_A_TERMINAR_ALTO_BLOQUE,0
      51:  00:5A07  00                  		db		#00
      52:  00:5A08  00                  		db		#00
      53:  00:5A09  C0                  		db		COPY_LOGICA_RELLENO_BOSS_5
      54:  00:5A0A                      
      55:  00:5A0A                      ; Filas en orden pseudoaleatorio.
      56:  00:5A0A                      ; Son las 53 filas de bloques de 4 pixeles: 0,4,8,...,208,
      57:  00:5A0A                      ; pero mezcladas. No hay repeticiones.
      58:  00:5A0A                      
      59:  00:5A0A                      FINAL_FASE_5_VAMOS_A_TERMINAR_TABLA_Y:
      60:  00:5A0A                      
      61:  00:5A0A                      		db		46,120,194,56,130,204,66,140,2,76,150,12,86,160,22,96
      61:  00:5A0A  2E 78 C2 38 82 CC 42 8C 02 4C 96 0C 56 A0 16 60 
      62:  00:5A1A                      		db		170,32,106,180,42,116,190,52,126,200,62,136,210,72,146,8
      62:  00:5A1A  AA 20 6A B4 2A 74 BE 34 7E C8 3E 88 D2 48 92 08 
      63:  00:5A2A                      		db		82,156,18,92,166,28,102,176,38,112,186,48,122,196,58,132
      63:  00:5A2A  52 9C 12 5C A6 1C 66 B0 26 70 BA 30 7A C4 3A 84 
      64:  00:5A3A                      		db		206,68,142,4,78,152,14,88,162,24,98,172,34,108,182,44
      64:  00:5A3A  CE 44 8E 04 4E 98 0E 58 A2 18 62 AC 22 6C B6 2C 
      65:  00:5A4A                      		db		118,192,54,128,202,64,138,0,74,148,10,84,158,20,94,168
      65:  00:5A4A  76 C0 36 80 CA 40 8A 00 4A 94 0A 54 9E 14 5E A8 
      66:  00:5A5A                      		db		30,104,178,40,114,188,50,124,198,60,134,208,70,144,6,80
      66:  00:5A5A  1E 68 B2 28 72 BC 32 7C C6 3C 86 D0 46 90 06 50 
      67:  00:5A6A                      		db		154,16,90,164,26,100,174,36,110,184
      67:  00:5A6A  9A 10 5A A4 1A 64 AE 24 6E B8 
      68:  00:5A74                      
      69:  00:5A74                      FINAL_FASE_5_VAMOS_A_TERMINAR_INICIO:
      70:  00:5A74                      
      71:  00:5A74                      		; Lanzamos FX 34 al empezar la secuencia final.
      72:  00:5A74  3E 22               		ld		a,34
      73:  00:5A76  0E 01               		ld		c,1
      74:  00:5A78  CD EC 59            		call	TIRA_FX_BOSS_5
      75:  00:5A7B                      
      76:  00:5A7B                      		; Aseguramos que la page visible es la 2, que es donde vamos a pintar.
      77:  00:5A7B  3E 02               		ld		a,2
      78:  00:5A7D  32 59 C0            		ld		(SET_PAGE),a
      79:  00:5A80                      
      80:  00:5A80                      		; Copiamos la plantilla ROM al buffer real en RAM.
      81:  00:5A80  21 FB 59            		ld		hl,FINAL_FASE_5_VAMOS_A_TERMINAR_PLANTILLA_HMMV
      82:  00:5A83  11 28 C6            		ld		de,FINAL_FASE_5_VAMOS_A_TERMINAR_DATAS_HMMV
      83:  00:5A86  01 0F 00            		ld		bc,FINAL_FASE_5_VAMOS_A_TERMINAR_BYTES_HMMV
      84:  00:5A89  ED B0               		ldir
      85:  00:5A8B                              
      86:  00:5A8B  06 6A               		ld		b,FINAL_FASE_5_VAMOS_A_TERMINAR_FILAS
      87:  00:5A8D  FD 21 0A 5A         		ld		iy,FINAL_FASE_5_VAMOS_A_TERMINAR_TABLA_Y
      88:  00:5A91                      
      89:  00:5A91                      .BUCLE_FILAS_FINAL_FASE_5:
      90:  00:5A91                      
      91:  00:5A91  C5                  		push	bc
      92:  00:5A92                      
      93:  00:5A92                      		; DY = fila actual en page 2.
      94:  00:5A92  FD 7E 00            		ld		a,(iy)
      95:  00:5A95  FD 23               		inc		iy
      96:  00:5A97  32 2E C6            		ld		(FINAL_FASE_5_VAMOS_A_TERMINAR_DATAS_HMMV+6),a
      97:  00:5A9A                      
      98:  00:5A9A                      		; Semilla X distinta para cada fila.
      99:  00:5A9A                      		; Como la tabla Y ya esta mezclada, esto evita que todas las filas
     100:  00:5A9A                      		; se borren con el mismo orden horizontal.
     101:  00:5A9A  CB 3F               		srl		a
     102:  00:5A9C  CB 3F               		srl		a
     103:  00:5A9E  C6 07               		add		a,7
     104:  00:5AA0  E6 3F               		and		00111111b
     105:  00:5AA2  32 37 C6            		ld		(FINAL_FASE_5_VAMOS_A_TERMINAR_X_SEED),a
     106:  00:5AA5                      
     107:  00:5AA5  06 40               		ld		b,FINAL_FASE_5_VAMOS_A_TERMINAR_COLUMNAS
     108:  00:5AA7                      
     109:  00:5AA7                      .BUCLE_COLUMNAS_FINAL_FASE_5:
     110:  00:5AA7                      
     111:  00:5AA7  C5                  		push	bc
     112:  00:5AA8  FD E5               		push	iy
     113:  00:5AAA                      
     114:  00:5AAA                      		; DX = (semilla X modulo 64) * 4.
     115:  00:5AAA  3A 37 C6            		ld		a,(FINAL_FASE_5_VAMOS_A_TERMINAR_X_SEED)
     116:  00:5AAD  E6 3F               		and		00111111b
     117:  00:5AAF  87                  		add		a,a
     118:  00:5AB0  87                  		add		a,a
     119:  00:5AB1  32 2C C6            		ld		(FINAL_FASE_5_VAMOS_A_TERMINAR_DATAS_HMMV+4),a
     120:  00:5AB4                      
     121:  00:5AB4                      		; Pintamos bloque negro 4x4 en page 2.
     122:  00:5AB4  21 28 C6            		ld		hl,FINAL_FASE_5_VAMOS_A_TERMINAR_DATAS_HMMV
     123:  00:5AB7  CD 2A 5E            		call	DOCOPY
     124:  00:5ABA  CD 33 5E            		call	VDPREADY
     125:  00:5ABD                      
     126:  00:5ABD                      		; Siguiente X pseudoaleatoria.
     127:  00:5ABD                      		; 21 es coprimo con 64, asi que recorre las 64 columnas
     128:  00:5ABD                      		; sin repetir ninguna dentro de la misma fila.
     129:  00:5ABD  3A 37 C6            		ld		a,(FINAL_FASE_5_VAMOS_A_TERMINAR_X_SEED)
     130:  00:5AC0  C6 15               		add		a,FINAL_FASE_5_VAMOS_A_TERMINAR_SALTO_X
     131:  00:5AC2  E6 3F               		and		00111111b
     132:  00:5AC4  32 37 C6            		ld		(FINAL_FASE_5_VAMOS_A_TERMINAR_X_SEED),a
     133:  00:5AC7                      
     134:  00:5AC7  FD E1               		pop		iy
     135:  00:5AC9  C1                  		pop		bc
     136:  00:5ACA  10 DB               		djnz	.BUCLE_COLUMNAS_FINAL_FASE_5
     137:  00:5ACC                      
     138:  00:5ACC  C1                  		pop		bc
     139:  00:5ACD                      
     140:  00:5ACD                      		; Pausa corta entre filas para que el borrado respire.
     141:  00:5ACD  C5                  		push	bc
     142:  00:5ACE  01 00 04            		ld		bc,FINAL_FASE_5_VAMOS_A_TERMINAR_PAUSA_FILAS
     143:  00:5AD1                      
     144:  00:5AD1                      .PAUSA_ENTRE_FILAS_FINAL_FASE_5:
     145:  00:5AD1                      
     146:  00:5AD1  0B                  		dec		bc
     147:  00:5AD2  78                  		ld		a,b
     148:  00:5AD3  B1                  		or		c
     149:  00:5AD4  20 FB               		jr		nz,.PAUSA_ENTRE_FILAS_FINAL_FASE_5
     150:  00:5AD6                      
     151:  00:5AD6  C1                  		pop		bc
     152:  00:5AD7                      
     153:  00:5AD7  10 B8               		djnz	.BUCLE_FILAS_FINAL_FASE_5
     154:  00:5AD9                      
     155:  00:5AD9                      ; Fin del include.
     156:  00:5AD9                      ; No hay ret.
