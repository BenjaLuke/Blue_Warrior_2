    2288.  00:506A  DD 36 09 00                 ld      (ix+9),0
    2289.  00:506E  DD 36 0A 08                 ld      (ix+10),ROTATIVO_ALTO_PRESENTACION
    2290.  00:5072  DD 36 0B 00                 ld      (ix+11),0
