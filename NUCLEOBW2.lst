     462.  00:425F                      ; -----------------------------------------------------------------------------
     463.  00:425F                      ; Carga de patrones y colores del barro.
     464.  00:425F                      ; OJO: debe ir DESPUES de RUTINA_BOSS_4 para que la entrada del banco
     465.  00:425F                      ; siga empezando en RUTINA_BOSS_4. Si se coloca antes, el boss puede entrar
     466.  00:425F                      ; por esta rutina y colgarse antes de iniciar el flujo normal.
     467.  00:425F                      ; -----------------------------------------------------------------------------
     468.  00:425F                      CARGA_SPRITES_BARRO_BOSS_4:
     469.  00:425F                      		
     470.  00:425F  CD CD 6D            		call	PAGE_32_A_SEGMENT_2
     471.  00:4262                      
     472.  00:4262                      		; Los dos patrones anteriores al barro quedan reservados para la
     473.  00:4262                      		; explosion de impacto: 92 y 96. NO se cargan aqui: ya estan
     474.  00:4262                      		; en VRAM en el sitio adecuado.
     475.  00:4262                      		; Barro empieza en 100: 100,104,108,112.
     476.  00:4262  21 80 9D            		ld		hl,SPRITE_BARRO
     477.  00:4265  11 20 43            		ld		de,PATRONES_SPRITES_VRAM_BOSS_4+BARRO_PATRON_INICIAL_BOSS_4*8
     478.  00:4268  01 80 00            		ld		bc,8*4*BARRO_CANTIDAD_BOSS_4
     479.  00:426B  CD 58 5F            		call	PON_COLOR_2.sin_bc_impuesta
     480.  00:426E                      
     481.  00:426E                      		; Los COVIDs se cargan despues de los cuatro patrones de barro:
     482.  00:426E                      		; COVID queda en 116 y 120.
     483.  00:426E  21 60 97            		ld		hl,SPRITES_COVID
     484.  00:4271  11 A0 43            		ld		de,PATRONES_SPRITES_VRAM_BOSS_4+COVID_PATRON_INICIAL_BOSS_4*8
     485.  00:4274  01 40 00            		ld		bc,8*4*COVID_PATRON_CANT_BOSS_4
     486.  00:4277  CD 58 5F            		call	PON_COLOR_2.sin_bc_impuesta
     487.  00:427A                      
     488.  00:427A                              ; Los BUBBLES se cargan despues de los COVIDs:
     489.  00:427A                              ; BUBBLES queda en 124 y 128.
     490.  00:427A  21 00 9E                    ld      hl,SPRITE_BUBBLES
     491.  00:427D  11 E0 43                    ld      de,PATRONES_SPRITES_VRAM_BOSS_4+BUBBLES_PATRON_INICIAL_BOSS_4*8
     492.  00:4280  01 40 00                    ld      bc,8*4*BUBBLES_PATRON_CANT_BOSS_4
     493.  00:4283  CD 58 5F                    call    PON_COLOR_2.sin_bc_impuesta
     494.  00:4286                      
     495.  00:4286                      		; El color de sprites en SCREEN 7 va por NUMERO DE SPRITE,
     496.  00:4286                      		; no por patron. Los proyectiles usan los sprites 22-29,
     497.  00:4286                      		; asi que sus colores deben arrancar en #4800 + 22*16 = #4960.
     498.  00:4286  11 60 49            		ld		de,PROYECTIL_BOSS_4_COLOR_VRAM
     499.  00:4289  06 08               		ld		b,PROYECTILES_BOSS_4_CANTIDAD
