    2490.  00:52CB                      
    2491.  00:52CB                      
    2492.  00:52CB                      		; Origen: primer recuadro arriba izquierda.
    2493.  00:52CB                      		; x=0, y=0. La page ya la hemos puesto en iy+3.
    2494.  00:52CB                      
    2495.  00:52CB  AF                  		xor		a
    2496.  00:52CC  FD 77 00            		ld		(iy),a								; origen x low
    2497.  00:52CF  FD 77 01            		ld		(iy+1),a							; origen x high
    2498.  00:52D2  FD 77 02            		ld		(iy+2),a							; origen y low
    2499.  00:52D5                      
    2500.  00:52D5                      
    2501.  00:52D5                      		; Destino X: posición actual de Agonix en page 2.
    2502.  00:52D5                      
    2503.  00:52D5  3A 39 C6            		ld		a,(AGONIX_BOSS_1_X)
    2504.  00:52D8  FD 77 04            		ld		(iy+4),a							; destino x low
    2505.  00:52DB  AF                  		xor		a
    2506.  00:52DC  FD 77 05            		ld		(iy+5),a							; destino x high
    2507.  00:52DF                      
    2508.  00:52DF                      
    2509.  00:52DF                      		; Recuperamos el contador externo del bucle.
    2510.  00:52DF                      		; B = altura actual que vamos a copiar.
    2511.  00:52DF                      		; Primera vuelta: B = 48.
    2512.  00:52DF                      		; Última vuelta: B = 1.
    2513.  00:52DF                      		; Cuando B llega a 0, el djnz de fuera termina la animación.
    2514.  00:52DF                      
    2515.  00:52DF  C1                  		pop		bc
    2516.  00:52E0  C5                  		push	bc
    2517.  00:52E1                      
    2518.  00:52E1                      		; offset = altura inicial - altura actual.
    2519.  00:52E1                      		; Este offset baja el destino.
    2520.  00:52E1                      
    2521.  00:52E1  3E 30               		ld		a,AGONIX_MUERTE_ALTO_BOSS_1
    2522.  00:52E3  90                  		sub		b
    2523.  00:52E4  4F                  		ld		c,a									; C = offset vertical
    2524.  00:52E5                      
    2525.  00:52E5                      
    2526.  00:52E5                      		; Destino Y = y actual de Agonix + offset.
