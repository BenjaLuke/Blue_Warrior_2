    1621.  00:4B83  FE 12               		cp		CHUMINIX_PELEA_X_MIN_BOSS_3
    1622.  00:4B85  30 04               		jr		nc,.COMPRUEBA_X_DEPH_MAX_CHUMINIX_BOSS_3
    1623.  00:4B87                      
    1624.  00:4B87  3E 12               		ld		a,CHUMINIX_PELEA_X_MIN_BOSS_3
    1625.  00:4B89  18 08               		jr		.OBJETIVO_X_DEPH_OK_CHUMINIX_BOSS_3
    1626.  00:4B8B                      
