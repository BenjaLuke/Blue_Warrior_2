      56:  00:59A8                      ; -----------------------------------------------------------------------------
      57:  00:59A8                      ; Copys de la animacion de entrada de Chuminix.
      58:  00:59A8                      ;
      59:  00:59A8                      ; SCREEN 5 / DOCOPY:
      60:  00:59A8                      ; Cuando hablamos de page N (x,y), aqui se traduce a coordenadas absolutas
      61:  00:59A8                      ; de VDP: X=x, Y=PAGE_N_VRAM_Y_BOSS_3+y. No se corrigen los origenes por
      62:  00:59A8                      ; tamanyo ni por centrado; se usan exactamente las coordenadas indicadas.
      63:  00:59A8                      ;
      64:  00:59A8                      ; Frame 0 se salva desde page 2 a page 0 (zona oculta en y=150).
      65:  00:59A8                      ; Los demas fotogramas se leen desde page 1 y se copian centrados a page 2.
      66:  00:59A8                      ; -----------------------------------------------------------------------------
      67:  00:59A8                      BOSS_3_COPY_GUARDA_FRAME_0_CHUMINIX:
      68:  00:59A8                      
      69:  00:59A8                      		; Guarda el fondo visible donde aparecera Chuminix.
      70:  00:59A8                      		; Origen:  page 2 (64,78)  -> X=#0040, Y=#0200+#004E = #024E
      71:  00:59A8                      		; Destino: page 0 (0,150)  -> X=#0000, Y=#0096
      72:  00:59A8  40 00 4E 02         		dw		#0040,#024E
      73:  00:59AC  00 00 96 00         		dw		#0000,#0096
      74:  00:59B0  80 00 30 00         		dw		CHUMINIX_APARICION_ANCHO_BOSS_3,CHUMINIX_APARICION_ALTO_BOSS_3
      75:  00:59B4  00 00 90            		db		#00,#00,10010000b
      76:  00:59B7                      
      77:  00:59B7                      BOSS_3_COPY_APARICION_CHUMINIX_FRAME_0:
      78:  00:59B7                      
      79:  00:59B7                      		; Recupera exactamente el frame 0 desde donde se guardo: page 0 (0,150).
      80:  00:59B7  00 00 96 00         		dw		#0000,#0096
      81:  00:59BB  40 00 4E 02         		dw		#0040,#024E
      82:  00:59BF  80 00 30 00         		dw		CHUMINIX_APARICION_ANCHO_BOSS_3,CHUMINIX_APARICION_ALTO_BOSS_3
      83:  00:59C3  00 00 90            		db		#00,#00,10010000b
