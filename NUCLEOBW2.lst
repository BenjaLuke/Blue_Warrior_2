    2595.  00:5383                      
    2596.  00:5383  FD 77 03            		ld		(iy+3),a							; page origen: 3 o 1
    2597.  00:5386                      
    2598.  00:5386                      
    2599.  00:5386                      		; Origen: primer recuadro arriba izquierda.
    2600.  00:5386                      		; x=0, y=0. La page ya la hemos puesto en iy+3.
    2601.  00:5386                      
    2602.  00:5386  AF                  		xor		a
    2603.  00:5387  FD 77 00            		ld		(iy),a								; origen x low
    2604.  00:538A  FD 77 01            		ld		(iy+1),a							; origen x high
    2605.  00:538D  FD 77 02            		ld		(iy+2),a							; origen y low
    2606.  00:5390                      
    2607.  00:5390                      
    2608.  00:5390                      		; Destino X: posición actual de Agonix en page 2.
    2609.  00:5390                      
    2610.  00:5390  3A 6A C6            		ld		a,(AGONIX_BOSS_1_X)
    2611.  00:5393  FD 77 04            		ld		(iy+4),a							; destino x low
    2612.  00:5396  AF                  		xor		a
    2613.  00:5397  FD 77 05            		ld		(iy+5),a							; destino x high
    2614.  00:539A                      
    2615.  00:539A                      
    2616.  00:539A                      		; Recuperamos el contador externo del bucle.
    2617.  00:539A                      		; B = altura actual que vamos a copiar.
    2618.  00:539A                      		; Primera vuelta: B = 48.
    2619.  00:539A                      		; Última vuelta: B = 1.
    2620.  00:539A                      		; Cuando B llega a 0, el djnz de fuera termina la animación.
    2621.  00:539A                      
    2622.  00:539A  C1                  		pop		bc
    2623.  00:539B  C5                  		push	bc
    2624.  00:539C                      
    2625.  00:539C                      		; offset = altura inicial - altura actual.
    2626.  00:539C                      		; Este offset baja el destino.
    2627.  00:539C                      
    2628.  00:539C  3E 30               		ld		a,AGONIX_MUERTE_ALTO_BOSS_1
    2629.  00:539E  90                  		sub		b
    2630.  00:539F  4F                  		ld		c,a									; C = offset vertical
    2631.  00:53A0                      
    2632.  00:53A0                      
    2633.  00:53A0                      		; Destino Y = y actual de Agonix + offset.
    2634.  00:53A0                      		; Page destino sigue siendo page 2.
    2635.  00:53A0                      
    2636.  00:53A0  3E 42               		ld		a,AGONIX_MOVIMIENTO_Y_BOSS_1
    2637.  00:53A2  81                  		add		c
    2638.  00:53A3  FD 77 06            		ld		(iy+6),a							; destino y low
    2639.  00:53A6                      
    2640.  00:53A6  3E 02               		ld		a,PAGE_2_VRAM_Y_BOSS_1 / 256
    2641.  00:53A8  FD 77 07            		ld		(iy+7),a							; destino page 2
    2642.  00:53AB                      
    2643.  00:53AB                      
    2644.  00:53AB                      		; Tamaño destino/fuente:
    2645.  00:53AB                      		; ancho fijo, altura decreciendo.
    2646.  00:53AB                      
    2647.  00:53AB  78                  		ld		a,b
    2648.  00:53AC  FD 77 0A            		ld		(iy+10),a							; alto low = B
    2649.  00:53AF  AF                  		xor		a
    2650.  00:53B0  FD 77 0B            		ld		(iy+11),a							; alto high = 0
