     538.  00:42BB                      ; -----------------------------------------------------------------------------
     539.  00:42BB                      ; Carga de patrones y colores del barro.
     540.  00:42BB                      ; OJO: debe ir DESPUES de RUTINA_BOSS_4 para que la entrada del banco
     541.  00:42BB                      ; siga empezando en RUTINA_BOSS_4. Si se coloca antes, el boss puede entrar
     542.  00:42BB                      ; por esta rutina y colgarse antes de iniciar el flujo normal.
     543.  00:42BB                      ; -----------------------------------------------------------------------------
     544.  00:42BB                      CARGA_SPRITES_BARRO_BOSS_4:
     545.  00:42BB                      		
     546.  00:42BB  CD B0 6D            		call	PAGE_32_A_SEGMENT_2
     547.  00:42BE                      
     548.  00:42BE                      		; Los dos patrones anteriores al barro quedan reservados para la
     549.  00:42BE                      		; explosion de impacto: 92 y 96. NO se cargan aqui: ya estan
     550.  00:42BE                      		; en VRAM en el sitio adecuado.
     551.  00:42BE                      		; Barro empieza en 100: 100,104,108,112.
     552.  00:42BE  21 60 97            		ld		hl,SPRITE_BARRO
     553.  00:42C1  11 20 43            		ld		de,PATRONES_SPRITES_VRAM_BOSS_4+BARRO_PATRON_INICIAL_BOSS_4*8
     554.  00:42C4  01 80 00            		ld		bc,8*4*BARRO_CANTIDAD_BOSS_4
     555.  00:42C7  CD A2 5F            		call	PON_COLOR_2.sin_bc_impuesta
     556.  00:42CA                      
     557.  00:42CA                      		; Los COVIDs se cargan despues de los cuatro patrones de barro:
     558.  00:42CA                      		; COVID queda en 116 y 120.
     559.  00:42CA  21 00 92            		ld		hl,SPRITES_COVID
     560.  00:42CD  11 A0 43            		ld		de,PATRONES_SPRITES_VRAM_BOSS_4+COVID_PATRON_INICIAL_BOSS_4*8
     561.  00:42D0  01 40 00            		ld		bc,8*4*COVID_PATRON_CANT_BOSS_4
     562.  00:42D3  CD A2 5F            		call	PON_COLOR_2.sin_bc_impuesta
     563.  00:42D6                      
