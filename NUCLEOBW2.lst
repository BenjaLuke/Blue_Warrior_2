    2414.  00:4EE5  (00:00C3)           ROTATIVO_Y_PRESENTACION                  equ     195
    2415.  00:4EE5                      
    2416.  00:4EE5                      ; Cada cuántos frames se actualiza el rotativo.
    2417.  00:4EE5                      ; 1 = cada frame, 2 = cada dos frames, etc.
    2418.  00:4EE5  (00:0003)           ROTATIVO_VELOCIDAD_PRESENTACION          equ     3
    2419.  00:4EE5                      
    2420.  00:4EE5                      ; El nuevo rotativo avanza copiando la franja 2 píxeles a la izquierda.
    2421.  00:4EE5                      ; Cada letra mide 6 píxeles, así que se introduce en 3 pasos:
    2422.  00:4EE5                      ;   paso 0 -> X=254
    2423.  00:4EE5                      ;   paso 1 -> X=252
    2424.  00:4EE5                      ;   paso 2 -> X=250
    2425.  00:4EE5  (00:0002)           ROTATIVO_PIXELES_POR_PASO_PRESENTACION   equ     2
    2426.  00:4EE5  (00:0003)           ROTATIVO_PASOS_POR_LETRA_PRESENTACION    equ     3
    2427.  00:4EE5  (00:00FE)           ROTATIVO_X_ENTRADA_PRESENTACION          equ     254
    2428.  00:4EE5  (00:00FE)           ROTATIVO_ANCHO_SCROLL_PRESENTACION       equ     254
    2429.  00:4EE5  (00:0008)           ROTATIVO_ALTO_PRESENTACION               equ     8
    2430.  00:4EE5                      
    2431.  00:4EE5                      ; Cuando se acaba el texto, metemos espacios hasta que toda la cola sale
    2432.  00:4EE5                      ; por la izquierda. 43 espacios * 6 píxeles = 258 píxeles.
    2433.  00:4EE5  (00:002B)           ROTATIVO_ESPACIOS_SALIDA_PRESENTACION    equ     43
    2434.  00:4EE5                      
    2435.  00:4EE5                      
    2436.  00:4EE5                      INICIALIZA_ROTATIVO_PRESENTACION:
    2437.  00:4EE5                      
    2438.  00:4EE5  AF                          xor     a
    2439.  00:4EE6  32 33 C6                    ld      (ROTATIVO_CONTADOR_PRESENTACION),a
    2440.  00:4EE9  32 34 C6                    ld      (ROTATIVO_PAGINA_VISIBLE_PRESENTACION),a
    2441.  00:4EEC  32 37 C6                    ld      (ROTATIVO_REPETICION_LETRA_PRESENTACION),a
    2442.  00:4EEF  32 38 C6                    ld      (ROTATIVO_MODO_SALIDA_PRESENTACION),a
    2443.  00:4EF2                      
    2444.  00:4EF2  3E 2B                       ld      a,ROTATIVO_ESPACIOS_SALIDA_PRESENTACION
    2445.  00:4EF4  32 39 C6                    ld      (ROTATIVO_PASOS_SALIDA_PRESENTACION),a
    2446.  00:4EF7                      
    2447.  00:4EF7  21 BE 50                    ld      hl,TEXTO_ROTATIVO_PRESENTACION
    2448.  00:4EFA  22 35 C6                    ld      (ROTATIVO_PUNTERO_TEXTO_PRESENTACION),hl
    2449.  00:4EFD                      
    2450.  00:4EFD                              ; Dejamos limpia la franja en las dos páginas. Así el primer paso
    2451.  00:4EFD                              ; parte de una zona negra y la página oculta no hereda basura.
    2452.  00:4EFD                      
    2453.  00:4EFD  21 A0 50                    ld      hl,DATOS_NEGRO_ROTATIVO_EN_PAGE_0
    2454.  00:4F00  CD 2A 5E                    call    DOCOPY
    2455.  00:4F03  CD 33 5E                    call    VDPREADY
