       1.  00:7FD1                      ; ------------------------------------------------------------
       2.  00:7FD1                      ; INICIA_MUSICA_COMUN
       3.  00:7FD1                      ;
       4.  00:7FD1                      ; Entrada:
       5.  00:7FD1                      ;   A  = banco donde está la música
       6.  00:7FD1                      ;   HL = dirección de la música
       7.  00:7FD1                      ;
       8.  00:7FD1                      ; Ejemplo:
       9.  00:7FD1                      ;   ld  a,39
      10.  00:7FD1                      ;   ld  hl,M_PUENTE
      11.  00:7FD1                      ;   call INICIA_MUSICA_COMUN
      12.  00:7FD1                      ;
      13.  00:7FD1                      ; IMPORTANTE:
      14.  00:7FD1                      ;   Esta rutina NO debe estar en el segmento que cambia
      15.  00:7FD1                      ;   CHANGE_BANK_2, porque si cambia el banco donde está
      16.  00:7FD1                      ;   ejecutándose, el MSX se pega el castañazo padre.
      17.  00:7FD1                      ; ------------------------------------------------------------
      18.  00:7FD1                      
      19.  00:7FD1  F5                  		push	af
      20.  00:7FD2  E5                  		push	hl
