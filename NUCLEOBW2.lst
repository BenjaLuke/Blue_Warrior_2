    2342.  00:4E5D                      
    2343.  00:4E5D                              ; Para HMMV el origen no importa.
    2344.  00:4E5D                      
    2345.  00:4E5D  DD 36 00 00                 ld      (ix+0),0
    2346.  00:4E61  DD 36 01 00                 ld      (ix+1),0
    2347.  00:4E65  DD 36 02 00                 ld      (ix+2),0
    2348.  00:4E69  DD 36 03 00                 ld      (ix+3),0
