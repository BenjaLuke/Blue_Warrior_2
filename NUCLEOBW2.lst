     220   00:6F73                      		include "AUDIOS/LANZADOR EFECTOS PSG (sin etiquetas).asm"
       1.  00:6F73                      ; ROMAN: PAR
       2.  00:6F73                      													; --- ayFX REPLAYER v2.0M ---
       3.  00:6F73                      
       4.  00:6F73                      													; --- v2.0T  New ayFX replayer routine. T -> Triple FX replayer
       5.  00:6F73                      
       6.  00:6F73                      ;ayFX_SETUP:											; ---          ayFX replayer setup          ---
       7.  00:6F73                      													; --- INPUT: HL -> pointer to the ayFX bank ---
       8.  00:6F73  22 C9 C2            		ld	[ayFX_BANK],hl							; Current ayFX bank
       9.  00:6F76                      ;ayFX_STOP:	
      10.  00:6F76                      		
      11.  00:6F76  3E FF               		ld	a,255									; Lowest ayFX priority
      12.  00:6F78  32 CB C2            		ld	[ayFX_C1],a								; First channel minimum priority
      13.  00:6F7B  32 CE C2            		ld	[ayFX_C2],a								; First channel minimum priority
      14.  00:6F7E  32 D1 C2            		ld	[ayFX_C3],a								; First channel minimum priority
      15.  00:6F81  C9                  		ret											; Return
      16.  00:6F82                      ;ayFX_END:											; --- End of an ayFX stream ---
      17.  00:6F82                      
      18.  00:6F82  DD 36 00 FF         		ld	[IX],255								; Priority saved (not playing ayFX stream)
      19.  00:6F86  C9                  		ret											; Return
      20.  00:6F87                      
      21.  00:6F87                      ;ayFX_INIT:											; ---     INIT A NEW ayFX STREAM     ---
      22.  00:6F87                      													; --- INPUT: A -> sound to be played ---
      23.  00:6F87                      													; ---        C -> sound priority     ---
      24.  00:6F87                      													; --- Checks the priorities of playing ayFX streams to place ---
      25.  00:6F87                      													; --- the new one on the channel with lowest priority        ---
      26.  00:6F87  C5                  		push	bc									; Store bc in stack
      27.  00:6F88  D5                  		push	de									; Store de in stack
      28.  00:6F89  E5                  		push	hl									; Store hl in stack
      29.  00:6F8A  DD E5               		push	IX									; Store IX in stack
      30.  00:6F8C                      													; --- Check if the index is in the bank ---
      31.  00:6F8C  47                  		ld	b,a										; b:=a (new ayFX stream index)
      32.  00:6F8D  2A C9 C2            		ld	hl,[ayFX_BANK]							; Current ayFX BANK
      33.  00:6F90  7E                  		ld	a,[hl]									; Number of samples in the bank
      34.  00:6F91  B7                  		or	a										; If zero (means 256 samples)...
      35.  00:6F92  CA 9C 6F            		jp	z,ayFX_INIT.CHECK_PRI							; ...goto .CHECK_PRI
      36.  00:6F95                      													; The bank has less than 256 samples
      37.  00:6F95  78                  		ld	a,b										; a:=b (new ayFX stream index)
      38.  00:6F96  BE                  		cp	[hl]									; If new index is not in the bank...
      39.  00:6F97  3E 02               		ld	a,2										; a:=2 (error 2: Sample not in the bank)
      40.  00:6F99  D2 FB 6F            		jp	nc,ayFX_INIT.INIT_END							; ...we can't init it
      41.  00:6F9C                      
      42.  00:6F9C                      ;.CHECK_PRI:											; --- Places the data on the correct channel                  ---
      43.  00:6F9C                      													; ---   Remember: 0 = highest priority, 15 = lowest priority  ---
      44.  00:6F9C                      													; --- Checks channel 1 ---
      45.  00:6F9C  3A CB C2            		ld	a,[ayFX_C1]								; Priority of ayFX Stream being played on channel 1
      46.  00:6F9F  FE FF               		cp	255										; If there's no Stream being played...
      47.  00:6FA1  28 39               		jr	z,ayFX_INIT.TOC1									; ...place the new Stream on channel 1
      48.  00:6FA3  5F                  		ld	e,a										; Minimum priority of Streams being played
      49.  00:6FA4  16 01               		ld	d,1										; On channel 1
      50.  00:6FA6                      													; --- Checks channel 2 ---
      51.  00:6FA6  3A CE C2            		ld	a,[ayFX_C2]								; Priority of ayFX Stream being played on channel 2
      52.  00:6FA9  FE FF               		cp	255										; If there's no Stream being played...
      53.  00:6FAB  28 29               		jr	z,ayFX_INIT.TOC2									; ...place the new Stream on channel 2
      54.  00:6FAD  BB                  		cp	e										; Compare priority with minimum one
      55.  00:6FAE  30 03               		jr	nc,ayFX_INIT.CHECKC3								; If P(C2) > min, go to .CHECKC3
      56.  00:6FB0  5F                  		ld	e,a										; Minimum priority of Streams being played
      57.  00:6FB1  16 02               		ld	d,2										; On channel 2
      58.  00:6FB3                      
      59.  00:6FB3                      ;.CHECKC3:											; --- Checks channel 3 ---
      60.  00:6FB3                      
      61.  00:6FB3  3A D1 C2            		ld	a,[ayFX_C3]								; Priority of ayFX Stream being played on channel 3
      62.  00:6FB6  FE FF               		cp	255										; If there's no stream being played
      63.  00:6FB8  28 16               		jr	z,ayFX_INIT.TOC3									; ...place the new Stream on channel 3
      64.  00:6FBA  BB                  		cp	e										; Compare priority with minimum one
      65.  00:6FBB  30 03               		jr	nc,ayFX_INIT.CHECKMIN							; If P(C3) > min, go to .CHECKMIN
      66.  00:6FBD  5F                  		ld	e,a										; Minimum priority of Streams being played
      67.  00:6FBE  16 03               		ld	d,3										; On channel 3
      68.  00:6FC0                      
      69.  00:6FC0                      ;.CHECKMIN:											; --- Checks if minimum priority is lower than priority of the new Stream ---
      70.  00:6FC0                      
      71.  00:6FC0  79                  		ld	a,c										; Priority of the new Stream
      72.  00:6FC1  BB                  		cp	e										; Minimum priority of Streams being played
      73.  00:6FC2  3E 01               		ld	a,1										; a:=1 (error 1: A sample with higher priority is being played)
      74.  00:6FC4  D2 FB 6F            		jp	nc,ayFX_INIT.INIT_END							; ...we can't play the new ayFX Stream
      75.  00:6FC7                      													; --- The new stream substitues the minimum priority Stream being played ---
      76.  00:6FC7  7A                  		ld	a,d										; Channel of minimum priority
      77.  00:6FC8  FE 01               		cp	1										; If it's 1...
      78.  00:6FCA  28 10               		jr	z,ayFX_INIT.TOC1									; ...send Stream to channel 1
      79.  00:6FCC  FE 02               		cp	2										; If it's 2...
      80.  00:6FCE  28 06               		jr	z,ayFX_INIT.TOC2									; ...send Stream to channel 2
      81.  00:6FD0                      
      82.  00:6FD0                      ;.TOC3:												; --- Stream will be played on channel 3
      83.  00:6FD0                      
      84.  00:6FD0  DD 21 D1 C2         		ld	IX,ayFX_C3								; Pointer to the chanel data
      85.  00:6FD4  18 0A               		jr	ayFX_INIT.SETDATA								; Go to .SETDATA
      86.  00:6FD6                      
      87.  00:6FD6                      ;.TOC2:												; --- Stream will be played on channel 2
      88.  00:6FD6                      
      89.  00:6FD6  DD 21 CE C2         		ld	IX,ayFX_C2								; Pointer to the channel data
      90.  00:6FDA  18 04               		jr	ayFX_INIT.SETDATA								; Go to .SETDATA
      91.  00:6FDC                      
      92.  00:6FDC                      ;.TOC1:												; --- Stream will be played on channel 1
      93.  00:6FDC                      		
      94.  00:6FDC  DD 21 CB C2         		ld	IX,ayFX_C1								; Pointer to the chanel data
      95.  00:6FE0                      
      96.  00:6FE0                      ;.SETDATA:											; --- Set data on the correct channel ---
      97.  00:6FE0                      											
      98.  00:6FE0  79                  		ld	a,c										; a:=New priority
      99.  00:6FE1  E6 0F               		and	$0F										; We mask the priority
     100.  00:6FE3  DD 77 00            		ld	[IX],a									; new ayFX stream priority saved in RAM
     101.  00:6FE6                      													; --- Calculate the pointer to the new ayFX stream ---
     102.  00:6FE6  ED 5B C9 C2         		ld	de,[ayFX_BANK]							; de:=Current ayFX bank
     103.  00:6FEA  13                  		inc	de										; de points to the increments table of the bank
     104.  00:6FEB  68                  		ld	l,b										; l:=b (new ayFX stream index)
     105.  00:6FEC  26 00               		ld	h,0										; hl:=b (new ayFX stream index)
     106.  00:6FEE  29                  		add	hl,hl									; hl:=hl*2
     107.  00:6FEF  19                  		add	hl,de									; hl:=hl+de (hl points to the correct increment)
     108.  00:6FF0  5E                  		ld	e,[hl]									; e:=lower byte of the increment
     109.  00:6FF1  23                  		inc	hl										; hl points to the higher byte of the correct increment
     110.  00:6FF2  56                  		ld	d,[hl]									; de:=increment
     111.  00:6FF3  19                  		add	hl,de									; hl:=hl+de (hl points to the new ayFX stream)
     112.  00:6FF4  DD 75 01            		ld	[IX+1],l								; Pointer lower byte saved in RAM
     113.  00:6FF7  DD 74 02            		ld	[IX+2],h								; Pointer higher byte saved in RAM
     114.  00:6FFA  AF                  		xor	a										; a:=0 (no errors)
     115.  00:6FFB                      
     116.  00:6FFB                      ;.INIT_END:	
     117.  00:6FFB                      
     118.  00:6FFB  DD E1               		pop	IX										; Retrieve IX from stack
     119.  00:6FFD  E1                  		pop	hl										; Retrieve hl from stack
     120.  00:6FFE  D1                  		pop	de										; Retrieve de from stack
     121.  00:6FFF  C1                  		pop	bc										; Retrieve bc from stack
     122.  00:7000  C9                  		ret											; Return
     123.  00:7001                      
     124.  00:7001                      ;ayFX_PLAY:											; --- Plays next frame of each ayFX Stream ---
     125.  00:7001                      			
     126.  00:7001  21 00 00            		ld	hl,0									; hl:=0
     127.  00:7004  22 E0 C2            		ld	[ayFX_REGS+7],hl						; Clears mixer and volume of channel A
     128.  00:7007  22 E2 C2            		ld	[ayFX_REGS+9],hl						; Clears volume of channels B and C
     129.  00:700A  DD 21 CB C2         		ld	IX,ayFX_C1								; Channel 1
     130.  00:700E  3E 01               		ld	a,1										; a:=1
     131.  00:7010  CD 22 70            		call	ayFX_PLAY.ayFX_PlayChannel					; Play Channel 1
     132.  00:7013  DD 21 CE C2         		ld	IX,ayFX_C2								; Channel 2
     133.  00:7017  3E 02               		ld	a,2										; a:=2
     134.  00:7019  CD 22 70            		call	ayFX_PLAY.ayFX_PlayChannel					; Play Channel 2
     135.  00:701C  DD 21 D1 C2         		ld	IX,ayFX_C3								; Channel 3
     136.  00:7020  3E 03               		ld	a,3										; a:=3
     137.  00:7022                      ;.ayFX_PlayChannel:									; --- Plays a channel stream ---
     138.  00:7022  32 D8 C2            		ld	[ayFX_CHANNEL],a						; Sets current channel
     139.  00:7025  DD 7E 00            		ld	a,[IX]									; a:=Current ayFX stream priority
     140.  00:7028  B7                  		or	a										; If priority has bit 7 on...
     141.  00:7029  F8                  		ret	m										; ...return
     142.  00:702A                      													; --- Extract control byte from stream ---
     143.  00:702A  DD 6E 01            		ld	l,[IX+1]								; Pointer to the current ayFX stream (lower byte)
     144.  00:702D  DD 66 02            		ld	h,[IX+2]								; Pointer to the current ayFX stream (higher byte)
     145.  00:7030  4E                  		ld	c,[hl]									; c:=Control byte
     146.  00:7031  23                  		inc	hl										; Increment pointer
     147.  00:7032                      													; --- Check if there's new tone on stream ---
     148.  00:7032  CB 69               		bit	5,c										; If bit 5 c is off...
     149.  00:7034  CA 3F 70            		jp	z,ayFX_PLAY.CHECK_NN								; ...jump to .CHECK_NN (no new tone)
     150.  00:7037                      													; --- Extract new tone from stream ---
     151.  00:7037  5E                  		ld	e,[hl]									; e:=lower byte of new tone
     152.  00:7038  23                  		inc	hl										; Increment pointer
     153.  00:7039  56                  		ld	d,[hl]									; d:=higher byte of new tone
     154.  00:703A  23                  		inc	hl										; Increment pointer
     155.  00:703B  ED 53 D4 C2         		ld	[ayFX_TONE],de							; ayFX tone updated
     156.  00:703F                      
     157.  00:703F                      ;.CHECK_NN:											; --- Check if there's new noise on stream ---
     158.  00:703F                      
     159.  00:703F  CB 71               		bit	6,c										; if bit 6 c is off...
     160.  00:7041  CA 4E 70            		jp	z,ayFX_PLAY.SETPOINTER							; ...jump to .SETPOINTER (no new noise)
     161.  00:7044                      													; --- Extract new noise from stream ---
     162.  00:7044  7E                  		ld	a,[hl]									; a:=New noise
     163.  00:7045  23                  		inc	hl										; Increment pointer
     164.  00:7046  FE 20               		cp	$20										; If it's an illegal value of noise (used to mark end of stream)...
     165.  00:7048  CA 82 6F            		jp	z,ayFX_END								; ...jump to ayFX_END
     166.  00:704B  32 D6 C2            		ld	[ayFX_NOISE],a							; ayFX noise updated
     167.  00:704E                      
     168.  00:704E                      ;.SETPOINTER:										; --- Update ayFX pointer ---
     169.  00:704E                      
     170.  00:704E  DD 75 01            		ld	[IX+1],l								; Pointer lower byte saved in RAM
     171.  00:7051  DD 74 02            		ld	[IX+2],h								; Pointer higher byte saved in RAM
     172.  00:7054                      													; --- Extract volume ---
     173.  00:7054  79                  		ld	a,c										; a:=Control byte
     174.  00:7055  E6 0F               		and	$0F										; lower nibble
     175.  00:7057  32 D7 C2            		ld	[ayFX_VOLUME],a							; ayFX volume updated
     176.  00:705A  C8                  		ret	z										; Return if volume is zero (don't copy ayFX values in to ayFX_REGS)
     177.  00:705B                      													; -------------------------------------
     178.  00:705B                      													; --- COPY ayFX VALUES IN TO ayFX_REGS ---
     179.  00:705B                      													; -------------------------------------
     180.  00:705B                      													; --- Set noise channel ---
     181.  00:705B  CB 79               		bit	7,c										; If noise is off...
     182.  00:705D  C2 66 70            		jp	nz,ayFX_PLAY.SETMASKS							; ...jump to .SETMASKS
     183.  00:7060  3A D6 C2            		ld	a,[ayFX_NOISE]							; ayFX noise value
     184.  00:7063  32 DF C2            		ld	[ayFX_REGS+6],a							; copied in to ayFX_REGS (noise channel)
     185.  00:7066                      
     186.  00:7066                      ;.SETMASKS:											; --- Set mixer masks ---
     187.  00:7066                      
     188.  00:7066  79                  		ld	a,c										; a:=Control byte
     189.  00:7067  E6 90               		and	$90										; Only bits 7 and 4 (noise and tone mask for psg reg 7)
     190.  00:7069  FE 90               		cp	$90										; If no noise and no tone...
     191.  00:706B  C8                  		ret	z										; ...return (don't copy ayFX values in to ayFX_REGS)
     192.  00:706C                      													; --- Copy ayFX values in to ayFX_REGS ---
     193.  00:706C  CB 0F               		rrc	a										; Rotate a to the right (1 TIME)
     194.  00:706E  CB 0F               		rrc	a										; Rotate a to the right (2 TIMES) (OR mask)
     195.  00:7070  16 DB               		ld	d,$DB									; d:=Mask for psg mixer (AND mask)
     196.  00:7072  21 D8 C2            		ld	hl,ayFX_CHANNEL							; ayFX playing channel
     197.  00:7075  46                  		ld	b,[hl]									; Channel counter
     198.  00:7076                      
     199.  00:7076                      ;.CHK1:												; --- Check if playing channel was 1 ---
     200.  00:7076                      
     201.  00:7076  10 10               		djnz	ayFX_PLAY.CHK2								; Decrement and jump if channel was not 1
     202.  00:7078                      
     203.  00:7078                      ;.PLAY_C:											; --- Play ayFX stream on channel C ---
     204.  00:7078                      
     205.  00:7078  CD B2 70            		call	ayFX_PLAY.SETMIXER							; Set PSG mixer value (a:=ayFX volume)
     206.  00:707B  32 E3 C2            		ld	[ayFX_REGS+10],a						; Volume copied in to ayFX_REGS (channel C volume)
     207.  00:707E  CB 51               		bit	2,c										; If tone is off...
     208.  00:7080  C0                  		ret	nz										; ...return
     209.  00:7081  2A D4 C2            		ld	hl,[ayFX_TONE]							; ayFX tone value
     210.  00:7084  22 DD C2            		ld	[ayFX_REGS+4],hl						; copied in to ayFX_REGS (channel C tone)
     211.  00:7087  C9                  		ret											; Return
     212.  00:7088                      
     213.  00:7088                      ;.CHK2:												; --- Check if playing channel was 2 ---
     214.  00:7088                      
     215.  00:7088  CB 0A               		rrc	d										; Rotate right AND mask
     216.  00:708A  CB 0F               		rrc	a										; Rotate right OR mask
     217.  00:708C  10 10               		djnz	ayFX_PLAY.CHK3								; Decrement and jump if channel was not 2
     218.  00:708E                      
     219.  00:708E                      ;.PLAY_B:											; --- Play ayFX stream on channel B ---
     220.  00:708E                      
     221.  00:708E  CD B2 70            		call	ayFX_PLAY.SETMIXER							; Set PSG mixer value (a:=ayFX volume)
     222.  00:7091  32 E2 C2            		ld	[ayFX_REGS+9],a							; Volume copied in to ayFX_REGS (channel B volume)
     223.  00:7094  CB 49               		bit	1,c										; If tone is off...
     224.  00:7096  C0                  		ret	nz										; ...return
     225.  00:7097  2A D4 C2            		ld	hl,[ayFX_TONE]							; ayFX tone value
     226.  00:709A  22 DB C2            		ld	[ayFX_REGS+2],hl						; copied in to ayFX_REGS (channel B tone)
     227.  00:709D  C9                  		ret											; Return
     228.  00:709E                      
     229.  00:709E                      ;.CHK3:												; --- Check if playing channel was 3 ---
     230.  00:709E                      
     231.  00:709E  CB 0A               		rrc	d										; Rotate right AND mask
     232.  00:70A0  CB 0F               		rrc	a										; Rotate right OR mask
     233.  00:70A2                      
     234.  00:70A2                      ;.PLAY_A:											; --- Play ayFX stream on channel A ---
     235.  00:70A2                      
     236.  00:70A2  CD B2 70            		call	ayFX_PLAY.SETMIXER							; Set PSG mixer value (a:=ayFX volume)
     237.  00:70A5  32 E1 C2            		ld	[ayFX_REGS+8],a							; Volume copied in to ayFX_REGS (channel A volume)
     238.  00:70A8  CB 41               		bit	0,c										; If tone is off...
     239.  00:70AA  C0                  		ret	nz										; ...return
     240.  00:70AB  2A D4 C2            		ld	hl,[ayFX_TONE]							; ayFX tone value
     241.  00:70AE  22 D9 C2            		ld	[ayFX_REGS+0],hl						; copied in to ayFX_REGS (channel A tone)
     242.  00:70B1  C9                  		ret											; Return
     243.  00:70B2                      
     244.  00:70B2                      ;.SETMIXER:											; --- Set PSG mixer value ---
     245.  00:70B2                      
     246.  00:70B2  4F                  		ld	c,a										; c:=OR mask
     247.  00:70B3  3A E0 C2            		ld	a,[ayFX_REGS+7]							; a:=PSG mixer value
     248.  00:70B6  A2                  		and	d										; AND mask
     249.  00:70B7  B1                  		or	c										; OR mask
     250.  00:70B8  32 E0 C2            		ld	[ayFX_REGS+7],a							; PSG mixer value updated
     251.  00:70BB  3A D7 C2            		ld	a,[ayFX_VOLUME]							; a:=ayFX volume value
     252.  00:70BE  C9                  		ret											; Return
     253.  00:70BF                      
     254.  00:70BF                      ;AYfx_ROUT:	
     255.  00:70BF                      
     256.  00:70BF  AF                  		XOR A
     257.  00:70C0                      	
