    2545.  00:531A                      		; Animación de muerte:
    2546.  00:531A                      		; copiamos siempre desde el primer recuadro de la page fuente
    2547.  00:531A                      		; hacia page 2, recortando altura y bajando destino.
    2548.  00:531A                      		;
    2549.  00:531A                      		; derecha  -> page 3
    2550.  00:531A                      		; izquierda -> page 1
    2551.  00:531A                      
    2552.  00:531A  DD 21 7E 56         		ld		ix,BOSS_1_COPY_MOVIMIENTO_AGONIX
    2553.  00:531E  FD 21 AA C2         		ld		iy,DATAS_COPY_RECUP_SCROLL
