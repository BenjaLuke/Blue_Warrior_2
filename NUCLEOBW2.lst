    2234.  00:4FEE  (00:00C3)           ROTATIVO_Y_PRESENTACION                  equ     195
    2235.  00:4FEE                      
    2236.  00:4FEE                      ; Cada cuántos frames se actualiza el rotativo.
    2237.  00:4FEE                      ; 1 = cada frame, 2 = cada dos frames, etc.
    2238.  00:4FEE  (00:0003)           ROTATIVO_VELOCIDAD_PRESENTACION          equ     3
    2239.  00:4FEE                      
    2240.  00:4FEE                      ; El nuevo rotativo avanza copiando la franja 2 píxeles a la izquierda.
    2241.  00:4FEE                      ; Cada letra mide 6 píxeles, así que se introduce en 3 pasos:
    2242.  00:4FEE                      ;   paso 0 -> X=254
    2243.  00:4FEE                      ;   paso 1 -> X=252
    2244.  00:4FEE                      ;   paso 2 -> X=250
    2245.  00:4FEE  (00:0002)           ROTATIVO_PIXELES_POR_PASO_PRESENTACION   equ     2
    2246.  00:4FEE  (00:0003)           ROTATIVO_PASOS_POR_LETRA_PRESENTACION    equ     3
    2247.  00:4FEE  (00:00FE)           ROTATIVO_X_ENTRADA_PRESENTACION          equ     254
    2248.  00:4FEE  (00:00FE)           ROTATIVO_ANCHO_SCROLL_PRESENTACION       equ     254
    2249.  00:4FEE  (00:0008)           ROTATIVO_ALTO_PRESENTACION               equ     8
    2250.  00:4FEE                      
    2251.  00:4FEE                      ; Cuando se acaba el texto, metemos espacios hasta que toda la cola sale
    2252.  00:4FEE                      ; por la izquierda. 43 espacios * 6 píxeles = 258 píxeles.
    2253.  00:4FEE  (00:002B)           ROTATIVO_ESPACIOS_SALIDA_PRESENTACION    equ     43
    2254.  00:4FEE                      
    2255.  00:4FEE                      
