      48.  00:4548  20 06               			jr		nz,EXPANSION_1
      49.  00:454A  79                  			ld		a,c
      50.  00:454B  CD 71 45            			call	COTEJA_CARACTERES_FM
      51.  00:454E  18 03               			jr		SIGUIENTE_SLOT_3
      52.  00:4550                      EXPANSION_1:
