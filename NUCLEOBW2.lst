     473.  00:4271                      ; -----------------------------------------------------------------------------
     474.  00:4271                      ; Carga de patrones y colores del barro.
     475.  00:4271                      ; OJO: debe ir DESPUES de RUTINA_BOSS_5 para que la entrada del banco
     476.  00:4271                      ; siga empezando en RUTINA_BOSS_5. Si se coloca antes, el boss puede entrar
     477.  00:4271                      ; por esta rutina y colgarse antes de iniciar el flujo normal.
     478.  00:4271                      ; -----------------------------------------------------------------------------
     479.  00:4271                      CARGA_SPRITES_BARRO_BOSS_5:
     480.  00:4271                      		
