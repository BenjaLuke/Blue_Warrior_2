    2543.  00:5310                      		; Animación de muerte:
    2544.  00:5310                      		; copiamos siempre desde el primer recuadro de la page fuente
    2545.  00:5310                      		; hacia page 2, recortando altura y bajando destino.
    2546.  00:5310                      		;
    2547.  00:5310                      		; derecha  -> page 3
    2548.  00:5310                      		; izquierda -> page 1
    2549.  00:5310                      
    2550.  00:5310  DD 21 77 56         		ld		ix,BOSS_1_COPY_MOVIMIENTO_AGONIX
