    2363.  00:50F9                      PINTA_LETRA_MENU_ROTATIVO_PARCIAL_EN_DESTINO:
    2364.  00:50F9                      
    2365.  00:50F9                              ; Entrada:
    2366.  00:50F9                              ;   A  = caracter a pintar
    2367.  00:50F9                              ;   HL = X destino: 254, 252 o 250
    2368.  00:50F9                              ;   DE = Y destino con page incluida
    2369.  00:50F9                              ;
    2370.  00:50F9                              ; Copiamos solo la parte visible de la letra:
    2371.  00:50F9                              ;   repeticion 0 -> ancho 2
    2372.  00:50F9                              ;   repeticion 1 -> ancho 4
    2373.  00:50F9                              ;   repeticion 2 -> ancho 6
    2374.  00:50F9                              ;
    2375.  00:50F9                              ; Así respetamos la entrada progresiva sin escribir fuera de X=255.
    2376.  00:50F9                      
