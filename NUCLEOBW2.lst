    1670.  00:4EB3  4F                          ld      c,a
    1671.  00:4EB4                      
    1672.  00:4EB4  3A 64 C0                    ld      a,(X_DEPH)
    1673.  00:4EB7  57                          ld      d,a
    1674.  00:4EB8                      
    1675.  00:4EB8  79                          ld      a,c
