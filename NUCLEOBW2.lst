    2951.  00:6F20  32 1B C1            		ld		(INMUNE),a
    2952.  00:6F23  3E 1E               		ld		a,30
    2953.  00:6F25  32 0A C1            		ld		(TIEMPO_DE_ADJUST),a
    2954.  00:6F28  C9                  		ret
