      38.  00:453D                      BUSCANDO_LA_CADENA_OPLL:	
      39.  00:453D                      	
      40.  00:453D  01 00 04            			ld		bc,00400h 												; Bucle DJNZ. Metemos 4 en B para mirar los 4 slots
      41.  00:4540  21 C1 FC            			ld		hl,0fcc1h 												; En RAM ->EXPTBL 
      42.  00:4543                      
      43.  00:4543                      SIGUIENTE_SLOT:
      44.  00:4543  C5                  			push	bc
      45.  00:4544  E5                  			push	hl
      46.  00:4545  7E                  			ld		a,(hl)
      47.  00:4546  CB 7F               			bit		7,a														; Slot expandido?
      48.  00:4548  20 06               			jr		nz,EXPANSION_1
      49.  00:454A  79                  			ld		a,c
      50.  00:454B  CD 71 45            			call	COTEJA_CARACTERES_FM
      51.  00:454E  18 03               			jr		SIGUIENTE_SLOT_3
      52.  00:4550                      EXPANSION_1:
      53.  00:4550  CD 5E 45            			call	EXPANSION
      54.  00:4553                      
      55.  00:4553                      SIGUIENTE_SLOT_3:
      56.  00:4553                      
      57.  00:4553  79                  			ld		a,c														; Slot
      58.  00:4554  E1                  			pop		hl
      59.  00:4555  C1                  			pop		bc
      60.  00:4556  C8                  			ret		z														; Si es diferente de FFh -> Encontrado!!!
      61.  00:4557  23                  			inc		hl
      62.  00:4558  0C                  			inc		c
      63.  00:4559  10 E8               			djnz	SIGUIENTE_SLOT
      64.  00:455B  3E FF               			ld		a,0FFh													; El FM no ha sido encontrado, por tanto->A=0FFh
      65.  00:455D  C9                  			ret
      66.  00:455E                      
      67.  00:455E                      EXPANSION:
      68.  00:455E                      
      69.  00:455E  E6 80               			and		080h
      70.  00:4560  B1                  			or		c
      71.  00:4561  4F                  			ld		c,a														; Slot más expandido o no
      72.  00:4562  06 04               			ld		b,4
