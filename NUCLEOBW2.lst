    2989.  00:6F02  00 00 00 00 00 00 AF 00 00 01 51 00 
    2990.  00:6F0E  00 00 C0            		db		#00,#00,11000000b
    2991.  00:6F11                      
    2992.  00:6F11                      ;DATOS_LIMPIA_PAGE_3_FIN_BOSS:
