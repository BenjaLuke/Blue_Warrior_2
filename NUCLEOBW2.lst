    2566.  00:5329                      
    2567.  00:5329  FD 77 03            		ld		(iy+3),a							; page origen: 3 o 1
    2568.  00:532C                      
    2569.  00:532C                      
    2570.  00:532C                      		; Origen: primer recuadro arriba izquierda.
    2571.  00:532C                      		; x=0, y=0. La page ya la hemos puesto en iy+3.
    2572.  00:532C                      
    2573.  00:532C  AF                  		xor		a
    2574.  00:532D  FD 77 00            		ld		(iy),a								; origen x low
    2575.  00:5330  FD 77 01            		ld		(iy+1),a							; origen x high
    2576.  00:5333  FD 77 02            		ld		(iy+2),a							; origen y low
    2577.  00:5336                      
    2578.  00:5336                      
    2579.  00:5336                      		; Destino X: posición actual de Agonix en page 2.
    2580.  00:5336                      
    2581.  00:5336  3A 79 C6            		ld		a,(AGONIX_BOSS_1_X)
    2582.  00:5339  FD 77 04            		ld		(iy+4),a							; destino x low
    2583.  00:533C  AF                  		xor		a
    2584.  00:533D  FD 77 05            		ld		(iy+5),a							; destino x high
    2585.  00:5340                      
    2586.  00:5340                      
    2587.  00:5340                      		; Recuperamos el contador externo del bucle.
    2588.  00:5340                      		; B = altura actual que vamos a copiar.
    2589.  00:5340                      		; Primera vuelta: B = 48.
    2590.  00:5340                      		; Última vuelta: B = 1.
    2591.  00:5340                      		; Cuando B llega a 0, el djnz de fuera termina la animación.
    2592.  00:5340                      
    2593.  00:5340  C1                  		pop		bc
    2594.  00:5341  C5                  		push	bc
    2595.  00:5342                      
    2596.  00:5342                      		; offset = altura inicial - altura actual.
    2597.  00:5342                      		; Este offset baja el destino.
    2598.  00:5342                      
    2599.  00:5342  3E 30               		ld		a,AGONIX_MUERTE_ALTO_BOSS_1
    2600.  00:5344  90                  		sub		b
    2601.  00:5345  4F                  		ld		c,a									; C = offset vertical
    2602.  00:5346                      
    2603.  00:5346                      
    2604.  00:5346                      		; Destino Y = y actual de Agonix + offset.
