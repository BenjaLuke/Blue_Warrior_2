     652   00:7F9A                      			include "AUDIOS/INICIA MUSICA_EXTRA.asm"
       1.  00:7F9A                      ; ------------------------------------------------------------
       2.  00:7F9A                      ; INICIA_MUSICA_COMUN
       3.  00:7F9A                      ;
       4.  00:7F9A                      ; Entrada:
       5.  00:7F9A                      ;   A  = banco donde está la música
       6.  00:7F9A                      ;   HL = dirección de la música
       7.  00:7F9A                      ;
       8.  00:7F9A                      ; Ejemplo:
       9.  00:7F9A                      ;   ld  a,39
      10.  00:7F9A                      ;   ld  hl,M_PUENTE
      11.  00:7F9A                      ;   call INICIA_MUSICA_COMUN
      12.  00:7F9A                      ;
      13.  00:7F9A                      ; IMPORTANTE:
      14.  00:7F9A                      ;   Esta rutina NO debe estar en el segmento que cambia
      15.  00:7F9A                      ;   CHANGE_BANK_2, porque si cambia el banco donde está
      16.  00:7F9A                      ;   ejecutándose, el MSX se pega el castañazo padre.
