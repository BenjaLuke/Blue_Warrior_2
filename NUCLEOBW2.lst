     461.  00:425C                      ; -----------------------------------------------------------------------------
     462.  00:425C                      ; Carga de patrones y colores del barro.
     463.  00:425C                      ; OJO: debe ir DESPUES de RUTINA_BOSS_4 para que la entrada del banco
     464.  00:425C                      ; siga empezando en RUTINA_BOSS_4. Si se coloca antes, el boss puede entrar
     465.  00:425C                      ; por esta rutina y colgarse antes de iniciar el flujo normal.
     466.  00:425C                      ; -----------------------------------------------------------------------------
     467.  00:425C                      CARGA_SPRITES_BARRO_BOSS_4:
     468.  00:425C                      		
     469.  00:425C  CD 14 6E            		call	PAGE_32_A_SEGMENT_2
     470.  00:425F                      
     471.  00:425F                      		; Los dos patrones anteriores al barro quedan reservados para la
     472.  00:425F                      		; explosion de impacto: 92 y 96. NO se cargan aqui: ya estan
     473.  00:425F                      		; en VRAM en el sitio adecuado.
     474.  00:425F                      		; Barro empieza en 100: 100,104,108,112.
     475.  00:425F  21 80 9D            		ld		hl,SPRITE_BARRO
     476.  00:4262  11 20 43            		ld		de,PATRONES_SPRITES_VRAM_BOSS_4+BARRO_PATRON_INICIAL_BOSS_4*8
     477.  00:4265  01 80 00            		ld		bc,8*4*BARRO_CANTIDAD_BOSS_4
     478.  00:4268  CD 42 5F            		call	PON_COLOR_2.sin_bc_impuesta
     479.  00:426B                      
     480.  00:426B                      		; Los COVIDs se cargan despues de los cuatro patrones de barro:
     481.  00:426B                      		; COVID queda en 116 y 120.
     482.  00:426B  21 60 97            		ld		hl,SPRITES_COVID
     483.  00:426E  11 A0 43            		ld		de,PATRONES_SPRITES_VRAM_BOSS_4+COVID_PATRON_INICIAL_BOSS_4*8
     484.  00:4271  01 40 00            		ld		bc,8*4*COVID_PATRON_CANT_BOSS_4
     485.  00:4274  CD 42 5F            		call	PON_COLOR_2.sin_bc_impuesta
     486.  00:4277                      
     487.  00:4277                              ; Los BUBBLES se cargan despues de los COVIDs:
     488.  00:4277                              ; BUBBLES queda en 124 y 128.
     489.  00:4277  21 00 9E                    ld      hl,SPRITE_BUBBLES
     490.  00:427A  11 E0 43                    ld      de,PATRONES_SPRITES_VRAM_BOSS_4+BUBBLES_PATRON_INICIAL_BOSS_4*8
     491.  00:427D  01 40 00                    ld      bc,8*4*BUBBLES_PATRON_CANT_BOSS_4
     492.  00:4280  CD 42 5F                    call    PON_COLOR_2.sin_bc_impuesta
     493.  00:4283                      
     494.  00:4283                      		; El color de sprites en SCREEN 7 va por NUMERO DE SPRITE,
     495.  00:4283                      		; no por patron. Los proyectiles usan los sprites 22-29,
     496.  00:4283                      		; asi que sus colores deben arrancar en #4800 + 22*16 = #4960.
     497.  00:4283  11 60 49            		ld		de,PROYECTIL_BOSS_4_COLOR_VRAM
     498.  00:4286  06 08               		ld		b,PROYECTILES_BOSS_4_CANTIDAD
