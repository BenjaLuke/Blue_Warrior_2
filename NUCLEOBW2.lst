     246.  00:7053  4F                  		ld	c,a										; c:=OR mask
     247.  00:7054  3A D8 C2            		ld	a,[ayFX_REGS+7]							; a:=PSG mixer value
     248.  00:7057  A2                  		and	d										; AND mask
     249.  00:7058  B1                  		or	c										; OR mask
     250.  00:7059  32 D8 C2            		ld	[ayFX_REGS+7],a							; PSG mixer value updated
     251.  00:705C  3A CF C2            		ld	a,[ayFX_VOLUME]							; a:=ayFX volume value
     252.  00:705F  C9                  		ret											; Return
