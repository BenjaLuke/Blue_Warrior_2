    2962.  00:6EDE                      
    2963.  00:6EDE  3E 03               		ld		a,3
    2964.  00:6EE0  0E 01               		ld		c,1
    2965.  00:6EE2  CD 9B 6D            		call	A_31_DESDE_10
    2966.  00:6EE5                      
    2967.  00:6EE5  3E 96               		ld		a,150
