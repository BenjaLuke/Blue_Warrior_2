    2913.  00:6ED8                      
    2914.  00:6ED8  3A DA C0            		ld      a,(FASE)
    2915.  00:6EDB  C6 0A               		add		10
    2916.  00:6EDD  CD 36 5F            		call	CHANGE_BANK_2
    2917.  00:6EE0  21 00 80            		ld		hl,#8000
    2918.  00:6EE3  11 00 80            		ld		de,#8000
    2919.  00:6EE6  01 00 40            		ld		bc,16384
    2920.  00:6EE9  CD 42 5F            		call	PON_COLOR_2.sin_bc_impuesta
    2921.  00:6EEC                      
