    1777.  00:4F28                      REVISAMOS_COLISION_CON_AGONIX_Y_DEPH:
    1778.  00:4F28                      
    1779.  00:4F28                      		; Hitbox Agonix reducido 20 px por cada lado.
    1780.  00:4F28                      		; Deph se sigue tratando como caja aproximada de 20x20.
    1781.  00:4F28                      		;
    1782.  00:4F28                      		; Agonix original:
    1783.  00:4F28                      		; X = AGONIX_BOSS_1_X
    1784.  00:4F28                      		; W = AGONIX_MOVIMIENTO_ANCHO_BOSS_1
    1785.  00:4F28                      		; Y = AGONIX_MOVIMIENTO_Y_BOSS_1
    1786.  00:4F28                      		; H = AGONIX_MOVIMIENTO_ALTO_BOSS_1
    1787.  00:4F28                      		;
    1788.  00:4F28                      		; Agonix reducido:
    1789.  00:4F28                      		; X izquierda = X + 20
    1790.  00:4F28                      		; X derecha   = X + ancho - 20
    1791.  00:4F28                      		; Y arriba    = Y + 20
    1792.  00:4F28                      		; Y abajo     = Y + alto - 20
    1793.  00:4F28                      
    1794.  00:4F28  3A 78 C6            		ld		a,(AGONIX_BOSS_1_X)
    1795.  00:4F2B  C6 14               		add		20
    1796.  00:4F2D  4F                  		ld		c,a
    1797.  00:4F2E  3A 64 C0            		ld		a,(X_DEPH)
    1798.  00:4F31  C6 14               		add		20
    1799.  00:4F33  B9                  		cp		c
    1800.  00:4F34  D8                  		ret		c
    1801.  00:4F35                      
    1802.  00:4F35  3A 78 C6            		ld		a,(AGONIX_BOSS_1_X)
    1803.  00:4F38  C6 6E               		add		AGONIX_MOVIMIENTO_ANCHO_BOSS_1-20
    1804.  00:4F3A  4F                  		ld		c,a
    1805.  00:4F3B  3A 64 C0            		ld		a,(X_DEPH)
    1806.  00:4F3E  B9                  		cp		c
    1807.  00:4F3F  D0                  		ret		nc
    1808.  00:4F40                      
    1809.  00:4F40  3A 65 C0            		ld		a,(Y_DEPH)
    1810.  00:4F43  C6 14               		add		20
    1811.  00:4F45  FE 56               		cp		AGONIX_MOVIMIENTO_Y_BOSS_1+20
    1812.  00:4F47  D8                  		ret		c
    1813.  00:4F48                      
    1814.  00:4F48  3A 65 C0            		ld		a,(Y_DEPH)
    1815.  00:4F4B  FE 5E               		cp		AGONIX_MOVIMIENTO_Y_BOSS_1+AGONIX_MOVIMIENTO_ALTO_BOSS_1-20
    1816.  00:4F4D  D0                  		ret		nc
