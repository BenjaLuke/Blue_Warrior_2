     471.  00:4270                      ; -----------------------------------------------------------------------------
     472.  00:4270                      ; Carga de patrones y colores del barro.
     473.  00:4270                      ; OJO: debe ir DESPUES de RUTINA_BOSS_5 para que la entrada del banco
     474.  00:4270                      ; siga empezando en RUTINA_BOSS_5. Si se coloca antes, el boss puede entrar
     475.  00:4270                      ; por esta rutina y colgarse antes de iniciar el flujo normal.
     476.  00:4270                      ; -----------------------------------------------------------------------------
     477.  00:4270                      CARGA_SPRITES_BARRO_BOSS_5:
     478.  00:4270                      		
     479.  00:4270  CD 14 6E            		call	PAGE_32_A_SEGMENT_2
     480.  00:4273                      
     481.  00:4273                      		; Los dos patrones anteriores al super disparo quedan reservados para la
     482.  00:4273                      		; explosion de impacto: 92 y 96. NO se cargan aqui: ya estan
     483.  00:4273                      		; en VRAM en el sitio adecuado.
     484.  00:4273                      		; El super disparo empieza en los patrones del barro: 100,104,108.
     485.  00:4273  21 40 9E            		ld		hl,SUPER_DISPARO
     486.  00:4276  11 20 43            		ld		de,PATRONES_SPRITES_VRAM_BOSS_5+BARRO_PATRON_INICIAL_BOSS_5*8
     487.  00:4279  01 60 00            		ld		bc,8*4*SUPER_DISPARO_CANTIDAD_BOSS_5
     488.  00:427C  CD 42 5F            		call	PON_COLOR_2.sin_bc_impuesta
     489.  00:427F                      
     490.  00:427F                              ; Los BUBBLES quedan despues del barro.
     491.  00:427F  21 00 9E                    ld      hl,SPRITE_BUBBLES
     492.  00:4282  11 A0 43                    ld      de,PATRONES_SPRITES_VRAM_BOSS_5+BUBBLES_PATRON_INICIAL_BOSS_5*8
     493.  00:4285  01 40 00                    ld      bc,8*4*BUBBLES_PATRON_CANT_BOSS_5
     494.  00:4288  CD 42 5F                    call    PON_COLOR_2.sin_bc_impuesta
     495.  00:428B                      
     496.  00:428B  21 60 97            		ld		hl,SPRITES_COVID
     497.  00:428E  11 E0 43            		ld		de,PATRONES_SPRITES_VRAM_BOSS_5+COVID_PATRON_INICIAL_BOSS_5*8
     498.  00:4291  01 40 00            		ld		bc,8*4*COVID_PATRON_CANT_BOSS_5
     499.  00:4294  CD 42 5F            		call	PON_COLOR_2.sin_bc_impuesta
     500.  00:4297                      
     501.  00:4297                      		; El color de sprites en SCREEN 7 va por NUMERO DE SPRITE,
     502.  00:4297                      		; no por patron. Los proyectiles usan los sprites 22-29,
     503.  00:4297                      		; asi que sus colores deben arrancar en #4800 + 22*16 = #4960.
     504.  00:4297  11 60 49            		ld		de,PROYECTIL_BOSS_5_COLOR_VRAM
     505.  00:429A  06 08               		ld		b,PROYECTILES_BOSS_5_CANTIDAD
