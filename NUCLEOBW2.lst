       2.  00:7FA5                      ; INICIA_MUSICA_COMUN
       3.  00:7FA5                      ;
       4.  00:7FA5                      ; Entrada:
       5.  00:7FA5                      ;   A  = banco donde está la música
       6.  00:7FA5                      ;   HL = dirección de la música
       7.  00:7FA5                      ;
       8.  00:7FA5                      ; Ejemplo:
       9.  00:7FA5                      ;   ld  a,39
      10.  00:7FA5                      ;   ld  hl,M_PUENTE
      11.  00:7FA5                      ;   call INICIA_MUSICA_COMUN
      12.  00:7FA5                      ;
      13.  00:7FA5                      ; IMPORTANTE:
      14.  00:7FA5                      ;   Esta rutina NO debe estar en el segmento que cambia
      15.  00:7FA5                      ;   CHANGE_BANK_2, porque si cambia el banco donde está
      16.  00:7FA5                      ;   ejecutándose, el MSX se pega el castañazo padre.
      17.  00:7FA5                      ; ------------------------------------------------------------
