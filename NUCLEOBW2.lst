    1630.  00:4B8D  38 04               		jr		c,.OBJETIVO_X_DEPH_OK_CHUMINIX_BOSS_3
    1631.  00:4B8F  28 02               		jr		z,.OBJETIVO_X_DEPH_OK_CHUMINIX_BOSS_3
