    2188.  00:4D9E  (00:00C3)           ROTATIVO_Y_PRESENTACION                  equ     195
    2189.  00:4D9E                      
    2190.  00:4D9E                      ; Cada cuántos frames se actualiza el rotativo.
    2191.  00:4D9E                      ; 1 = cada frame, 2 = cada dos frames, etc.
    2192.  00:4D9E  (00:0003)           ROTATIVO_VELOCIDAD_PRESENTACION          equ     3
    2193.  00:4D9E                      
    2194.  00:4D9E                      ; El nuevo rotativo avanza copiando la franja 2 píxeles a la izquierda.
    2195.  00:4D9E                      ; Cada letra mide 6 píxeles, así que se introduce en 3 pasos:
    2196.  00:4D9E                      ;   paso 0 -> X=254
    2197.  00:4D9E                      ;   paso 1 -> X=252
    2198.  00:4D9E                      ;   paso 2 -> X=250
    2199.  00:4D9E  (00:0002)           ROTATIVO_PIXELES_POR_PASO_PRESENTACION   equ     2
    2200.  00:4D9E  (00:0003)           ROTATIVO_PASOS_POR_LETRA_PRESENTACION    equ     3
    2201.  00:4D9E  (00:00FE)           ROTATIVO_X_ENTRADA_PRESENTACION          equ     254
    2202.  00:4D9E  (00:00FE)           ROTATIVO_ANCHO_SCROLL_PRESENTACION       equ     254
    2203.  00:4D9E  (00:0008)           ROTATIVO_ALTO_PRESENTACION               equ     8
    2204.  00:4D9E                      
    2205.  00:4D9E                      ; Cuando se acaba el texto, metemos espacios hasta que toda la cola sale
    2206.  00:4D9E                      ; por la izquierda. 43 espacios * 6 píxeles = 258 píxeles.
    2207.  00:4D9E  (00:002B)           ROTATIVO_ESPACIOS_SALIDA_PRESENTACION    equ     43
    2208.  00:4D9E                      
    2209.  00:4D9E                      
    2210.  00:4D9E                      INICIALIZA_ROTATIVO_PRESENTACION:
    2211.  00:4D9E                      
    2212.  00:4D9E  AF                          xor     a
    2213.  00:4D9F  32 17 C6                    ld      (ROTATIVO_CONTADOR_PRESENTACION),a
    2214.  00:4DA2  32 18 C6                    ld      (ROTATIVO_PAGINA_VISIBLE_PRESENTACION),a
    2215.  00:4DA5  32 1B C6                    ld      (ROTATIVO_REPETICION_LETRA_PRESENTACION),a
    2216.  00:4DA8  32 1C C6                    ld      (ROTATIVO_MODO_SALIDA_PRESENTACION),a
    2217.  00:4DAB                      
    2218.  00:4DAB  3E 2B                       ld      a,ROTATIVO_ESPACIOS_SALIDA_PRESENTACION
    2219.  00:4DAD  32 1D C6                    ld      (ROTATIVO_PASOS_SALIDA_PRESENTACION),a
    2220.  00:4DB0                      
    2221.  00:4DB0  21 70 4F                    ld      hl,TEXTO_ROTATIVO_PRESENTACION
    2222.  00:4DB3  22 19 C6                    ld      (ROTATIVO_PUNTERO_TEXTO_PRESENTACION),hl
    2223.  00:4DB6                      
    2224.  00:4DB6                              ; Dejamos limpia la franja en las dos páginas. Así el primer paso
    2225.  00:4DB6                              ; parte de una zona negra y la página oculta no hereda basura.
    2226.  00:4DB6                      
    2227.  00:4DB6  21 52 4F                    ld      hl,DATOS_NEGRO_ROTATIVO_EN_PAGE_0
    2228.  00:4DB9  CD 2A 5E                    call    DOCOPY
    2229.  00:4DBC  CD 33 5E                    call    VDPREADY
    2230.  00:4DBF                      
