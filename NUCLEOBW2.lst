    2268.  00:5003  22 15 C6                    ld      (ROTATIVO_PUNTERO_TEXTO_PRESENTACION),hl
    2269.  00:5006                      
    2270.  00:5006                              ; Dejamos limpia la franja en las dos páginas. Así el primer paso
    2271.  00:5006                              ; parte de una zona negra y la página oculta no hereda basura.
    2272.  00:5006                      
    2273.  00:5006  21 A2 51                    ld      hl,DATOS_NEGRO_ROTATIVO_EN_PAGE_0
    2274.  00:5009  CD 2A 5E                    call    DOCOPY
    2275.  00:500C  CD 33 5E                    call    VDPREADY
    2276.  00:500F                      
