    1672.  00:483C                      ; -----------------------------------------------------------------------------
    1673.  00:483C                      ; Control del lodo en Boss 4 por coordenada Y.
    1674.  00:483C                      ; Si Y_DEPH < 85: sprites normales y movimiento normal.
    1675.  00:483C                      ; Si Y_DEPH >= 85: sprites de pies en lodo.
    1676.  00:483C                      ;
    1677.  00:483C                      ; IMPORTANTE:
    1678.  00:483C                      ; La rutina comun de movimiento debe ejecutarse SIEMPRE.
    1679.  00:483C                      ; Las pruebas anteriores que saltaban MOVIMIENTO_DEPH_EN_BOSS_4 o restauraban X/Y
    1680.  00:483C                      ; dejaban a Deph bloqueado o descolocaban sus limites internos.
    1681.  00:483C                      ; Aqui no tocamos coordenadas, no restauramos posiciones y no cortamos el flujo.
    1682.  00:483C                      ; -----------------------------------------------------------------------------
    1683.  00:483C                      CONTROL_LODO_Y_MOVIMIENTO_DEPH_BOSS_4:
    1684.  00:483C                      
    1685.  00:483C  3A 65 C0            		ld		a,(Y_DEPH)
    1686.  00:483F  FE 55               		cp		DEPH_LODO_LIMITE_Y_BOSS_4
    1687.  00:4841  30 06               		jr		nc,.DEPH_EN_LODO_BOSS_4
