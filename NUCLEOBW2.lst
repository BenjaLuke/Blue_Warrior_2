       1.  00:6F20                      ; ROMAN: PAR
       2.  00:6F20                      													; --- ayFX REPLAYER v2.0M ---
       3.  00:6F20                      
       4.  00:6F20                      													; --- v2.0T  New ayFX replayer routine. T -> Triple FX replayer
       5.  00:6F20                      
       6.  00:6F20                      ;ayFX_SETUP:											; ---          ayFX replayer setup          ---
       7.  00:6F20                      													; --- INPUT: HL -> pointer to the ayFX bank ---
       8.  00:6F20  22 BF C2            		ld	[ayFX_BANK],hl							; Current ayFX bank
       9.  00:6F23                      ;ayFX_STOP:	
      10.  00:6F23                      		
      11.  00:6F23  3E FF               		ld	a,255									; Lowest ayFX priority
      12.  00:6F25  32 C1 C2            		ld	[ayFX_C1],a								; First channel minimum priority
      13.  00:6F28  32 C4 C2            		ld	[ayFX_C2],a								; First channel minimum priority
      14.  00:6F2B  32 C7 C2            		ld	[ayFX_C3],a								; First channel minimum priority
      15.  00:6F2E  C9                  		ret											; Return
      16.  00:6F2F                      ;ayFX_END:											; --- End of an ayFX stream ---
      17.  00:6F2F                      
      18.  00:6F2F  DD 36 00 FF         		ld	[IX],255								; Priority saved (not playing ayFX stream)
      19.  00:6F33  C9                  		ret											; Return
      20.  00:6F34                      
      21.  00:6F34                      ;ayFX_INIT:											; ---     INIT A NEW ayFX STREAM     ---
      22.  00:6F34                      													; --- INPUT: A -> sound to be played ---
      23.  00:6F34                      													; ---        C -> sound priority     ---
      24.  00:6F34                      													; --- Checks the priorities of playing ayFX streams to place ---
      25.  00:6F34                      													; --- the new one on the channel with lowest priority        ---
      26.  00:6F34  C5                  		push	bc									; Store bc in stack
      27.  00:6F35  D5                  		push	de									; Store de in stack
      28.  00:6F36  E5                  		push	hl									; Store hl in stack
      29.  00:6F37  DD E5               		push	IX									; Store IX in stack
      30.  00:6F39                      													; --- Check if the index is in the bank ---
      31.  00:6F39  47                  		ld	b,a										; b:=a (new ayFX stream index)
      32.  00:6F3A  2A BF C2            		ld	hl,[ayFX_BANK]							; Current ayFX BANK
      33.  00:6F3D  7E                  		ld	a,[hl]									; Number of samples in the bank
      34.  00:6F3E  B7                  		or	a										; If zero (means 256 samples)...
      35.  00:6F3F  CA 49 6F            		jp	z,ayFX_INIT.CHECK_PRI							; ...goto .CHECK_PRI
      36.  00:6F42                      													; The bank has less than 256 samples
      37.  00:6F42  78                  		ld	a,b										; a:=b (new ayFX stream index)
      38.  00:6F43  BE                  		cp	[hl]									; If new index is not in the bank...
      39.  00:6F44  3E 02               		ld	a,2										; a:=2 (error 2: Sample not in the bank)
      40.  00:6F46  D2 A8 6F            		jp	nc,ayFX_INIT.INIT_END							; ...we can't init it
      41.  00:6F49                      
      42.  00:6F49                      ;.CHECK_PRI:											; --- Places the data on the correct channel                  ---
      43.  00:6F49                      													; ---   Remember: 0 = highest priority, 15 = lowest priority  ---
      44.  00:6F49                      													; --- Checks channel 1 ---
      45.  00:6F49  3A C1 C2            		ld	a,[ayFX_C1]								; Priority of ayFX Stream being played on channel 1
      46.  00:6F4C  FE FF               		cp	255										; If there's no Stream being played...
      47.  00:6F4E  28 39               		jr	z,ayFX_INIT.TOC1									; ...place the new Stream on channel 1
      48.  00:6F50  5F                  		ld	e,a										; Minimum priority of Streams being played
      49.  00:6F51  16 01               		ld	d,1										; On channel 1
      50.  00:6F53                      													; --- Checks channel 2 ---
      51.  00:6F53  3A C4 C2            		ld	a,[ayFX_C2]								; Priority of ayFX Stream being played on channel 2
      52.  00:6F56  FE FF               		cp	255										; If there's no Stream being played...
      53.  00:6F58  28 29               		jr	z,ayFX_INIT.TOC2									; ...place the new Stream on channel 2
      54.  00:6F5A  BB                  		cp	e										; Compare priority with minimum one
      55.  00:6F5B  30 03               		jr	nc,ayFX_INIT.CHECKC3								; If P(C2) > min, go to .CHECKC3
      56.  00:6F5D  5F                  		ld	e,a										; Minimum priority of Streams being played
      57.  00:6F5E  16 02               		ld	d,2										; On channel 2
      58.  00:6F60                      
      59.  00:6F60                      ;.CHECKC3:											; --- Checks channel 3 ---
      60.  00:6F60                      
      61.  00:6F60  3A C7 C2            		ld	a,[ayFX_C3]								; Priority of ayFX Stream being played on channel 3
      62.  00:6F63  FE FF               		cp	255										; If there's no stream being played
      63.  00:6F65  28 16               		jr	z,ayFX_INIT.TOC3									; ...place the new Stream on channel 3
      64.  00:6F67  BB                  		cp	e										; Compare priority with minimum one
      65.  00:6F68  30 03               		jr	nc,ayFX_INIT.CHECKMIN							; If P(C3) > min, go to .CHECKMIN
      66.  00:6F6A  5F                  		ld	e,a										; Minimum priority of Streams being played
      67.  00:6F6B  16 03               		ld	d,3										; On channel 3
      68.  00:6F6D                      
      69.  00:6F6D                      ;.CHECKMIN:											; --- Checks if minimum priority is lower than priority of the new Stream ---
      70.  00:6F6D                      
      71.  00:6F6D  79                  		ld	a,c										; Priority of the new Stream
      72.  00:6F6E  BB                  		cp	e										; Minimum priority of Streams being played
      73.  00:6F6F  3E 01               		ld	a,1										; a:=1 (error 1: A sample with higher priority is being played)
      74.  00:6F71  D2 A8 6F            		jp	nc,ayFX_INIT.INIT_END							; ...we can't play the new ayFX Stream
      75.  00:6F74                      													; --- The new stream substitues the minimum priority Stream being played ---
      76.  00:6F74  7A                  		ld	a,d										; Channel of minimum priority
      77.  00:6F75  FE 01               		cp	1										; If it's 1...
      78.  00:6F77  28 10               		jr	z,ayFX_INIT.TOC1									; ...send Stream to channel 1
      79.  00:6F79  FE 02               		cp	2										; If it's 2...
      80.  00:6F7B  28 06               		jr	z,ayFX_INIT.TOC2									; ...send Stream to channel 2
      81.  00:6F7D                      
      82.  00:6F7D                      ;.TOC3:												; --- Stream will be played on channel 3
      83.  00:6F7D                      
      84.  00:6F7D  DD 21 C7 C2         		ld	IX,ayFX_C3								; Pointer to the chanel data
      85.  00:6F81  18 0A               		jr	ayFX_INIT.SETDATA								; Go to .SETDATA
      86.  00:6F83                      
      87.  00:6F83                      ;.TOC2:												; --- Stream will be played on channel 2
      88.  00:6F83                      
      89.  00:6F83  DD 21 C4 C2         		ld	IX,ayFX_C2								; Pointer to the channel data
      90.  00:6F87  18 04               		jr	ayFX_INIT.SETDATA								; Go to .SETDATA
      91.  00:6F89                      
      92.  00:6F89                      ;.TOC1:												; --- Stream will be played on channel 1
      93.  00:6F89                      		
      94.  00:6F89  DD 21 C1 C2         		ld	IX,ayFX_C1								; Pointer to the chanel data
      95.  00:6F8D                      
      96.  00:6F8D                      ;.SETDATA:											; --- Set data on the correct channel ---
      97.  00:6F8D                      											
      98.  00:6F8D  79                  		ld	a,c										; a:=New priority
      99.  00:6F8E  E6 0F               		and	$0F										; We mask the priority
     100.  00:6F90  DD 77 00            		ld	[IX],a									; new ayFX stream priority saved in RAM
     101.  00:6F93                      													; --- Calculate the pointer to the new ayFX stream ---
     102.  00:6F93  ED 5B BF C2         		ld	de,[ayFX_BANK]							; de:=Current ayFX bank
     103.  00:6F97  13                  		inc	de										; de points to the increments table of the bank
     104.  00:6F98  68                  		ld	l,b										; l:=b (new ayFX stream index)
     105.  00:6F99  26 00               		ld	h,0										; hl:=b (new ayFX stream index)
     106.  00:6F9B  29                  		add	hl,hl									; hl:=hl*2
     107.  00:6F9C  19                  		add	hl,de									; hl:=hl+de (hl points to the correct increment)
     108.  00:6F9D  5E                  		ld	e,[hl]									; e:=lower byte of the increment
     109.  00:6F9E  23                  		inc	hl										; hl points to the higher byte of the correct increment
     110.  00:6F9F  56                  		ld	d,[hl]									; de:=increment
     111.  00:6FA0  19                  		add	hl,de									; hl:=hl+de (hl points to the new ayFX stream)
     112.  00:6FA1  DD 75 01            		ld	[IX+1],l								; Pointer lower byte saved in RAM
     113.  00:6FA4  DD 74 02            		ld	[IX+2],h								; Pointer higher byte saved in RAM
     114.  00:6FA7  AF                  		xor	a										; a:=0 (no errors)
     115.  00:6FA8                      
     116.  00:6FA8                      ;.INIT_END:	
     117.  00:6FA8                      
     118.  00:6FA8  DD E1               		pop	IX										; Retrieve IX from stack
     119.  00:6FAA  E1                  		pop	hl										; Retrieve hl from stack
     120.  00:6FAB  D1                  		pop	de										; Retrieve de from stack
     121.  00:6FAC  C1                  		pop	bc										; Retrieve bc from stack
     122.  00:6FAD  C9                  		ret											; Return
     123.  00:6FAE                      
     124.  00:6FAE                      ;ayFX_PLAY:											; --- Plays next frame of each ayFX Stream ---
     125.  00:6FAE                      			
     126.  00:6FAE  21 00 00            		ld	hl,0									; hl:=0
     127.  00:6FB1  22 D6 C2            		ld	[ayFX_REGS+7],hl						; Clears mixer and volume of channel A
     128.  00:6FB4  22 D8 C2            		ld	[ayFX_REGS+9],hl						; Clears volume of channels B and C
     129.  00:6FB7  DD 21 C1 C2         		ld	IX,ayFX_C1								; Channel 1
     130.  00:6FBB  3E 01               		ld	a,1										; a:=1
     131.  00:6FBD  CD CF 6F            		call	ayFX_PLAY.ayFX_PlayChannel					; Play Channel 1
     132.  00:6FC0  DD 21 C4 C2         		ld	IX,ayFX_C2								; Channel 2
     133.  00:6FC4  3E 02               		ld	a,2										; a:=2
     134.  00:6FC6  CD CF 6F            		call	ayFX_PLAY.ayFX_PlayChannel					; Play Channel 2
     135.  00:6FC9  DD 21 C7 C2         		ld	IX,ayFX_C3								; Channel 3
     136.  00:6FCD  3E 03               		ld	a,3										; a:=3
     137.  00:6FCF                      ;.ayFX_PlayChannel:									; --- Plays a channel stream ---
     138.  00:6FCF  32 CE C2            		ld	[ayFX_CHANNEL],a						; Sets current channel
     139.  00:6FD2  DD 7E 00            		ld	a,[IX]									; a:=Current ayFX stream priority
     140.  00:6FD5  B7                  		or	a										; If priority has bit 7 on...
     141.  00:6FD6  F8                  		ret	m										; ...return
     142.  00:6FD7                      													; --- Extract control byte from stream ---
     143.  00:6FD7  DD 6E 01            		ld	l,[IX+1]								; Pointer to the current ayFX stream (lower byte)
     144.  00:6FDA  DD 66 02            		ld	h,[IX+2]								; Pointer to the current ayFX stream (higher byte)
     145.  00:6FDD  4E                  		ld	c,[hl]									; c:=Control byte
     146.  00:6FDE  23                  		inc	hl										; Increment pointer
     147.  00:6FDF                      													; --- Check if there's new tone on stream ---
     148.  00:6FDF  CB 69               		bit	5,c										; If bit 5 c is off...
     149.  00:6FE1  CA EC 6F            		jp	z,ayFX_PLAY.CHECK_NN								; ...jump to .CHECK_NN (no new tone)
     150.  00:6FE4                      													; --- Extract new tone from stream ---
     151.  00:6FE4  5E                  		ld	e,[hl]									; e:=lower byte of new tone
     152.  00:6FE5  23                  		inc	hl										; Increment pointer
     153.  00:6FE6  56                  		ld	d,[hl]									; d:=higher byte of new tone
     154.  00:6FE7  23                  		inc	hl										; Increment pointer
     155.  00:6FE8  ED 53 CA C2         		ld	[ayFX_TONE],de							; ayFX tone updated
     156.  00:6FEC                      
     157.  00:6FEC                      ;.CHECK_NN:											; --- Check if there's new noise on stream ---
     158.  00:6FEC                      
     159.  00:6FEC  CB 71               		bit	6,c										; if bit 6 c is off...
     160.  00:6FEE  CA FB 6F            		jp	z,ayFX_PLAY.SETPOINTER							; ...jump to .SETPOINTER (no new noise)
     161.  00:6FF1                      													; --- Extract new noise from stream ---
     162.  00:6FF1  7E                  		ld	a,[hl]									; a:=New noise
     163.  00:6FF2  23                  		inc	hl										; Increment pointer
     164.  00:6FF3  FE 20               		cp	$20										; If it's an illegal value of noise (used to mark end of stream)...
     165.  00:6FF5  CA 2F 6F            		jp	z,ayFX_END								; ...jump to ayFX_END
     166.  00:6FF8  32 CC C2            		ld	[ayFX_NOISE],a							; ayFX noise updated
     167.  00:6FFB                      
     168.  00:6FFB                      ;.SETPOINTER:										; --- Update ayFX pointer ---
     169.  00:6FFB                      
     170.  00:6FFB  DD 75 01            		ld	[IX+1],l								; Pointer lower byte saved in RAM
     171.  00:6FFE  DD 74 02            		ld	[IX+2],h								; Pointer higher byte saved in RAM
     172.  00:7001                      													; --- Extract volume ---
     173.  00:7001  79                  		ld	a,c										; a:=Control byte
     174.  00:7002  E6 0F               		and	$0F										; lower nibble
     175.  00:7004  32 CD C2            		ld	[ayFX_VOLUME],a							; ayFX volume updated
     176.  00:7007  C8                  		ret	z										; Return if volume is zero (don't copy ayFX values in to ayFX_REGS)
     177.  00:7008                      													; -------------------------------------
     178.  00:7008                      													; --- COPY ayFX VALUES IN TO ayFX_REGS ---
     179.  00:7008                      													; -------------------------------------
     180.  00:7008                      													; --- Set noise channel ---
     181.  00:7008  CB 79               		bit	7,c										; If noise is off...
     182.  00:700A  C2 13 70            		jp	nz,ayFX_PLAY.SETMASKS							; ...jump to .SETMASKS
     183.  00:700D  3A CC C2            		ld	a,[ayFX_NOISE]							; ayFX noise value
     184.  00:7010  32 D5 C2            		ld	[ayFX_REGS+6],a							; copied in to ayFX_REGS (noise channel)
     185.  00:7013                      
     186.  00:7013                      ;.SETMASKS:											; --- Set mixer masks ---
     187.  00:7013                      
     188.  00:7013  79                  		ld	a,c										; a:=Control byte
     189.  00:7014  E6 90               		and	$90										; Only bits 7 and 4 (noise and tone mask for psg reg 7)
     190.  00:7016  FE 90               		cp	$90										; If no noise and no tone...
     191.  00:7018  C8                  		ret	z										; ...return (don't copy ayFX values in to ayFX_REGS)
     192.  00:7019                      													; --- Copy ayFX values in to ayFX_REGS ---
     193.  00:7019  CB 0F               		rrc	a										; Rotate a to the right (1 TIME)
     194.  00:701B  CB 0F               		rrc	a										; Rotate a to the right (2 TIMES) (OR mask)
     195.  00:701D  16 DB               		ld	d,$DB									; d:=Mask for psg mixer (AND mask)
     196.  00:701F  21 CE C2            		ld	hl,ayFX_CHANNEL							; ayFX playing channel
     197.  00:7022  46                  		ld	b,[hl]									; Channel counter
     198.  00:7023                      
     199.  00:7023                      ;.CHK1:												; --- Check if playing channel was 1 ---
     200.  00:7023                      
     201.  00:7023  10 10               		djnz	ayFX_PLAY.CHK2								; Decrement and jump if channel was not 1
     202.  00:7025                      
     203.  00:7025                      ;.PLAY_C:											; --- Play ayFX stream on channel C ---
     204.  00:7025                      
     205.  00:7025  CD 5F 70            		call	ayFX_PLAY.SETMIXER							; Set PSG mixer value (a:=ayFX volume)
     206.  00:7028  32 D9 C2            		ld	[ayFX_REGS+10],a						; Volume copied in to ayFX_REGS (channel C volume)
     207.  00:702B  CB 51               		bit	2,c										; If tone is off...
     208.  00:702D  C0                  		ret	nz										; ...return
     209.  00:702E  2A CA C2            		ld	hl,[ayFX_TONE]							; ayFX tone value
     210.  00:7031  22 D3 C2            		ld	[ayFX_REGS+4],hl						; copied in to ayFX_REGS (channel C tone)
     211.  00:7034  C9                  		ret											; Return
     212.  00:7035                      
     213.  00:7035                      ;.CHK2:												; --- Check if playing channel was 2 ---
     214.  00:7035                      
     215.  00:7035  CB 0A               		rrc	d										; Rotate right AND mask
     216.  00:7037  CB 0F               		rrc	a										; Rotate right OR mask
     217.  00:7039  10 10               		djnz	ayFX_PLAY.CHK3								; Decrement and jump if channel was not 2
     218.  00:703B                      
     219.  00:703B                      ;.PLAY_B:											; --- Play ayFX stream on channel B ---
     220.  00:703B                      
     221.  00:703B  CD 5F 70            		call	ayFX_PLAY.SETMIXER							; Set PSG mixer value (a:=ayFX volume)
     222.  00:703E  32 D8 C2            		ld	[ayFX_REGS+9],a							; Volume copied in to ayFX_REGS (channel B volume)
     223.  00:7041  CB 49               		bit	1,c										; If tone is off...
     224.  00:7043  C0                  		ret	nz										; ...return
     225.  00:7044  2A CA C2            		ld	hl,[ayFX_TONE]							; ayFX tone value
     226.  00:7047  22 D1 C2            		ld	[ayFX_REGS+2],hl						; copied in to ayFX_REGS (channel B tone)
     227.  00:704A  C9                  		ret											; Return
     228.  00:704B                      
     229.  00:704B                      ;.CHK3:												; --- Check if playing channel was 3 ---
     230.  00:704B                      
     231.  00:704B  CB 0A               		rrc	d										; Rotate right AND mask
     232.  00:704D  CB 0F               		rrc	a										; Rotate right OR mask
     233.  00:704F                      
     234.  00:704F                      ;.PLAY_A:											; --- Play ayFX stream on channel A ---
     235.  00:704F                      
     236.  00:704F  CD 5F 70            		call	ayFX_PLAY.SETMIXER							; Set PSG mixer value (a:=ayFX volume)
     237.  00:7052  32 D7 C2            		ld	[ayFX_REGS+8],a							; Volume copied in to ayFX_REGS (channel A volume)
     238.  00:7055  CB 41               		bit	0,c										; If tone is off...
     239.  00:7057  C0                  		ret	nz										; ...return
     240.  00:7058  2A CA C2            		ld	hl,[ayFX_TONE]							; ayFX tone value
     241.  00:705B  22 CF C2            		ld	[ayFX_REGS+0],hl						; copied in to ayFX_REGS (channel A tone)
     242.  00:705E  C9                  		ret											; Return
     243.  00:705F                      
     244.  00:705F                      ;.SETMIXER:											; --- Set PSG mixer value ---
     245.  00:705F                      
     246.  00:705F  4F                  		ld	c,a										; c:=OR mask
     247.  00:7060  3A D6 C2            		ld	a,[ayFX_REGS+7]							; a:=PSG mixer value
     248.  00:7063  A2                  		and	d										; AND mask
     249.  00:7064  B1                  		or	c										; OR mask
     250.  00:7065  32 D6 C2            		ld	[ayFX_REGS+7],a							; PSG mixer value updated
     251.  00:7068  3A CD C2            		ld	a,[ayFX_VOLUME]							; a:=ayFX volume value
     252.  00:706B  C9                  		ret											; Return
