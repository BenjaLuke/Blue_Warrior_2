    2543.  00:5301                      
    2544.  00:5301                      
    2545.  00:5301                      		; Origen: primer recuadro arriba izquierda.
    2546.  00:5301                      		; x=0, y=0. La page ya la hemos puesto en iy+3.
    2547.  00:5301                      
    2548.  00:5301  AF                  		xor		a
    2549.  00:5302  FD 77 00            		ld		(iy),a								; origen x low
    2550.  00:5305  FD 77 01            		ld		(iy+1),a							; origen x high
    2551.  00:5308  FD 77 02            		ld		(iy+2),a							; origen y low
    2552.  00:530B                      
    2553.  00:530B                      
    2554.  00:530B                      		; Destino X: posición actual de Agonix en page 2.
    2555.  00:530B                      
    2556.  00:530B  3A 78 C6            		ld		a,(AGONIX_BOSS_1_X)
    2557.  00:530E  FD 77 04            		ld		(iy+4),a							; destino x low
    2558.  00:5311  AF                  		xor		a
    2559.  00:5312  FD 77 05            		ld		(iy+5),a							; destino x high
    2560.  00:5315                      
    2561.  00:5315                      
    2562.  00:5315                      		; Recuperamos el contador externo del bucle.
    2563.  00:5315                      		; B = altura actual que vamos a copiar.
    2564.  00:5315                      		; Primera vuelta: B = 48.
    2565.  00:5315                      		; Última vuelta: B = 1.
    2566.  00:5315                      		; Cuando B llega a 0, el djnz de fuera termina la animación.
    2567.  00:5315                      
    2568.  00:5315  C1                  		pop		bc
    2569.  00:5316  C5                  		push	bc
    2570.  00:5317                      
    2571.  00:5317                      		; offset = altura inicial - altura actual.
    2572.  00:5317                      		; Este offset baja el destino.
    2573.  00:5317                      
    2574.  00:5317  3E 30               		ld		a,AGONIX_MUERTE_ALTO_BOSS_1
    2575.  00:5319  90                  		sub		b
    2576.  00:531A  4F                  		ld		c,a									; C = offset vertical
    2577.  00:531B                      
    2578.  00:531B                      
    2579.  00:531B                      		; Destino Y = y actual de Agonix + offset.
