    2221.  00:4E6A                      ; -----------------------------------------------------------------------------
    2222.  00:4E6A                      ; Limpia las franjas que deja Chuminix al desplazarse.
    2223.  00:4E6A                      ; Se llama DESPUES de pintar el copy nuevo.
    2224.  00:4E6A                      ;
    2225.  00:4E6A                      ; VARIABLE_UN_USO  = X anterior
    2226.  00:4E6A                      ; VARIABLE_UN_USO2 = Y anterior
    2227.  00:4E6A                      ;
    2228.  00:4E6A                      ; Secuencia 1 y 2:
    2229.  00:4E6A                      ;   X crece   -> X nueva - deltaX, Y nueva, ancho deltaX, alto Chuminix
    2230.  00:4E6A                      ;   X decrece -> X nueva + ancho Chuminix, Y nueva, ancho deltaX, alto Chuminix
    2231.  00:4E6A                      ;   Y crece   -> X nueva, Y nueva - deltaY, ancho Chuminix, alto deltaY
    2232.  00:4E6A                      ;   Y decrece -> X nueva, Y nueva + alto Chuminix, ancho Chuminix, alto deltaY
    2233.  00:4E6A                      ; -----------------------------------------------------------------------------
