    1718.  00:487A  CD E5 48            		call	MOVIMIENTO_DEPH_EN_BOSS_4
    1719.  00:487D                      		; La rutina comun puede reponer colores normales al pintar a Deph.
    1720.  00:487D                      		; Por eso, en lodo los colores de pies se vuelcan despues del movimiento.
    1721.  00:487D  CD D0 48            		call	CARGA_COLORES_DEPH_LODO_BOSS_4
