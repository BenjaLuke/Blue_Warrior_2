     954   00:7304                      		include "AUDIOS/LANZADOR FMPACK Y MUSIC MODULE (sin etiquetas).asm"        
       1.  00:7304                      ; ROMAN: PAR
       2.  00:7304                      ;INICIAMOS_MUSICA:
       3.  00:7304                      
       4.  00:7304  AF                  		xor		a														;le damos 0 a la posicion de arranque de la música
