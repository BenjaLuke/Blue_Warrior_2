    2923.  00:6EEF  C6 0F               		add		15
    2924.  00:6EF1  CD 36 5F            		call	CHANGE_BANK_2
    2925.  00:6EF4  21 00 80            		ld		hl,#8000
    2926.  00:6EF7  11 00 C0            		ld		de,#C000
    2927.  00:6EFA  01 00 40            		ld		bc,16384
