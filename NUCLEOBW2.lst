    2445.  00:531F                      REVISAMOS_COLISION_CON_ERRECENYX_Y_DEPH:
    2446.  00:531F                      
    2447.  00:531F                      		; Hitbox Errecenyx/Herrecenix reducido 20 px por cada lado.
    2448.  00:531F                      		; Deph se sigue tratando como caja aproximada de 20x20.
    2449.  00:531F                      		;
    2450.  00:531F                      		; X original visible:
    2451.  00:531F                      		;   izquierda = VARIABLE_UN_USO3
    2452.  00:531F                      		;   ancho     = VARIABLE_UN_USO2
    2453.  00:531F                      		;
    2454.  00:531F                      		; X reducido:
    2455.  00:531F                      		;   izquierda = VARIABLE_UN_USO3 + 20
    2456.  00:531F                      		;   derecha   = VARIABLE_UN_USO3 + VARIABLE_UN_USO2 - 20
    2457.  00:531F                      		;
    2458.  00:531F                      		; Y original:
    2459.  00:531F                      		;   arriba = ERRECENYX_MOVIMIENTO_Y_BOSS_4
    2460.  00:531F                      		;   alto   = ERRECENYX_MOVIMIENTO_ALTO_BOSS_4
    2461.  00:531F                      		;
    2462.  00:531F                      		; Y reducido:
    2463.  00:531F                      		;   arriba = ERRECENYX_MOVIMIENTO_Y_BOSS_4 + 20
    2464.  00:531F                      		;   abajo  = ERRECENYX_MOVIMIENTO_Y_BOSS_4 + ERRECENYX_MOVIMIENTO_ALTO_BOSS_4 - 20
    2465.  00:531F                      
    2466.  00:531F  CD 8C 4F            		call	CALCULA_RECORTE_ERRECENYX_BOSS_4
    2467.  00:5322                      
    2468.  00:5322                      		; Si el ancho visible es 40 o menos, al meter 20 por cada lado
    2469.  00:5322                      		; no queda hitbox real.
    2470.  00:5322  3A 97 C2            		ld		a,(VARIABLE_UN_USO2)
    2471.  00:5325  FE 29               		cp		41
    2472.  00:5327  D8                  		ret		c
    2473.  00:5328                      
    2474.  00:5328                      		; Comprueba borde izquierdo reducido:
    2475.  00:5328                      		; Deph derecha >= Errecenyx izquierda + 20
    2476.  00:5328  3A 98 C2            		ld		a,(VARIABLE_UN_USO3)
    2477.  00:532B  C6 14               		add		20
    2478.  00:532D  4F                  		ld		c,a
    2479.  00:532E  3A 55 C0            		ld		a,(X_DEPH)
    2480.  00:5331  C6 14               		add		20
    2481.  00:5333  B9                  		cp		c
    2482.  00:5334  D8                  		ret		c
    2483.  00:5335                      
    2484.  00:5335                      		; Comprueba borde derecho reducido:
    2485.  00:5335                      		; Deph izquierda < Errecenyx derecha - 20
    2486.  00:5335  3A 98 C2            		ld		a,(VARIABLE_UN_USO3)
    2487.  00:5338  4F                  		ld		c,a
    2488.  00:5339  3A 97 C2            		ld		a,(VARIABLE_UN_USO2)
    2489.  00:533C  81                  		add		c
    2490.  00:533D  D6 14               		sub		20
    2491.  00:533F  4F                  		ld		c,a
    2492.  00:5340  3A 55 C0            		ld		a,(X_DEPH)
    2493.  00:5343  B9                  		cp		c
    2494.  00:5344  D0                  		ret		nc
    2495.  00:5345                      
    2496.  00:5345                      		; Comprueba borde superior reducido:
    2497.  00:5345                      		; Deph abajo >= Errecenyx arriba + 20
    2498.  00:5345  3A 56 C0            		ld		a,(Y_DEPH)
    2499.  00:5348  C6 14               		add		20
    2500.  00:534A  FE 30               		cp		ERRECENYX_MOVIMIENTO_Y_BOSS_4+20
    2501.  00:534C  D8                  		ret		c
    2502.  00:534D                      
    2503.  00:534D                      		; Comprueba borde inferior reducido:
    2504.  00:534D                      		; Deph arriba < Errecenyx abajo - 20
    2505.  00:534D  3A 56 C0            		ld		a,(Y_DEPH)
    2506.  00:5350  FE 46               		cp		ERRECENYX_MOVIMIENTO_Y_BOSS_4+ERRECENYX_MOVIMIENTO_ALTO_BOSS_4-20
    2507.  00:5352  D0                  		ret		nc
