      43.  00:5E33                      
      44.  00:5E33                      ;VDPREADY:
      45.  00:5E33                      	
      46.  00:5E33  3E 02               		ld		a,2
      47.  00:5E35  F3                  		di
      48.  00:5E36  D3 99               		out		(#99),a									; Selecciona s#2
      49.  00:5E38  3E 8F               		ld		a,15+128
      50.  00:5E3A  D3 99               		out		(#99),a
      51.  00:5E3C  DB 99               		in		a,(#99)
      52.  00:5E3E  1F                  		rra
      53.  00:5E3F  3E 00               		ld 		a,0										; Regresa a s#0, activa interrupciones
      54.  00:5E41  D3 99               		out		(#99),a
      55.  00:5E43  3E 8F               		ld		a,15+128
      56.  00:5E45  D3 99               		out		(#99),a									; Loop si el VDP no está listo
      57.  00:5E47  FB                  		ei
      58.  00:5E48  DA 33 5E            		jp		c,VDPREADY
      59.  00:5E4B                      		
      60.  00:5E4B                      		dw		#A3ED,#A3ED,#A3ED,#A3ED	  				; 15x OUTI
