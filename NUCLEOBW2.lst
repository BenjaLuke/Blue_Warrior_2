     474.  00:4271                      ; Carga de patrones y colores del barro.
     475.  00:4271                      ; OJO: debe ir DESPUES de RUTINA_BOSS_5 para que la entrada del banco
     476.  00:4271                      ; siga empezando en RUTINA_BOSS_5. Si se coloca antes, el boss puede entrar
     477.  00:4271                      ; por esta rutina y colgarse antes de iniciar el flujo normal.
     478.  00:4271                      ; -----------------------------------------------------------------------------
     479.  00:4271                      CARGA_SPRITES_BARRO_BOSS_5:
     480.  00:4271                      		
     481.  00:4271  CD C0 6D            		call	PAGE_32_A_SEGMENT_2
     482.  00:4274                      
     483.  00:4274                      		; Los dos patrones anteriores al super disparo quedan reservados para la
     484.  00:4274                      		; explosion de impacto: 92 y 96. NO se cargan aqui: ya estan
     485.  00:4274                      		; en VRAM en el sitio adecuado.
     486.  00:4274                      		; El super disparo empieza en los patrones del barro: 100,104,108.
     487.  00:4274  21 40 9E            		ld		hl,SUPER_DISPARO
     488.  00:4277  11 20 43            		ld		de,PATRONES_SPRITES_VRAM_BOSS_5+BARRO_PATRON_INICIAL_BOSS_5*8
     489.  00:427A  01 60 00            		ld		bc,8*4*SUPER_DISPARO_CANTIDAD_BOSS_5
     490.  00:427D  CD 58 5F            		call	PON_COLOR_2.sin_bc_impuesta
     491.  00:4280                      
     492.  00:4280                              ; Los BUBBLES quedan despues del barro.
     493.  00:4280  21 00 9E                    ld      hl,SPRITE_BUBBLES
     494.  00:4283  11 A0 43                    ld      de,PATRONES_SPRITES_VRAM_BOSS_5+BUBBLES_PATRON_INICIAL_BOSS_5*8
     495.  00:4286  01 40 00                    ld      bc,8*4*BUBBLES_PATRON_CANT_BOSS_5
     496.  00:4289  CD 58 5F                    call    PON_COLOR_2.sin_bc_impuesta
     497.  00:428C                      
