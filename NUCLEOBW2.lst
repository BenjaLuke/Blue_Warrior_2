    2962.  00:6F25                      
    2963.  00:6F25  3A 0E C1            		ld		a,(CORAZONES)
    2964.  00:6F28  3D                  		dec		a
    2965.  00:6F29  32 0E C1            		ld		(CORAZONES),a
    2966.  00:6F2C  28 12               		jr		z,.MUERE_DEPH_EN_BOSS_COMUN
    2967.  00:6F2E                      
    2968.  00:6F2E  3E 03               		ld		a,3
    2969.  00:6F30  0E 01               		ld		c,1
