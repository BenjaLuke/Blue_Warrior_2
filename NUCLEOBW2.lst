    2935.  00:6EF5  C6 0F               		add		15
    2936.  00:6EF7  CD 36 5F            		call	CHANGE_BANK_2
    2937.  00:6EFA  21 00 80            		ld		hl,#8000
    2938.  00:6EFD  11 00 C0            		ld		de,#C000
    2939.  00:6F00  01 00 40            		ld		bc,16384
