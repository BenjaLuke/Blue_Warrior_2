    2367.  00:52A1                      REVISAMOS_COLISION_CON_ERRECENYX_Y_DEPH:
    2368.  00:52A1                      
    2369.  00:52A1                      		; Hitbox Errecenyx/Herrecenix reducido 20 px por cada lado.
    2370.  00:52A1                      		; Deph se sigue tratando como caja aproximada de 20x20.
    2371.  00:52A1                      		;
    2372.  00:52A1                      		; X original visible:
    2373.  00:52A1                      		;   izquierda = VARIABLE_UN_USO3
    2374.  00:52A1                      		;   ancho     = VARIABLE_UN_USO2
    2375.  00:52A1                      		;
    2376.  00:52A1                      		; X reducido:
    2377.  00:52A1                      		;   izquierda = VARIABLE_UN_USO3 + 20
    2378.  00:52A1                      		;   derecha   = VARIABLE_UN_USO3 + VARIABLE_UN_USO2 - 20
    2379.  00:52A1                      		;
    2380.  00:52A1                      		; Y original:
    2381.  00:52A1                      		;   arriba = ERRECENYX_MOVIMIENTO_Y_BOSS_4
    2382.  00:52A1                      		;   alto   = ERRECENYX_MOVIMIENTO_ALTO_BOSS_4
    2383.  00:52A1                      		;
    2384.  00:52A1                      		; Y reducido:
    2385.  00:52A1                      		;   arriba = ERRECENYX_MOVIMIENTO_Y_BOSS_4 + 20
    2386.  00:52A1                      		;   abajo  = ERRECENYX_MOVIMIENTO_Y_BOSS_4 + ERRECENYX_MOVIMIENTO_ALTO_BOSS_4 - 20
    2387.  00:52A1                      
    2388.  00:52A1  CD 9A 4E            		call	CALCULA_RECORTE_ERRECENYX_BOSS_4
    2389.  00:52A4                      
    2390.  00:52A4                      		; Si el ancho visible es 40 o menos, al meter 20 por cada lado
    2391.  00:52A4                      		; no queda hitbox real.
    2392.  00:52A4  3A AA C2            		ld		a,(VARIABLE_UN_USO2)
    2393.  00:52A7  FE 29               		cp		41
    2394.  00:52A9  D8                  		ret		c
    2395.  00:52AA                      
    2396.  00:52AA                      		; Comprueba borde izquierdo reducido:
    2397.  00:52AA                      		; Deph derecha >= Errecenyx izquierda + 20
    2398.  00:52AA  3A AB C2            		ld		a,(VARIABLE_UN_USO3)
    2399.  00:52AD  C6 14               		add		20
    2400.  00:52AF  4F                  		ld		c,a
    2401.  00:52B0  3A 64 C0            		ld		a,(X_DEPH)
    2402.  00:52B3  C6 14               		add		20
    2403.  00:52B5  B9                  		cp		c
    2404.  00:52B6  D8                  		ret		c
    2405.  00:52B7                      
    2406.  00:52B7                      		; Comprueba borde derecho reducido:
    2407.  00:52B7                      		; Deph izquierda < Errecenyx derecha - 20
    2408.  00:52B7  3A AB C2            		ld		a,(VARIABLE_UN_USO3)
    2409.  00:52BA  4F                  		ld		c,a
    2410.  00:52BB  3A AA C2            		ld		a,(VARIABLE_UN_USO2)
    2411.  00:52BE  81                  		add		c
    2412.  00:52BF  D6 14               		sub		20
    2413.  00:52C1  4F                  		ld		c,a
    2414.  00:52C2  3A 64 C0            		ld		a,(X_DEPH)
    2415.  00:52C5  B9                  		cp		c
    2416.  00:52C6  D0                  		ret		nc
    2417.  00:52C7                      
    2418.  00:52C7                      		; Comprueba borde superior reducido:
    2419.  00:52C7                      		; Deph abajo >= Errecenyx arriba + 20
    2420.  00:52C7  3A 65 C0            		ld		a,(Y_DEPH)
    2421.  00:52CA  C6 14               		add		20
    2422.  00:52CC  FE 30               		cp		ERRECENYX_MOVIMIENTO_Y_BOSS_4+20
    2423.  00:52CE  D8                  		ret		c
    2424.  00:52CF                      
    2425.  00:52CF                      		; Comprueba borde inferior reducido:
    2426.  00:52CF                      		; Deph arriba < Errecenyx abajo - 20
    2427.  00:52CF  3A 65 C0            		ld		a,(Y_DEPH)
    2428.  00:52D2  FE 46               		cp		ERRECENYX_MOVIMIENTO_Y_BOSS_4+ERRECENYX_MOVIMIENTO_ALTO_BOSS_4-20
    2429.  00:52D4  D0                  		ret		nc
