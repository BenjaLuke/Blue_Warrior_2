       1.  00:7FC5                      ; ------------------------------------------------------------
       2.  00:7FC5                      ; INICIA_MUSICA_COMUN
       3.  00:7FC5                      ;
       4.  00:7FC5                      ; Entrada:
       5.  00:7FC5                      ;   A  = banco donde está la música
       6.  00:7FC5                      ;   HL = dirección de la música
       7.  00:7FC5                      ;
       8.  00:7FC5                      ; Ejemplo:
       9.  00:7FC5                      ;   ld  a,39
      10.  00:7FC5                      ;   ld  hl,M_PUENTE
      11.  00:7FC5                      ;   call INICIA_MUSICA_COMUN
      12.  00:7FC5                      ;
      13.  00:7FC5                      ; IMPORTANTE:
      14.  00:7FC5                      ;   Esta rutina NO debe estar en el segmento que cambia
      15.  00:7FC5                      ;   CHANGE_BANK_2, porque si cambia el banco donde está
      16.  00:7FC5                      ;   ejecutándose, el MSX se pega el castañazo padre.
      17.  00:7FC5                      ; ------------------------------------------------------------
      18.  00:7FC5                      
      19.  00:7FC5  F5                  		push	af
      20.  00:7FC6  E5                  		push	hl
