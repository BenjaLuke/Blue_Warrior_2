    1781.  00:48CC                      
    1782.  00:48CC  CD D6 48            		call	ACTIVA_SPRITES_DEPH_LODO_BOSS_4
    1783.  00:48CF  CD 3A 49            		call	MOVIMIENTO_DEPH_EN_BOSS_4
    1784.  00:48D2                      		; La rutina comun puede reponer colores normales al pintar a Deph.
    1785.  00:48D2                      		; Por eso, en lodo los colores de pies se vuelcan despues del movimiento.
    1786.  00:48D2  CD 25 49            		call	CARGA_COLORES_DEPH_LODO_BOSS_4
    1787.  00:48D5  C9                  		ret
    1788.  00:48D6                      
