    1831.  00:4FAD                      REVISAMOS_COLISION_CON_AGONIX_Y_DEPH:
    1832.  00:4FAD                      
    1833.  00:4FAD                      		; Hitbox Agonix reducido 20 px por cada lado.
    1834.  00:4FAD                      		; Deph se sigue tratando como caja aproximada de 20x20.
    1835.  00:4FAD                      		;
    1836.  00:4FAD                      		; Agonix original:
    1837.  00:4FAD                      		; X = AGONIX_BOSS_1_X
    1838.  00:4FAD                      		; W = AGONIX_MOVIMIENTO_ANCHO_BOSS_1
    1839.  00:4FAD                      		; Y = AGONIX_MOVIMIENTO_Y_BOSS_1
    1840.  00:4FAD                      		; H = AGONIX_MOVIMIENTO_ALTO_BOSS_1
    1841.  00:4FAD                      		;
    1842.  00:4FAD                      		; Agonix reducido:
    1843.  00:4FAD                      		; X izquierda = X + 20
    1844.  00:4FAD                      		; X derecha   = X + ancho - 20
    1845.  00:4FAD                      		; Y arriba    = Y + 20
    1846.  00:4FAD                      		; Y abajo     = Y + alto - 20
    1847.  00:4FAD                      
    1848.  00:4FAD  3A 6A C6            		ld		a,(AGONIX_BOSS_1_X)
    1849.  00:4FB0  C6 14               		add		20
    1850.  00:4FB2  4F                  		ld		c,a
    1851.  00:4FB3  3A 55 C0            		ld		a,(X_DEPH)
    1852.  00:4FB6  C6 14               		add		20
    1853.  00:4FB8  B9                  		cp		c
    1854.  00:4FB9  D8                  		ret		c
    1855.  00:4FBA                      
    1856.  00:4FBA  3A 6A C6            		ld		a,(AGONIX_BOSS_1_X)
    1857.  00:4FBD  C6 6E               		add		AGONIX_MOVIMIENTO_ANCHO_BOSS_1-20
    1858.  00:4FBF  4F                  		ld		c,a
    1859.  00:4FC0  3A 55 C0            		ld		a,(X_DEPH)
    1860.  00:4FC3  B9                  		cp		c
    1861.  00:4FC4  D0                  		ret		nc
    1862.  00:4FC5                      
    1863.  00:4FC5  3A 56 C0            		ld		a,(Y_DEPH)
    1864.  00:4FC8  C6 14               		add		20
    1865.  00:4FCA  FE 56               		cp		AGONIX_MOVIMIENTO_Y_BOSS_1+20
    1866.  00:4FCC  D8                  		ret		c
    1867.  00:4FCD                      
    1868.  00:4FCD  3A 56 C0            		ld		a,(Y_DEPH)
    1869.  00:4FD0  FE 5E               		cp		AGONIX_MOVIMIENTO_Y_BOSS_1+AGONIX_MOVIMIENTO_ALTO_BOSS_1-20
    1870.  00:4FD2  D0                  		ret		nc
