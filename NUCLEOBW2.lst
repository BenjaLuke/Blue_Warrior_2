    2282.  00:5014  3A 1B C6                    ld      a,(ROTATIVO_CONTADOR_PRESENTACION)
    2283.  00:5017  3C                          inc     a
    2284.  00:5018  FE 03                       cp      ROTATIVO_VELOCIDAD_PRESENTACION
    2285.  00:501A  30 04                       jr      nc,.MUEVE_ROTATIVO_PRESENTACION
