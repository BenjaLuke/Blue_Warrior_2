    2589.  00:5326                      
    2590.  00:5326                      		; Tamaño destino/fuente:
    2591.  00:5326                      		; ancho fijo, altura decreciendo.
    2592.  00:5326                      
    2593.  00:5326  78                  		ld		a,b
    2594.  00:5327  FD 77 0A            		ld		(iy+10),a							; alto low = B
    2595.  00:532A  AF                  		xor		a
    2596.  00:532B  FD 77 0B            		ld		(iy+11),a							; alto high = 0
