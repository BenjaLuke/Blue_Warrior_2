     587.  00:42F7  01 10 00            		ld		bc,16
     588.  00:42FA  CD 58 5F            		call	PON_COLOR_2.sin_bc_impuesta
     589.  00:42FD  D1                  		pop		de
     590.  00:42FE  7B                  		ld		a,e
     591.  00:42FF  C6 10               		add		16
     592.  00:4301  5F                  		ld		e,a
     593.  00:4302  30 01               		jr		nc,.SIN_ACARREO_COLOR_BARRO_BOSS_4
     594.  00:4304  14                  		inc		d
