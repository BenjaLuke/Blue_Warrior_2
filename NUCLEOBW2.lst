    1738.  00:4BC9                      
    1739.  00:4BC9                      ; Calcula la X y el ancho para los rectangulos de rastro vertical.
    1740.  00:4BC9                      ; Cuando Chuminix se mueve en diagonal, el barrido de Y debe cubrir
    1741.  00:4BC9                      ; desde la X menor hasta el final derecho de la posicion mas a la derecha.
    1742.  00:4BC9                      ;
    1743.  00:4BC9                      ; Salida:
    1744.  00:4BC9                      ;   B = min(X anterior, X nueva)
    1745.  00:4BC9                      ;   D = 128 + abs(X nueva - X anterior)
    1746.  00:4BC9                      ; Conserva:
    1747.  00:4BC9                      ;   C = Y destino
    1748.  00:4BC9                      ;   E = alto
    1749.  00:4BC9                      
