      31   00:4011  ED 56                       im 	    1							                            ; Modo de interrupcion 1 
      32   00:4013                                                                                              ; (en caso de interrupcion, la rutina de servicio
      33   00:4013                                                                                              ; de interrupcion (ISR) esta en #0038		
      34   00:4013  31 00 E5                    ld 	    sp,0xE500						                        ; Colocamos la pila en esta posicion.
