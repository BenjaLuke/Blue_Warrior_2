      97.  00:5EC9                      ;LDIRVM2:																; Entra con A a 0 para las primeras 128k a escribir
      98.  00:5EC9                      																		; BIOS:	5Ch
      99.  00:5EC9                      																		; IN: HL= Dirección origen RAM
     100.  00:5EC9                      																		; DE = Dirección destino VRAM
     101.  00:5EC9                      																		; BC = Cantidad de bytes a transferir	
     102.  00:5EC9  EB                  		ex		de,hl
     103.  00:5ECA  CD DE 5E            		call	SetVdp_Write
     104.  00:5ECD  EB                  		ex		de,hl
     105.  00:5ECE  79                  		ld		a,c
     106.  00:5ECF  B7                  		or		a
     107.  00:5ED0  78                  		ld		a,b
     108.  00:5ED1  41                  		ld		b,c
     109.  00:5ED2  28 01               		jr		z,blk_VRAM_0
     110.  00:5ED4  3C                  		inc		a
