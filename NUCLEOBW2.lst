    2621.  00:4FF9                      PINTA_LETRA_MENU_ROTATIVO_PARCIAL_EN_DESTINO:
    2622.  00:4FF9                      
    2623.  00:4FF9                              ; Entrada:
    2624.  00:4FF9                              ;   A  = caracter a pintar
    2625.  00:4FF9                              ;   HL = X destino: 254, 252 o 250
    2626.  00:4FF9                              ;   DE = Y destino con page incluida
    2627.  00:4FF9                              ;
    2628.  00:4FF9                              ; Copiamos solo la parte visible de la letra:
    2629.  00:4FF9                              ;   repeticion 0 -> ancho 2
    2630.  00:4FF9                              ;   repeticion 1 -> ancho 4
    2631.  00:4FF9                              ;   repeticion 2 -> ancho 6
    2632.  00:4FF9                              ;
    2633.  00:4FF9                              ; Así respetamos la entrada progresiva sin escribir fuera de X=255.
    2634.  00:4FF9                      
