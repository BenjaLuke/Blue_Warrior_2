    2369.  00:52A7                      REVISAMOS_COLISION_CON_ERRECENYX_Y_DEPH:
    2370.  00:52A7                      
    2371.  00:52A7                      		; Hitbox Errecenyx/Herrecenix reducido 20 px por cada lado.
    2372.  00:52A7                      		; Deph se sigue tratando como caja aproximada de 20x20.
    2373.  00:52A7                      		;
    2374.  00:52A7                      		; X original visible:
    2375.  00:52A7                      		;   izquierda = VARIABLE_UN_USO3
    2376.  00:52A7                      		;   ancho     = VARIABLE_UN_USO2
    2377.  00:52A7                      		;
    2378.  00:52A7                      		; X reducido:
    2379.  00:52A7                      		;   izquierda = VARIABLE_UN_USO3 + 20
    2380.  00:52A7                      		;   derecha   = VARIABLE_UN_USO3 + VARIABLE_UN_USO2 - 20
    2381.  00:52A7                      		;
    2382.  00:52A7                      		; Y original:
    2383.  00:52A7                      		;   arriba = ERRECENYX_MOVIMIENTO_Y_BOSS_4
    2384.  00:52A7                      		;   alto   = ERRECENYX_MOVIMIENTO_ALTO_BOSS_4
    2385.  00:52A7                      		;
    2386.  00:52A7                      		; Y reducido:
    2387.  00:52A7                      		;   arriba = ERRECENYX_MOVIMIENTO_Y_BOSS_4 + 20
    2388.  00:52A7                      		;   abajo  = ERRECENYX_MOVIMIENTO_Y_BOSS_4 + ERRECENYX_MOVIMIENTO_ALTO_BOSS_4 - 20
    2389.  00:52A7                      
    2390.  00:52A7  CD 9D 4E            		call	CALCULA_RECORTE_ERRECENYX_BOSS_4
    2391.  00:52AA                      
    2392.  00:52AA                      		; Si el ancho visible es 40 o menos, al meter 20 por cada lado
    2393.  00:52AA                      		; no queda hitbox real.
    2394.  00:52AA  3A A8 C2            		ld		a,(VARIABLE_UN_USO2)
    2395.  00:52AD  FE 29               		cp		41
    2396.  00:52AF  D8                  		ret		c
    2397.  00:52B0                      
    2398.  00:52B0                      		; Comprueba borde izquierdo reducido:
    2399.  00:52B0                      		; Deph derecha >= Errecenyx izquierda + 20
    2400.  00:52B0  3A A9 C2            		ld		a,(VARIABLE_UN_USO3)
    2401.  00:52B3  C6 14               		add		20
    2402.  00:52B5  4F                  		ld		c,a
    2403.  00:52B6  3A 64 C0            		ld		a,(X_DEPH)
    2404.  00:52B9  C6 14               		add		20
    2405.  00:52BB  B9                  		cp		c
    2406.  00:52BC  D8                  		ret		c
    2407.  00:52BD                      
    2408.  00:52BD                      		; Comprueba borde derecho reducido:
    2409.  00:52BD                      		; Deph izquierda < Errecenyx derecha - 20
    2410.  00:52BD  3A A9 C2            		ld		a,(VARIABLE_UN_USO3)
    2411.  00:52C0  4F                  		ld		c,a
    2412.  00:52C1  3A A8 C2            		ld		a,(VARIABLE_UN_USO2)
    2413.  00:52C4  81                  		add		c
    2414.  00:52C5  D6 14               		sub		20
    2415.  00:52C7  4F                  		ld		c,a
    2416.  00:52C8  3A 64 C0            		ld		a,(X_DEPH)
    2417.  00:52CB  B9                  		cp		c
    2418.  00:52CC  D0                  		ret		nc
    2419.  00:52CD                      
    2420.  00:52CD                      		; Comprueba borde superior reducido:
    2421.  00:52CD                      		; Deph abajo >= Errecenyx arriba + 20
    2422.  00:52CD  3A 65 C0            		ld		a,(Y_DEPH)
    2423.  00:52D0  C6 14               		add		20
    2424.  00:52D2  FE 30               		cp		ERRECENYX_MOVIMIENTO_Y_BOSS_4+20
    2425.  00:52D4  D8                  		ret		c
    2426.  00:52D5                      
    2427.  00:52D5                      		; Comprueba borde inferior reducido:
    2428.  00:52D5                      		; Deph arriba < Errecenyx abajo - 20
    2429.  00:52D5  3A 65 C0            		ld		a,(Y_DEPH)
    2430.  00:52D8  FE 46               		cp		ERRECENYX_MOVIMIENTO_Y_BOSS_4+ERRECENYX_MOVIMIENTO_ALTO_BOSS_4-20
    2431.  00:52DA  D0                  		ret		nc
    2432.  00:52DB                      
    2433.  00:52DB  CD DF 52            		call	DANO_DEPH_EN_BOSS_4
    2434.  00:52DE  C9                  		ret
