    2320.  00:4E23  DD 36 09 00                 ld      (ix+9),0
    2321.  00:4E27  DD 36 0A 08                 ld      (ix+10),ROTATIVO_ALTO_PRESENTACION
    2322.  00:4E2B  DD 36 0B 00                 ld      (ix+11),0
