    2633.  00:4FF9                      
    2634.  00:4FF9                              ; Entrada:
    2635.  00:4FF9                              ;   A  = caracter a pintar
    2636.  00:4FF9                              ;   HL = X destino: 254, 252 o 250
    2637.  00:4FF9                              ;   DE = Y destino con page incluida
    2638.  00:4FF9                              ;
    2639.  00:4FF9                              ; Copiamos solo la parte visible de la letra:
    2640.  00:4FF9                              ;   repeticion 0 -> ancho 2
    2641.  00:4FF9                              ;   repeticion 1 -> ancho 4
    2642.  00:4FF9                              ;   repeticion 2 -> ancho 6
    2643.  00:4FF9                              ;
    2644.  00:4FF9                              ; Así respetamos la entrada progresiva sin escribir fuera de X=255.
