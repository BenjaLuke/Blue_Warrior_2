       1.  00:72D2                      ; ROMAN: PAR
       2.  00:72D2                      ;INICIAMOS_MUSICA:
       3.  00:72D2                      
       4.  00:72D2  AF                  		xor		a														;le damos 0 a la posicion de arranque de la música
