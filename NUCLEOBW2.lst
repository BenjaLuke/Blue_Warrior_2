    2369.  00:50D9                              ;
    2370.  00:50D9                              ; Copiamos solo la parte visible de la letra:
    2371.  00:50D9                              ;   repeticion 0 -> ancho 2
    2372.  00:50D9                              ;   repeticion 1 -> ancho 4
    2373.  00:50D9                              ;   repeticion 2 -> ancho 6
    2374.  00:50D9                              ;
