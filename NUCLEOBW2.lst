    2935.  00:6EAA  C6 0F               		add		15
    2936.  00:6EAC  CD 8D 5F            		call	CHANGE_BANK_2
    2937.  00:6EAF  21 00 80            		ld		hl,#8000
    2938.  00:6EB2  11 00 C0            		ld		de,#C000
    2939.  00:6EB5  01 00 40            		ld		bc,16384
