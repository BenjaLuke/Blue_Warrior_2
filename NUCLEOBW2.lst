    2240.  00:519E                      REVISAMOS_COLISION_CON_ERRECENYX_Y_DEPH:
    2241.  00:519E                      
    2242.  00:519E                      		; Hitbox Errecenyx/Herrecenix reducido 20 px por cada lado.
    2243.  00:519E                      		; Deph se sigue tratando como caja aproximada de 20x20.
    2244.  00:519E                      		;
    2245.  00:519E                      		; X original visible:
    2246.  00:519E                      		;   izquierda = VARIABLE_UN_USO3
    2247.  00:519E                      		;   ancho     = VARIABLE_UN_USO2
    2248.  00:519E                      		;
    2249.  00:519E                      		; X reducido:
    2250.  00:519E                      		;   izquierda = VARIABLE_UN_USO3 + 20
    2251.  00:519E                      		;   derecha   = VARIABLE_UN_USO3 + VARIABLE_UN_USO2 - 20
    2252.  00:519E                      		;
    2253.  00:519E                      		; Y original:
    2254.  00:519E                      		;   arriba = ERRECENYX_MOVIMIENTO_Y_BOSS_4
    2255.  00:519E                      		;   alto   = ERRECENYX_MOVIMIENTO_ALTO_BOSS_4
    2256.  00:519E                      		;
    2257.  00:519E                      		; Y reducido:
    2258.  00:519E                      		;   arriba = ERRECENYX_MOVIMIENTO_Y_BOSS_4 + 20
    2259.  00:519E                      		;   abajo  = ERRECENYX_MOVIMIENTO_Y_BOSS_4 + ERRECENYX_MOVIMIENTO_ALTO_BOSS_4 - 20
    2260.  00:519E                      
    2261.  00:519E  CD A2 4D            		call	CALCULA_RECORTE_ERRECENYX_BOSS_4
    2262.  00:51A1                      
    2263.  00:51A1                      		; Si el ancho visible es 40 o menos, al meter 20 por cada lado
    2264.  00:51A1                      		; no queda hitbox real.
    2265.  00:51A1  3A A9 C2            		ld		a,(VARIABLE_UN_USO2)
    2266.  00:51A4  FE 29               		cp		41
    2267.  00:51A6  D8                  		ret		c
    2268.  00:51A7                      
    2269.  00:51A7                      		; Comprueba borde izquierdo reducido:
    2270.  00:51A7                      		; Deph derecha >= Errecenyx izquierda + 20
    2271.  00:51A7  3A AA C2            		ld		a,(VARIABLE_UN_USO3)
    2272.  00:51AA  C6 14               		add		20
    2273.  00:51AC  4F                  		ld		c,a
    2274.  00:51AD  3A 64 C0            		ld		a,(X_DEPH)
    2275.  00:51B0  C6 14               		add		20
    2276.  00:51B2  B9                  		cp		c
    2277.  00:51B3  D8                  		ret		c
    2278.  00:51B4                      
    2279.  00:51B4                      		; Comprueba borde derecho reducido:
    2280.  00:51B4                      		; Deph izquierda < Errecenyx derecha - 20
    2281.  00:51B4  3A AA C2            		ld		a,(VARIABLE_UN_USO3)
    2282.  00:51B7  4F                  		ld		c,a
    2283.  00:51B8  3A A9 C2            		ld		a,(VARIABLE_UN_USO2)
    2284.  00:51BB  81                  		add		c
    2285.  00:51BC  D6 14               		sub		20
    2286.  00:51BE  4F                  		ld		c,a
    2287.  00:51BF  3A 64 C0            		ld		a,(X_DEPH)
    2288.  00:51C2  B9                  		cp		c
    2289.  00:51C3  D0                  		ret		nc
    2290.  00:51C4                      
    2291.  00:51C4                      		; Comprueba borde superior reducido:
    2292.  00:51C4                      		; Deph abajo >= Errecenyx arriba + 20
    2293.  00:51C4  3A 65 C0            		ld		a,(Y_DEPH)
    2294.  00:51C7  C6 14               		add		20
    2295.  00:51C9  FE 30               		cp		ERRECENYX_MOVIMIENTO_Y_BOSS_4+20
    2296.  00:51CB  D8                  		ret		c
    2297.  00:51CC                      
    2298.  00:51CC                      		; Comprueba borde inferior reducido:
    2299.  00:51CC                      		; Deph arriba < Errecenyx abajo - 20
    2300.  00:51CC  3A 65 C0            		ld		a,(Y_DEPH)
    2301.  00:51CF  FE 46               		cp		ERRECENYX_MOVIMIENTO_Y_BOSS_4+ERRECENYX_MOVIMIENTO_ALTO_BOSS_4-20
    2302.  00:51D1  D0                  		ret		nc
    2303.  00:51D2                      
    2304.  00:51D2  CD D6 51            		call	DANO_DEPH_EN_BOSS_4
    2305.  00:51D5  C9                  		ret
