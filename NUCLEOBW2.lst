    2187.  00:4D8B                      TEXTO_CINEMATICA_1_1:
    2188.  00:4D8B                      		db		"The story of Gamourla isn't exactly as ",0
    2188.  00:4D8B  54 68 65 20 73 74 6F 72 79 20 6F 66 20 47 61 6D 
    2188.  00:4D9B  6F 75 72 6C 61 20 69 73 6E 27 74 20 65 78 61 63 
    2188.  00:4DAB  74 6C 79 20 61 73 20 00 
    2189.  00:4DB3                      TEXTO_CINEMATICA_1_2:
    2190.  00:4DB3                      		db		"you were told. Although it's a ",0
    2190.  00:4DB3  79 6F 75 20 77 65 72 65 20 74 6F 6C 64 2E 20 41 
    2190.  00:4DC3  6C 74 68 6F 75 67 68 20 69 74 27 73 20 61 20 00 
    2191.  00:4DD3                      TEXTO_CINEMATICA_1_3:
    2192.  00:4DD3                      		db		"prosperous village, the fear of the past",0
    2192.  00:4DD3  70 72 6F 73 70 65 72 6F 75 73 20 76 69 6C 6C 61 
    2192.  00:4DE3  67 65 2C 20 74 68 65 20 66 65 61 72 20 6F 66 20 
    2192.  00:4DF3  74 68 65 20 70 61 73 74 00 
    2193.  00:4DFC                      TEXTO_CINEMATICA_1_4:
    2194.  00:4DFC                      		db		"still lingers.",0
    2194.  00:4DFC  73 74 69 6C 6C 20 6C 69 6E 67 65 72 73 2E 00 
    2195.  00:4E0B                      
    2196.  00:4E0B                      TEXTO_CINEMATICA_2_1:
    2197.  00:4E0B                      		db		"And Deph Kurgan, hero of past ",0
    2197.  00:4E0B  41 6E 64 20 44 65 70 68 20 4B 75 72 67 61 6E 2C 
    2197.  00:4E1B  20 68 65 72 6F 20 6F 66 20 70 61 73 74 20 00 
    2198.  00:4E2A                      TEXTO_CINEMATICA_2_2:
    2199.  00:4E2A                      		db		"adventures, feels in his bones how",0
    2199.  00:4E2A  61 64 76 65 6E 74 75 72 65 73 2C 20 66 65 65 6C 
    2199.  00:4E3A  73 20 69 6E 20 68 69 73 20 62 6F 6E 65 73 20 68 
    2199.  00:4E4A  6F 77 00 
    2200.  00:4E4D                      TEXTO_CINEMATICA_2_3:
    2201.  00:4E4D                      		db		"evil is approaching once more.",0
    2201.  00:4E4D  65 76 69 6C 20 69 73 20 61 70 70 72 6F 61 63 68 
    2201.  00:4E5D  69 6E 67 20 6F 6E 63 65 20 6D 6F 72 65 2E 00 
    2202.  00:4E6C                      TEXTO_CINEMATICA_2_4:
    2203.  00:4E6C  20 20 20 00         		db		"   ",0
    2204.  00:4E70                      
    2205.  00:4E70                      TEXTO_CINEMATICA_3_1:
    2206.  00:4E70                      		db		"And one night, his worst nightmares come",0
    2206.  00:4E70  41 6E 64 20 6F 6E 65 20 6E 69 67 68 74 2C 20 68 
    2206.  00:4E80  69 73 20 77 6F 72 73 74 20 6E 69 67 68 74 6D 61 
    2206.  00:4E90  72 65 73 20 63 6F 6D 65 00 
    2207.  00:4E99                      TEXTO_CINEMATICA_3_2:
    2208.  00:4E99                      		db		"true. Lord Adder floods the sky,",0
    2208.  00:4E99  74 72 75 65 2E 20 4C 6F 72 64 20 41 64 64 65 72 
    2208.  00:4EA9  20 66 6C 6F 6F 64 73 20 74 68 65 20 73 6B 79 2C 
    2208.  00:4EB9  00 
    2209.  00:4EBA                      TEXTO_CINEMATICA_3_3:
    2210.  00:4EBA                      		db		"threatening the crops and the lives of",0
    2210.  00:4EBA  74 68 72 65 61 74 65 6E 69 6E 67 20 74 68 65 20 
    2210.  00:4ECA  63 72 6F 70 73 20 61 6E 64 20 74 68 65 20 6C 69 
    2210.  00:4EDA  76 65 73 20 6F 66 00 
    2211.  00:4EE1                      TEXTO_CINEMATICA_3_4:
    2212.  00:4EE1                      		db		"the villagers.",0
    2212.  00:4EE1  74 68 65 20 76 69 6C 6C 61 67 65 72 73 2E 00 
    2213.  00:4EF0                      
    2214.  00:4EF0                      TEXTO_CINEMATICA_4_1:
    2215.  00:4EF0                      		db		"But Deph isn't intimidated by this",0				  	
    2215.  00:4EF0  42 75 74 20 44 65 70 68 20 69 73 6E 27 74 20 69 
    2215.  00:4F00  6E 74 69 6D 69 64 61 74 65 64 20 62 79 20 74 68 
    2215.  00:4F10  69 73 00 
    2216.  00:4F13                      TEXTO_CINEMATICA_4_2:
    2217.  00:4F13                      		db		"apocalyptic vision. He knows what he has",0
    2217.  00:4F13  61 70 6F 63 61 6C 79 70 74 69 63 20 76 69 73 69 
    2217.  00:4F23  6F 6E 2E 20 48 65 20 6B 6E 6F 77 73 20 77 68 61 
    2217.  00:4F33  74 20 68 65 20 68 61 73 00 
    2218.  00:4F3C                      TEXTO_CINEMATICA_4_3:
    2219.  00:4F3C                      		db		"to do. He's done it before.",0
    2219.  00:4F3C  74 6F 20 64 6F 2E 20 48 65 27 73 20 64 6F 6E 65 
    2219.  00:4F4C  20 69 74 20 62 65 66 6F 72 65 2E 00 
    2220.  00:4F58                      TEXTO_CINEMATICA_4_4:
    2221.  00:4F58  20 20 20 00         		db		"   ",0
    2222.  00:4F5C                      
    2223.  00:4F5C                      TEXTO_CINEMATICA_5_1:
    2224.  00:4F5C                      		db		"Deph will obtain the Earth Goddess Stone",0
    2224.  00:4F5C  44 65 70 68 20 77 69 6C 6C 20 6F 62 74 61 69 6E 
    2224.  00:4F6C  20 74 68 65 20 45 61 72 74 68 20 47 6F 64 64 65 
    2224.  00:4F7C  73 73 20 53 74 6F 6E 65 00 
    2225.  00:4F85                      TEXTO_CINEMATICA_5_2:
    2226.  00:4F85                      		db		"to stop Lord Adder. But this time, he",0
    2226.  00:4F85  74 6F 20 73 74 6F 70 20 4C 6F 72 64 20 41 64 64 
    2226.  00:4F95  65 72 2E 20 42 75 74 20 74 68 69 73 20 74 69 6D 
    2226.  00:4FA5  65 2C 20 68 65 00 
    2227.  00:4FAB                      TEXTO_CINEMATICA_5_3:
    2228.  00:4FAB                      		db		"will also obtain the sacred Diamond that",0
    2228.  00:4FAB  77 69 6C 6C 20 61 6C 73 6F 20 6F 62 74 61 69 6E 
    2228.  00:4FBB  20 74 68 65 20 73 61 63 72 65 64 20 44 69 61 6D 
    2228.  00:4FCB  6F 6E 64 20 74 68 61 74 00 
    2229.  00:4FD4                      TEXTO_CINEMATICA_5_4:
    2230.  00:4FD4                      		db		"will break the cycle.",0
    2230.  00:4FD4  77 69 6C 6C 20 62 72 65 61 6B 20 74 68 65 20 63 
    2230.  00:4FE4  79 63 6C 65 2E 00 
    2231.  00:4FEA                      
    2232.  00:4FEA  (00:00C3)           ROTATIVO_Y_PRESENTACION                  equ     195
    2233.  00:4FEA                      
    2234.  00:4FEA                      ; Cada cuántos frames se actualiza el rotativo.
    2235.  00:4FEA                      ; 1 = cada frame, 2 = cada dos frames, etc.
    2236.  00:4FEA  (00:0003)           ROTATIVO_VELOCIDAD_PRESENTACION          equ     3
    2237.  00:4FEA                      
    2238.  00:4FEA                      ; El nuevo rotativo avanza copiando la franja 2 píxeles a la izquierda.
    2239.  00:4FEA                      ; Cada letra mide 6 píxeles, así que se introduce en 3 pasos:
    2240.  00:4FEA                      ;   paso 0 -> X=254
    2241.  00:4FEA                      ;   paso 1 -> X=252
    2242.  00:4FEA                      ;   paso 2 -> X=250
    2243.  00:4FEA  (00:0002)           ROTATIVO_PIXELES_POR_PASO_PRESENTACION   equ     2
    2244.  00:4FEA  (00:0003)           ROTATIVO_PASOS_POR_LETRA_PRESENTACION    equ     3
    2245.  00:4FEA  (00:00FE)           ROTATIVO_X_ENTRADA_PRESENTACION          equ     254
    2246.  00:4FEA  (00:00FE)           ROTATIVO_ANCHO_SCROLL_PRESENTACION       equ     254
    2247.  00:4FEA  (00:0008)           ROTATIVO_ALTO_PRESENTACION               equ     8
    2248.  00:4FEA                      
    2249.  00:4FEA                      ; Cuando se acaba el texto, metemos espacios hasta que toda la cola sale
    2250.  00:4FEA                      ; por la izquierda. 43 espacios * 6 píxeles = 258 píxeles.
    2251.  00:4FEA  (00:002B)           ROTATIVO_ESPACIOS_SALIDA_PRESENTACION    equ     43
    2252.  00:4FEA                      
    2253.  00:4FEA                      
    2254.  00:4FEA                      INICIALIZA_ROTATIVO_PRESENTACION:
    2255.  00:4FEA                      
    2256.  00:4FEA  AF                          xor     a
    2257.  00:4FEB  32 0C C6                    ld      (ROTATIVO_CONTADOR_PRESENTACION),a
    2258.  00:4FEE  32 0D C6                    ld      (ROTATIVO_PAGINA_VISIBLE_PRESENTACION),a
    2259.  00:4FF1  32 10 C6                    ld      (ROTATIVO_REPETICION_LETRA_PRESENTACION),a
    2260.  00:4FF4  32 11 C6                    ld      (ROTATIVO_MODO_SALIDA_PRESENTACION),a
    2261.  00:4FF7                      
    2262.  00:4FF7  3E 2B                       ld      a,ROTATIVO_ESPACIOS_SALIDA_PRESENTACION
    2263.  00:4FF9  32 12 C6                    ld      (ROTATIVO_PASOS_SALIDA_PRESENTACION),a
    2264.  00:4FFC                      
    2265.  00:4FFC  21 C9 51                    ld      hl,TEXTO_ROTATIVO_PRESENTACION
    2266.  00:4FFF  22 0E C6                    ld      (ROTATIVO_PUNTERO_TEXTO_PRESENTACION),hl
    2267.  00:5002                      
    2268.  00:5002                              ; Dejamos limpia la franja en las dos páginas. Así el primer paso
    2269.  00:5002                              ; parte de una zona negra y la página oculta no hereda basura.
    2270.  00:5002                      
    2271.  00:5002  21 AB 51                    ld      hl,DATOS_NEGRO_ROTATIVO_EN_PAGE_0
    2272.  00:5005  CD 2A 5E                    call    DOCOPY
    2273.  00:5008  CD 33 5E                    call    VDPREADY
    2274.  00:500B                      
    2275.  00:500B  21 BA 51                    ld      hl,DATOS_NEGRO_ROTATIVO_EN_PAGE_1
    2276.  00:500E  CD 2A 5E                    call    DOCOPY
    2277.  00:5011  C3 33 5E                    jp      VDPREADY
    2278.  00:5014                      
    2279.  00:5014                      
    2280.  00:5014                      ACTUALIZA_ROTATIVO_PRESENTACION:
    2281.  00:5014                      
    2282.  00:5014  3A 0C C6                    ld      a,(ROTATIVO_CONTADOR_PRESENTACION)
    2283.  00:5017  3C                          inc     a
    2284.  00:5018  FE 03                       cp      ROTATIVO_VELOCIDAD_PRESENTACION
    2285.  00:501A  30 04                       jr      nc,.MUEVE_ROTATIVO_PRESENTACION
    2286.  00:501C                      
    2287.  00:501C  32 0C C6                    ld      (ROTATIVO_CONTADOR_PRESENTACION),a
    2288.  00:501F  C9                          ret
    2289.  00:5020                      
    2290.  00:5020                      
    2291.  00:5020                      .MUEVE_ROTATIVO_PRESENTACION:
    2292.  00:5020                      
    2293.  00:5020  AF                          xor     a
    2294.  00:5021  32 0C C6                    ld      (ROTATIVO_CONTADOR_PRESENTACION),a
    2295.  00:5024                      
    2296.  00:5024                              ; 1 - Copiamos el rotativo ya visible hacia la página oculta,
    2297.  00:5024                              ;     desplazándolo 2 píxeles a la izquierda.
    2298.  00:5024                              ;     OJO: se usa la visible como origen para que el doble buffer
    2299.  00:5024                              ;     no vaya alternando dos estados distintos del scroll.
    2300.  00:5024                      
    2301.  00:5024  CD 3F 50                    call    COPIA_SCROLL_ROTATIVO_A_PAGE_OCULTA
    2302.  00:5027                      
    2303.  00:5027                              ; 2 - Borramos en la página oculta la parte derecha que ha quedado libre.
    2304.  00:5027                      
    2305.  00:5027  CD 90 50                    call    BORRA_DERECHA_ROTATIVO_EN_PAGE_OCULTA
    2306.  00:502A                      
    2307.  00:502A                              ; 3 - Pintamos la letra que toca. La misma letra se pinta 3 veces,
    2308.  00:502A                              ;     cada vez 2 píxeles más a la izquierda: 254, 252 y 250.
    2309.  00:502A                      
    2310.  00:502A  CD DD 50                    call    PINTA_ENTRADA_LETRA_ROTATIVO
    2311.  00:502D                      
    2312.  00:502D                              ; 4 - Mostramos la página que acabamos de preparar.
    2313.  00:502D                      
    2314.  00:502D  C3 9C 51                    jp      MUESTRA_PAGE_OCULTA_ROTATIVO
    2315.  00:5030                      
    2316.  00:5030                      
    2317.  00:5030                      OBTIENE_PAGE_OCULTA_ROTATIVO:
    2318.  00:5030                      
    2319.  00:5030  3A 0D C6                    ld      a,(ROTATIVO_PAGINA_VISIBLE_PRESENTACION)
    2320.  00:5033  EE 01                       xor     1
    2321.  00:5035  C9                          ret
    2322.  00:5036                      
    2323.  00:5036                      
    2324.  00:5036                      OBTIENE_Y_ROTATIVO_DESDE_A_EN_HL:
    2325.  00:5036                      
    2326.  00:5036  B7                          or      a
    2327.  00:5037  21 C3 00                    ld      hl,ROTATIVO_Y_PRESENTACION
    2328.  00:503A  C8                          ret     z
    2329.  00:503B  21 C3 01                    ld      hl,#0100+ROTATIVO_Y_PRESENTACION
    2330.  00:503E  C9                          ret
    2331.  00:503F                      
    2332.  00:503F                      
    2333.  00:503F                      COPIA_SCROLL_ROTATIVO_A_PAGE_OCULTA:
    2334.  00:503F                      
    2335.  00:503F  DD 21 13 C6                 ld      ix,DATOS_COPY_SCROLL_ROTATIVO_PRESENTACION
    2336.  00:5043                      
    2337.  00:5043                              ; Origen X = 2.
    2338.  00:5043                      
    2339.  00:5043  DD 36 00 02                 ld      (ix+0),2
    2340.  00:5047  DD 36 01 00                 ld      (ix+1),0
    2341.  00:504B                      
    2342.  00:504B                              ; Origen Y = página actualmente visible + Y del rotativo.
    2343.  00:504B                      
    2344.  00:504B  3A 0D C6                    ld      a,(ROTATIVO_PAGINA_VISIBLE_PRESENTACION)
    2345.  00:504E  CD 36 50                    call    OBTIENE_Y_ROTATIVO_DESDE_A_EN_HL
    2346.  00:5051  DD 75 02                    ld      (ix+2),l
    2347.  00:5054  DD 74 03                    ld      (ix+3),h
    2348.  00:5057                      
    2349.  00:5057                              ; Destino X = 0.
    2350.  00:5057                      
    2351.  00:5057  DD 36 04 00                 ld      (ix+4),0
    2352.  00:505B  DD 36 05 00                 ld      (ix+5),0
    2353.  00:505F                      
    2354.  00:505F                              ; Destino Y = página oculta + Y del rotativo.
    2355.  00:505F                      
    2356.  00:505F  CD 30 50                    call    OBTIENE_PAGE_OCULTA_ROTATIVO
    2357.  00:5062  CD 36 50                    call    OBTIENE_Y_ROTATIVO_DESDE_A_EN_HL
    2358.  00:5065  DD 75 06                    ld      (ix+6),l
    2359.  00:5068  DD 74 07                    ld      (ix+7),h
    2360.  00:506B                      
    2361.  00:506B                              ; Ancho = 254, alto = 8, comando HMMM.
    2362.  00:506B                      
    2363.  00:506B  DD 36 08 FE                 ld      (ix+8),ROTATIVO_ANCHO_SCROLL_PRESENTACION
    2364.  00:506F  DD 36 09 00                 ld      (ix+9),0
    2365.  00:5073  DD 36 0A 08                 ld      (ix+10),ROTATIVO_ALTO_PRESENTACION
    2366.  00:5077  DD 36 0B 00                 ld      (ix+11),0
    2367.  00:507B  DD 36 0C 00                 ld      (ix+12),#00
    2368.  00:507F  DD 36 0D 00                 ld      (ix+13),#00
    2369.  00:5083  DD 36 0E D0                 ld      (ix+14),11010000b
    2370.  00:5087                      
    2371.  00:5087  21 13 C6                    ld      hl,DATOS_COPY_SCROLL_ROTATIVO_PRESENTACION
    2372.  00:508A  CD 2A 5E                    call    DOCOPY
    2373.  00:508D  C3 33 5E                    jp      VDPREADY
    2374.  00:5090                      
    2375.  00:5090                      
    2376.  00:5090                      BORRA_DERECHA_ROTATIVO_EN_PAGE_OCULTA:
