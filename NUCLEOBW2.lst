    1603.  00:4B76                      MUEVE_X_HACIA_DEPH_CHUMINIX_BOSS_3:
    1604.  00:4B76                      
    1605.  00:4B76                      ; ---------------------------------------------------------
    1606.  00:4B76                      ; Primero calculamos el objetivo:
    1607.  00:4B76                      ; objetivo = X_DEPH - 48, pero evitando underflow
    1608.  00:4B76                      ; y limitado entre X_MIN y X_MAX
    1609.  00:4B76                      ; ---------------------------------------------------------
    1610.  00:4B76                      
    1611.  00:4B76  3A 64 C0            		ld		a,(X_DEPH)
    1612.  00:4B79  FE 30               		cp		48
    1613.  00:4B7B  30 04               		jr		nc,.RESTA_OFFSET_X_DEPH_CHUMINIX_BOSS_3
    1614.  00:4B7D                      
