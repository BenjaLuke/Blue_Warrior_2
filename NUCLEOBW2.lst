    2614.  00:5351                      
    2615.  00:5351                      		; Tamaño destino/fuente:
    2616.  00:5351                      		; ancho fijo, altura decreciendo.
    2617.  00:5351                      
    2618.  00:5351  78                  		ld		a,b
    2619.  00:5352  FD 77 0A            		ld		(iy+10),a							; alto low = B
    2620.  00:5355  AF                  		xor		a
    2621.  00:5356  FD 77 0B            		ld		(iy+11),a							; alto high = 0
