    2464.  00:5313                      REVISAMOS_COLISION_CON_ERRECENYX_Y_DEPH:
    2465.  00:5313                      
    2466.  00:5313                      		; Hitbox Errecenyx/Herrecenix reducido 20 px por cada lado.
    2467.  00:5313                      		; Deph se sigue tratando como caja aproximada de 20x20.
    2468.  00:5313                      		;
    2469.  00:5313                      		; X original visible:
    2470.  00:5313                      		;   izquierda = VARIABLE_UN_USO3
    2471.  00:5313                      		;   ancho     = VARIABLE_UN_USO2
    2472.  00:5313                      		;
    2473.  00:5313                      		; X reducido:
    2474.  00:5313                      		;   izquierda = VARIABLE_UN_USO3 + 20
    2475.  00:5313                      		;   derecha   = VARIABLE_UN_USO3 + VARIABLE_UN_USO2 - 20
    2476.  00:5313                      		;
    2477.  00:5313                      		; Y original:
    2478.  00:5313                      		;   arriba = ERRECENYX_MOVIMIENTO_Y_BOSS_4
    2479.  00:5313                      		;   alto   = ERRECENYX_MOVIMIENTO_ALTO_BOSS_4
    2480.  00:5313                      		;
    2481.  00:5313                      		; Y reducido:
    2482.  00:5313                      		;   arriba = ERRECENYX_MOVIMIENTO_Y_BOSS_4 + 20
    2483.  00:5313                      		;   abajo  = ERRECENYX_MOVIMIENTO_Y_BOSS_4 + ERRECENYX_MOVIMIENTO_ALTO_BOSS_4 - 20
    2484.  00:5313                      
    2485.  00:5313  CD 17 4F            		call	CALCULA_RECORTE_ERRECENYX_BOSS_4
    2486.  00:5316                      
    2487.  00:5316                      		; Si el ancho visible es 40 o menos, al meter 20 por cada lado
    2488.  00:5316                      		; no queda hitbox real.
    2489.  00:5316  3A A7 C2            		ld		a,(VARIABLE_UN_USO2)
    2490.  00:5319  FE 29               		cp		41
    2491.  00:531B  D8                  		ret		c
    2492.  00:531C                      
    2493.  00:531C                      		; Comprueba borde izquierdo reducido:
    2494.  00:531C                      		; Deph derecha >= Errecenyx izquierda + 20
    2495.  00:531C  3A A8 C2            		ld		a,(VARIABLE_UN_USO3)
    2496.  00:531F  C6 14               		add		20
    2497.  00:5321  4F                  		ld		c,a
    2498.  00:5322  3A 64 C0            		ld		a,(X_DEPH)
    2499.  00:5325  C6 14               		add		20
    2500.  00:5327  B9                  		cp		c
    2501.  00:5328  D8                  		ret		c
    2502.  00:5329                      
    2503.  00:5329                      		; Comprueba borde derecho reducido:
    2504.  00:5329                      		; Deph izquierda < Errecenyx derecha - 20
    2505.  00:5329  3A A8 C2            		ld		a,(VARIABLE_UN_USO3)
    2506.  00:532C  4F                  		ld		c,a
    2507.  00:532D  3A A7 C2            		ld		a,(VARIABLE_UN_USO2)
    2508.  00:5330  81                  		add		c
    2509.  00:5331  D6 14               		sub		20
    2510.  00:5333  4F                  		ld		c,a
    2511.  00:5334  3A 64 C0            		ld		a,(X_DEPH)
    2512.  00:5337  B9                  		cp		c
    2513.  00:5338  D0                  		ret		nc
    2514.  00:5339                      
    2515.  00:5339                      		; Comprueba borde superior reducido:
    2516.  00:5339                      		; Deph abajo >= Errecenyx arriba + 20
    2517.  00:5339  3A 65 C0            		ld		a,(Y_DEPH)
    2518.  00:533C  C6 14               		add		20
    2519.  00:533E  FE 30               		cp		ERRECENYX_MOVIMIENTO_Y_BOSS_4+20
    2520.  00:5340  D8                  		ret		c
    2521.  00:5341                      
    2522.  00:5341                      		; Comprueba borde inferior reducido:
    2523.  00:5341                      		; Deph arriba < Errecenyx abajo - 20
    2524.  00:5341  3A 65 C0            		ld		a,(Y_DEPH)
    2525.  00:5344  FE 46               		cp		ERRECENYX_MOVIMIENTO_Y_BOSS_4+ERRECENYX_MOVIMIENTO_ALTO_BOSS_4-20
    2526.  00:5346  D0                  		ret		nc
    2527.  00:5347                      
    2528.  00:5347  CD 4B 53            		call	DANO_DEPH_EN_BOSS_4
    2529.  00:534A  C9                  		ret
