       1.  00:7FCE                      ; ------------------------------------------------------------
       2.  00:7FCE                      ; INICIA_MUSICA_COMUN
       3.  00:7FCE                      ;
       4.  00:7FCE                      ; Entrada:
       5.  00:7FCE                      ;   A  = banco donde está la música
       6.  00:7FCE                      ;   HL = dirección de la música
       7.  00:7FCE                      ;
       8.  00:7FCE                      ; Ejemplo:
       9.  00:7FCE                      ;   ld  a,39
      10.  00:7FCE                      ;   ld  hl,M_PUENTE
      11.  00:7FCE                      ;   call INICIA_MUSICA_COMUN
      12.  00:7FCE                      ;
      13.  00:7FCE                      ; IMPORTANTE:
      14.  00:7FCE                      ;   Esta rutina NO debe estar en el segmento que cambia
      15.  00:7FCE                      ;   CHANGE_BANK_2, porque si cambia el banco donde está
      16.  00:7FCE                      ;   ejecutándose, el MSX se pega el castañazo padre.
      17.  00:7FCE                      ; ------------------------------------------------------------
      18.  00:7FCE                      
      19.  00:7FCE  F5                  		push	af
      20.  00:7FCF  E5                  		push	hl
