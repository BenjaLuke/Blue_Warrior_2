     545.  00:42C6                      ; -----------------------------------------------------------------------------
     546.  00:42C6                      ; Carga de patrones y colores del barro.
     547.  00:42C6                      ; OJO: debe ir DESPUES de RUTINA_BOSS_4 para que la entrada del banco
     548.  00:42C6                      ; siga empezando en RUTINA_BOSS_4. Si se coloca antes, el boss puede entrar
     549.  00:42C6                      ; por esta rutina y colgarse antes de iniciar el flujo normal.
     550.  00:42C6                      ; -----------------------------------------------------------------------------
     551.  00:42C6                      CARGA_SPRITES_BARRO_BOSS_4:
     552.  00:42C6                      		
     553.  00:42C6  CD A4 6D            		call	PAGE_32_A_SEGMENT_2
     554.  00:42C9                      
     555.  00:42C9                      		; Los dos patrones anteriores al barro quedan reservados para la
     556.  00:42C9                      		; explosion de impacto: 92 y 96. NO se cargan aqui: ya estan
     557.  00:42C9                      		; en VRAM en el sitio adecuado.
     558.  00:42C9                      		; Barro empieza en 100: 100,104,108,112.
     559.  00:42C9  21 60 97            		ld		hl,SPRITE_BARRO
     560.  00:42CC  11 20 43            		ld		de,PATRONES_SPRITES_VRAM_BOSS_4+BARRO_PATRON_INICIAL_BOSS_4*8
     561.  00:42CF  01 80 00            		ld		bc,8*4*BARRO_CANTIDAD_BOSS_4
     562.  00:42D2  CD 99 5F            		call	PON_COLOR_2.sin_bc_impuesta
     563.  00:42D5                      
     564.  00:42D5                      		; Los COVIDs se cargan despues de los cuatro patrones de barro:
     565.  00:42D5                      		; COVID queda en 116 y 120.
     566.  00:42D5  21 00 92            		ld		hl,SPRITES_COVID
     567.  00:42D8  11 A0 43            		ld		de,PATRONES_SPRITES_VRAM_BOSS_4+COVID_PATRON_INICIAL_BOSS_4*8
     568.  00:42DB  01 40 00            		ld		bc,8*4*COVID_PATRON_CANT_BOSS_4
     569.  00:42DE  CD 99 5F            		call	PON_COLOR_2.sin_bc_impuesta
     570.  00:42E1                      
     571.  00:42E1                              ; Los BUBBLES se cargan despues de los COVIDs:
     572.  00:42E1                              ; BUBBLES queda en 124 y 128.
     573.  00:42E1  21 E0 97                    ld      hl,SPRITE_BUBBLES
     574.  00:42E4  11 E0 43                    ld      de,PATRONES_SPRITES_VRAM_BOSS_4+BUBBLES_PATRON_INICIAL_BOSS_4*8
     575.  00:42E7  01 40 00                    ld      bc,8*4*BUBBLES_PATRON_CANT_BOSS_4
     576.  00:42EA  CD 99 5F                    call    PON_COLOR_2.sin_bc_impuesta
     577.  00:42ED                      
     578.  00:42ED                      		; El color de sprites en SCREEN 7 va por NUMERO DE SPRITE,
     579.  00:42ED                      		; no por patron. Los proyectiles usan los sprites 22-29,
