    1803.  00:4F53                      REVISAMOS_COLISION_CON_AGONIX_Y_DEPH:
    1804.  00:4F53                      
    1805.  00:4F53                      		; Hitbox Agonix reducido 20 px por cada lado.
    1806.  00:4F53                      		; Deph se sigue tratando como caja aproximada de 20x20.
    1807.  00:4F53                      		;
    1808.  00:4F53                      		; Agonix original:
    1809.  00:4F53                      		; X = AGONIX_BOSS_1_X
    1810.  00:4F53                      		; W = AGONIX_MOVIMIENTO_ANCHO_BOSS_1
    1811.  00:4F53                      		; Y = AGONIX_MOVIMIENTO_Y_BOSS_1
    1812.  00:4F53                      		; H = AGONIX_MOVIMIENTO_ALTO_BOSS_1
    1813.  00:4F53                      		;
    1814.  00:4F53                      		; Agonix reducido:
    1815.  00:4F53                      		; X izquierda = X + 20
    1816.  00:4F53                      		; X derecha   = X + ancho - 20
    1817.  00:4F53                      		; Y arriba    = Y + 20
    1818.  00:4F53                      		; Y abajo     = Y + alto - 20
    1819.  00:4F53                      
    1820.  00:4F53  3A 79 C6            		ld		a,(AGONIX_BOSS_1_X)
    1821.  00:4F56  C6 14               		add		20
    1822.  00:4F58  4F                  		ld		c,a
    1823.  00:4F59  3A 64 C0            		ld		a,(X_DEPH)
    1824.  00:4F5C  C6 14               		add		20
    1825.  00:4F5E  B9                  		cp		c
    1826.  00:4F5F  D8                  		ret		c
    1827.  00:4F60                      
    1828.  00:4F60  3A 79 C6            		ld		a,(AGONIX_BOSS_1_X)
    1829.  00:4F63  C6 6E               		add		AGONIX_MOVIMIENTO_ANCHO_BOSS_1-20
    1830.  00:4F65  4F                  		ld		c,a
    1831.  00:4F66  3A 64 C0            		ld		a,(X_DEPH)
    1832.  00:4F69  B9                  		cp		c
    1833.  00:4F6A  D0                  		ret		nc
    1834.  00:4F6B                      
    1835.  00:4F6B  3A 65 C0            		ld		a,(Y_DEPH)
    1836.  00:4F6E  C6 14               		add		20
    1837.  00:4F70  FE 56               		cp		AGONIX_MOVIMIENTO_Y_BOSS_1+20
    1838.  00:4F72  D8                  		ret		c
    1839.  00:4F73                      
    1840.  00:4F73  3A 65 C0            		ld		a,(Y_DEPH)
    1841.  00:4F76  FE 5E               		cp		AGONIX_MOVIMIENTO_Y_BOSS_1+AGONIX_MOVIMIENTO_ALTO_BOSS_1-20
    1842.  00:4F78  D0                  		ret		nc
