    2228.  00:4F89  74 6F 20 73 74 6F 70 20 4C 6F 72 64 20 41 64 64 
    2228.  00:4F99  65 72 2E 20 42 75 74 20 74 68 69 73 20 74 69 6D 
    2228.  00:4FA9  65 2C 20 68 65 00 
    2229.  00:4FAF                      TEXTO_CINEMATICA_5_3:
    2230.  00:4FAF                      		db		"will also obtain the sacred Diamond that",0
    2230.  00:4FAF  77 69 6C 6C 20 61 6C 73 6F 20 6F 62 74 61 69 6E 
    2230.  00:4FBF  20 74 68 65 20 73 61 63 72 65 64 20 44 69 61 6D 
    2230.  00:4FCF  6F 6E 64 20 74 68 61 74 00 
    2231.  00:4FD8                      TEXTO_CINEMATICA_5_4:
