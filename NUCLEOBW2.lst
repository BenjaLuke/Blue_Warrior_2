     268.  00:7093                      
     269.  00:7093  ED 79               		OUT [C],A
     270.  00:7095  0C                  		INC C
     271.  00:7096  ED A3               		OUTI 
     272.  00:7098  0D                  		DEC C
     273.  00:7099  3C                  		INC A
     274.  00:709A  FE 0D               		CP 13
     275.  00:709C  20 F5               		JR NZ,ROUT_A0.LOUT
     276.  00:709E  ED 79               		OUT [C],A
     277.  00:70A0  7E                  		LD A,[HL]
     278.  00:70A1                      	
