    2958.  00:6ED2  3E 03               		ld		a,3
    2959.  00:6ED4  0E 01               		ld		c,1
    2960.  00:6ED6  CD 8F 6D            		call	A_31_DESDE_10
    2961.  00:6ED9                      
    2962.  00:6ED9  3E 96               		ld		a,150
    2963.  00:6EDB  32 21 C1            		ld		(INMUNE),a
