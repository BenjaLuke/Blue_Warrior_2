    1769.  00:48CA                      ; -----------------------------------------------------------------------------
    1770.  00:48CA                      ; Control del lodo en Boss 4 por coordenada Y.
    1771.  00:48CA                      ; Si Y_DEPH < 85: sprites normales y movimiento normal.
    1772.  00:48CA                      ; Si Y_DEPH >= 85: sprites de pies en lodo.
    1773.  00:48CA                      ;
    1774.  00:48CA                      ; IMPORTANTE:
    1775.  00:48CA                      ; La rutina comun de movimiento debe ejecutarse SIEMPRE.
    1776.  00:48CA                      ; Las pruebas anteriores que saltaban MOVIMIENTO_DEPH_EN_BOSS_4 o restauraban X/Y
    1777.  00:48CA                      ; dejaban a Deph bloqueado o descolocaban sus limites internos.
    1778.  00:48CA                      ; Aqui no tocamos coordenadas, no restauramos posiciones y no cortamos el flujo.
    1779.  00:48CA                      ; -----------------------------------------------------------------------------
    1780.  00:48CA                      CONTROL_LODO_Y_MOVIMIENTO_DEPH_BOSS_4:
    1781.  00:48CA                      
