    1141.  00:648A  0E 9B               		ld c,$9B
    1142.  00:648C                      		
    1143.  00:648C                      		REPEAT 11
    1144.  00:648C                    < 		outi 															;ejecutamos 11 outi uno por cada registro
    1145.  00:648C                    < 		ENDREPEAT
