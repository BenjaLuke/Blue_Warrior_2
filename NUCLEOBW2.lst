    2426.  00:4ED2  DD 75 04                    ld      (ix+4),l
    2427.  00:4ED5  DD 74 05                    ld      (ix+5),h
    2428.  00:4ED8                      
    2429.  00:4ED8  3A 1B C6                    ld      a,(ROTATIVO_REPETICION_LETRA_PRESENTACION)
    2430.  00:4EDB  3C                          inc     a
    2431.  00:4EDC  87                          add     a,a
    2432.  00:4EDD  DD 77 08                    ld      (ix+8),a
