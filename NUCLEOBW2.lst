    2643.  00:53AB                      
    2644.  00:53AB                      		; Tamaño destino/fuente:
    2645.  00:53AB                      		; ancho fijo, altura decreciendo.
    2646.  00:53AB                      
    2647.  00:53AB  78                  		ld		a,b
    2648.  00:53AC  FD 77 0A            		ld		(iy+10),a							; alto low = B
    2649.  00:53AF  AF                  		xor		a
    2650.  00:53B0  FD 77 0B            		ld		(iy+11),a							; alto high = 0
