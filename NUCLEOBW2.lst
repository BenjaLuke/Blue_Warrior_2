    2181.  00:4FE6  32 08 C6                    ld      (ROTATIVO_CONTADOR_PRESENTACION),a
    2182.  00:4FE9  32 09 C6                    ld      (ROTATIVO_PAGINA_VISIBLE_PRESENTACION),a
    2183.  00:4FEC  32 0C C6                    ld      (ROTATIVO_REPETICION_LETRA_PRESENTACION),a
    2184.  00:4FEF  32 0D C6                    ld      (ROTATIVO_MODO_SALIDA_PRESENTACION),a
    2185.  00:4FF2                      
    2186.  00:4FF2  3E 2B                       ld      a,ROTATIVO_ESPACIOS_SALIDA_PRESENTACION
    2187.  00:4FF4  32 0E C6                    ld      (ROTATIVO_PASOS_SALIDA_PRESENTACION),a
    2188.  00:4FF7                      
    2189.  00:4FF7  21 C4 51                    ld      hl,TEXTO_ROTATIVO_PRESENTACION
    2190.  00:4FFA  22 0A C6                    ld      (ROTATIVO_PUNTERO_TEXTO_PRESENTACION),hl
