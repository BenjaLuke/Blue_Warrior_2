    2606.  00:5346                      
    2607.  00:5346  3E 42               		ld		a,AGONIX_MOVIMIENTO_Y_BOSS_1
    2608.  00:5348  81                  		add		c
    2609.  00:5349  FD 77 06            		ld		(iy+6),a							; destino y low
