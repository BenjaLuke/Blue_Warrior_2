    2453.  00:5301                      REVISAMOS_COLISION_CON_ERRECENYX_Y_DEPH:
    2454.  00:5301                      
    2455.  00:5301                      		; Hitbox Errecenyx/Herrecenix reducido 20 px por cada lado.
    2456.  00:5301                      		; Deph se sigue tratando como caja aproximada de 20x20.
    2457.  00:5301                      		;
    2458.  00:5301                      		; X original visible:
    2459.  00:5301                      		;   izquierda = VARIABLE_UN_USO3
    2460.  00:5301                      		;   ancho     = VARIABLE_UN_USO2
    2461.  00:5301                      		;
    2462.  00:5301                      		; X reducido:
    2463.  00:5301                      		;   izquierda = VARIABLE_UN_USO3 + 20
    2464.  00:5301                      		;   derecha   = VARIABLE_UN_USO3 + VARIABLE_UN_USO2 - 20
    2465.  00:5301                      		;
    2466.  00:5301                      		; Y original:
    2467.  00:5301                      		;   arriba = ERRECENYX_MOVIMIENTO_Y_BOSS_4
    2468.  00:5301                      		;   alto   = ERRECENYX_MOVIMIENTO_ALTO_BOSS_4
    2469.  00:5301                      		;
    2470.  00:5301                      		; Y reducido:
    2471.  00:5301                      		;   arriba = ERRECENYX_MOVIMIENTO_Y_BOSS_4 + 20
    2472.  00:5301                      		;   abajo  = ERRECENYX_MOVIMIENTO_Y_BOSS_4 + ERRECENYX_MOVIMIENTO_ALTO_BOSS_4 - 20
    2473.  00:5301                      
    2474.  00:5301  CD EE 4E            		call	CALCULA_RECORTE_ERRECENYX_BOSS_4
    2475.  00:5304                      
    2476.  00:5304                      		; Si el ancho visible es 40 o menos, al meter 20 por cada lado
    2477.  00:5304                      		; no queda hitbox real.
    2478.  00:5304  3A A3 C2            		ld		a,(VARIABLE_UN_USO2)
    2479.  00:5307  FE 29               		cp		41
    2480.  00:5309  D8                  		ret		c
    2481.  00:530A                      
    2482.  00:530A                      		; Comprueba borde izquierdo reducido:
    2483.  00:530A                      		; Deph derecha >= Errecenyx izquierda + 20
    2484.  00:530A  3A A4 C2            		ld		a,(VARIABLE_UN_USO3)
    2485.  00:530D  C6 14               		add		20
    2486.  00:530F  4F                  		ld		c,a
    2487.  00:5310  3A 64 C0            		ld		a,(X_DEPH)
    2488.  00:5313  C6 14               		add		20
    2489.  00:5315  B9                  		cp		c
    2490.  00:5316  D8                  		ret		c
    2491.  00:5317                      
    2492.  00:5317                      		; Comprueba borde derecho reducido:
    2493.  00:5317                      		; Deph izquierda < Errecenyx derecha - 20
    2494.  00:5317  3A A4 C2            		ld		a,(VARIABLE_UN_USO3)
    2495.  00:531A  4F                  		ld		c,a
    2496.  00:531B  3A A3 C2            		ld		a,(VARIABLE_UN_USO2)
    2497.  00:531E  81                  		add		c
    2498.  00:531F  D6 14               		sub		20
    2499.  00:5321  4F                  		ld		c,a
    2500.  00:5322  3A 64 C0            		ld		a,(X_DEPH)
    2501.  00:5325  B9                  		cp		c
    2502.  00:5326  D0                  		ret		nc
    2503.  00:5327                      
    2504.  00:5327                      		; Comprueba borde superior reducido:
    2505.  00:5327                      		; Deph abajo >= Errecenyx arriba + 20
    2506.  00:5327  3A 65 C0            		ld		a,(Y_DEPH)
    2507.  00:532A  C6 14               		add		20
    2508.  00:532C  FE 30               		cp		ERRECENYX_MOVIMIENTO_Y_BOSS_4+20
    2509.  00:532E  D8                  		ret		c
    2510.  00:532F                      
    2511.  00:532F                      		; Comprueba borde inferior reducido:
    2512.  00:532F                      		; Deph arriba < Errecenyx abajo - 20
    2513.  00:532F  3A 65 C0            		ld		a,(Y_DEPH)
    2514.  00:5332  FE 46               		cp		ERRECENYX_MOVIMIENTO_Y_BOSS_4+ERRECENYX_MOVIMIENTO_ALTO_BOSS_4-20
    2515.  00:5334  D0                  		ret		nc
