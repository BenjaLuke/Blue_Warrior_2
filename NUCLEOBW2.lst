     602.  00:4315                      ; -----------------------------------------------------------------------------
     603.  00:4315                      ; Carga de patrones y colores del barro.
     604.  00:4315                      ; OJO: debe ir DESPUES de RUTINA_BOSS_4 para que la entrada del banco
     605.  00:4315                      ; siga empezando en RUTINA_BOSS_4. Si se coloca antes, el boss puede entrar
     606.  00:4315                      ; por esta rutina y colgarse antes de iniciar el flujo normal.
     607.  00:4315                      ; -----------------------------------------------------------------------------
     608.  00:4315                      CARGA_SPRITES_BARRO_BOSS_4:
     609.  00:4315                      		
     610.  00:4315  CD B0 6D            		call	PAGE_32_A_SEGMENT_2
     611.  00:4318                      
     612.  00:4318                      		; Los dos patrones anteriores al barro quedan reservados para la
     613.  00:4318                      		; explosion de impacto: 92 y 96. NO se cargan aqui: ya estan
     614.  00:4318                      		; en VRAM en el sitio adecuado.
     615.  00:4318                      		; Barro empieza en 100: 100,104,108,112.
     616.  00:4318  21 40 97            		ld		hl,SPRITE_BARRO
     617.  00:431B  11 20 43            		ld		de,PATRONES_SPRITES_VRAM_BOSS_4+BARRO_PATRON_INICIAL_BOSS_4*8
     618.  00:431E  01 80 00            		ld		bc,8*4*BARRO_CANTIDAD_BOSS_4
     619.  00:4321  CD A2 5F            		call	PON_COLOR_2.sin_bc_impuesta
     620.  00:4324                      
     621.  00:4324                      		; Los COVIDs se cargan despues de los cuatro patrones de barro:
     622.  00:4324                      		; COVID queda en 116 y 120.
     623.  00:4324  21 00 92            		ld		hl,SPRITES_COVID
     624.  00:4327  11 A0 43            		ld		de,PATRONES_SPRITES_VRAM_BOSS_4+COVID_PATRON_INICIAL_BOSS_4*8
     625.  00:432A  01 40 00            		ld		bc,8*4*COVID_PATRON_CANT_BOSS_4
     626.  00:432D  CD A2 5F            		call	PON_COLOR_2.sin_bc_impuesta
     627.  00:4330                      
     628.  00:4330                              ; Los BUBBLES se cargan despues de los COVIDs:
     629.  00:4330                              ; BUBBLES queda en 124 y 128.
     630.  00:4330  21 C0 97                    ld      hl,SPRITE_BUBBLES
     631.  00:4333  11 E0 43                    ld      de,PATRONES_SPRITES_VRAM_BOSS_4+BUBBLES_PATRON_INICIAL_BOSS_4*8
     632.  00:4336  01 40 00                    ld      bc,8*4*BUBBLES_PATRON_CANT_BOSS_4
     633.  00:4339  CD A2 5F                    call    PON_COLOR_2.sin_bc_impuesta
     634.  00:433C                      
     635.  00:433C                      		; El color de sprites en SCREEN 7 va por NUMERO DE SPRITE,
     636.  00:433C                      		; no por patron. Los proyectiles usan los sprites 22-27,
     637.  00:433C                      		; asi que sus colores deben arrancar en #4800 + 22*16 = #4960.
