    2136.  00:4EDC  74 68 65 20 76 69 6C 6C 61 67 65 72 73 2E 00 
    2137.  00:4EEB                      
    2138.  00:4EEB                      TEXTO_CINEMATICA_4_1:
    2139.  00:4EEB                      		db		"But Deph isn't intimidated by this",0				  	
    2139.  00:4EEB  42 75 74 20 44 65 70 68 20 69 73 6E 27 74 20 69 
    2139.  00:4EFB  6E 74 69 6D 69 64 61 74 65 64 20 62 79 20 74 68 
