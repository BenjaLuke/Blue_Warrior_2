       1:  00:5AB8                      ; -----------------------------------------------------------------------------
       2:  00:5AB8                      ; FINAL FASE 5 VAMOS A TERMINAR.asm
       3:  00:5AB8                      ;
       4:  00:5AB8                      ; Include ejecutado desde BOSS 5.asm en la etiqueta FINAL_b5.
       5:  00:5AB8                      ;
       6:  00:5AB8                      ; Objetivo:
       7:  00:5AB8                      ;   - Borrar visualmente la page 2 visible.
       8:  00:5AB8                      ;   - Pintar bloques negros en orden pseudoaleatorio.
       9:  00:5AB8                      ;   - No repetir nunca el mismo bloque.
      10:  00:5AB8                      ;   - Al terminar, NO hacer ret ni jp: el flujo cae al codigo siguiente
      11:  00:5AB8                      ;     del include, es decir, VOLVEMOS_b5.
      12:  00:5AB8                      ;
      13:  00:5AB8                      ; Nota:
      14:  00:5AB8                      ;   La pantalla se divide en bloques de 4x4.
      15:  00:5AB8                      ;   64 columnas x 53 filas = 3392 bloques.
      16:  00:5AB8                      ;   Cada bloque se pinta una sola vez mediante HMMV.
      17:  00:5AB8                      ; -----------------------------------------------------------------------------
      18:  00:5AB8                      
      19:  00:5AB8  C3 34 5B            		jp		FINAL_FASE_5_VAMOS_A_TERMINAR_INICIO
      20:  00:5ABB                      
      21:  00:5ABB                      ; Buffer de comando VDP.
      22:  00:5ABB                      ; Formato DOCOPY:
      23:  00:5ABB                      ;   0-1   SX
      24:  00:5ABB                      ;   2-3   SY
      25:  00:5ABB                      ;   4-5   DX
      26:  00:5ABB                      ;   6-7   DY
      27:  00:5ABB                      ;   8-9   NX
      28:  00:5ABB                      ;   10-11 NY
      29:  00:5ABB                      ;   12    color
      30:  00:5ABB                      ;   13    argumento
      31:  00:5ABB                      ;   14    comando
      32:  00:5ABB                      ;
      33:  00:5ABB                      ; HMMV (#C0) rellena un rectangulo con un color.
      34:  00:5ABB                      ; DY alto = 2 para pintar en la page 2.
      35:  00:5ABB                      FINAL_FASE_5_VAMOS_A_TERMINAR_PLANTILLA_HMMV:
      36:  00:5ABB                      
      37:  00:5ABB  00 00 00 00         		db		0,0,0,0
      38:  00:5ABF  00 00               		db		0,0
