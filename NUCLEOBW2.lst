    2462.  00:52A9                      		; Animación de muerte:
    2463.  00:52A9                      		; copiamos siempre desde el primer recuadro de la page fuente
    2464.  00:52A9                      		; hacia page 2, recortando altura y bajando destino.
    2465.  00:52A9                      		;
    2466.  00:52A9                      		; derecha  -> page 3
    2467.  00:52A9                      		; izquierda -> page 1
    2468.  00:52A9                      
    2469.  00:52A9  DD 21 F2 55         		ld		ix,BOSS_1_COPY_MOVIMIENTO_AGONIX
    2470.  00:52AD  FD 21 B2 C2         		ld		iy,DATAS_COPY_RECUP_SCROLL
