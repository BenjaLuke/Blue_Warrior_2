      57.  00:4553  79                  			ld		a,c														; Slot
      58.  00:4554  E1                  			pop		hl
      59.  00:4555  C1                  			pop		bc
      60.  00:4556  C8                  			ret		z														; Si es diferente de FFh -> Encontrado!!!
      61.  00:4557  23                  			inc		hl
      62.  00:4558  0C                  			inc		c
      63.  00:4559  10 E8               			djnz	SIGUIENTE_SLOT
      64.  00:455B  3E FF               			ld		a,0FFh													; El FM no ha sido encontrado, por tanto->A=0FFh
      65.  00:455D  C9                  			ret
