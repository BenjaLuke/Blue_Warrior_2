    1813.  00:490C                      ; -----------------------------------------------------------------------------
    1814.  00:490C                      ; Control del lodo en Boss 4 por coordenada Y.
    1815.  00:490C                      ; Si Y_DEPH < 85: sprites normales y movimiento normal.
    1816.  00:490C                      ; Si Y_DEPH >= 85: sprites de pies en lodo.
    1817.  00:490C                      ;
    1818.  00:490C                      ; IMPORTANTE:
    1819.  00:490C                      ; La rutina comun de movimiento debe ejecutarse SIEMPRE.
    1820.  00:490C                      ; Las pruebas anteriores que saltaban MOVIMIENTO_DEPH_EN_BOSS_4 o restauraban X/Y
    1821.  00:490C                      ; dejaban a Deph bloqueado o descolocaban sus limites internos.
    1822.  00:490C                      ; Aqui no tocamos coordenadas, no restauramos posiciones y no cortamos el flujo.
    1823.  00:490C                      ; -----------------------------------------------------------------------------
    1824.  00:490C                      CONTROL_LODO_Y_MOVIMIENTO_DEPH_BOSS_4:
    1825.  00:490C                      
    1826.  00:490C  3A 65 C0            		ld		a,(Y_DEPH)
