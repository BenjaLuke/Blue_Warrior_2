    3059.  00:6F55  00 00 00 00 00 00 AF 00 00 01 51 00 
    3060.  00:6F61  00 00 C0            		db		#00,#00,11000000b
    3061.  00:6F64                      
    3062.  00:6F64                      ;DATOS_LIMPIA_PAGE_3_FIN_BOSS:
    3063.  00:6F64                      
