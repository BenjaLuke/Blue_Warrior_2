    2320.  00:4E2B  CD FF 4D                    call    OBTIENE_Y_ROTATIVO_DESDE_A_EN_HL
    2321.  00:4E2E  DD 75 06                    ld      (ix+6),l
    2322.  00:4E31  DD 74 07                    ld      (ix+7),h
    2323.  00:4E34                      
    2324.  00:4E34                              ; Ancho = 254, alto = 8, comando HMMM.
    2325.  00:4E34                      
    2326.  00:4E34  DD 36 08 FE                 ld      (ix+8),ROTATIVO_ANCHO_SCROLL_PRESENTACION
    2327.  00:4E38  DD 36 09 00                 ld      (ix+9),0
    2328.  00:4E3C  DD 36 0A 08                 ld      (ix+10),ROTATIVO_ALTO_PRESENTACION
    2329.  00:4E40  DD 36 0B 00                 ld      (ix+11),0
    2330.  00:4E44  DD 36 0C 00                 ld      (ix+12),#00
    2331.  00:4E48  DD 36 0D 00                 ld      (ix+13),#00
    2332.  00:4E4C  DD 36 0E D0                 ld      (ix+14),11010000b
