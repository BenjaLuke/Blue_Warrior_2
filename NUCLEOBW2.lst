    2980.  00:6F46  C3 75 A7            		jp		MUERTE_POR_TOQUES_DESDE_BOSS
    2981.  00:6F49                      
    2982.  00:6F49                      ;DATOS_LIMPIA_PAGE_0_FIN_BOSS:
    2983.  00:6F49                      
