       1.  00:7F8F                      ; ------------------------------------------------------------
       2.  00:7F8F                      ; INICIA_MUSICA_COMUN
       3.  00:7F8F                      ;
       4.  00:7F8F                      ; Entrada:
       5.  00:7F8F                      ;   A  = banco donde está la música
       6.  00:7F8F                      ;   HL = dirección de la música
       7.  00:7F8F                      ;
       8.  00:7F8F                      ; Ejemplo:
       9.  00:7F8F                      ;   ld  a,39
      10.  00:7F8F                      ;   ld  hl,M_PUENTE
      11.  00:7F8F                      ;   call INICIA_MUSICA_COMUN
      12.  00:7F8F                      ;
      13.  00:7F8F                      ; IMPORTANTE:
      14.  00:7F8F                      ;   Esta rutina NO debe estar en el segmento que cambia
      15.  00:7F8F                      ;   CHANGE_BANK_2, porque si cambia el banco donde está
      16.  00:7F8F                      ;   ejecutándose, el MSX se pega el castañazo padre.
      17.  00:7F8F                      ; ------------------------------------------------------------
