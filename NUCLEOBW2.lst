    2590.  00:537F  28 02               		jr		z,.GUARDA_PAGE_ORIGEN_MUERTE_AGONIX_BOSS_1
    2591.  00:5381                      
    2592.  00:5381  3E 01               		ld		a,AGONIX_MOVIMIENTO_PAG_IZQUIERDA_BOSS_1
