    2395.  00:4EB2                      PINTA_LETRA_MENU_ROTATIVO_PARCIAL_EN_DESTINO:
    2396.  00:4EB2                      
    2397.  00:4EB2                              ; Entrada:
    2398.  00:4EB2                              ;   A  = caracter a pintar
    2399.  00:4EB2                              ;   HL = X destino: 254, 252 o 250
    2400.  00:4EB2                              ;   DE = Y destino con page incluida
    2401.  00:4EB2                              ;
    2402.  00:4EB2                              ; Copiamos solo la parte visible de la letra:
    2403.  00:4EB2                              ;   repeticion 0 -> ancho 2
    2404.  00:4EB2                              ;   repeticion 1 -> ancho 4
    2405.  00:4EB2                              ;   repeticion 2 -> ancho 6
    2406.  00:4EB2                              ;
    2407.  00:4EB2                              ; Así respetamos la entrada progresiva sin escribir fuera de X=255.
    2408.  00:4EB2                      
    2409.  00:4EB2  E5                          push    hl
    2410.  00:4EB3  D5                          push    de
