     222.  00:703E  32 D9 C2            		ld	[ayFX_REGS+9],a							; Volume copied in to ayFX_REGS (channel B volume)
     223.  00:7041  CB 49               		bit	1,c										; If tone is off...
     224.  00:7043  C0                  		ret	nz										; ...return
