     259.  00:706D                      				
     260.  00:706D  21 D6 C2            		LD	HL,ayFX_REGS+AR_Mixer
     261.  00:7070  CB FE               		set	7,[hl]
     262.  00:7072  CB B6               		res	6,[hl]
