    2195.  00:4DB3  (00:00C3)           ROTATIVO_Y_PRESENTACION                  equ     195
    2196.  00:4DB3                      
    2197.  00:4DB3                      ; Cada cuántos frames se actualiza el rotativo.
    2198.  00:4DB3                      ; 1 = cada frame, 2 = cada dos frames, etc.
    2199.  00:4DB3  (00:0003)           ROTATIVO_VELOCIDAD_PRESENTACION          equ     3
    2200.  00:4DB3                      
    2201.  00:4DB3                      ; El nuevo rotativo avanza copiando la franja 2 píxeles a la izquierda.
    2202.  00:4DB3                      ; Cada letra mide 6 píxeles, así que se introduce en 3 pasos:
    2203.  00:4DB3                      ;   paso 0 -> X=254
    2204.  00:4DB3                      ;   paso 1 -> X=252
    2205.  00:4DB3                      ;   paso 2 -> X=250
    2206.  00:4DB3  (00:0002)           ROTATIVO_PIXELES_POR_PASO_PRESENTACION   equ     2
    2207.  00:4DB3  (00:0003)           ROTATIVO_PASOS_POR_LETRA_PRESENTACION    equ     3
    2208.  00:4DB3  (00:00FE)           ROTATIVO_X_ENTRADA_PRESENTACION          equ     254
    2209.  00:4DB3  (00:00FE)           ROTATIVO_ANCHO_SCROLL_PRESENTACION       equ     254
    2210.  00:4DB3  (00:0008)           ROTATIVO_ALTO_PRESENTACION               equ     8
    2211.  00:4DB3                      
    2212.  00:4DB3                      ; Cuando se acaba el texto, metemos espacios hasta que toda la cola sale
    2213.  00:4DB3                      ; por la izquierda. 43 espacios * 6 píxeles = 258 píxeles.
    2214.  00:4DB3  (00:002B)           ROTATIVO_ESPACIOS_SALIDA_PRESENTACION    equ     43
    2215.  00:4DB3                      
    2216.  00:4DB3                      
    2217.  00:4DB3                      INICIALIZA_ROTATIVO_PRESENTACION:
    2218.  00:4DB3                      
    2219.  00:4DB3  AF                          xor     a
    2220.  00:4DB4  32 32 C6                    ld      (ROTATIVO_CONTADOR_PRESENTACION),a
    2221.  00:4DB7  32 33 C6                    ld      (ROTATIVO_PAGINA_VISIBLE_PRESENTACION),a
    2222.  00:4DBA  32 36 C6                    ld      (ROTATIVO_REPETICION_LETRA_PRESENTACION),a
    2223.  00:4DBD  32 37 C6                    ld      (ROTATIVO_MODO_SALIDA_PRESENTACION),a
    2224.  00:4DC0                      
    2225.  00:4DC0  3E 2B                       ld      a,ROTATIVO_ESPACIOS_SALIDA_PRESENTACION
    2226.  00:4DC2  32 38 C6                    ld      (ROTATIVO_PASOS_SALIDA_PRESENTACION),a
    2227.  00:4DC5                      
    2228.  00:4DC5  21 85 4F                    ld      hl,TEXTO_ROTATIVO_PRESENTACION
    2229.  00:4DC8  22 34 C6                    ld      (ROTATIVO_PUNTERO_TEXTO_PRESENTACION),hl
    2230.  00:4DCB                      
    2231.  00:4DCB                              ; Dejamos limpia la franja en las dos páginas. Así el primer paso
    2232.  00:4DCB                              ; parte de una zona negra y la página oculta no hereda basura.
    2233.  00:4DCB                      
    2234.  00:4DCB  21 67 4F                    ld      hl,DATOS_NEGRO_ROTATIVO_EN_PAGE_0
    2235.  00:4DCE  CD 2A 5E                    call    DOCOPY
    2236.  00:4DD1  CD 33 5E                    call    VDPREADY
    2237.  00:4DD4                      
    2238.  00:4DD4  21 76 4F                    ld      hl,DATOS_NEGRO_ROTATIVO_EN_PAGE_1
    2239.  00:4DD7  CD 2A 5E                    call    DOCOPY
