    2472.  00:52B4                      
    2473.  00:52B4  FD 21 B2 C2         		ld		iy,DATAS_COPY_RECUP_SCROLL
    2474.  00:52B8                      
    2475.  00:52B8                      		; Página fuente según dirección.
    2476.  00:52B8                      
    2477.  00:52B8  3A 5C C6            		ld		a,(AGONIX_BOSS_1_DIRECCION)
    2478.  00:52BB  B7                  		or		a
    2479.  00:52BC  3E 03               		ld		a,AGONIX_MOVIMIENTO_PAG_DERECHA_BOSS_1
    2480.  00:52BE  28 02               		jr		z,.GUARDA_PAGE_ORIGEN_MUERTE_AGONIX_BOSS_1
    2481.  00:52C0                      
    2482.  00:52C0  3E 01               		ld		a,AGONIX_MOVIMIENTO_PAG_IZQUIERDA_BOSS_1
