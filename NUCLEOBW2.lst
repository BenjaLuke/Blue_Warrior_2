    2485.  00:52C2                      
    2486.  00:52C2  FD 77 03            		ld		(iy+3),a							; page origen: 3 o 1
    2487.  00:52C5                      
    2488.  00:52C5                      
    2489.  00:52C5                      		; Origen: primer recuadro arriba izquierda.
    2490.  00:52C5                      		; x=0, y=0. La page ya la hemos puesto en iy+3.
    2491.  00:52C5                      
    2492.  00:52C5  AF                  		xor		a
    2493.  00:52C6  FD 77 00            		ld		(iy),a								; origen x low
    2494.  00:52C9  FD 77 01            		ld		(iy+1),a							; origen x high
    2495.  00:52CC  FD 77 02            		ld		(iy+2),a							; origen y low
    2496.  00:52CF                      
    2497.  00:52CF                      
    2498.  00:52CF                      		; Destino X: posición actual de Agonix en page 2.
    2499.  00:52CF                      
    2500.  00:52CF  3A 59 C6            		ld		a,(AGONIX_BOSS_1_X)
    2501.  00:52D2  FD 77 04            		ld		(iy+4),a							; destino x low
    2502.  00:52D5  AF                  		xor		a
    2503.  00:52D6  FD 77 05            		ld		(iy+5),a							; destino x high
    2504.  00:52D9                      
    2505.  00:52D9                      
    2506.  00:52D9                      		; Recuperamos el contador externo del bucle.
    2507.  00:52D9                      		; B = altura actual que vamos a copiar.
    2508.  00:52D9                      		; Primera vuelta: B = 48.
    2509.  00:52D9                      		; Última vuelta: B = 1.
    2510.  00:52D9                      		; Cuando B llega a 0, el djnz de fuera termina la animación.
    2511.  00:52D9                      
    2512.  00:52D9  C1                  		pop		bc
    2513.  00:52DA  C5                  		push	bc
    2514.  00:52DB                      
    2515.  00:52DB                      		; offset = altura inicial - altura actual.
    2516.  00:52DB                      		; Este offset baja el destino.
    2517.  00:52DB                      
    2518.  00:52DB  3E 30               		ld		a,AGONIX_MUERTE_ALTO_BOSS_1
    2519.  00:52DD  90                  		sub		b
    2520.  00:52DE  4F                  		ld		c,a									; C = offset vertical
    2521.  00:52DF                      
    2522.  00:52DF                      
    2523.  00:52DF                      		; Destino Y = y actual de Agonix + offset.
    2524.  00:52DF                      		; Page destino sigue siendo page 2.
    2525.  00:52DF                      
    2526.  00:52DF  3E 42               		ld		a,AGONIX_MOVIMIENTO_Y_BOSS_1
    2527.  00:52E1  81                  		add		c
    2528.  00:52E2  FD 77 06            		ld		(iy+6),a							; destino y low
    2529.  00:52E5                      
    2530.  00:52E5  3E 02               		ld		a,PAGE_2_VRAM_Y_BOSS_1 / 256
    2531.  00:52E7  FD 77 07            		ld		(iy+7),a							; destino page 2
    2532.  00:52EA                      
    2533.  00:52EA                      
    2534.  00:52EA                      		; Tamaño destino/fuente:
    2535.  00:52EA                      		; ancho fijo, altura decreciendo.
    2536.  00:52EA                      
    2537.  00:52EA  78                  		ld		a,b
    2538.  00:52EB  FD 77 0A            		ld		(iy+10),a							; alto low = B
    2539.  00:52EE  AF                  		xor		a
    2540.  00:52EF  FD 77 0B            		ld		(iy+11),a							; alto high = 0
