    2398.  00:5122  3C                          inc     a
    2399.  00:5123  87                          add     a,a
    2400.  00:5124  DD 77 08                    ld      (ix+8),a
    2401.  00:5127  DD 36 09 00                 ld      (ix+9),0
    2402.  00:512B  DD 36 0A 06                 ld      (ix+10),MENU_LETRA_ALTO
