    1722.  00:4EEC                      REVISAMOS_COLISION_CON_AGONIX_Y_DEPH:
    1723.  00:4EEC                      
    1724.  00:4EEC                      		; Hitbox Agonix reducido 20 px por cada lado.
    1725.  00:4EEC                      		; Deph se sigue tratando como caja aproximada de 20x20.
    1726.  00:4EEC                      		;
    1727.  00:4EEC                      		; Agonix original:
    1728.  00:4EEC                      		; X = AGONIX_BOSS_1_X
    1729.  00:4EEC                      		; W = AGONIX_MOVIMIENTO_ANCHO_BOSS_1
    1730.  00:4EEC                      		; Y = AGONIX_MOVIMIENTO_Y_BOSS_1
    1731.  00:4EEC                      		; H = AGONIX_MOVIMIENTO_ALTO_BOSS_1
    1732.  00:4EEC                      		;
    1733.  00:4EEC                      		; Agonix reducido:
    1734.  00:4EEC                      		; X izquierda = X + 20
    1735.  00:4EEC                      		; X derecha   = X + ancho - 20
    1736.  00:4EEC                      		; Y arriba    = Y + 20
    1737.  00:4EEC                      		; Y abajo     = Y + alto - 20
    1738.  00:4EEC                      
    1739.  00:4EEC  3A 42 C6            		ld		a,(AGONIX_BOSS_1_X)
    1740.  00:4EEF  C6 14               		add		20
    1741.  00:4EF1  4F                  		ld		c,a
    1742.  00:4EF2  3A 64 C0            		ld		a,(X_DEPH)
    1743.  00:4EF5  C6 14               		add		20
    1744.  00:4EF7  B9                  		cp		c
    1745.  00:4EF8  D8                  		ret		c
    1746.  00:4EF9                      
    1747.  00:4EF9  3A 42 C6            		ld		a,(AGONIX_BOSS_1_X)
    1748.  00:4EFC  C6 6E               		add		AGONIX_MOVIMIENTO_ANCHO_BOSS_1-20
    1749.  00:4EFE  4F                  		ld		c,a
    1750.  00:4EFF  3A 64 C0            		ld		a,(X_DEPH)
    1751.  00:4F02  B9                  		cp		c
    1752.  00:4F03  D0                  		ret		nc
    1753.  00:4F04                      
    1754.  00:4F04  3A 65 C0            		ld		a,(Y_DEPH)
    1755.  00:4F07  C6 14               		add		20
    1756.  00:4F09  FE 56               		cp		AGONIX_MOVIMIENTO_Y_BOSS_1+20
    1757.  00:4F0B  D8                  		ret		c
    1758.  00:4F0C                      
    1759.  00:4F0C  3A 65 C0            		ld		a,(Y_DEPH)
    1760.  00:4F0F  FE 5E               		cp		AGONIX_MOVIMIENTO_Y_BOSS_1+AGONIX_MOVIMIENTO_ALTO_BOSS_1-20
    1761.  00:4F11  D0                  		ret		nc
