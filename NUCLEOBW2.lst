    3013.  00:6F0D  C3 9E BF            		jp		MUERTE_POR_TOQUES_DESDE_BOSS
    3014.  00:6F10                      
    3015.  00:6F10                      ;LIMPIA_ESTADO_DANO_DEPH_EN_MUERTE_BOSS:
    3016.  00:6F10                      
    3017.  00:6F10  AF                  		xor		a
    3018.  00:6F11  32 20 C1            		ld		(INMUNE),a
    3019.  00:6F14  32 0E C1            		ld		(TIEMPO_DE_ADJUST),a
    3020.  00:6F17  3C                  		inc		a
