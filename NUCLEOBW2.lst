     125.  00:5EDE                      ;Set VDP address counter to write from address AHL (17-bit)
     126.  00:5EDE                      ;Enables the interrupts
     127.  00:5EDE                      
     128.  00:5EDE                      ;SetVdp_Write:
     129.  00:5EDE                      ;SETWRT_in_RAM:															; BIOS: 53h
     130.  00:5EDE                      	
     131.  00:5EDE  F5                  		push	af
