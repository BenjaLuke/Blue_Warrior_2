    2452.  00:4EEC  32 37 C6                    ld      (ROTATIVO_REPETICION_LETRA_PRESENTACION),a
    2453.  00:4EEF  32 38 C6                    ld      (ROTATIVO_MODO_SALIDA_PRESENTACION),a
    2454.  00:4EF2                      
    2455.  00:4EF2  3E 2B                       ld      a,ROTATIVO_ESPACIOS_SALIDA_PRESENTACION
    2456.  00:4EF4  32 39 C6                    ld      (ROTATIVO_PASOS_SALIDA_PRESENTACION),a
    2457.  00:4EF7                      
