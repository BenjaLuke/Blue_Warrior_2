    2377.  00:52A5                      REVISAMOS_COLISION_CON_ERRECENYX_Y_DEPH:
    2378.  00:52A5                      
    2379.  00:52A5                      		; Hitbox Errecenyx/Herrecenix reducido 20 px por cada lado.
    2380.  00:52A5                      		; Deph se sigue tratando como caja aproximada de 20x20.
    2381.  00:52A5                      		;
    2382.  00:52A5                      		; X original visible:
    2383.  00:52A5                      		;   izquierda = VARIABLE_UN_USO3
    2384.  00:52A5                      		;   ancho     = VARIABLE_UN_USO2
    2385.  00:52A5                      		;
    2386.  00:52A5                      		; X reducido:
    2387.  00:52A5                      		;   izquierda = VARIABLE_UN_USO3 + 20
    2388.  00:52A5                      		;   derecha   = VARIABLE_UN_USO3 + VARIABLE_UN_USO2 - 20
    2389.  00:52A5                      		;
    2390.  00:52A5                      		; Y original:
    2391.  00:52A5                      		;   arriba = ERRECENYX_MOVIMIENTO_Y_BOSS_4
    2392.  00:52A5                      		;   alto   = ERRECENYX_MOVIMIENTO_ALTO_BOSS_4
    2393.  00:52A5                      		;
    2394.  00:52A5                      		; Y reducido:
    2395.  00:52A5                      		;   arriba = ERRECENYX_MOVIMIENTO_Y_BOSS_4 + 20
    2396.  00:52A5                      		;   abajo  = ERRECENYX_MOVIMIENTO_Y_BOSS_4 + ERRECENYX_MOVIMIENTO_ALTO_BOSS_4 - 20
    2397.  00:52A5                      
    2398.  00:52A5  CD 9E 4E            		call	CALCULA_RECORTE_ERRECENYX_BOSS_4
    2399.  00:52A8                      
    2400.  00:52A8                      		; Si el ancho visible es 40 o menos, al meter 20 por cada lado
    2401.  00:52A8                      		; no queda hitbox real.
    2402.  00:52A8  3A AA C2            		ld		a,(VARIABLE_UN_USO2)
    2403.  00:52AB  FE 29               		cp		41
    2404.  00:52AD  D8                  		ret		c
    2405.  00:52AE                      
    2406.  00:52AE                      		; Comprueba borde izquierdo reducido:
    2407.  00:52AE                      		; Deph derecha >= Errecenyx izquierda + 20
    2408.  00:52AE  3A AB C2            		ld		a,(VARIABLE_UN_USO3)
    2409.  00:52B1  C6 14               		add		20
    2410.  00:52B3  4F                  		ld		c,a
    2411.  00:52B4  3A 64 C0            		ld		a,(X_DEPH)
    2412.  00:52B7  C6 14               		add		20
    2413.  00:52B9  B9                  		cp		c
    2414.  00:52BA  D8                  		ret		c
    2415.  00:52BB                      
    2416.  00:52BB                      		; Comprueba borde derecho reducido:
    2417.  00:52BB                      		; Deph izquierda < Errecenyx derecha - 20
    2418.  00:52BB  3A AB C2            		ld		a,(VARIABLE_UN_USO3)
    2419.  00:52BE  4F                  		ld		c,a
    2420.  00:52BF  3A AA C2            		ld		a,(VARIABLE_UN_USO2)
    2421.  00:52C2  81                  		add		c
    2422.  00:52C3  D6 14               		sub		20
    2423.  00:52C5  4F                  		ld		c,a
    2424.  00:52C6  3A 64 C0            		ld		a,(X_DEPH)
    2425.  00:52C9  B9                  		cp		c
    2426.  00:52CA  D0                  		ret		nc
    2427.  00:52CB                      
    2428.  00:52CB                      		; Comprueba borde superior reducido:
    2429.  00:52CB                      		; Deph abajo >= Errecenyx arriba + 20
    2430.  00:52CB  3A 65 C0            		ld		a,(Y_DEPH)
    2431.  00:52CE  C6 14               		add		20
    2432.  00:52D0  FE 30               		cp		ERRECENYX_MOVIMIENTO_Y_BOSS_4+20
    2433.  00:52D2  D8                  		ret		c
    2434.  00:52D3                      
    2435.  00:52D3                      		; Comprueba borde inferior reducido:
    2436.  00:52D3                      		; Deph arriba < Errecenyx abajo - 20
    2437.  00:52D3  3A 65 C0            		ld		a,(Y_DEPH)
    2438.  00:52D6  FE 46               		cp		ERRECENYX_MOVIMIENTO_Y_BOSS_4+ERRECENYX_MOVIMIENTO_ALTO_BOSS_4-20
    2439.  00:52D8  D0                  		ret		nc
    2440.  00:52D9                      
    2441.  00:52D9  CD DD 52            		call	DANO_DEPH_EN_BOSS_4
    2442.  00:52DC  C9                  		ret
