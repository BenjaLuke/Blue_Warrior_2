    2546.  00:52F8  21 AD C2            		ld		hl,DATAS_COPY_RECUP_SCROLL
    2547.  00:52FB  CD 2A 5E            		call	DOCOPY
    2548.  00:52FE  CD 33 5E            		call	VDPREADY
