      70:  00:5B4E                      		; Destino: page 0 (0,150)  -> X=#0000, Y=#0096
      71:  00:5B4E  40 00 4E 02         		dw		#0040,#024E
      72:  00:5B52  00 00 96 00         		dw		#0000,#0096
      73:  00:5B56  80 00 30 00         		dw		CHUMINIX_APARICION_ANCHO_BOSS_3,CHUMINIX_APARICION_ALTO_BOSS_3
