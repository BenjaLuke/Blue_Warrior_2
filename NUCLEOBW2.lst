    2976.  00:6EF3  C3 52 BF            		jp		MUERTE_POR_TOQUES_DESDE_BOSS
    2977.  00:6EF6                      
    2978.  00:6EF6                      ;LIMPIA_ESTADO_DANO_DEPH_EN_MUERTE_BOSS:
