      40:  00:5AC3  04 00               		db		4,0
      41:  00:5AC5  02 00               		db		2,0
      42:  00:5AC7  00                  		db		#00
      43:  00:5AC8  00                  		db		#00
      44:  00:5AC9  C0                  		db		COPY_LOGICA_RELLENO_BOSS_5
