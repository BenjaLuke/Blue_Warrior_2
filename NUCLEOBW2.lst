       1:  00:57BD                      ; -----------------------------------------------------------------------------
       2:  00:57BD                      ; FINAL FASE 5 VAMOS A TERMINAR.asm
       3:  00:57BD                      ;
       4:  00:57BD                      ; Include ejecutado desde BOSS 5.asm en la etiqueta FINAL_b5.
       5:  00:57BD                      ;
       6:  00:57BD                      ; Objetivo:
       7:  00:57BD                      ;   - Borrar visualmente la page 2 visible.
       8:  00:57BD                      ;   - Pintar bloques negros en orden pseudoaleatorio.
       9:  00:57BD                      ;   - No repetir nunca el mismo bloque.
      10:  00:57BD                      ;   - Al terminar, NO hacer ret ni jp: el flujo cae al codigo siguiente
      11:  00:57BD                      ;     del include, es decir, VOLVEMOS_b5.
      12:  00:57BD                      ;
      13:  00:57BD                      ; Nota:
      14:  00:57BD                      ;   La pantalla se divide en bloques de 4x4.
      15:  00:57BD                      ;   64 columnas x 53 filas = 3392 bloques.
      16:  00:57BD                      ;   Cada bloque se pinta una sola vez mediante HMMV.
      17:  00:57BD                      ; -----------------------------------------------------------------------------
      18:  00:57BD                      
      19:  00:57BD  C3 39 58            		jp		FINAL_FASE_5_VAMOS_A_TERMINAR_INICIO
      20:  00:57C0                      
      21:  00:57C0                      ; Buffer de comando VDP.
      22:  00:57C0                      ; Formato DOCOPY:
      23:  00:57C0                      ;   0-1   SX
      24:  00:57C0                      ;   2-3   SY
      25:  00:57C0                      ;   4-5   DX
      26:  00:57C0                      ;   6-7   DY
      27:  00:57C0                      ;   8-9   NX
      28:  00:57C0                      ;   10-11 NY
      29:  00:57C0                      ;   12    color
      30:  00:57C0                      ;   13    argumento
      31:  00:57C0                      ;   14    comando
      32:  00:57C0                      ;
      33:  00:57C0                      ; HMMV (#C0) rellena un rectangulo con un color.
      34:  00:57C0                      ; DY alto = 2 para pintar en la page 2.
      35:  00:57C0                      FINAL_FASE_5_VAMOS_A_TERMINAR_PLANTILLA_HMMV:
      36:  00:57C0                      
      37:  00:57C0  00 00 00 00         		db		0,0,0,0
      38:  00:57C4  00 00               		db		0,0
      39:  00:57C6  00 02               		db		0,PAGE_2_VRAM_Y_BOSS_5/256
      40:  00:57C8  04 00               		db		4,0
      41:  00:57CA  02 00               		db		2,0
      42:  00:57CC  00                  		db		#00
      43:  00:57CD  00                  		db		#00
      44:  00:57CE  C0                  		db		COPY_LOGICA_RELLENO_BOSS_5
      45:  00:57CF                      
      46:  00:57CF                      ; Filas en orden pseudoaleatorio.
      47:  00:57CF                      ; Son las 53 filas de bloques de 4 pixeles: 0,4,8,...,208,
      48:  00:57CF                      ; pero mezcladas. No hay repeticiones.
      49:  00:57CF                      
      50:  00:57CF                      FINAL_FASE_5_VAMOS_A_TERMINAR_TABLA_Y:
      51:  00:57CF                      
      52:  00:57CF                      		db		46,120,194,56,130,204,66,140,2,76,150,12,86,160,22,96
      52:  00:57CF  2E 78 C2 38 82 CC 42 8C 02 4C 96 0C 56 A0 16 60 
      53:  00:57DF                      		db		170,32,106,180,42,116,190,52,126,200,62,136,210,72,146,8
      53:  00:57DF  AA 20 6A B4 2A 74 BE 34 7E C8 3E 88 D2 48 92 08 
      54:  00:57EF                      		db		82,156,18,92,166,28,102,176,38,112,186,48,122,196,58,132
      54:  00:57EF  52 9C 12 5C A6 1C 66 B0 26 70 BA 30 7A C4 3A 84 
      55:  00:57FF                      		db		206,68,142,4,78,152,14,88,162,24,98,172,34,108,182,44
      55:  00:57FF  CE 44 8E 04 4E 98 0E 58 A2 18 62 AC 22 6C B6 2C 
      56:  00:580F                      		db		118,192,54,128,202,64,138,0,74,148,10,84,158,20,94,168
      56:  00:580F  76 C0 36 80 CA 40 8A 00 4A 94 0A 54 9E 14 5E A8 
      57:  00:581F                      		db		30,104,178,40,114,188,50,124,198,60,134,208,70,144,6,80
      57:  00:581F  1E 68 B2 28 72 BC 32 7C C6 3C 86 D0 46 90 06 50 
      58:  00:582F                      		db		154,16,90,164,26,100,174,36,110,184
      58:  00:582F  9A 10 5A A4 1A 64 AE 24 6E B8 
      59:  00:5839                      
      60:  00:5839                      FINAL_FASE_5_VAMOS_A_TERMINAR_INICIO:
      61:  00:5839                      
      62:  00:5839                      		; Lanzamos FX 34 al empezar la secuencia final.
      63:  00:5839  3E 22               		ld		a,34
      64:  00:583B  0E 01               		ld		c,1
      65:  00:583D  CD 69 57            		call	TIRA_FX_BOSS_5
      66:  00:5840                      
      67:  00:5840                      		; Aseguramos que la page visible es la 2, que es donde vamos a pintar.
      68:  00:5840  3E 02               		ld		a,2
      69:  00:5842  32 59 C0            		ld		(SET_PAGE),a
      70:  00:5845                      
      71:  00:5845                      		; Copiamos la plantilla ROM al buffer real en RAM.
      72:  00:5845  21 C0 57            		ld		hl,FINAL_FASE_5_VAMOS_A_TERMINAR_PLANTILLA_HMMV
      73:  00:5848  11 5E C6            		ld		de,FINAL_FASE_5_VAMOS_A_TERMINAR_DATAS_HMMV
      74:  00:584B  01 0F 00            		ld		bc,15
      75:  00:584E  ED B0               		ldir
      76:  00:5850                              
      77:  00:5850  06 6A               		ld		b,106
      78:  00:5852  FD 21 CF 57         		ld		iy,FINAL_FASE_5_VAMOS_A_TERMINAR_TABLA_Y
      79:  00:5856                      
      80:  00:5856                      .BUCLE_FILAS_FINAL_FASE_5:
      81:  00:5856                      
      82:  00:5856  C5                  		push	bc
      83:  00:5857                      
      84:  00:5857                      		; DY = fila actual en page 2.
      85:  00:5857  FD 7E 00            		ld		a,(iy)
      86:  00:585A  FD 23               		inc		iy
      87:  00:585C  32 64 C6            		ld		(FINAL_FASE_5_VAMOS_A_TERMINAR_DATAS_HMMV+6),a
      88:  00:585F                      
      89:  00:585F                      		; Semilla X distinta para cada fila.
      90:  00:585F                      		; Como la tabla Y ya esta mezclada, esto evita que todas las filas
      91:  00:585F                      		; se borren con el mismo orden horizontal.
      92:  00:585F  CB 3F               		srl		a
      93:  00:5861  CB 3F               		srl		a
      94:  00:5863  C6 07               		add		a,7
      95:  00:5865  E6 3F               		and		00111111b
      96:  00:5867  32 6D C6            		ld		(FINAL_FASE_5_VAMOS_A_TERMINAR_X_SEED),a
      97:  00:586A                      
      98:  00:586A  06 40               		ld		b,64
      99:  00:586C                      
     100:  00:586C                      .BUCLE_COLUMNAS_FINAL_FASE_5:
     101:  00:586C                      
     102:  00:586C  C5                  		push	bc
     103:  00:586D  FD E5               		push	iy
     104:  00:586F                      
     105:  00:586F                      		; DX = (semilla X modulo 64) * 4.
     106:  00:586F  3A 6D C6            		ld		a,(FINAL_FASE_5_VAMOS_A_TERMINAR_X_SEED)
     107:  00:5872  E6 3F               		and		00111111b
     108:  00:5874  87                  		add		a,a
     109:  00:5875  87                  		add		a,a
     110:  00:5876  32 62 C6            		ld		(FINAL_FASE_5_VAMOS_A_TERMINAR_DATAS_HMMV+4),a
     111:  00:5879                      
     112:  00:5879                      		; Pintamos bloque negro 4x4 en page 2.
     113:  00:5879  21 5E C6            		ld		hl,FINAL_FASE_5_VAMOS_A_TERMINAR_DATAS_HMMV
     114:  00:587C  CD 2A 5E            		call	DOCOPY
     115:  00:587F  CD 33 5E            		call	VDPREADY
     116:  00:5882                      
     117:  00:5882                      		; Siguiente X pseudoaleatoria.
     118:  00:5882                      		; 21 es coprimo con 64, asi que recorre las 64 columnas
     119:  00:5882                      		; sin repetir ninguna dentro de la misma fila.
     120:  00:5882  3A 6D C6            		ld		a,(FINAL_FASE_5_VAMOS_A_TERMINAR_X_SEED)
     121:  00:5885  C6 15               		add		a,21
     122:  00:5887  E6 3F               		and		00111111b
     123:  00:5889  32 6D C6            		ld		(FINAL_FASE_5_VAMOS_A_TERMINAR_X_SEED),a
     124:  00:588C                      
     125:  00:588C  FD E1               		pop		iy
     126:  00:588E  C1                  		pop		bc
     127:  00:588F  10 DB               		djnz	.BUCLE_COLUMNAS_FINAL_FASE_5
     128:  00:5891                      
     129:  00:5891  C1                  		pop		bc
     130:  00:5892                      
     131:  00:5892                      		; Pausa corta entre filas para que el borrado respire.
     132:  00:5892  C5                  		push	bc
     133:  00:5893  01 00 04            		ld		bc,#0400
     134:  00:5896                      
     135:  00:5896                      .PAUSA_ENTRE_FILAS_FINAL_FASE_5:
     136:  00:5896                      
     137:  00:5896  0B                  		dec		bc
     138:  00:5897  78                  		ld		a,b
     139:  00:5898  B1                  		or		c
     140:  00:5899  20 FB               		jr		nz,.PAUSA_ENTRE_FILAS_FINAL_FASE_5
     141:  00:589B                      
     142:  00:589B  C1                  		pop		bc
     143:  00:589C                      
     144:  00:589C  10 B8               		djnz	.BUCLE_FILAS_FINAL_FASE_5
     145:  00:589E                      
     146:  00:589E                      ; Fin del include.
     147:  00:589E                      ; No hay ret.
     148:  00:589E                      ; El ensamblador continua con la siguiente linea de BOSS 5.asm:
     149:  00:589E                      ; VOLVEMOS_b5 -> jp CARGA_SLOT_REGRESO_A_JUEGO
    3081.  00:589E                      
