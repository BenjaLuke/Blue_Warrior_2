    2141.  00:4F0E                      		db		"apocalyptic vision. He knows what he has",0
    2141.  00:4F0E  61 70 6F 63 61 6C 79 70 74 69 63 20 76 69 73 69 
    2141.  00:4F1E  6F 6E 2E 20 48 65 20 6B 6E 6F 77 73 20 77 68 61 
