    2445.  00:52DD                      
    2446.  00:52DD  3A 0E C1            	ld		a,(CORAZONES)
    2447.  00:52E0  B7                  	or		a
    2448.  00:52E1  CA 08 53            	jp		z,MUERTE_DEPH_EN_BOSS_4
