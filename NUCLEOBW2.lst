    2245.  00:4DDD  3A 32 C6                    ld      a,(ROTATIVO_CONTADOR_PRESENTACION)
    2246.  00:4DE0  3C                          inc     a
    2247.  00:4DE1  FE 03                       cp      ROTATIVO_VELOCIDAD_PRESENTACION
    2248.  00:4DE3  30 04                       jr      nc,.MUEVE_ROTATIVO_PRESENTACION
    2249.  00:4DE5                      
