     221.  00:7055  CD 79 70            		call	ayFX_PLAY.SETMIXER							; Set PSG mixer value (a:=ayFX volume)
     222.  00:7058  32 DC C2            		ld	[ayFX_REGS+9],a							; Volume copied in to ayFX_REGS (channel B volume)
     223.  00:705B  CB 49               		bit	1,c										; If tone is off...
     224.  00:705D  C0                  		ret	nz										; ...return
     225.  00:705E  2A CE C2            		ld	hl,[ayFX_TONE]							; ayFX tone value
     226.  00:7061  22 D5 C2            		ld	[ayFX_REGS+2],hl						; copied in to ayFX_REGS (channel B tone)
     227.  00:7064  C9                  		ret											; Return
     228.  00:7065                      
     229.  00:7065                      ;.CHK3:												; --- Check if playing channel was 3 ---
     230.  00:7065                      
     231.  00:7065  CB 0A               		rrc	d										; Rotate right AND mask
     232.  00:7067  CB 0F               		rrc	a										; Rotate right OR mask
     233.  00:7069                      
     234.  00:7069                      ;.PLAY_A:											; --- Play ayFX stream on channel A ---
     235.  00:7069                      
