    1771.  00:4F6C                               ; --- Comprobar X ---
    1772.  00:4F6C                              ; Miramos si el centro dañino del proyectil entra dentro
    1773.  00:4F6C                              ; Deph: X_DEPH+4 .. X_DEPH+17
    1774.  00:4F6C                      
    1775.  00:4F6C  DD 7E 00                    ld      a,(ix+0)        ; X proyectil
    1776.  00:4F6F  C6 06                       add     a,6             ; inicio de los 4 px centrales del proyectil
    1777.  00:4F71  4F                          ld      c,a
    1778.  00:4F72                      
    1779.  00:4F72  3A 64 C0                    ld      a,(X_DEPH)
    1780.  00:4F75  3C                          inc     a
    1781.  00:4F76  57                          ld      d,a
    1782.  00:4F77                      
    1783.  00:4F77  79                          ld      a,c
    1784.  00:4F78  92                          sub     d               ; centroX_proyectil - X_DEPH
    1785.  00:4F79  FE 11                       cp      17              ; Deph X+4..X+17 compensado con proyectil 4 px
    1786.  00:4F7B  30 19                       jr      nc,.SIGUIENTE_PROYECTIL__BOSS_1
    1787.  00:4F7D                      
    1788.  00:4F7D                      
    1789.  00:4F7D                              ; --- Comprobar Y ---
    1790.  00:4F7D                              ; Miramos si el centro dañino del proyectil entra dentro
    1791.  00:4F7D                              ; Deph: Y_DEPH+10 .. Y_DEPH+30
    1792.  00:4F7D                      
    1793.  00:4F7D  FD 7E 00                    ld      a,(iy+0)        ; Y proyectil
    1794.  00:4F80  C6 06                       add     a,6             ; inicio de los 4 px centrales del proyectil
