    2156.  00:4FE5  (00:00C3)           ROTATIVO_Y_PRESENTACION                  equ     195
    2157.  00:4FE5                      
    2158.  00:4FE5                      ; Cada cuántos frames se actualiza el rotativo.
    2159.  00:4FE5                      ; 1 = cada frame, 2 = cada dos frames, etc.
    2160.  00:4FE5  (00:0003)           ROTATIVO_VELOCIDAD_PRESENTACION          equ     3
    2161.  00:4FE5                      
    2162.  00:4FE5                      ; El nuevo rotativo avanza copiando la franja 2 píxeles a la izquierda.
    2163.  00:4FE5                      ; Cada letra mide 6 píxeles, así que se introduce en 3 pasos:
    2164.  00:4FE5                      ;   paso 0 -> X=254
    2165.  00:4FE5                      ;   paso 1 -> X=252
    2166.  00:4FE5                      ;   paso 2 -> X=250
    2167.  00:4FE5  (00:0002)           ROTATIVO_PIXELES_POR_PASO_PRESENTACION   equ     2
    2168.  00:4FE5  (00:0003)           ROTATIVO_PASOS_POR_LETRA_PRESENTACION    equ     3
    2169.  00:4FE5  (00:00FE)           ROTATIVO_X_ENTRADA_PRESENTACION          equ     254
    2170.  00:4FE5  (00:00FE)           ROTATIVO_ANCHO_SCROLL_PRESENTACION       equ     254
    2171.  00:4FE5  (00:0008)           ROTATIVO_ALTO_PRESENTACION               equ     8
    2172.  00:4FE5                      
    2173.  00:4FE5                      ; Cuando se acaba el texto, metemos espacios hasta que toda la cola sale
    2174.  00:4FE5                      ; por la izquierda. 43 espacios * 6 píxeles = 258 píxeles.
    2175.  00:4FE5  (00:002B)           ROTATIVO_ESPACIOS_SALIDA_PRESENTACION    equ     43
    2176.  00:4FE5                      
    2177.  00:4FE5                      
