    2582.  00:5375                      
    2583.  00:5375  FD 21 9A C2         		ld		iy,DATAS_COPY_RECUP_SCROLL
    2584.  00:5379                      
    2585.  00:5379                      		; Página fuente según dirección.
    2586.  00:5379                      
    2587.  00:5379  3A 6B C6            		ld		a,(AGONIX_BOSS_1_DIRECCION)
    2588.  00:537C  B7                  		or		a
