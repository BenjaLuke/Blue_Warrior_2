    2557.  00:5329                      
    2558.  00:5329                      		; Página fuente según dirección.
    2559.  00:5329                      
    2560.  00:5329  3A 78 C6            		ld		a,(AGONIX_BOSS_1_DIRECCION)
    2561.  00:532C  B7                  		or		a
