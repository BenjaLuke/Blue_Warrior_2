    1830.  00:4FAA                      REVISAMOS_COLISION_CON_AGONIX_Y_DEPH:
    1831.  00:4FAA                      
    1832.  00:4FAA                      		; Hitbox Agonix reducido 20 px por cada lado.
    1833.  00:4FAA                      		; Deph se sigue tratando como caja aproximada de 20x20.
    1834.  00:4FAA                      		;
    1835.  00:4FAA                      		; Agonix original:
    1836.  00:4FAA                      		; X = AGONIX_BOSS_1_X
    1837.  00:4FAA                      		; W = AGONIX_MOVIMIENTO_ANCHO_BOSS_1
    1838.  00:4FAA                      		; Y = AGONIX_MOVIMIENTO_Y_BOSS_1
    1839.  00:4FAA                      		; H = AGONIX_MOVIMIENTO_ALTO_BOSS_1
    1840.  00:4FAA                      		;
    1841.  00:4FAA                      		; Agonix reducido:
    1842.  00:4FAA                      		; X izquierda = X + 20
    1843.  00:4FAA                      		; X derecha   = X + ancho - 20
    1844.  00:4FAA                      		; Y arriba    = Y + 20
    1845.  00:4FAA                      		; Y abajo     = Y + alto - 20
    1846.  00:4FAA                      
    1847.  00:4FAA  3A 79 C6            		ld		a,(AGONIX_BOSS_1_X)
    1848.  00:4FAD  C6 14               		add		20
    1849.  00:4FAF  4F                  		ld		c,a
    1850.  00:4FB0  3A 64 C0            		ld		a,(X_DEPH)
    1851.  00:4FB3  C6 14               		add		20
    1852.  00:4FB5  B9                  		cp		c
    1853.  00:4FB6  D8                  		ret		c
    1854.  00:4FB7                      
    1855.  00:4FB7  3A 79 C6            		ld		a,(AGONIX_BOSS_1_X)
    1856.  00:4FBA  C6 6E               		add		AGONIX_MOVIMIENTO_ANCHO_BOSS_1-20
    1857.  00:4FBC  4F                  		ld		c,a
    1858.  00:4FBD  3A 64 C0            		ld		a,(X_DEPH)
    1859.  00:4FC0  B9                  		cp		c
    1860.  00:4FC1  D0                  		ret		nc
    1861.  00:4FC2                      
    1862.  00:4FC2  3A 65 C0            		ld		a,(Y_DEPH)
    1863.  00:4FC5  C6 14               		add		20
