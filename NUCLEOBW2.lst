    3023.  00:6F1C                      
    3024.  00:6F1C                      ;DATOS_LIMPIA_PAGE_0_FIN_BOSS:
    3025.  00:6F1C                      
    3026.  00:6F1C                      		dw		#0000,#0000,#0000,#00AF,#0100,#0051
    3026.  00:6F1C  00 00 00 00 00 00 AF 00 00 01 51 00 
    3027.  00:6F28  00 00 C0            		db		#00,#00,11000000b
    3028.  00:6F2B                      
    3029.  00:6F2B                      ;DATOS_LIMPIA_PAGE_3_FIN_BOSS:
    3030.  00:6F2B                      
    3031.  00:6F2B                      		dw		#0000,#0000,#0000,#0300,#0100,#0100
