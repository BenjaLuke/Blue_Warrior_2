       9.  00:4520                      FM_ENCONTRADO:
      10.  00:4520                      
      11.  00:4520  FE FF               			cp		0FFh
      12.  00:4522  C8                  			ret		z 														; No FM!!!
      13.  00:4523                      			
      14.  00:4523  4F                  			ld		c,a														; Slot
      15.  00:4524  C5                  			push	bc														; C ->slot FM
      16.  00:4525                      			
