      59.  00:4560  C1                  			pop		bc
      60.  00:4561  C8                  			ret		z														; Si es diferente de FFh -> Encontrado!!!
      61.  00:4562  23                  			inc		hl
      62.  00:4563  0C                  			inc		c
      63.  00:4564  10 E8               			djnz	SIGUIENTE_SLOT
