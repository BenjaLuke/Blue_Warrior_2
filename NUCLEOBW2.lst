    2963.  00:6F2F  00 00 00 00 00 00 AF 00 00 01 51 00 
    2964.  00:6F3B  00 00 C0            		db		#00,#00,11000000b
    2965.  00:6F3E                      
    2966.  00:6F3E                      ;DATOS_LIMPIA_PAGE_3_FIN_BOSS:
