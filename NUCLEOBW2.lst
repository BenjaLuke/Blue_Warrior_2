    2955.  00:6F18  32 0E C1            		ld		(CORAZONES),a
    2956.  00:6F1B  28 12               		jr		z,.MUERE_DEPH_EN_BOSS_COMUN
    2957.  00:6F1D                      
    2958.  00:6F1D  3E 03               		ld		a,3
    2959.  00:6F1F  0E 01               		ld		c,1
    2960.  00:6F21  CD ED 6D            		call	A_31_DESDE_10
    2961.  00:6F24                      
