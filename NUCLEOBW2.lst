      59.  00:455D  C1                  			pop		bc
      60.  00:455E  C8                  			ret		z														; Si es diferente de FFh -> Encontrado!!!
      61.  00:455F  23                  			inc		hl
      62.  00:4560  0C                  			inc		c
      63.  00:4561  10 E8               			djnz	SIGUIENTE_SLOT
      64.  00:4563  3E FF               			ld		a,0FFh													; El FM no ha sido encontrado, por tanto->A=0FFh
