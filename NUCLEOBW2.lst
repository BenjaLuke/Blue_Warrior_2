    2239.  00:4E79                      ; -----------------------------------------------------------------------------
    2240.  00:4E79                      ; Limpia las franjas que deja Chuminix al desplazarse.
    2241.  00:4E79                      ; Se llama DESPUES de pintar el copy nuevo.
    2242.  00:4E79                      ;
    2243.  00:4E79                      ; VARIABLE_UN_USO  = X anterior
    2244.  00:4E79                      ; VARIABLE_UN_USO2 = Y anterior
    2245.  00:4E79                      ;
    2246.  00:4E79                      ; Secuencia 1 y 2:
    2247.  00:4E79                      ;   X crece   -> X nueva - deltaX, Y nueva, ancho deltaX, alto Chuminix
    2248.  00:4E79                      ;   X decrece -> X nueva + ancho Chuminix, Y nueva, ancho deltaX, alto Chuminix
    2249.  00:4E79                      ;   Y crece   -> X nueva, Y nueva - deltaY, ancho Chuminix, alto deltaY
    2250.  00:4E79                      ;   Y decrece -> X nueva, Y nueva + alto Chuminix, ancho Chuminix, alto deltaY
    2251.  00:4E79                      ; -----------------------------------------------------------------------------
