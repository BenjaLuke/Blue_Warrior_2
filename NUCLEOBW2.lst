       1:  00:57DF                      ; -----------------------------------------------------------------------------
       2:  00:57DF                      ; FINAL FASE 5 VAMOS A TERMINAR.asm
       3:  00:57DF                      ;
       4:  00:57DF                      ; Include ejecutado desde BOSS 5.asm en la etiqueta FINAL_b5.
       5:  00:57DF                      ;
       6:  00:57DF                      ; Objetivo:
       7:  00:57DF                      ;   - Borrar visualmente la page 2 visible.
       8:  00:57DF                      ;   - Pintar bloques negros en orden pseudoaleatorio.
       9:  00:57DF                      ;   - No repetir nunca el mismo bloque.
      10:  00:57DF                      ;   - Al terminar, NO hacer ret ni jp: el flujo cae al codigo siguiente
      11:  00:57DF                      ;     del include, es decir, VOLVEMOS_b5.
      12:  00:57DF                      ;
      13:  00:57DF                      ; Nota:
      14:  00:57DF                      ;   La pantalla se divide en bloques de 4x4.
      15:  00:57DF                      ;   64 columnas x 53 filas = 3392 bloques.
      16:  00:57DF                      ;   Cada bloque se pinta una sola vez mediante HMMV.
      17:  00:57DF                      ; -----------------------------------------------------------------------------
      18:  00:57DF                      
      19:  00:57DF  C3 5B 58            		jp		FINAL_FASE_5_VAMOS_A_TERMINAR_INICIO
      20:  00:57E2                      
      21:  00:57E2                      ; Buffer de comando VDP.
      22:  00:57E2                      ; Formato DOCOPY:
      23:  00:57E2                      ;   0-1   SX
      24:  00:57E2                      ;   2-3   SY
      25:  00:57E2                      ;   4-5   DX
      26:  00:57E2                      ;   6-7   DY
      27:  00:57E2                      ;   8-9   NX
      28:  00:57E2                      ;   10-11 NY
      29:  00:57E2                      ;   12    color
      30:  00:57E2                      ;   13    argumento
      31:  00:57E2                      ;   14    comando
      32:  00:57E2                      ;
      33:  00:57E2                      ; HMMV (#C0) rellena un rectangulo con un color.
      34:  00:57E2                      ; DY alto = 2 para pintar en la page 2.
      35:  00:57E2                      FINAL_FASE_5_VAMOS_A_TERMINAR_PLANTILLA_HMMV:
      36:  00:57E2                      
      37:  00:57E2  00 00 00 00         		db		0,0,0,0
      38:  00:57E6  00 00               		db		0,0
      39:  00:57E8  00 02               		db		0,PAGE_2_VRAM_Y_BOSS_5/256
      40:  00:57EA  04 00               		db		4,0
      41:  00:57EC  02 00               		db		2,0
      42:  00:57EE  00                  		db		#00
      43:  00:57EF  00                  		db		#00
      44:  00:57F0  C0                  		db		COPY_LOGICA_RELLENO_BOSS_5
      45:  00:57F1                      
      46:  00:57F1                      ; Filas en orden pseudoaleatorio.
      47:  00:57F1                      ; Son las 53 filas de bloques de 4 pixeles: 0,4,8,...,208,
      48:  00:57F1                      ; pero mezcladas. No hay repeticiones.
      49:  00:57F1                      
      50:  00:57F1                      FINAL_FASE_5_VAMOS_A_TERMINAR_TABLA_Y:
      51:  00:57F1                      
      52:  00:57F1                      		db		46,120,194,56,130,204,66,140,2,76,150,12,86,160,22,96
      52:  00:57F1  2E 78 C2 38 82 CC 42 8C 02 4C 96 0C 56 A0 16 60 
      53:  00:5801                      		db		170,32,106,180,42,116,190,52,126,200,62,136,210,72,146,8
      53:  00:5801  AA 20 6A B4 2A 74 BE 34 7E C8 3E 88 D2 48 92 08 
      54:  00:5811                      		db		82,156,18,92,166,28,102,176,38,112,186,48,122,196,58,132
      54:  00:5811  52 9C 12 5C A6 1C 66 B0 26 70 BA 30 7A C4 3A 84 
      55:  00:5821                      		db		206,68,142,4,78,152,14,88,162,24,98,172,34,108,182,44
      55:  00:5821  CE 44 8E 04 4E 98 0E 58 A2 18 62 AC 22 6C B6 2C 
      56:  00:5831                      		db		118,192,54,128,202,64,138,0,74,148,10,84,158,20,94,168
      56:  00:5831  76 C0 36 80 CA 40 8A 00 4A 94 0A 54 9E 14 5E A8 
      57:  00:5841                      		db		30,104,178,40,114,188,50,124,198,60,134,208,70,144,6,80
      57:  00:5841  1E 68 B2 28 72 BC 32 7C C6 3C 86 D0 46 90 06 50 
      58:  00:5851                      		db		154,16,90,164,26,100,174,36,110,184
      58:  00:5851  9A 10 5A A4 1A 64 AE 24 6E B8 
      59:  00:585B                      
      60:  00:585B                      FINAL_FASE_5_VAMOS_A_TERMINAR_INICIO:
      61:  00:585B                      
      62:  00:585B                      		; Lanzamos FX 34 al empezar la secuencia final.
      63:  00:585B  3E 22               		ld		a,34
      64:  00:585D  0E 01               		ld		c,1
      65:  00:585F  CD 83 57            		call	TIRA_FX_BOSS_5
      66:  00:5862                      
      67:  00:5862                      		; Aseguramos que la page visible es la 2, que es donde vamos a pintar.
      68:  00:5862  3E 02               		ld		a,2
      69:  00:5864  32 4A C0            		ld		(SET_PAGE),a
      70:  00:5867                      
      71:  00:5867                      		; Copiamos la plantilla ROM al buffer real en RAM.
      72:  00:5867  21 E2 57            		ld		hl,FINAL_FASE_5_VAMOS_A_TERMINAR_PLANTILLA_HMMV
      73:  00:586A  11 4F C6            		ld		de,FINAL_FASE_5_VAMOS_A_TERMINAR_DATAS_HMMV
      74:  00:586D  01 0F 00            		ld		bc,15
      75:  00:5870  ED B0               		ldir
      76:  00:5872                              
      77:  00:5872  06 6A               		ld		b,106
      78:  00:5874  FD 21 F1 57         		ld		iy,FINAL_FASE_5_VAMOS_A_TERMINAR_TABLA_Y
      79:  00:5878                      
      80:  00:5878                      .BUCLE_FILAS_FINAL_FASE_5:
      81:  00:5878                      
      82:  00:5878  C5                  		push	bc
      83:  00:5879                      
      84:  00:5879                      		; DY = fila actual en page 2.
      85:  00:5879  FD 7E 00            		ld		a,(iy)
      86:  00:587C  FD 23               		inc		iy
      87:  00:587E  32 55 C6            		ld		(FINAL_FASE_5_VAMOS_A_TERMINAR_DATAS_HMMV+6),a
      88:  00:5881                      
      89:  00:5881                      		; Semilla X distinta para cada fila.
      90:  00:5881                      		; Como la tabla Y ya esta mezclada, esto evita que todas las filas
      91:  00:5881                      		; se borren con el mismo orden horizontal.
      92:  00:5881  CB 3F               		srl		a
      93:  00:5883  CB 3F               		srl		a
      94:  00:5885  C6 07               		add		a,7
      95:  00:5887  E6 3F               		and		00111111b
      96:  00:5889  32 5E C6            		ld		(FINAL_FASE_5_VAMOS_A_TERMINAR_X_SEED),a
      97:  00:588C                      
      98:  00:588C  06 40               		ld		b,64
      99:  00:588E                      
     100:  00:588E                      .BUCLE_COLUMNAS_FINAL_FASE_5:
     101:  00:588E                      
     102:  00:588E  C5                  		push	bc
     103:  00:588F  FD E5               		push	iy
     104:  00:5891                      
     105:  00:5891                      		; DX = (semilla X modulo 64) * 4.
     106:  00:5891  3A 5E C6            		ld		a,(FINAL_FASE_5_VAMOS_A_TERMINAR_X_SEED)
     107:  00:5894  E6 3F               		and		00111111b
     108:  00:5896  87                  		add		a,a
     109:  00:5897  87                  		add		a,a
     110:  00:5898  32 53 C6            		ld		(FINAL_FASE_5_VAMOS_A_TERMINAR_DATAS_HMMV+4),a
     111:  00:589B                      
     112:  00:589B                      		; Pintamos bloque negro 4x4 en page 2.
     113:  00:589B  21 4F C6            		ld		hl,FINAL_FASE_5_VAMOS_A_TERMINAR_DATAS_HMMV
     114:  00:589E  CD 2A 5E            		call	DOCOPY
     115:  00:58A1  CD 33 5E            		call	VDPREADY
     116:  00:58A4                      
     117:  00:58A4                      		; Siguiente X pseudoaleatoria.
     118:  00:58A4                      		; 21 es coprimo con 64, asi que recorre las 64 columnas
     119:  00:58A4                      		; sin repetir ninguna dentro de la misma fila.
     120:  00:58A4  3A 5E C6            		ld		a,(FINAL_FASE_5_VAMOS_A_TERMINAR_X_SEED)
     121:  00:58A7  C6 15               		add		a,21
     122:  00:58A9  E6 3F               		and		00111111b
     123:  00:58AB  32 5E C6            		ld		(FINAL_FASE_5_VAMOS_A_TERMINAR_X_SEED),a
     124:  00:58AE                      
     125:  00:58AE  FD E1               		pop		iy
     126:  00:58B0  C1                  		pop		bc
     127:  00:58B1  10 DB               		djnz	.BUCLE_COLUMNAS_FINAL_FASE_5
     128:  00:58B3                      
     129:  00:58B3  C1                  		pop		bc
     130:  00:58B4                      
     131:  00:58B4                      		; Pausa corta entre filas para que el borrado respire.
     132:  00:58B4  C5                  		push	bc
     133:  00:58B5  01 00 04            		ld		bc,#0400
     134:  00:58B8                      
     135:  00:58B8                      .PAUSA_ENTRE_FILAS_FINAL_FASE_5:
     136:  00:58B8                      
     137:  00:58B8  0B                  		dec		bc
     138:  00:58B9  78                  		ld		a,b
     139:  00:58BA  B1                  		or		c
     140:  00:58BB  20 FB               		jr		nz,.PAUSA_ENTRE_FILAS_FINAL_FASE_5
     141:  00:58BD                      
     142:  00:58BD  C1                  		pop		bc
     143:  00:58BE                      
     144:  00:58BE  10 B8               		djnz	.BUCLE_FILAS_FINAL_FASE_5
     145:  00:58C0                      
     146:  00:58C0                      ; Fin del include.
     147:  00:58C0                      ; No hay ret.
     148:  00:58C0                      ; El ensamblador continua con la siguiente linea de BOSS 5.asm:
     149:  00:58C0                      ; VOLVEMOS_b5 -> jp CARGA_SLOT_REGRESO_A_JUEGO
