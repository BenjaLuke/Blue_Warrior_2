    2940.  00:6EB6  C6 0F               		add		15
    2941.  00:6EB8  CD 96 5F            		call	CHANGE_BANK_2
    2942.  00:6EBB  21 00 80            		ld		hl,#8000
    2943.  00:6EBE  11 00 C0            		ld		de,#C000
    2944.  00:6EC1  01 00 40            		ld		bc,16384
