    1761.  00:48BF                      ; Si Y_DEPH >= 85: sprites de pies en lodo.
    1762.  00:48BF                      ;
    1763.  00:48BF                      ; IMPORTANTE:
    1764.  00:48BF                      ; La rutina comun de movimiento debe ejecutarse SIEMPRE.
    1765.  00:48BF                      ; Las pruebas anteriores que saltaban MOVIMIENTO_DEPH_EN_BOSS_4 o restauraban X/Y
    1766.  00:48BF                      ; dejaban a Deph bloqueado o descolocaban sus limites internos.
    1767.  00:48BF                      ; Aqui no tocamos coordenadas, no restauramos posiciones y no cortamos el flujo.
    1768.  00:48BF                      ; -----------------------------------------------------------------------------
    1769.  00:48BF                      CONTROL_LODO_Y_MOVIMIENTO_DEPH_BOSS_4:
    1770.  00:48BF                      
    1771.  00:48BF  3A 65 C0            		ld		a,(Y_DEPH)
    1772.  00:48C2  FE 55               		cp		DEPH_LODO_LIMITE_Y_BOSS_4
    1773.  00:48C4  30 06               		jr		nc,.DEPH_EN_LODO_BOSS_4
