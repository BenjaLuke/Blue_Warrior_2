       1.  00:72C7                      ; ROMAN: PAR
       2.  00:72C7                      ;INICIAMOS_MUSICA:
       3.  00:72C7                      
       4.  00:72C7  AF                  		xor		a														;le damos 0 a la posicion de arranque de la música
