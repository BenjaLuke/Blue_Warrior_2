      21.  00:452D  CB CF               			set		1,a														; Lo convierte en xxxxxx1x para indicar que es estero
      22.  00:452F  32 DF C2            			ld		(chips),a												; Lo salva para futuros usos
      23.  00:4532                      					
      24.  00:4532  79                  			ld		a,c														; Slot
      25.  00:4533  21 F6 7F            			ld		hl,#7FF6
      26.  00:4536  CD 0C 00            			call	RDSLT
      27.  00:4539                      			
      28.  00:4539  F6 01               			or		00000001B		
      29.  00:453B  5F                  			ld		e,a														; Valor a escribir
      30.  00:453C                      
      31.  00:453C  C1                  			pop		bc
      32.  00:453D  79                  			ld		a,c
      33.  00:453E  21 F6 7F            			ld		hl,#7FF6
      34.  00:4541  CD 14 00            			call	WRSLT
