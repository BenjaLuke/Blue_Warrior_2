      67.  00:455E                      EXPANSION:
      68.  00:455E                      
      69.  00:455E  E6 80               			and		080h
      70.  00:4560  B1                  			or		c
      71.  00:4561  4F                  			ld		c,a														; Slot más expandido o no
      72.  00:4562  06 04               			ld		b,4
