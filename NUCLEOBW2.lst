       1:  00:5B6A                      ; -----------------------------------------------------------------------------
       2:  00:5B6A                      ; FINAL FASE 5 VAMOS A TERMINAR.asm
       3:  00:5B6A                      ;
       4:  00:5B6A                      ; Include ejecutado desde BOSS 5.asm en la etiqueta FINAL_b5.
       5:  00:5B6A                      ;
       6:  00:5B6A                      ; Objetivo:
       7:  00:5B6A                      ;   - Borrar visualmente la page 2 visible.
       8:  00:5B6A                      ;   - Pintar bloques negros en orden pseudoaleatorio.
       9:  00:5B6A                      ;   - No repetir nunca el mismo bloque.
      10:  00:5B6A                      ;   - Al terminar, NO hacer ret ni jp: el flujo cae al codigo siguiente
      11:  00:5B6A                      ;     del include, es decir, VOLVEMOS_b5.
      12:  00:5B6A                      ;
      13:  00:5B6A                      ; Nota:
      14:  00:5B6A                      ;   La pantalla se divide en bloques de 4x4.
      15:  00:5B6A                      ;   64 columnas x 53 filas = 3392 bloques.
      16:  00:5B6A                      ;   Cada bloque se pinta una sola vez mediante HMMV.
      17:  00:5B6A                      ; -----------------------------------------------------------------------------
      18:  00:5B6A                      
      19:  00:5B6A  C3 E6 5B            		jp		FINAL_FASE_5_VAMOS_A_TERMINAR_INICIO
      20:  00:5B6D                      
      21:  00:5B6D                      
      22:  00:5B6D  (00:0004)           FINAL_FASE_5_VAMOS_A_TERMINAR_ANCHO_BLOQUE:	equ	4
      23:  00:5B6D  (00:0002)           FINAL_FASE_5_VAMOS_A_TERMINAR_ALTO_BLOQUE:	equ	2
      24:  00:5B6D  (00:0040)           FINAL_FASE_5_VAMOS_A_TERMINAR_COLUMNAS:		equ	64
      25:  00:5B6D  (00:006A)           FINAL_FASE_5_VAMOS_A_TERMINAR_FILAS:		equ	106
      26:  00:5B6D  (00:0015)           FINAL_FASE_5_VAMOS_A_TERMINAR_SALTO_X:		equ	21
      27:  00:5B6D  (00:000F)           FINAL_FASE_5_VAMOS_A_TERMINAR_BYTES_HMMV:	equ	15
      28:  00:5B6D  (00:0400)           FINAL_FASE_5_VAMOS_A_TERMINAR_PAUSA_FILAS:	equ	#0400
      29:  00:5B6D                      
      30:  00:5B6D                      ; Buffer de comando VDP.
      31:  00:5B6D                      ; Formato DOCOPY:
      32:  00:5B6D                      ;   0-1   SX
      33:  00:5B6D                      ;   2-3   SY
      34:  00:5B6D                      ;   4-5   DX
      35:  00:5B6D                      ;   6-7   DY
      36:  00:5B6D                      ;   8-9   NX
      37:  00:5B6D                      ;   10-11 NY
      38:  00:5B6D                      ;   12    color
      39:  00:5B6D                      ;   13    argumento
      40:  00:5B6D                      ;   14    comando
      41:  00:5B6D                      ;
      42:  00:5B6D                      ; HMMV (#C0) rellena un rectangulo con un color.
      43:  00:5B6D                      ; DY alto = 2 para pintar en la page 2.
      44:  00:5B6D                      FINAL_FASE_5_VAMOS_A_TERMINAR_PLANTILLA_HMMV:
      45:  00:5B6D                      
      46:  00:5B6D  00 00 00 00         		db		0,0,0,0
      47:  00:5B71  00 00               		db		0,0
      48:  00:5B73  00 02               		db		0,PAGE_2_VRAM_Y_BOSS_5/256
      49:  00:5B75  04 00               		db		FINAL_FASE_5_VAMOS_A_TERMINAR_ANCHO_BLOQUE,0
      50:  00:5B77  02 00               		db		FINAL_FASE_5_VAMOS_A_TERMINAR_ALTO_BLOQUE,0
      51:  00:5B79  00                  		db		#00
      52:  00:5B7A  00                  		db		#00
      53:  00:5B7B  C0                  		db		COPY_LOGICA_RELLENO_BOSS_5
      54:  00:5B7C                      
      55:  00:5B7C                      ; Filas en orden pseudoaleatorio.
      56:  00:5B7C                      ; Son las 53 filas de bloques de 4 pixeles: 0,4,8,...,208,
      57:  00:5B7C                      ; pero mezcladas. No hay repeticiones.
      58:  00:5B7C                      
      59:  00:5B7C                      FINAL_FASE_5_VAMOS_A_TERMINAR_TABLA_Y:
      60:  00:5B7C                      
      61:  00:5B7C                      		db		46,120,194,56,130,204,66,140,2,76,150,12,86,160,22,96
      61:  00:5B7C  2E 78 C2 38 82 CC 42 8C 02 4C 96 0C 56 A0 16 60 
      62:  00:5B8C                      		db		170,32,106,180,42,116,190,52,126,200,62,136,210,72,146,8
      62:  00:5B8C  AA 20 6A B4 2A 74 BE 34 7E C8 3E 88 D2 48 92 08 
      63:  00:5B9C                      		db		82,156,18,92,166,28,102,176,38,112,186,48,122,196,58,132
      63:  00:5B9C  52 9C 12 5C A6 1C 66 B0 26 70 BA 30 7A C4 3A 84 
      64:  00:5BAC                      		db		206,68,142,4,78,152,14,88,162,24,98,172,34,108,182,44
      64:  00:5BAC  CE 44 8E 04 4E 98 0E 58 A2 18 62 AC 22 6C B6 2C 
      65:  00:5BBC                      		db		118,192,54,128,202,64,138,0,74,148,10,84,158,20,94,168
      65:  00:5BBC  76 C0 36 80 CA 40 8A 00 4A 94 0A 54 9E 14 5E A8 
      66:  00:5BCC                      		db		30,104,178,40,114,188,50,124,198,60,134,208,70,144,6,80
      66:  00:5BCC  1E 68 B2 28 72 BC 32 7C C6 3C 86 D0 46 90 06 50 
      67:  00:5BDC                      		db		154,16,90,164,26,100,174,36,110,184
      67:  00:5BDC  9A 10 5A A4 1A 64 AE 24 6E B8 
