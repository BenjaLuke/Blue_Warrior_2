    2568.  00:5333                      
    2569.  00:5333  FD 77 03            		ld		(iy+3),a							; page origen: 3 o 1
    2570.  00:5336                      
    2571.  00:5336                      
    2572.  00:5336                      		; Origen: primer recuadro arriba izquierda.
    2573.  00:5336                      		; x=0, y=0. La page ya la hemos puesto en iy+3.
    2574.  00:5336                      
    2575.  00:5336  AF                  		xor		a
    2576.  00:5337  FD 77 00            		ld		(iy),a								; origen x low
    2577.  00:533A  FD 77 01            		ld		(iy+1),a							; origen x high
    2578.  00:533D  FD 77 02            		ld		(iy+2),a							; origen y low
    2579.  00:5340                      
    2580.  00:5340                      
    2581.  00:5340                      		; Destino X: posición actual de Agonix en page 2.
    2582.  00:5340                      
    2583.  00:5340  3A 77 C6            		ld		a,(AGONIX_BOSS_1_X)
    2584.  00:5343  FD 77 04            		ld		(iy+4),a							; destino x low
    2585.  00:5346  AF                  		xor		a
    2586.  00:5347  FD 77 05            		ld		(iy+5),a							; destino x high
    2587.  00:534A                      
    2588.  00:534A                      
    2589.  00:534A                      		; Recuperamos el contador externo del bucle.
    2590.  00:534A                      		; B = altura actual que vamos a copiar.
    2591.  00:534A                      		; Primera vuelta: B = 48.
    2592.  00:534A                      		; Última vuelta: B = 1.
    2593.  00:534A                      		; Cuando B llega a 0, el djnz de fuera termina la animación.
    2594.  00:534A                      
    2595.  00:534A  C1                  		pop		bc
    2596.  00:534B  C5                  		push	bc
    2597.  00:534C                      
    2598.  00:534C                      		; offset = altura inicial - altura actual.
    2599.  00:534C                      		; Este offset baja el destino.
    2600.  00:534C                      
    2601.  00:534C  3E 30               		ld		a,AGONIX_MUERTE_ALTO_BOSS_1
    2602.  00:534E  90                  		sub		b
    2603.  00:534F  4F                  		ld		c,a									; C = offset vertical
    2604.  00:5350                      
    2605.  00:5350                      
    2606.  00:5350                      		; Destino Y = y actual de Agonix + offset.
    2607.  00:5350                      		; Page destino sigue siendo page 2.
    2608.  00:5350                      
    2609.  00:5350  3E 42               		ld		a,AGONIX_MOVIMIENTO_Y_BOSS_1
    2610.  00:5352  81                  		add		c
    2611.  00:5353  FD 77 06            		ld		(iy+6),a							; destino y low
    2612.  00:5356                      
    2613.  00:5356  3E 02               		ld		a,PAGE_2_VRAM_Y_BOSS_1 / 256
    2614.  00:5358  FD 77 07            		ld		(iy+7),a							; destino page 2
    2615.  00:535B                      
    2616.  00:535B                      
    2617.  00:535B                      		; Tamaño destino/fuente:
    2618.  00:535B                      		; ancho fijo, altura decreciendo.
    2619.  00:535B                      
    2620.  00:535B  78                  		ld		a,b
    2621.  00:535C  FD 77 0A            		ld		(iy+10),a							; alto low = B
    2622.  00:535F  AF                  		xor		a
    2623.  00:5360  FD 77 0B            		ld		(iy+11),a							; alto high = 0
