    2494.  00:531D  D8                  		ret		c
    2495.  00:531E                      
    2496.  00:531E                      		; Comprueba borde derecho reducido:
    2497.  00:531E                      		; Deph izquierda < Errecenyx derecha - 20
    2498.  00:531E  3A A6 C2            		ld		a,(VARIABLE_UN_USO3)
    2499.  00:5321  4F                  		ld		c,a
    2500.  00:5322  3A A5 C2            		ld		a,(VARIABLE_UN_USO2)
    2501.  00:5325  81                  		add		c
