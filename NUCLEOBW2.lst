    2174.  00:4FE9  32 10 C6                    ld      (ROTATIVO_REPETICION_LETRA_PRESENTACION),a
    2175.  00:4FEC  32 11 C6                    ld      (ROTATIVO_MODO_SALIDA_PRESENTACION),a
    2176.  00:4FEF                      
