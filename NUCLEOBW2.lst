    1277   00:6F14                      		include "AUDIOS/LANZADOR EFECTOS PSG (sin etiquetas).asm"
       1.  00:6F14                      ; ROMAN: PAR
       2.  00:6F14                      													; --- ayFX REPLAYER v2.0M ---
       3.  00:6F14                      
       4.  00:6F14                      													; --- v2.0T  New ayFX replayer routine. T -> Triple FX replayer
       5.  00:6F14                      
       6.  00:6F14                      ;ayFX_SETUP:											; ---          ayFX replayer setup          ---
       7.  00:6F14                      													; --- INPUT: HL -> pointer to the ayFX bank ---
       8.  00:6F14  22 C1 C2            		ld	[ayFX_BANK],hl							; Current ayFX bank
       9.  00:6F17                      ;ayFX_STOP:	
      10.  00:6F17                      		
      11.  00:6F17  3E FF               		ld	a,255									; Lowest ayFX priority
      12.  00:6F19  32 C3 C2            		ld	[ayFX_C1],a								; First channel minimum priority
      13.  00:6F1C  32 C6 C2            		ld	[ayFX_C2],a								; First channel minimum priority
      14.  00:6F1F  32 C9 C2            		ld	[ayFX_C3],a								; First channel minimum priority
      15.  00:6F22  C9                  		ret											; Return
      16.  00:6F23                      ;ayFX_END:											; --- End of an ayFX stream ---
      17.  00:6F23                      
      18.  00:6F23  DD 36 00 FF         		ld	[IX],255								; Priority saved (not playing ayFX stream)
      19.  00:6F27  C9                  		ret											; Return
      20.  00:6F28                      
      21.  00:6F28                      ;ayFX_INIT:											; ---     INIT A NEW ayFX STREAM     ---
      22.  00:6F28                      													; --- INPUT: A -> sound to be played ---
      23.  00:6F28                      													; ---        C -> sound priority     ---
      24.  00:6F28                      													; --- Checks the priorities of playing ayFX streams to place ---
      25.  00:6F28                      													; --- the new one on the channel with lowest priority        ---
      26.  00:6F28  C5                  		push	bc									; Store bc in stack
      27.  00:6F29  D5                  		push	de									; Store de in stack
      28.  00:6F2A  E5                  		push	hl									; Store hl in stack
      29.  00:6F2B  DD E5               		push	IX									; Store IX in stack
      30.  00:6F2D                      													; --- Check if the index is in the bank ---
      31.  00:6F2D  47                  		ld	b,a										; b:=a (new ayFX stream index)
      32.  00:6F2E  2A C1 C2            		ld	hl,[ayFX_BANK]							; Current ayFX BANK
      33.  00:6F31  7E                  		ld	a,[hl]									; Number of samples in the bank
      34.  00:6F32  B7                  		or	a										; If zero (means 256 samples)...
      35.  00:6F33  CA 3D 6F            		jp	z,ayFX_INIT.CHECK_PRI							; ...goto .CHECK_PRI
      36.  00:6F36                      													; The bank has less than 256 samples
      37.  00:6F36  78                  		ld	a,b										; a:=b (new ayFX stream index)
      38.  00:6F37  BE                  		cp	[hl]									; If new index is not in the bank...
      39.  00:6F38  3E 02               		ld	a,2										; a:=2 (error 2: Sample not in the bank)
      40.  00:6F3A  D2 9C 6F            		jp	nc,ayFX_INIT.INIT_END							; ...we can't init it
      41.  00:6F3D                      
      42.  00:6F3D                      ;.CHECK_PRI:											; --- Places the data on the correct channel                  ---
      43.  00:6F3D                      													; ---   Remember: 0 = highest priority, 15 = lowest priority  ---
      44.  00:6F3D                      													; --- Checks channel 1 ---
      45.  00:6F3D  3A C3 C2            		ld	a,[ayFX_C1]								; Priority of ayFX Stream being played on channel 1
      46.  00:6F40  FE FF               		cp	255										; If there's no Stream being played...
      47.  00:6F42  28 39               		jr	z,ayFX_INIT.TOC1									; ...place the new Stream on channel 1
      48.  00:6F44  5F                  		ld	e,a										; Minimum priority of Streams being played
      49.  00:6F45  16 01               		ld	d,1										; On channel 1
      50.  00:6F47                      													; --- Checks channel 2 ---
      51.  00:6F47  3A C6 C2            		ld	a,[ayFX_C2]								; Priority of ayFX Stream being played on channel 2
      52.  00:6F4A  FE FF               		cp	255										; If there's no Stream being played...
      53.  00:6F4C  28 29               		jr	z,ayFX_INIT.TOC2									; ...place the new Stream on channel 2
      54.  00:6F4E  BB                  		cp	e										; Compare priority with minimum one
      55.  00:6F4F  30 03               		jr	nc,ayFX_INIT.CHECKC3								; If P(C2) > min, go to .CHECKC3
      56.  00:6F51  5F                  		ld	e,a										; Minimum priority of Streams being played
      57.  00:6F52  16 02               		ld	d,2										; On channel 2
      58.  00:6F54                      
      59.  00:6F54                      ;.CHECKC3:											; --- Checks channel 3 ---
      60.  00:6F54                      
      61.  00:6F54  3A C9 C2            		ld	a,[ayFX_C3]								; Priority of ayFX Stream being played on channel 3
      62.  00:6F57  FE FF               		cp	255										; If there's no stream being played
      63.  00:6F59  28 16               		jr	z,ayFX_INIT.TOC3									; ...place the new Stream on channel 3
      64.  00:6F5B  BB                  		cp	e										; Compare priority with minimum one
      65.  00:6F5C  30 03               		jr	nc,ayFX_INIT.CHECKMIN							; If P(C3) > min, go to .CHECKMIN
      66.  00:6F5E  5F                  		ld	e,a										; Minimum priority of Streams being played
      67.  00:6F5F  16 03               		ld	d,3										; On channel 3
      68.  00:6F61                      
      69.  00:6F61                      ;.CHECKMIN:											; --- Checks if minimum priority is lower than priority of the new Stream ---
      70.  00:6F61                      
      71.  00:6F61  79                  		ld	a,c										; Priority of the new Stream
      72.  00:6F62  BB                  		cp	e										; Minimum priority of Streams being played
      73.  00:6F63  3E 01               		ld	a,1										; a:=1 (error 1: A sample with higher priority is being played)
      74.  00:6F65  D2 9C 6F            		jp	nc,ayFX_INIT.INIT_END							; ...we can't play the new ayFX Stream
      75.  00:6F68                      													; --- The new stream substitues the minimum priority Stream being played ---
      76.  00:6F68  7A                  		ld	a,d										; Channel of minimum priority
      77.  00:6F69  FE 01               		cp	1										; If it's 1...
      78.  00:6F6B  28 10               		jr	z,ayFX_INIT.TOC1									; ...send Stream to channel 1
      79.  00:6F6D  FE 02               		cp	2										; If it's 2...
      80.  00:6F6F  28 06               		jr	z,ayFX_INIT.TOC2									; ...send Stream to channel 2
      81.  00:6F71                      
      82.  00:6F71                      ;.TOC3:												; --- Stream will be played on channel 3
      83.  00:6F71                      
      84.  00:6F71  DD 21 C9 C2         		ld	IX,ayFX_C3								; Pointer to the chanel data
      85.  00:6F75  18 0A               		jr	ayFX_INIT.SETDATA								; Go to .SETDATA
      86.  00:6F77                      
      87.  00:6F77                      ;.TOC2:												; --- Stream will be played on channel 2
      88.  00:6F77                      
      89.  00:6F77  DD 21 C6 C2         		ld	IX,ayFX_C2								; Pointer to the channel data
      90.  00:6F7B  18 04               		jr	ayFX_INIT.SETDATA								; Go to .SETDATA
      91.  00:6F7D                      
      92.  00:6F7D                      ;.TOC1:												; --- Stream will be played on channel 1
      93.  00:6F7D                      		
      94.  00:6F7D  DD 21 C3 C2         		ld	IX,ayFX_C1								; Pointer to the chanel data
      95.  00:6F81                      
      96.  00:6F81                      ;.SETDATA:											; --- Set data on the correct channel ---
      97.  00:6F81                      											
      98.  00:6F81  79                  		ld	a,c										; a:=New priority
      99.  00:6F82  E6 0F               		and	$0F										; We mask the priority
     100.  00:6F84  DD 77 00            		ld	[IX],a									; new ayFX stream priority saved in RAM
     101.  00:6F87                      													; --- Calculate the pointer to the new ayFX stream ---
     102.  00:6F87  ED 5B C1 C2         		ld	de,[ayFX_BANK]							; de:=Current ayFX bank
     103.  00:6F8B  13                  		inc	de										; de points to the increments table of the bank
     104.  00:6F8C  68                  		ld	l,b										; l:=b (new ayFX stream index)
     105.  00:6F8D  26 00               		ld	h,0										; hl:=b (new ayFX stream index)
     106.  00:6F8F  29                  		add	hl,hl									; hl:=hl*2
     107.  00:6F90  19                  		add	hl,de									; hl:=hl+de (hl points to the correct increment)
     108.  00:6F91  5E                  		ld	e,[hl]									; e:=lower byte of the increment
     109.  00:6F92  23                  		inc	hl										; hl points to the higher byte of the correct increment
     110.  00:6F93  56                  		ld	d,[hl]									; de:=increment
     111.  00:6F94  19                  		add	hl,de									; hl:=hl+de (hl points to the new ayFX stream)
     112.  00:6F95  DD 75 01            		ld	[IX+1],l								; Pointer lower byte saved in RAM
     113.  00:6F98  DD 74 02            		ld	[IX+2],h								; Pointer higher byte saved in RAM
     114.  00:6F9B  AF                  		xor	a										; a:=0 (no errors)
     115.  00:6F9C                      
     116.  00:6F9C                      ;.INIT_END:	
     117.  00:6F9C                      
     118.  00:6F9C  DD E1               		pop	IX										; Retrieve IX from stack
     119.  00:6F9E  E1                  		pop	hl										; Retrieve hl from stack
     120.  00:6F9F  D1                  		pop	de										; Retrieve de from stack
     121.  00:6FA0  C1                  		pop	bc										; Retrieve bc from stack
     122.  00:6FA1  C9                  		ret											; Return
     123.  00:6FA2                      
     124.  00:6FA2                      ;ayFX_PLAY:											; --- Plays next frame of each ayFX Stream ---
     125.  00:6FA2                      			
     126.  00:6FA2  21 00 00            		ld	hl,0									; hl:=0
     127.  00:6FA5  22 D8 C2            		ld	[ayFX_REGS+7],hl						; Clears mixer and volume of channel A
     128.  00:6FA8  22 DA C2            		ld	[ayFX_REGS+9],hl						; Clears volume of channels B and C
     129.  00:6FAB  DD 21 C3 C2         		ld	IX,ayFX_C1								; Channel 1
     130.  00:6FAF  3E 01               		ld	a,1										; a:=1
     131.  00:6FB1  CD C3 6F            		call	ayFX_PLAY.ayFX_PlayChannel					; Play Channel 1
     132.  00:6FB4  DD 21 C6 C2         		ld	IX,ayFX_C2								; Channel 2
     133.  00:6FB8  3E 02               		ld	a,2										; a:=2
     134.  00:6FBA  CD C3 6F            		call	ayFX_PLAY.ayFX_PlayChannel					; Play Channel 2
     135.  00:6FBD  DD 21 C9 C2         		ld	IX,ayFX_C3								; Channel 3
     136.  00:6FC1  3E 03               		ld	a,3										; a:=3
     137.  00:6FC3                      ;.ayFX_PlayChannel:									; --- Plays a channel stream ---
     138.  00:6FC3  32 D0 C2            		ld	[ayFX_CHANNEL],a						; Sets current channel
     139.  00:6FC6  DD 7E 00            		ld	a,[IX]									; a:=Current ayFX stream priority
     140.  00:6FC9  B7                  		or	a										; If priority has bit 7 on...
     141.  00:6FCA  F8                  		ret	m										; ...return
     142.  00:6FCB                      													; --- Extract control byte from stream ---
     143.  00:6FCB  DD 6E 01            		ld	l,[IX+1]								; Pointer to the current ayFX stream (lower byte)
     144.  00:6FCE  DD 66 02            		ld	h,[IX+2]								; Pointer to the current ayFX stream (higher byte)
     145.  00:6FD1  4E                  		ld	c,[hl]									; c:=Control byte
     146.  00:6FD2  23                  		inc	hl										; Increment pointer
     147.  00:6FD3                      													; --- Check if there's new tone on stream ---
     148.  00:6FD3  CB 69               		bit	5,c										; If bit 5 c is off...
     149.  00:6FD5  CA E0 6F            		jp	z,ayFX_PLAY.CHECK_NN								; ...jump to .CHECK_NN (no new tone)
     150.  00:6FD8                      													; --- Extract new tone from stream ---
     151.  00:6FD8  5E                  		ld	e,[hl]									; e:=lower byte of new tone
     152.  00:6FD9  23                  		inc	hl										; Increment pointer
     153.  00:6FDA  56                  		ld	d,[hl]									; d:=higher byte of new tone
     154.  00:6FDB  23                  		inc	hl										; Increment pointer
     155.  00:6FDC  ED 53 CC C2         		ld	[ayFX_TONE],de							; ayFX tone updated
     156.  00:6FE0                      
     157.  00:6FE0                      ;.CHECK_NN:											; --- Check if there's new noise on stream ---
     158.  00:6FE0                      
     159.  00:6FE0  CB 71               		bit	6,c										; if bit 6 c is off...
     160.  00:6FE2  CA EF 6F            		jp	z,ayFX_PLAY.SETPOINTER							; ...jump to .SETPOINTER (no new noise)
     161.  00:6FE5                      													; --- Extract new noise from stream ---
     162.  00:6FE5  7E                  		ld	a,[hl]									; a:=New noise
     163.  00:6FE6  23                  		inc	hl										; Increment pointer
     164.  00:6FE7  FE 20               		cp	$20										; If it's an illegal value of noise (used to mark end of stream)...
     165.  00:6FE9  CA 23 6F            		jp	z,ayFX_END								; ...jump to ayFX_END
     166.  00:6FEC  32 CE C2            		ld	[ayFX_NOISE],a							; ayFX noise updated
     167.  00:6FEF                      
     168.  00:6FEF                      ;.SETPOINTER:										; --- Update ayFX pointer ---
     169.  00:6FEF                      
     170.  00:6FEF  DD 75 01            		ld	[IX+1],l								; Pointer lower byte saved in RAM
     171.  00:6FF2  DD 74 02            		ld	[IX+2],h								; Pointer higher byte saved in RAM
     172.  00:6FF5                      													; --- Extract volume ---
     173.  00:6FF5  79                  		ld	a,c										; a:=Control byte
     174.  00:6FF6  E6 0F               		and	$0F										; lower nibble
     175.  00:6FF8  32 CF C2            		ld	[ayFX_VOLUME],a							; ayFX volume updated
     176.  00:6FFB  C8                  		ret	z										; Return if volume is zero (don't copy ayFX values in to ayFX_REGS)
     177.  00:6FFC                      													; -------------------------------------
     178.  00:6FFC                      													; --- COPY ayFX VALUES IN TO ayFX_REGS ---
     179.  00:6FFC                      													; -------------------------------------
     180.  00:6FFC                      													; --- Set noise channel ---
     181.  00:6FFC  CB 79               		bit	7,c										; If noise is off...
     182.  00:6FFE  C2 07 70            		jp	nz,ayFX_PLAY.SETMASKS							; ...jump to .SETMASKS
     183.  00:7001  3A CE C2            		ld	a,[ayFX_NOISE]							; ayFX noise value
     184.  00:7004  32 D7 C2            		ld	[ayFX_REGS+6],a							; copied in to ayFX_REGS (noise channel)
     185.  00:7007                      
     186.  00:7007                      ;.SETMASKS:											; --- Set mixer masks ---
     187.  00:7007                      
     188.  00:7007  79                  		ld	a,c										; a:=Control byte
     189.  00:7008  E6 90               		and	$90										; Only bits 7 and 4 (noise and tone mask for psg reg 7)
     190.  00:700A  FE 90               		cp	$90										; If no noise and no tone...
     191.  00:700C  C8                  		ret	z										; ...return (don't copy ayFX values in to ayFX_REGS)
     192.  00:700D                      													; --- Copy ayFX values in to ayFX_REGS ---
     193.  00:700D  CB 0F               		rrc	a										; Rotate a to the right (1 TIME)
     194.  00:700F  CB 0F               		rrc	a										; Rotate a to the right (2 TIMES) (OR mask)
     195.  00:7011  16 DB               		ld	d,$DB									; d:=Mask for psg mixer (AND mask)
     196.  00:7013  21 D0 C2            		ld	hl,ayFX_CHANNEL							; ayFX playing channel
     197.  00:7016  46                  		ld	b,[hl]									; Channel counter
     198.  00:7017                      
     199.  00:7017                      ;.CHK1:												; --- Check if playing channel was 1 ---
     200.  00:7017                      
     201.  00:7017  10 10               		djnz	ayFX_PLAY.CHK2								; Decrement and jump if channel was not 1
     202.  00:7019                      
     203.  00:7019                      ;.PLAY_C:											; --- Play ayFX stream on channel C ---
     204.  00:7019                      
     205.  00:7019  CD 53 70            		call	ayFX_PLAY.SETMIXER							; Set PSG mixer value (a:=ayFX volume)
     206.  00:701C  32 DB C2            		ld	[ayFX_REGS+10],a						; Volume copied in to ayFX_REGS (channel C volume)
     207.  00:701F  CB 51               		bit	2,c										; If tone is off...
     208.  00:7021  C0                  		ret	nz										; ...return
     209.  00:7022  2A CC C2            		ld	hl,[ayFX_TONE]							; ayFX tone value
     210.  00:7025  22 D5 C2            		ld	[ayFX_REGS+4],hl						; copied in to ayFX_REGS (channel C tone)
     211.  00:7028  C9                  		ret											; Return
     212.  00:7029                      
     213.  00:7029                      ;.CHK2:												; --- Check if playing channel was 2 ---
     214.  00:7029                      
     215.  00:7029  CB 0A               		rrc	d										; Rotate right AND mask
     216.  00:702B  CB 0F               		rrc	a										; Rotate right OR mask
     217.  00:702D  10 10               		djnz	ayFX_PLAY.CHK3								; Decrement and jump if channel was not 2
     218.  00:702F                      
     219.  00:702F                      ;.PLAY_B:											; --- Play ayFX stream on channel B ---
     220.  00:702F                      
     221.  00:702F  CD 53 70            		call	ayFX_PLAY.SETMIXER							; Set PSG mixer value (a:=ayFX volume)
     222.  00:7032  32 DA C2            		ld	[ayFX_REGS+9],a							; Volume copied in to ayFX_REGS (channel B volume)
     223.  00:7035  CB 49               		bit	1,c										; If tone is off...
     224.  00:7037  C0                  		ret	nz										; ...return
     225.  00:7038  2A CC C2            		ld	hl,[ayFX_TONE]							; ayFX tone value
     226.  00:703B  22 D3 C2            		ld	[ayFX_REGS+2],hl						; copied in to ayFX_REGS (channel B tone)
     227.  00:703E  C9                  		ret											; Return
     228.  00:703F                      
     229.  00:703F                      ;.CHK3:												; --- Check if playing channel was 3 ---
     230.  00:703F                      
     231.  00:703F  CB 0A               		rrc	d										; Rotate right AND mask
     232.  00:7041  CB 0F               		rrc	a										; Rotate right OR mask
     233.  00:7043                      
     234.  00:7043                      ;.PLAY_A:											; --- Play ayFX stream on channel A ---
     235.  00:7043                      
     236.  00:7043  CD 53 70            		call	ayFX_PLAY.SETMIXER							; Set PSG mixer value (a:=ayFX volume)
     237.  00:7046  32 D9 C2            		ld	[ayFX_REGS+8],a							; Volume copied in to ayFX_REGS (channel A volume)
     238.  00:7049  CB 41               		bit	0,c										; If tone is off...
     239.  00:704B  C0                  		ret	nz										; ...return
     240.  00:704C  2A CC C2            		ld	hl,[ayFX_TONE]							; ayFX tone value
     241.  00:704F  22 D1 C2            		ld	[ayFX_REGS+0],hl						; copied in to ayFX_REGS (channel A tone)
     242.  00:7052  C9                  		ret											; Return
     243.  00:7053                      
     244.  00:7053                      ;.SETMIXER:											; --- Set PSG mixer value ---
     245.  00:7053                      
     246.  00:7053  4F                  		ld	c,a										; c:=OR mask
     247.  00:7054  3A D8 C2            		ld	a,[ayFX_REGS+7]							; a:=PSG mixer value
     248.  00:7057  A2                  		and	d										; AND mask
