    2950.  00:6EC7  B7                  		or		a
    2951.  00:6EC8  C0                  		ret		nz
    2952.  00:6EC9                      
    2953.  00:6EC9  3A 12 C1            		ld		a,(CORAZONES)
    2954.  00:6ECC  3D                  		dec		a
    2955.  00:6ECD  32 12 C1            		ld		(CORAZONES),a
    2956.  00:6ED0  28 12               		jr		z,.MUERE_DEPH_EN_BOSS_COMUN
