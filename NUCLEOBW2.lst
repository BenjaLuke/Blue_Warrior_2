    2458.  00:5308                      
    2459.  00:5308                      		; Hitbox Errecenyx/Herrecenix reducido 20 px por cada lado.
    2460.  00:5308                      		; Deph se sigue tratando como caja aproximada de 20x20.
    2461.  00:5308                      		;
    2462.  00:5308                      		; X original visible:
    2463.  00:5308                      		;   izquierda = VARIABLE_UN_USO3
    2464.  00:5308                      		;   ancho     = VARIABLE_UN_USO2
    2465.  00:5308                      		;
    2466.  00:5308                      		; X reducido:
    2467.  00:5308                      		;   izquierda = VARIABLE_UN_USO3 + 20
    2468.  00:5308                      		;   derecha   = VARIABLE_UN_USO3 + VARIABLE_UN_USO2 - 20
    2469.  00:5308                      		;
    2470.  00:5308                      		; Y original:
    2471.  00:5308                      		;   arriba = ERRECENYX_MOVIMIENTO_Y_BOSS_4
    2472.  00:5308                      		;   alto   = ERRECENYX_MOVIMIENTO_ALTO_BOSS_4
    2473.  00:5308                      		;
    2474.  00:5308                      		; Y reducido:
    2475.  00:5308                      		;   arriba = ERRECENYX_MOVIMIENTO_Y_BOSS_4 + 20
    2476.  00:5308                      		;   abajo  = ERRECENYX_MOVIMIENTO_Y_BOSS_4 + ERRECENYX_MOVIMIENTO_ALTO_BOSS_4 - 20
    2477.  00:5308                      
    2478.  00:5308  CD 0C 4F            		call	CALCULA_RECORTE_ERRECENYX_BOSS_4
    2479.  00:530B                      
    2480.  00:530B                      		; Si el ancho visible es 40 o menos, al meter 20 por cada lado
    2481.  00:530B                      		; no queda hitbox real.
    2482.  00:530B  3A A5 C2            		ld		a,(VARIABLE_UN_USO2)
    2483.  00:530E  FE 29               		cp		41
    2484.  00:5310  D8                  		ret		c
    2485.  00:5311                      
    2486.  00:5311                      		; Comprueba borde izquierdo reducido:
    2487.  00:5311                      		; Deph derecha >= Errecenyx izquierda + 20
    2488.  00:5311  3A A6 C2            		ld		a,(VARIABLE_UN_USO3)
    2489.  00:5314  C6 14               		add		20
    2490.  00:5316  4F                  		ld		c,a
    2491.  00:5317  3A 64 C0            		ld		a,(X_DEPH)
    2492.  00:531A  C6 14               		add		20
