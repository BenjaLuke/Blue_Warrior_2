    2444.  00:531C                      REVISAMOS_COLISION_CON_ERRECENYX_Y_DEPH:
    2445.  00:531C                      
    2446.  00:531C                      		; Hitbox Errecenyx/Herrecenix reducido 20 px por cada lado.
    2447.  00:531C                      		; Deph se sigue tratando como caja aproximada de 20x20.
    2448.  00:531C                      		;
    2449.  00:531C                      		; X original visible:
    2450.  00:531C                      		;   izquierda = VARIABLE_UN_USO3
    2451.  00:531C                      		;   ancho     = VARIABLE_UN_USO2
    2452.  00:531C                      		;
    2453.  00:531C                      		; X reducido:
    2454.  00:531C                      		;   izquierda = VARIABLE_UN_USO3 + 20
    2455.  00:531C                      		;   derecha   = VARIABLE_UN_USO3 + VARIABLE_UN_USO2 - 20
    2456.  00:531C                      		;
    2457.  00:531C                      		; Y original:
    2458.  00:531C                      		;   arriba = ERRECENYX_MOVIMIENTO_Y_BOSS_4
    2459.  00:531C                      		;   alto   = ERRECENYX_MOVIMIENTO_ALTO_BOSS_4
    2460.  00:531C                      		;
    2461.  00:531C                      		; Y reducido:
    2462.  00:531C                      		;   arriba = ERRECENYX_MOVIMIENTO_Y_BOSS_4 + 20
    2463.  00:531C                      		;   abajo  = ERRECENYX_MOVIMIENTO_Y_BOSS_4 + ERRECENYX_MOVIMIENTO_ALTO_BOSS_4 - 20
    2464.  00:531C                      
    2465.  00:531C  CD 89 4F            		call	CALCULA_RECORTE_ERRECENYX_BOSS_4
    2466.  00:531F                      
    2467.  00:531F                      		; Si el ancho visible es 40 o menos, al meter 20 por cada lado
    2468.  00:531F                      		; no queda hitbox real.
    2469.  00:531F  3A A6 C2            		ld		a,(VARIABLE_UN_USO2)
    2470.  00:5322  FE 29               		cp		41
    2471.  00:5324  D8                  		ret		c
    2472.  00:5325                      
    2473.  00:5325                      		; Comprueba borde izquierdo reducido:
    2474.  00:5325                      		; Deph derecha >= Errecenyx izquierda + 20
    2475.  00:5325  3A A7 C2            		ld		a,(VARIABLE_UN_USO3)
    2476.  00:5328  C6 14               		add		20
    2477.  00:532A  4F                  		ld		c,a
    2478.  00:532B  3A 64 C0            		ld		a,(X_DEPH)
    2479.  00:532E  C6 14               		add		20
    2480.  00:5330  B9                  		cp		c
    2481.  00:5331  D8                  		ret		c
    2482.  00:5332                      
    2483.  00:5332                      		; Comprueba borde derecho reducido:
    2484.  00:5332                      		; Deph izquierda < Errecenyx derecha - 20
    2485.  00:5332  3A A7 C2            		ld		a,(VARIABLE_UN_USO3)
    2486.  00:5335  4F                  		ld		c,a
    2487.  00:5336  3A A6 C2            		ld		a,(VARIABLE_UN_USO2)
    2488.  00:5339  81                  		add		c
    2489.  00:533A  D6 14               		sub		20
    2490.  00:533C  4F                  		ld		c,a
    2491.  00:533D  3A 64 C0            		ld		a,(X_DEPH)
    2492.  00:5340  B9                  		cp		c
    2493.  00:5341  D0                  		ret		nc
    2494.  00:5342                      
    2495.  00:5342                      		; Comprueba borde superior reducido:
    2496.  00:5342                      		; Deph abajo >= Errecenyx arriba + 20
    2497.  00:5342  3A 65 C0            		ld		a,(Y_DEPH)
    2498.  00:5345  C6 14               		add		20
    2499.  00:5347  FE 30               		cp		ERRECENYX_MOVIMIENTO_Y_BOSS_4+20
    2500.  00:5349  D8                  		ret		c
    2501.  00:534A                      
    2502.  00:534A                      		; Comprueba borde inferior reducido:
    2503.  00:534A                      		; Deph arriba < Errecenyx abajo - 20
    2504.  00:534A  3A 65 C0            		ld		a,(Y_DEPH)
    2505.  00:534D  FE 46               		cp		ERRECENYX_MOVIMIENTO_Y_BOSS_4+ERRECENYX_MOVIMIENTO_ALTO_BOSS_4-20
    2506.  00:534F  D0                  		ret		nc
    2507.  00:5350                      
    2508.  00:5350  CD 54 53            		call	DANO_DEPH_EN_BOSS_4
    2509.  00:5353  C9                  		ret
