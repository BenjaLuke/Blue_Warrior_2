       1.  00:5E00                      ; ROMAN: PAR
       2.  00:5E00                      ;SEARCH_SLOT_SET:														; Ampliar a espacios 1 y 2 los usados en la ram del ordenador
       3.  00:5E00                      		
       4.  00:5E00  CD 06 5E            		call 	SEARCH_SLOT
       5.  00:5E03  C3 24 00            		jp 		ENASLT
       6.  00:5E06                      
       7.  00:5E06                      ;SEARCH_SLOT:
       8.  00:5E06                      
       9.  00:5E06  CD 38 01            		call 	RSLREG
      10.  00:5E09  0F                  		rrca
      11.  00:5E0A  0F                  		rrca
      12.  00:5E0B  E6 03               		and 	3
      13.  00:5E0D  4F                  		ld 		c,a
      14.  00:5E0E  06 00               		ld 		b,0
      15.  00:5E10  21 C1 FC            		ld 		hl,0FCC1h
      16.  00:5E13  09                  		add 	hl,bc
      17.  00:5E14  7E                  		ld 		a,(hl)
      18.  00:5E15  E6 80               		and 	080h
      19.  00:5E17  B1                  		or 		c
      20.  00:5E18  4F                  		ld 		c,a
      21.  00:5E19  23                  		inc 	hl
      22.  00:5E1A  23                  		inc 	hl
      23.  00:5E1B  23                  		inc 	hl
      24.  00:5E1C  23                  		inc	 	hl
      25.  00:5E1D  7E                  		ld 		a,(hl)
      26.  00:5E1E  E6 0C               		and 	0Ch
      27.  00:5E20  B1                  		or 		c
      28.  00:5E21  26 80               		ld 		h,080h
      29.  00:5E23  32 00 C0            		ld 		(SLOTVAR),a
      30.  00:5E26                      				
      31.  00:5E26  C9                  		ret
      32.  00:5E27                      				
      33.  00:5E27                      ;HL_DATOS_DEL_COPY:
      34.  00:5E27                      
