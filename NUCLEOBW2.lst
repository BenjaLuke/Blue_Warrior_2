    2445.  00:50FE                              ;
    2446.  00:50FE                              ; Copiamos solo la parte visible de la letra:
    2447.  00:50FE                              ;   repeticion 0 -> ancho 2
    2448.  00:50FE                              ;   repeticion 1 -> ancho 4
    2449.  00:50FE                              ;   repeticion 2 -> ancho 6
    2450.  00:50FE                              ;
