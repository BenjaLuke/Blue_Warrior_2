      22.  00:7FD0  CD 60 7C            		call	stpmus
      23.  00:7FD3                      
      24.  00:7FD3  3E 01               		ld		a,1
      25.  00:7FD5  32 E0 C0            		ld		(MUSICA_BEST_ON),a
      26.  00:7FD8                      
      27.  00:7FD8  E1                  		pop		hl
      28.  00:7FD9  F1                  		pop		af
