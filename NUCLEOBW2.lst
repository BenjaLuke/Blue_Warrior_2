       1.  00:7FD3                      ; ------------------------------------------------------------
       2.  00:7FD3                      ; INICIA_MUSICA_COMUN
       3.  00:7FD3                      ;
       4.  00:7FD3                      ; Entrada:
       5.  00:7FD3                      ;   A  = banco donde está la música
       6.  00:7FD3                      ;   HL = dirección de la música
       7.  00:7FD3                      ;
       8.  00:7FD3                      ; Ejemplo:
       9.  00:7FD3                      ;   ld  a,39
      10.  00:7FD3                      ;   ld  hl,M_PUENTE
      11.  00:7FD3                      ;   call INICIA_MUSICA_COMUN
      12.  00:7FD3                      ;
      13.  00:7FD3                      ; IMPORTANTE:
      14.  00:7FD3                      ;   Esta rutina NO debe estar en el segmento que cambia
      15.  00:7FD3                      ;   CHANGE_BANK_2, porque si cambia el banco donde está
      16.  00:7FD3                      ;   ejecutándose, el MSX se pega el castañazo padre.
      17.  00:7FD3                      ; ------------------------------------------------------------
      18.  00:7FD3                      
      19.  00:7FD3  F5                  		push	af
      20.  00:7FD4  E5                  		push	hl
      21.  00:7FD5                      
      22.  00:7FD5  CD 6F 7C            		call	stpmus
      23.  00:7FD8                      
      24.  00:7FD8  3E 01               		ld		a,1
      25.  00:7FDA  32 E0 C0            		ld		(MUSICA_BEST_ON),a
      26.  00:7FDD                      
      27.  00:7FDD  E1                  		pop		hl
      28.  00:7FDE  F1                  		pop		af
      29.  00:7FDF                      
      30.  00:7FDF  CD 4C 5F            		call	CHANGE_BANK_2
      31.  00:7FE2                      
      32.  00:7FE2  22 C1 C2            		ld		(MUSIC_ON),hl
      33.  00:7FE5  CD 10 73            		call	INICIAMOS_MUSICA
      34.  00:7FE8                      
      35.  00:7FE8  F3                  		di
      36.  00:7FE9  CD 60 73            		call	strmus
      37.  00:7FEC  FB                  		ei
