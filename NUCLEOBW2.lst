     254.  00:7060                      ;AYfx_ROUT:	
     255.  00:7060                      
     256.  00:7060  AF                  		XOR A
     257.  00:7061                      	
     258.  00:7061                      ;ROUT_A0:											; --- FIXES BITS 6 AND 7 OF MIXER ---
     259.  00:7061                      				
     260.  00:7061  21 D8 C2            		LD	HL,ayFX_REGS+AR_Mixer
