      60:  00:5BEB                      FINAL_FASE_5_VAMOS_A_TERMINAR_INICIO:
      61:  00:5BEB                      
      62:  00:5BEB                      		; Lanzamos FX 34 al empezar la secuencia final.
      63:  00:5BEB  3E 22               		ld		a,34
      64:  00:5BED  0E 01               		ld		c,1
      65:  00:5BEF  CD 48 5B            		call	TIRA_FX_BOSS_5
      66:  00:5BF2                      
      67:  00:5BF2                      		; Aseguramos que la page visible es la 2, que es donde vamos a pintar.
      68:  00:5BF2  3E 02               		ld		a,2
      69:  00:5BF4  32 59 C0            		ld		(SET_PAGE),a
      70:  00:5BF7                      
      71:  00:5BF7                      		; Copiamos la plantilla ROM al buffer real en RAM.
      72:  00:5BF7  21 72 5B            		ld		hl,FINAL_FASE_5_VAMOS_A_TERMINAR_PLANTILLA_HMMV
      73:  00:5BFA  11 5D C6            		ld		de,FINAL_FASE_5_VAMOS_A_TERMINAR_DATAS_HMMV
      74:  00:5BFD  01 0F 00            		ld		bc,15
      75:  00:5C00  ED B0               		ldir
      76:  00:5C02                              
      77:  00:5C02  06 6A               		ld		b,106
      78:  00:5C04  FD 21 81 5B         		ld		iy,FINAL_FASE_5_VAMOS_A_TERMINAR_TABLA_Y
      79:  00:5C08                      
      80:  00:5C08                      .BUCLE_FILAS_FINAL_FASE_5:
      81:  00:5C08                      
      82:  00:5C08  C5                  		push	bc
      83:  00:5C09                      
      84:  00:5C09                      		; DY = fila actual en page 2.
      85:  00:5C09  FD 7E 00            		ld		a,(iy)
      86:  00:5C0C  FD 23               		inc		iy
      87:  00:5C0E  32 63 C6            		ld		(FINAL_FASE_5_VAMOS_A_TERMINAR_DATAS_HMMV+6),a
      88:  00:5C11                      
      89:  00:5C11                      		; Semilla X distinta para cada fila.
      90:  00:5C11                      		; Como la tabla Y ya esta mezclada, esto evita que todas las filas
      91:  00:5C11                      		; se borren con el mismo orden horizontal.
      92:  00:5C11  CB 3F               		srl		a
      93:  00:5C13  CB 3F               		srl		a
      94:  00:5C15  C6 07               		add		a,7
      95:  00:5C17  E6 3F               		and		00111111b
      96:  00:5C19  32 6C C6            		ld		(FINAL_FASE_5_VAMOS_A_TERMINAR_X_SEED),a
      97:  00:5C1C                      
      98:  00:5C1C  06 40               		ld		b,64
      99:  00:5C1E                      
     100:  00:5C1E                      .BUCLE_COLUMNAS_FINAL_FASE_5:
     101:  00:5C1E                      
     102:  00:5C1E  C5                  		push	bc
     103:  00:5C1F  FD E5               		push	iy
     104:  00:5C21                      
     105:  00:5C21                      		; DX = (semilla X modulo 64) * 4.
