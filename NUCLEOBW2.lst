    2114.  00:4DA9                      		db		"Benja, el desarrollador es un poco trucha.",0
    2114.  00:4DA9  42 65 6E 6A 61 2C 20 65 6C 20 64 65 73 61 72 72 
    2114.  00:4DB9  6F 6C 6C 61 64 6F 72 20 65 73 20 75 6E 20 70 6F 
    2114.  00:4DC9  63 6F 20 74 72 75 63 68 61 2E 00 
    2115.  00:4DD4                      TEXTO_CINEMATICA_1_3:
    2116.  00:4DD4                      		db		"El sol lo hinunda todo de norte a sur",0
    2116.  00:4DD4  45 6C 20 73 6F 6C 20 6C 6F 20 68 69 6E 75 6E 64 
    2116.  00:4DE4  61 20 74 6F 64 6F 20 64 65 20 6E 6F 72 74 65 20 
    2116.  00:4DF4  61 20 73 75 72 00 
    2117.  00:4DFA                      TEXTO_CINEMATICA_1_4:
    2118.  00:4DFA                      		db		"por eso no pienso volar con wintertour.",0
    2118.  00:4DFA  70 6F 72 20 65 73 6F 20 6E 6F 20 70 69 65 6E 73 
    2118.  00:4E0A  6F 20 76 6F 6C 61 72 20 63 6F 6E 20 77 69 6E 74 
    2118.  00:4E1A  65 72 74 6F 75 72 2E 00 
