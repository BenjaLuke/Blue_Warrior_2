      69:  00:5BE6                      FINAL_FASE_5_VAMOS_A_TERMINAR_INICIO:
      70:  00:5BE6                      
      71:  00:5BE6                      		; Lanzamos FX 34 al empezar la secuencia final.
      72:  00:5BE6  3E 22               		ld		a,34
      73:  00:5BE8  0E 01               		ld		c,1
      74:  00:5BEA  CD 46 5B            		call	TIRA_FX_BOSS_5
      75:  00:5BED                      
      76:  00:5BED                      		; Aseguramos que la page visible es la 2, que es donde vamos a pintar.
      77:  00:5BED  3E 02               		ld		a,2
      78:  00:5BEF  32 59 C0            		ld		(SET_PAGE),a
      79:  00:5BF2                      
      80:  00:5BF2                      		; Copiamos la plantilla ROM al buffer real en RAM.
      81:  00:5BF2  21 6D 5B            		ld		hl,FINAL_FASE_5_VAMOS_A_TERMINAR_PLANTILLA_HMMV
      82:  00:5BF5  11 2D C6            		ld		de,FINAL_FASE_5_VAMOS_A_TERMINAR_DATAS_HMMV
      83:  00:5BF8  01 0F 00            		ld		bc,FINAL_FASE_5_VAMOS_A_TERMINAR_BYTES_HMMV
      84:  00:5BFB  ED B0               		ldir
      85:  00:5BFD                              
      86:  00:5BFD  06 6A               		ld		b,FINAL_FASE_5_VAMOS_A_TERMINAR_FILAS
      87:  00:5BFF  FD 21 7C 5B         		ld		iy,FINAL_FASE_5_VAMOS_A_TERMINAR_TABLA_Y
      88:  00:5C03                      
      89:  00:5C03                      .BUCLE_FILAS_FINAL_FASE_5:
      90:  00:5C03                      
      91:  00:5C03  C5                  		push	bc
      92:  00:5C04                      
      93:  00:5C04                      		; DY = fila actual en page 2.
      94:  00:5C04  FD 7E 00            		ld		a,(iy)
      95:  00:5C07  FD 23               		inc		iy
      96:  00:5C09  32 33 C6            		ld		(FINAL_FASE_5_VAMOS_A_TERMINAR_DATAS_HMMV+6),a
      97:  00:5C0C                      
      98:  00:5C0C                      		; Semilla X distinta para cada fila.
      99:  00:5C0C                      		; Como la tabla Y ya esta mezclada, esto evita que todas las filas
     100:  00:5C0C                      		; se borren con el mismo orden horizontal.
     101:  00:5C0C  CB 3F               		srl		a
     102:  00:5C0E  CB 3F               		srl		a
     103:  00:5C10  C6 07               		add		a,7
     104:  00:5C12  E6 3F               		and		00111111b
     105:  00:5C14  32 3C C6            		ld		(FINAL_FASE_5_VAMOS_A_TERMINAR_X_SEED),a
     106:  00:5C17                      
     107:  00:5C17  06 40               		ld		b,FINAL_FASE_5_VAMOS_A_TERMINAR_COLUMNAS
     108:  00:5C19                      
     109:  00:5C19                      .BUCLE_COLUMNAS_FINAL_FASE_5:
     110:  00:5C19                      
     111:  00:5C19  C5                  		push	bc
     112:  00:5C1A  FD E5               		push	iy
     113:  00:5C1C                      
     114:  00:5C1C                      		; DX = (semilla X modulo 64) * 4.
     115:  00:5C1C  3A 3C C6            		ld		a,(FINAL_FASE_5_VAMOS_A_TERMINAR_X_SEED)
     116:  00:5C1F  E6 3F               		and		00111111b
     117:  00:5C21  87                  		add		a,a
     118:  00:5C22  87                  		add		a,a
     119:  00:5C23  32 31 C6            		ld		(FINAL_FASE_5_VAMOS_A_TERMINAR_DATAS_HMMV+4),a
     120:  00:5C26                      
     121:  00:5C26                      		; Pintamos bloque negro 4x4 en page 2.
     122:  00:5C26  21 2D C6            		ld		hl,FINAL_FASE_5_VAMOS_A_TERMINAR_DATAS_HMMV
     123:  00:5C29  CD 2A 5E            		call	DOCOPY
     124:  00:5C2C  CD 33 5E            		call	VDPREADY
     125:  00:5C2F                      
     126:  00:5C2F                      		; Siguiente X pseudoaleatoria.
     127:  00:5C2F                      		; 21 es coprimo con 64, asi que recorre las 64 columnas
     128:  00:5C2F                      		; sin repetir ninguna dentro de la misma fila.
     129:  00:5C2F  3A 3C C6            		ld		a,(FINAL_FASE_5_VAMOS_A_TERMINAR_X_SEED)
     130:  00:5C32  C6 15               		add		a,FINAL_FASE_5_VAMOS_A_TERMINAR_SALTO_X
     131:  00:5C34  E6 3F               		and		00111111b
     132:  00:5C36  32 3C C6            		ld		(FINAL_FASE_5_VAMOS_A_TERMINAR_X_SEED),a
     133:  00:5C39                      
     134:  00:5C39  FD E1               		pop		iy
     135:  00:5C3B  C1                  		pop		bc
     136:  00:5C3C  10 DB               		djnz	.BUCLE_COLUMNAS_FINAL_FASE_5
     137:  00:5C3E                      
     138:  00:5C3E  C1                  		pop		bc
     139:  00:5C3F                      
     140:  00:5C3F                      		; Pausa corta entre filas para que el borrado respire.
     141:  00:5C3F  C5                  		push	bc
     142:  00:5C40  01 00 04            		ld		bc,FINAL_FASE_5_VAMOS_A_TERMINAR_PAUSA_FILAS
     143:  00:5C43                      
     144:  00:5C43                      .PAUSA_ENTRE_FILAS_FINAL_FASE_5:
     145:  00:5C43                      
     146:  00:5C43  0B                  		dec		bc
     147:  00:5C44  78                  		ld		a,b
     148:  00:5C45  B1                  		or		c
     149:  00:5C46  20 FB               		jr		nz,.PAUSA_ENTRE_FILAS_FINAL_FASE_5
     150:  00:5C48                      
     151:  00:5C48  C1                  		pop		bc
     152:  00:5C49                      
     153:  00:5C49  10 B8               		djnz	.BUCLE_FILAS_FINAL_FASE_5
     154:  00:5C4B                      
     155:  00:5C4B                      ; Fin del include.
     156:  00:5C4B                      ; No hay ret.
