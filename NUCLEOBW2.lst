      18.  00:6F76  DD 36 00 FF         		ld	[IX],255								; Priority saved (not playing ayFX stream)
      19.  00:6F7A  C9                  		ret											; Return
      20.  00:6F7B                      
      21.  00:6F7B                      ;ayFX_INIT:											; ---     INIT A NEW ayFX STREAM     ---
      22.  00:6F7B                      													; --- INPUT: A -> sound to be played ---
      23.  00:6F7B                      													; ---        C -> sound priority     ---
      24.  00:6F7B                      													; --- Checks the priorities of playing ayFX streams to place ---
      25.  00:6F7B                      													; --- the new one on the channel with lowest priority        ---
      26.  00:6F7B  C5                  		push	bc									; Store bc in stack
      27.  00:6F7C  D5                  		push	de									; Store de in stack
      28.  00:6F7D  E5                  		push	hl									; Store hl in stack
      29.  00:6F7E  DD E5               		push	IX									; Store IX in stack
      30.  00:6F80                      													; --- Check if the index is in the bank ---
      31.  00:6F80  47                  		ld	b,a										; b:=a (new ayFX stream index)
      32.  00:6F81  2A C3 C2            		ld	hl,[ayFX_BANK]							; Current ayFX BANK
      33.  00:6F84  7E                  		ld	a,[hl]									; Number of samples in the bank
      34.  00:6F85  B7                  		or	a										; If zero (means 256 samples)...
      35.  00:6F86  CA 90 6F            		jp	z,ayFX_INIT.CHECK_PRI							; ...goto .CHECK_PRI
      36.  00:6F89                      													; The bank has less than 256 samples
      37.  00:6F89  78                  		ld	a,b										; a:=b (new ayFX stream index)
      38.  00:6F8A  BE                  		cp	[hl]									; If new index is not in the bank...
      39.  00:6F8B  3E 02               		ld	a,2										; a:=2 (error 2: Sample not in the bank)
      40.  00:6F8D  D2 EF 6F            		jp	nc,ayFX_INIT.INIT_END							; ...we can't init it
      41.  00:6F90                      
      42.  00:6F90                      ;.CHECK_PRI:											; --- Places the data on the correct channel                  ---
      43.  00:6F90                      													; ---   Remember: 0 = highest priority, 15 = lowest priority  ---
      44.  00:6F90                      													; --- Checks channel 1 ---
      45.  00:6F90  3A C5 C2            		ld	a,[ayFX_C1]								; Priority of ayFX Stream being played on channel 1
      46.  00:6F93  FE FF               		cp	255										; If there's no Stream being played...
      47.  00:6F95  28 39               		jr	z,ayFX_INIT.TOC1									; ...place the new Stream on channel 1
      48.  00:6F97  5F                  		ld	e,a										; Minimum priority of Streams being played
      49.  00:6F98  16 01               		ld	d,1										; On channel 1
      50.  00:6F9A                      													; --- Checks channel 2 ---
      51.  00:6F9A  3A C8 C2            		ld	a,[ayFX_C2]								; Priority of ayFX Stream being played on channel 2
      52.  00:6F9D  FE FF               		cp	255										; If there's no Stream being played...
      53.  00:6F9F  28 29               		jr	z,ayFX_INIT.TOC2									; ...place the new Stream on channel 2
      54.  00:6FA1  BB                  		cp	e										; Compare priority with minimum one
      55.  00:6FA2  30 03               		jr	nc,ayFX_INIT.CHECKC3								; If P(C2) > min, go to .CHECKC3
      56.  00:6FA4  5F                  		ld	e,a										; Minimum priority of Streams being played
      57.  00:6FA5  16 02               		ld	d,2										; On channel 2
      58.  00:6FA7                      
      59.  00:6FA7                      ;.CHECKC3:											; --- Checks channel 3 ---
      60.  00:6FA7                      
      61.  00:6FA7  3A CB C2            		ld	a,[ayFX_C3]								; Priority of ayFX Stream being played on channel 3
      62.  00:6FAA  FE FF               		cp	255										; If there's no stream being played
      63.  00:6FAC  28 16               		jr	z,ayFX_INIT.TOC3									; ...place the new Stream on channel 3
      64.  00:6FAE  BB                  		cp	e										; Compare priority with minimum one
      65.  00:6FAF  30 03               		jr	nc,ayFX_INIT.CHECKMIN							; If P(C3) > min, go to .CHECKMIN
      66.  00:6FB1  5F                  		ld	e,a										; Minimum priority of Streams being played
      67.  00:6FB2  16 03               		ld	d,3										; On channel 3
      68.  00:6FB4                      
      69.  00:6FB4                      ;.CHECKMIN:											; --- Checks if minimum priority is lower than priority of the new Stream ---
      70.  00:6FB4                      
      71.  00:6FB4  79                  		ld	a,c										; Priority of the new Stream
      72.  00:6FB5  BB                  		cp	e										; Minimum priority of Streams being played
      73.  00:6FB6  3E 01               		ld	a,1										; a:=1 (error 1: A sample with higher priority is being played)
      74.  00:6FB8  D2 EF 6F            		jp	nc,ayFX_INIT.INIT_END							; ...we can't play the new ayFX Stream
      75.  00:6FBB                      													; --- The new stream substitues the minimum priority Stream being played ---
      76.  00:6FBB  7A                  		ld	a,d										; Channel of minimum priority
      77.  00:6FBC  FE 01               		cp	1										; If it's 1...
      78.  00:6FBE  28 10               		jr	z,ayFX_INIT.TOC1									; ...send Stream to channel 1
      79.  00:6FC0  FE 02               		cp	2										; If it's 2...
      80.  00:6FC2  28 06               		jr	z,ayFX_INIT.TOC2									; ...send Stream to channel 2
      81.  00:6FC4                      
      82.  00:6FC4                      ;.TOC3:												; --- Stream will be played on channel 3
      83.  00:6FC4                      
      84.  00:6FC4  DD 21 CB C2         		ld	IX,ayFX_C3								; Pointer to the chanel data
      85.  00:6FC8  18 0A               		jr	ayFX_INIT.SETDATA								; Go to .SETDATA
      86.  00:6FCA                      
      87.  00:6FCA                      ;.TOC2:												; --- Stream will be played on channel 2
      88.  00:6FCA                      
      89.  00:6FCA  DD 21 C8 C2         		ld	IX,ayFX_C2								; Pointer to the channel data
      90.  00:6FCE  18 04               		jr	ayFX_INIT.SETDATA								; Go to .SETDATA
      91.  00:6FD0                      
      92.  00:6FD0                      ;.TOC1:												; --- Stream will be played on channel 1
      93.  00:6FD0                      		
      94.  00:6FD0  DD 21 C5 C2         		ld	IX,ayFX_C1								; Pointer to the chanel data
      95.  00:6FD4                      
      96.  00:6FD4                      ;.SETDATA:											; --- Set data on the correct channel ---
      97.  00:6FD4                      											
      98.  00:6FD4  79                  		ld	a,c										; a:=New priority
      99.  00:6FD5  E6 0F               		and	$0F										; We mask the priority
     100.  00:6FD7  DD 77 00            		ld	[IX],a									; new ayFX stream priority saved in RAM
     101.  00:6FDA                      													; --- Calculate the pointer to the new ayFX stream ---
     102.  00:6FDA  ED 5B C3 C2         		ld	de,[ayFX_BANK]							; de:=Current ayFX bank
     103.  00:6FDE  13                  		inc	de										; de points to the increments table of the bank
     104.  00:6FDF  68                  		ld	l,b										; l:=b (new ayFX stream index)
     105.  00:6FE0  26 00               		ld	h,0										; hl:=b (new ayFX stream index)
     106.  00:6FE2  29                  		add	hl,hl									; hl:=hl*2
     107.  00:6FE3  19                  		add	hl,de									; hl:=hl+de (hl points to the correct increment)
     108.  00:6FE4  5E                  		ld	e,[hl]									; e:=lower byte of the increment
     109.  00:6FE5  23                  		inc	hl										; hl points to the higher byte of the correct increment
     110.  00:6FE6  56                  		ld	d,[hl]									; de:=increment
     111.  00:6FE7  19                  		add	hl,de									; hl:=hl+de (hl points to the new ayFX stream)
     112.  00:6FE8  DD 75 01            		ld	[IX+1],l								; Pointer lower byte saved in RAM
     113.  00:6FEB  DD 74 02            		ld	[IX+2],h								; Pointer higher byte saved in RAM
     114.  00:6FEE  AF                  		xor	a										; a:=0 (no errors)
     115.  00:6FEF                      
     116.  00:6FEF                      ;.INIT_END:	
     117.  00:6FEF                      
     118.  00:6FEF  DD E1               		pop	IX										; Retrieve IX from stack
     119.  00:6FF1  E1                  		pop	hl										; Retrieve hl from stack
     120.  00:6FF2  D1                  		pop	de										; Retrieve de from stack
     121.  00:6FF3  C1                  		pop	bc										; Retrieve bc from stack
     122.  00:6FF4  C9                  		ret											; Return
     123.  00:6FF5                      
     124.  00:6FF5                      ;ayFX_PLAY:											; --- Plays next frame of each ayFX Stream ---
     125.  00:6FF5                      			
     126.  00:6FF5  21 00 00            		ld	hl,0									; hl:=0
     127.  00:6FF8  22 DA C2            		ld	[ayFX_REGS+7],hl						; Clears mixer and volume of channel A
     128.  00:6FFB  22 DC C2            		ld	[ayFX_REGS+9],hl						; Clears volume of channels B and C
     129.  00:6FFE  DD 21 C5 C2         		ld	IX,ayFX_C1								; Channel 1
     130.  00:7002  3E 01               		ld	a,1										; a:=1
     131.  00:7004  CD 16 70            		call	ayFX_PLAY.ayFX_PlayChannel					; Play Channel 1
     132.  00:7007  DD 21 C8 C2         		ld	IX,ayFX_C2								; Channel 2
     133.  00:700B  3E 02               		ld	a,2										; a:=2
     134.  00:700D  CD 16 70            		call	ayFX_PLAY.ayFX_PlayChannel					; Play Channel 2
     135.  00:7010  DD 21 CB C2         		ld	IX,ayFX_C3								; Channel 3
     136.  00:7014  3E 03               		ld	a,3										; a:=3
     137.  00:7016                      ;.ayFX_PlayChannel:									; --- Plays a channel stream ---
     138.  00:7016  32 D2 C2            		ld	[ayFX_CHANNEL],a						; Sets current channel
     139.  00:7019  DD 7E 00            		ld	a,[IX]									; a:=Current ayFX stream priority
     140.  00:701C  B7                  		or	a										; If priority has bit 7 on...
     141.  00:701D  F8                  		ret	m										; ...return
     142.  00:701E                      													; --- Extract control byte from stream ---
     143.  00:701E  DD 6E 01            		ld	l,[IX+1]								; Pointer to the current ayFX stream (lower byte)
     144.  00:7021  DD 66 02            		ld	h,[IX+2]								; Pointer to the current ayFX stream (higher byte)
     145.  00:7024  4E                  		ld	c,[hl]									; c:=Control byte
     146.  00:7025  23                  		inc	hl										; Increment pointer
     147.  00:7026                      													; --- Check if there's new tone on stream ---
     148.  00:7026  CB 69               		bit	5,c										; If bit 5 c is off...
     149.  00:7028  CA 33 70            		jp	z,ayFX_PLAY.CHECK_NN								; ...jump to .CHECK_NN (no new tone)
     150.  00:702B                      													; --- Extract new tone from stream ---
     151.  00:702B  5E                  		ld	e,[hl]									; e:=lower byte of new tone
     152.  00:702C  23                  		inc	hl										; Increment pointer
     153.  00:702D  56                  		ld	d,[hl]									; d:=higher byte of new tone
     154.  00:702E  23                  		inc	hl										; Increment pointer
     155.  00:702F  ED 53 CE C2         		ld	[ayFX_TONE],de							; ayFX tone updated
     156.  00:7033                      
     157.  00:7033                      ;.CHECK_NN:											; --- Check if there's new noise on stream ---
     158.  00:7033                      
     159.  00:7033  CB 71               		bit	6,c										; if bit 6 c is off...
     160.  00:7035  CA 42 70            		jp	z,ayFX_PLAY.SETPOINTER							; ...jump to .SETPOINTER (no new noise)
     161.  00:7038                      													; --- Extract new noise from stream ---
     162.  00:7038  7E                  		ld	a,[hl]									; a:=New noise
     163.  00:7039  23                  		inc	hl										; Increment pointer
     164.  00:703A  FE 20               		cp	$20										; If it's an illegal value of noise (used to mark end of stream)...
     165.  00:703C  CA 76 6F            		jp	z,ayFX_END								; ...jump to ayFX_END
     166.  00:703F  32 D0 C2            		ld	[ayFX_NOISE],a							; ayFX noise updated
     167.  00:7042                      
     168.  00:7042                      ;.SETPOINTER:										; --- Update ayFX pointer ---
     169.  00:7042                      
     170.  00:7042  DD 75 01            		ld	[IX+1],l								; Pointer lower byte saved in RAM
     171.  00:7045  DD 74 02            		ld	[IX+2],h								; Pointer higher byte saved in RAM
     172.  00:7048                      													; --- Extract volume ---
     173.  00:7048  79                  		ld	a,c										; a:=Control byte
     174.  00:7049  E6 0F               		and	$0F										; lower nibble
     175.  00:704B  32 D1 C2            		ld	[ayFX_VOLUME],a							; ayFX volume updated
     176.  00:704E  C8                  		ret	z										; Return if volume is zero (don't copy ayFX values in to ayFX_REGS)
     177.  00:704F                      													; -------------------------------------
     178.  00:704F                      													; --- COPY ayFX VALUES IN TO ayFX_REGS ---
     179.  00:704F                      													; -------------------------------------
     180.  00:704F                      													; --- Set noise channel ---
     181.  00:704F  CB 79               		bit	7,c										; If noise is off...
     182.  00:7051  C2 5A 70            		jp	nz,ayFX_PLAY.SETMASKS							; ...jump to .SETMASKS
     183.  00:7054  3A D0 C2            		ld	a,[ayFX_NOISE]							; ayFX noise value
     184.  00:7057  32 D9 C2            		ld	[ayFX_REGS+6],a							; copied in to ayFX_REGS (noise channel)
     185.  00:705A                      
     186.  00:705A                      ;.SETMASKS:											; --- Set mixer masks ---
     187.  00:705A                      
     188.  00:705A  79                  		ld	a,c										; a:=Control byte
     189.  00:705B  E6 90               		and	$90										; Only bits 7 and 4 (noise and tone mask for psg reg 7)
     190.  00:705D  FE 90               		cp	$90										; If no noise and no tone...
     191.  00:705F  C8                  		ret	z										; ...return (don't copy ayFX values in to ayFX_REGS)
     192.  00:7060                      													; --- Copy ayFX values in to ayFX_REGS ---
     193.  00:7060  CB 0F               		rrc	a										; Rotate a to the right (1 TIME)
     194.  00:7062  CB 0F               		rrc	a										; Rotate a to the right (2 TIMES) (OR mask)
     195.  00:7064  16 DB               		ld	d,$DB									; d:=Mask for psg mixer (AND mask)
     196.  00:7066  21 D2 C2            		ld	hl,ayFX_CHANNEL							; ayFX playing channel
     197.  00:7069  46                  		ld	b,[hl]									; Channel counter
     198.  00:706A                      
     199.  00:706A                      ;.CHK1:												; --- Check if playing channel was 1 ---
     200.  00:706A                      
     201.  00:706A  10 10               		djnz	ayFX_PLAY.CHK2								; Decrement and jump if channel was not 1
     202.  00:706C                      
     203.  00:706C                      ;.PLAY_C:											; --- Play ayFX stream on channel C ---
     204.  00:706C                      
     205.  00:706C  CD A6 70            		call	ayFX_PLAY.SETMIXER							; Set PSG mixer value (a:=ayFX volume)
     206.  00:706F  32 DD C2            		ld	[ayFX_REGS+10],a						; Volume copied in to ayFX_REGS (channel C volume)
     207.  00:7072  CB 51               		bit	2,c										; If tone is off...
     208.  00:7074  C0                  		ret	nz										; ...return
     209.  00:7075  2A CE C2            		ld	hl,[ayFX_TONE]							; ayFX tone value
     210.  00:7078  22 D7 C2            		ld	[ayFX_REGS+4],hl						; copied in to ayFX_REGS (channel C tone)
     211.  00:707B  C9                  		ret											; Return
     212.  00:707C                      
     213.  00:707C                      ;.CHK2:												; --- Check if playing channel was 2 ---
     214.  00:707C                      
     215.  00:707C  CB 0A               		rrc	d										; Rotate right AND mask
     216.  00:707E  CB 0F               		rrc	a										; Rotate right OR mask
     217.  00:7080  10 10               		djnz	ayFX_PLAY.CHK3								; Decrement and jump if channel was not 2
     218.  00:7082                      
     219.  00:7082                      ;.PLAY_B:											; --- Play ayFX stream on channel B ---
     220.  00:7082                      
     221.  00:7082  CD A6 70            		call	ayFX_PLAY.SETMIXER							; Set PSG mixer value (a:=ayFX volume)
     222.  00:7085  32 DC C2            		ld	[ayFX_REGS+9],a							; Volume copied in to ayFX_REGS (channel B volume)
     223.  00:7088  CB 49               		bit	1,c										; If tone is off...
     224.  00:708A  C0                  		ret	nz										; ...return
     225.  00:708B  2A CE C2            		ld	hl,[ayFX_TONE]							; ayFX tone value
     226.  00:708E  22 D5 C2            		ld	[ayFX_REGS+2],hl						; copied in to ayFX_REGS (channel B tone)
     227.  00:7091  C9                  		ret											; Return
     228.  00:7092                      
     229.  00:7092                      ;.CHK3:												; --- Check if playing channel was 3 ---
     230.  00:7092                      
     231.  00:7092  CB 0A               		rrc	d										; Rotate right AND mask
     232.  00:7094  CB 0F               		rrc	a										; Rotate right OR mask
     233.  00:7096                      
     234.  00:7096                      ;.PLAY_A:											; --- Play ayFX stream on channel A ---
     235.  00:7096                      
     236.  00:7096  CD A6 70            		call	ayFX_PLAY.SETMIXER							; Set PSG mixer value (a:=ayFX volume)
     237.  00:7099  32 DB C2            		ld	[ayFX_REGS+8],a							; Volume copied in to ayFX_REGS (channel A volume)
     238.  00:709C  CB 41               		bit	0,c										; If tone is off...
     239.  00:709E  C0                  		ret	nz										; ...return
     240.  00:709F  2A CE C2            		ld	hl,[ayFX_TONE]							; ayFX tone value
     241.  00:70A2  22 D3 C2            		ld	[ayFX_REGS+0],hl						; copied in to ayFX_REGS (channel A tone)
     242.  00:70A5  C9                  		ret											; Return
     243.  00:70A6                      
     244.  00:70A6                      ;.SETMIXER:											; --- Set PSG mixer value ---
     245.  00:70A6                      
     246.  00:70A6  4F                  		ld	c,a										; c:=OR mask
     247.  00:70A7  3A DA C2            		ld	a,[ayFX_REGS+7]							; a:=PSG mixer value
     248.  00:70AA  A2                  		and	d										; AND mask
     249.  00:70AB  B1                  		or	c										; OR mask
     250.  00:70AC  32 DA C2            		ld	[ayFX_REGS+7],a							; PSG mixer value updated
     251.  00:70AF  3A D1 C2            		ld	a,[ayFX_VOLUME]							; a:=ayFX volume value
     252.  00:70B2  C9                  		ret											; Return
     253.  00:70B3                      
     254.  00:70B3                      ;AYfx_ROUT:	
     255.  00:70B3                      
     256.  00:70B3  AF                  		XOR A
     257.  00:70B4                      	
     258.  00:70B4                      ;ROUT_A0:											; --- FIXES BITS 6 AND 7 OF MIXER ---
     259.  00:70B4                      				
     260.  00:70B4  21 DA C2            		LD	HL,ayFX_REGS+AR_Mixer
     261.  00:70B7  CB FE               		set	7,[hl]
     262.  00:70B9  CB B6               		res	6,[hl]
     263.  00:70BB                      
     264.  00:70BB  0E A0               		LD C,$A0
     265.  00:70BD  21 D3 C2            		LD HL,ayFX_REGS
     266.  00:70C0                      
     267.  00:70C0                      ;.LOUT:	
     268.  00:70C0                      
     269.  00:70C0  ED 79               		OUT [C],A
     270.  00:70C2  0C                  		INC C
     271.  00:70C3  ED A3               		OUTI 
     272.  00:70C5  0D                  		DEC C
     273.  00:70C6  3C                  		INC A
     274.  00:70C7  FE 0D               		CP 13
     275.  00:70C9  20 F5               		JR NZ,ROUT_A0.LOUT
     276.  00:70CB  ED 79               		OUT [C],A
     277.  00:70CD  7E                  		LD A,[HL]
     278.  00:70CE                      	
     279.  00:70CE  A7                  		AND A
     280.  00:70CF  F8                  		RET M
     281.  00:70D0  0C                  		INC C
     282.  00:70D1  ED 79               		OUT [C],A
     283.  00:70D3  C9                  		RET
