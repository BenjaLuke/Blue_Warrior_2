     556.  00:42D8                      ; -----------------------------------------------------------------------------
     557.  00:42D8                      ; Carga de patrones y colores del barro.
     558.  00:42D8                      ; OJO: debe ir DESPUES de RUTINA_BOSS_5 para que la entrada del banco
     559.  00:42D8                      ; siga empezando en RUTINA_BOSS_5. Si se coloca antes, el boss puede entrar
     560.  00:42D8                      ; por esta rutina y colgarse antes de iniciar el flujo normal.
     561.  00:42D8                      ; -----------------------------------------------------------------------------
     562.  00:42D8                      CARGA_SPRITES_BARRO_BOSS_5:
     563.  00:42D8                      		
     564.  00:42D8  CD A4 6D            		call	PAGE_32_A_SEGMENT_2
     565.  00:42DB                      
     566.  00:42DB                      		; Los dos patrones anteriores al super disparo quedan reservados para la
     567.  00:42DB                      		; explosion de impacto: 92 y 96. NO se cargan aqui: ya estan
     568.  00:42DB                      		; en VRAM en el sitio adecuado.
     569.  00:42DB                      		; El super disparo empieza en los patrones del barro: 100,104,108.
     570.  00:42DB  21 20 98            		ld		hl,SUPER_DISPARO
     571.  00:42DE  11 20 43            		ld		de,PATRONES_SPRITES_VRAM_BOSS_5+BARRO_PATRON_INICIAL_BOSS_5*8
     572.  00:42E1  01 60 00            		ld		bc,8*4*SUPER_DISPARO_CANTIDAD_BOSS_5
     573.  00:42E4  CD 99 5F            		call	PON_COLOR_2.sin_bc_impuesta
     574.  00:42E7                      
     575.  00:42E7                              ; Los BUBBLES quedan despues del barro.
     576.  00:42E7  21 E0 97                    ld      hl,SPRITE_BUBBLES
     577.  00:42EA  11 A0 43                    ld      de,PATRONES_SPRITES_VRAM_BOSS_5+BUBBLES_PATRON_INICIAL_BOSS_5*8
     578.  00:42ED  01 40 00                    ld      bc,8*4*BUBBLES_PATRON_CANT_BOSS_5
     579.  00:42F0  CD 99 5F                    call    PON_COLOR_2.sin_bc_impuesta
     580.  00:42F3                      
     581.  00:42F3  21 00 92            		ld		hl,SPRITES_COVID
     582.  00:42F6  11 E0 43            		ld		de,PATRONES_SPRITES_VRAM_BOSS_5+COVID_PATRON_INICIAL_BOSS_5*8
     583.  00:42F9  01 40 00            		ld		bc,8*4*COVID_PATRON_CANT_BOSS_5
     584.  00:42FC  CD 99 5F            		call	PON_COLOR_2.sin_bc_impuesta
     585.  00:42FF                      
