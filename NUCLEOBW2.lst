      16.  00:6F44                      ;ayFX_END:											; --- End of an ayFX stream ---
      17.  00:6F44                      
      18.  00:6F44  DD 36 00 FF         		ld	[IX],255								; Priority saved (not playing ayFX stream)
      19.  00:6F48  C9                  		ret											; Return
      20.  00:6F49                      
      21.  00:6F49                      ;ayFX_INIT:											; ---     INIT A NEW ayFX STREAM     ---
      22.  00:6F49                      													; --- INPUT: A -> sound to be played ---
      23.  00:6F49                      													; ---        C -> sound priority     ---
      24.  00:6F49                      													; --- Checks the priorities of playing ayFX streams to place ---
      25.  00:6F49                      													; --- the new one on the channel with lowest priority        ---
      26.  00:6F49  C5                  		push	bc									; Store bc in stack
      27.  00:6F4A  D5                  		push	de									; Store de in stack
      28.  00:6F4B  E5                  		push	hl									; Store hl in stack
      29.  00:6F4C  DD E5               		push	IX									; Store IX in stack
      30.  00:6F4E                      													; --- Check if the index is in the bank ---
      31.  00:6F4E  47                  		ld	b,a										; b:=a (new ayFX stream index)
      32.  00:6F4F  2A BD C2            		ld	hl,[ayFX_BANK]							; Current ayFX BANK
      33.  00:6F52  7E                  		ld	a,[hl]									; Number of samples in the bank
      34.  00:6F53  B7                  		or	a										; If zero (means 256 samples)...
      35.  00:6F54  CA 5E 6F            		jp	z,ayFX_INIT.CHECK_PRI							; ...goto .CHECK_PRI
      36.  00:6F57                      													; The bank has less than 256 samples
      37.  00:6F57  78                  		ld	a,b										; a:=b (new ayFX stream index)
      38.  00:6F58  BE                  		cp	[hl]									; If new index is not in the bank...
      39.  00:6F59  3E 02               		ld	a,2										; a:=2 (error 2: Sample not in the bank)
      40.  00:6F5B  D2 BD 6F            		jp	nc,ayFX_INIT.INIT_END							; ...we can't init it
      41.  00:6F5E                      
      42.  00:6F5E                      ;.CHECK_PRI:											; --- Places the data on the correct channel                  ---
      43.  00:6F5E                      													; ---   Remember: 0 = highest priority, 15 = lowest priority  ---
      44.  00:6F5E                      													; --- Checks channel 1 ---
      45.  00:6F5E  3A BF C2            		ld	a,[ayFX_C1]								; Priority of ayFX Stream being played on channel 1
      46.  00:6F61  FE FF               		cp	255										; If there's no Stream being played...
      47.  00:6F63  28 39               		jr	z,ayFX_INIT.TOC1									; ...place the new Stream on channel 1
      48.  00:6F65  5F                  		ld	e,a										; Minimum priority of Streams being played
      49.  00:6F66  16 01               		ld	d,1										; On channel 1
      50.  00:6F68                      													; --- Checks channel 2 ---
      51.  00:6F68  3A C2 C2            		ld	a,[ayFX_C2]								; Priority of ayFX Stream being played on channel 2
      52.  00:6F6B  FE FF               		cp	255										; If there's no Stream being played...
      53.  00:6F6D  28 29               		jr	z,ayFX_INIT.TOC2									; ...place the new Stream on channel 2
      54.  00:6F6F  BB                  		cp	e										; Compare priority with minimum one
      55.  00:6F70  30 03               		jr	nc,ayFX_INIT.CHECKC3								; If P(C2) > min, go to .CHECKC3
      56.  00:6F72  5F                  		ld	e,a										; Minimum priority of Streams being played
      57.  00:6F73  16 02               		ld	d,2										; On channel 2
      58.  00:6F75                      
      59.  00:6F75                      ;.CHECKC3:											; --- Checks channel 3 ---
      60.  00:6F75                      
      61.  00:6F75  3A C5 C2            		ld	a,[ayFX_C3]								; Priority of ayFX Stream being played on channel 3
      62.  00:6F78  FE FF               		cp	255										; If there's no stream being played
      63.  00:6F7A  28 16               		jr	z,ayFX_INIT.TOC3									; ...place the new Stream on channel 3
      64.  00:6F7C  BB                  		cp	e										; Compare priority with minimum one
      65.  00:6F7D  30 03               		jr	nc,ayFX_INIT.CHECKMIN							; If P(C3) > min, go to .CHECKMIN
      66.  00:6F7F  5F                  		ld	e,a										; Minimum priority of Streams being played
      67.  00:6F80  16 03               		ld	d,3										; On channel 3
      68.  00:6F82                      
      69.  00:6F82                      ;.CHECKMIN:											; --- Checks if minimum priority is lower than priority of the new Stream ---
      70.  00:6F82                      
      71.  00:6F82  79                  		ld	a,c										; Priority of the new Stream
      72.  00:6F83  BB                  		cp	e										; Minimum priority of Streams being played
      73.  00:6F84  3E 01               		ld	a,1										; a:=1 (error 1: A sample with higher priority is being played)
      74.  00:6F86  D2 BD 6F            		jp	nc,ayFX_INIT.INIT_END							; ...we can't play the new ayFX Stream
      75.  00:6F89                      													; --- The new stream substitues the minimum priority Stream being played ---
      76.  00:6F89  7A                  		ld	a,d										; Channel of minimum priority
      77.  00:6F8A  FE 01               		cp	1										; If it's 1...
      78.  00:6F8C  28 10               		jr	z,ayFX_INIT.TOC1									; ...send Stream to channel 1
      79.  00:6F8E  FE 02               		cp	2										; If it's 2...
      80.  00:6F90  28 06               		jr	z,ayFX_INIT.TOC2									; ...send Stream to channel 2
      81.  00:6F92                      
      82.  00:6F92                      ;.TOC3:												; --- Stream will be played on channel 3
      83.  00:6F92                      
      84.  00:6F92  DD 21 C5 C2         		ld	IX,ayFX_C3								; Pointer to the chanel data
      85.  00:6F96  18 0A               		jr	ayFX_INIT.SETDATA								; Go to .SETDATA
      86.  00:6F98                      
      87.  00:6F98                      ;.TOC2:												; --- Stream will be played on channel 2
      88.  00:6F98                      
      89.  00:6F98  DD 21 C2 C2         		ld	IX,ayFX_C2								; Pointer to the channel data
      90.  00:6F9C  18 04               		jr	ayFX_INIT.SETDATA								; Go to .SETDATA
      91.  00:6F9E                      
      92.  00:6F9E                      ;.TOC1:												; --- Stream will be played on channel 1
      93.  00:6F9E                      		
      94.  00:6F9E  DD 21 BF C2         		ld	IX,ayFX_C1								; Pointer to the chanel data
      95.  00:6FA2                      
      96.  00:6FA2                      ;.SETDATA:											; --- Set data on the correct channel ---
      97.  00:6FA2                      											
      98.  00:6FA2  79                  		ld	a,c										; a:=New priority
      99.  00:6FA3  E6 0F               		and	$0F										; We mask the priority
     100.  00:6FA5  DD 77 00            		ld	[IX],a									; new ayFX stream priority saved in RAM
     101.  00:6FA8                      													; --- Calculate the pointer to the new ayFX stream ---
     102.  00:6FA8  ED 5B BD C2         		ld	de,[ayFX_BANK]							; de:=Current ayFX bank
     103.  00:6FAC  13                  		inc	de										; de points to the increments table of the bank
     104.  00:6FAD  68                  		ld	l,b										; l:=b (new ayFX stream index)
     105.  00:6FAE  26 00               		ld	h,0										; hl:=b (new ayFX stream index)
     106.  00:6FB0  29                  		add	hl,hl									; hl:=hl*2
     107.  00:6FB1  19                  		add	hl,de									; hl:=hl+de (hl points to the correct increment)
     108.  00:6FB2  5E                  		ld	e,[hl]									; e:=lower byte of the increment
     109.  00:6FB3  23                  		inc	hl										; hl points to the higher byte of the correct increment
     110.  00:6FB4  56                  		ld	d,[hl]									; de:=increment
     111.  00:6FB5  19                  		add	hl,de									; hl:=hl+de (hl points to the new ayFX stream)
     112.  00:6FB6  DD 75 01            		ld	[IX+1],l								; Pointer lower byte saved in RAM
     113.  00:6FB9  DD 74 02            		ld	[IX+2],h								; Pointer higher byte saved in RAM
     114.  00:6FBC  AF                  		xor	a										; a:=0 (no errors)
     115.  00:6FBD                      
     116.  00:6FBD                      ;.INIT_END:	
     117.  00:6FBD                      
     118.  00:6FBD  DD E1               		pop	IX										; Retrieve IX from stack
     119.  00:6FBF  E1                  		pop	hl										; Retrieve hl from stack
     120.  00:6FC0  D1                  		pop	de										; Retrieve de from stack
     121.  00:6FC1  C1                  		pop	bc										; Retrieve bc from stack
     122.  00:6FC2  C9                  		ret											; Return
     123.  00:6FC3                      
     124.  00:6FC3                      ;ayFX_PLAY:											; --- Plays next frame of each ayFX Stream ---
     125.  00:6FC3                      			
     126.  00:6FC3  21 00 00            		ld	hl,0									; hl:=0
     127.  00:6FC6  22 D4 C2            		ld	[ayFX_REGS+7],hl						; Clears mixer and volume of channel A
     128.  00:6FC9  22 D6 C2            		ld	[ayFX_REGS+9],hl						; Clears volume of channels B and C
     129.  00:6FCC  DD 21 BF C2         		ld	IX,ayFX_C1								; Channel 1
     130.  00:6FD0  3E 01               		ld	a,1										; a:=1
     131.  00:6FD2  CD E4 6F            		call	ayFX_PLAY.ayFX_PlayChannel					; Play Channel 1
     132.  00:6FD5  DD 21 C2 C2         		ld	IX,ayFX_C2								; Channel 2
     133.  00:6FD9  3E 02               		ld	a,2										; a:=2
     134.  00:6FDB  CD E4 6F            		call	ayFX_PLAY.ayFX_PlayChannel					; Play Channel 2
     135.  00:6FDE  DD 21 C5 C2         		ld	IX,ayFX_C3								; Channel 3
     136.  00:6FE2  3E 03               		ld	a,3										; a:=3
     137.  00:6FE4                      ;.ayFX_PlayChannel:									; --- Plays a channel stream ---
     138.  00:6FE4  32 CC C2            		ld	[ayFX_CHANNEL],a						; Sets current channel
     139.  00:6FE7  DD 7E 00            		ld	a,[IX]									; a:=Current ayFX stream priority
     140.  00:6FEA  B7                  		or	a										; If priority has bit 7 on...
     141.  00:6FEB  F8                  		ret	m										; ...return
     142.  00:6FEC                      													; --- Extract control byte from stream ---
     143.  00:6FEC  DD 6E 01            		ld	l,[IX+1]								; Pointer to the current ayFX stream (lower byte)
     144.  00:6FEF  DD 66 02            		ld	h,[IX+2]								; Pointer to the current ayFX stream (higher byte)
     145.  00:6FF2  4E                  		ld	c,[hl]									; c:=Control byte
     146.  00:6FF3  23                  		inc	hl										; Increment pointer
     147.  00:6FF4                      													; --- Check if there's new tone on stream ---
     148.  00:6FF4  CB 69               		bit	5,c										; If bit 5 c is off...
     149.  00:6FF6  CA 01 70            		jp	z,ayFX_PLAY.CHECK_NN								; ...jump to .CHECK_NN (no new tone)
     150.  00:6FF9                      													; --- Extract new tone from stream ---
     151.  00:6FF9  5E                  		ld	e,[hl]									; e:=lower byte of new tone
     152.  00:6FFA  23                  		inc	hl										; Increment pointer
     153.  00:6FFB  56                  		ld	d,[hl]									; d:=higher byte of new tone
     154.  00:6FFC  23                  		inc	hl										; Increment pointer
     155.  00:6FFD  ED 53 C8 C2         		ld	[ayFX_TONE],de							; ayFX tone updated
     156.  00:7001                      
     157.  00:7001                      ;.CHECK_NN:											; --- Check if there's new noise on stream ---
     158.  00:7001                      
     159.  00:7001  CB 71               		bit	6,c										; if bit 6 c is off...
     160.  00:7003  CA 10 70            		jp	z,ayFX_PLAY.SETPOINTER							; ...jump to .SETPOINTER (no new noise)
     161.  00:7006                      													; --- Extract new noise from stream ---
     162.  00:7006  7E                  		ld	a,[hl]									; a:=New noise
     163.  00:7007  23                  		inc	hl										; Increment pointer
     164.  00:7008  FE 20               		cp	$20										; If it's an illegal value of noise (used to mark end of stream)...
     165.  00:700A  CA 44 6F            		jp	z,ayFX_END								; ...jump to ayFX_END
     166.  00:700D  32 CA C2            		ld	[ayFX_NOISE],a							; ayFX noise updated
     167.  00:7010                      
     168.  00:7010                      ;.SETPOINTER:										; --- Update ayFX pointer ---
     169.  00:7010                      
     170.  00:7010  DD 75 01            		ld	[IX+1],l								; Pointer lower byte saved in RAM
     171.  00:7013  DD 74 02            		ld	[IX+2],h								; Pointer higher byte saved in RAM
     172.  00:7016                      													; --- Extract volume ---
     173.  00:7016  79                  		ld	a,c										; a:=Control byte
     174.  00:7017  E6 0F               		and	$0F										; lower nibble
     175.  00:7019  32 CB C2            		ld	[ayFX_VOLUME],a							; ayFX volume updated
     176.  00:701C  C8                  		ret	z										; Return if volume is zero (don't copy ayFX values in to ayFX_REGS)
     177.  00:701D                      													; -------------------------------------
     178.  00:701D                      													; --- COPY ayFX VALUES IN TO ayFX_REGS ---
     179.  00:701D                      													; -------------------------------------
     180.  00:701D                      													; --- Set noise channel ---
     181.  00:701D  CB 79               		bit	7,c										; If noise is off...
     182.  00:701F  C2 28 70            		jp	nz,ayFX_PLAY.SETMASKS							; ...jump to .SETMASKS
     183.  00:7022  3A CA C2            		ld	a,[ayFX_NOISE]							; ayFX noise value
     184.  00:7025  32 D3 C2            		ld	[ayFX_REGS+6],a							; copied in to ayFX_REGS (noise channel)
     185.  00:7028                      
     186.  00:7028                      ;.SETMASKS:											; --- Set mixer masks ---
     187.  00:7028                      
     188.  00:7028  79                  		ld	a,c										; a:=Control byte
     189.  00:7029  E6 90               		and	$90										; Only bits 7 and 4 (noise and tone mask for psg reg 7)
     190.  00:702B  FE 90               		cp	$90										; If no noise and no tone...
     191.  00:702D  C8                  		ret	z										; ...return (don't copy ayFX values in to ayFX_REGS)
     192.  00:702E                      													; --- Copy ayFX values in to ayFX_REGS ---
     193.  00:702E  CB 0F               		rrc	a										; Rotate a to the right (1 TIME)
     194.  00:7030  CB 0F               		rrc	a										; Rotate a to the right (2 TIMES) (OR mask)
     195.  00:7032  16 DB               		ld	d,$DB									; d:=Mask for psg mixer (AND mask)
     196.  00:7034  21 CC C2            		ld	hl,ayFX_CHANNEL							; ayFX playing channel
     197.  00:7037  46                  		ld	b,[hl]									; Channel counter
     198.  00:7038                      
     199.  00:7038                      ;.CHK1:												; --- Check if playing channel was 1 ---
     200.  00:7038                      
     201.  00:7038  10 10               		djnz	ayFX_PLAY.CHK2								; Decrement and jump if channel was not 1
     202.  00:703A                      
     203.  00:703A                      ;.PLAY_C:											; --- Play ayFX stream on channel C ---
     204.  00:703A                      
     205.  00:703A  CD 74 70            		call	ayFX_PLAY.SETMIXER							; Set PSG mixer value (a:=ayFX volume)
     206.  00:703D  32 D7 C2            		ld	[ayFX_REGS+10],a						; Volume copied in to ayFX_REGS (channel C volume)
     207.  00:7040  CB 51               		bit	2,c										; If tone is off...
     208.  00:7042  C0                  		ret	nz										; ...return
     209.  00:7043  2A C8 C2            		ld	hl,[ayFX_TONE]							; ayFX tone value
     210.  00:7046  22 D1 C2            		ld	[ayFX_REGS+4],hl						; copied in to ayFX_REGS (channel C tone)
     211.  00:7049  C9                  		ret											; Return
     212.  00:704A                      
     213.  00:704A                      ;.CHK2:												; --- Check if playing channel was 2 ---
     214.  00:704A                      
     215.  00:704A  CB 0A               		rrc	d										; Rotate right AND mask
     216.  00:704C  CB 0F               		rrc	a										; Rotate right OR mask
     217.  00:704E  10 10               		djnz	ayFX_PLAY.CHK3								; Decrement and jump if channel was not 2
     218.  00:7050                      
     219.  00:7050                      ;.PLAY_B:											; --- Play ayFX stream on channel B ---
     220.  00:7050                      
     221.  00:7050  CD 74 70            		call	ayFX_PLAY.SETMIXER							; Set PSG mixer value (a:=ayFX volume)
     222.  00:7053  32 D6 C2            		ld	[ayFX_REGS+9],a							; Volume copied in to ayFX_REGS (channel B volume)
     223.  00:7056  CB 49               		bit	1,c										; If tone is off...
     224.  00:7058  C0                  		ret	nz										; ...return
     225.  00:7059  2A C8 C2            		ld	hl,[ayFX_TONE]							; ayFX tone value
     226.  00:705C  22 CF C2            		ld	[ayFX_REGS+2],hl						; copied in to ayFX_REGS (channel B tone)
     227.  00:705F  C9                  		ret											; Return
     228.  00:7060                      
     229.  00:7060                      ;.CHK3:												; --- Check if playing channel was 3 ---
     230.  00:7060                      
     231.  00:7060  CB 0A               		rrc	d										; Rotate right AND mask
     232.  00:7062  CB 0F               		rrc	a										; Rotate right OR mask
     233.  00:7064                      
     234.  00:7064                      ;.PLAY_A:											; --- Play ayFX stream on channel A ---
     235.  00:7064                      
     236.  00:7064  CD 74 70            		call	ayFX_PLAY.SETMIXER							; Set PSG mixer value (a:=ayFX volume)
     237.  00:7067  32 D5 C2            		ld	[ayFX_REGS+8],a							; Volume copied in to ayFX_REGS (channel A volume)
     238.  00:706A  CB 41               		bit	0,c										; If tone is off...
     239.  00:706C  C0                  		ret	nz										; ...return
     240.  00:706D  2A C8 C2            		ld	hl,[ayFX_TONE]							; ayFX tone value
     241.  00:7070  22 CD C2            		ld	[ayFX_REGS+0],hl						; copied in to ayFX_REGS (channel A tone)
     242.  00:7073  C9                  		ret											; Return
     243.  00:7074                      
     244.  00:7074                      ;.SETMIXER:											; --- Set PSG mixer value ---
     245.  00:7074                      
     246.  00:7074  4F                  		ld	c,a										; c:=OR mask
     247.  00:7075  3A D4 C2            		ld	a,[ayFX_REGS+7]							; a:=PSG mixer value
     248.  00:7078  A2                  		and	d										; AND mask
     249.  00:7079  B1                  		or	c										; OR mask
     250.  00:707A  32 D4 C2            		ld	[ayFX_REGS+7],a							; PSG mixer value updated
     251.  00:707D  3A CB C2            		ld	a,[ayFX_VOLUME]							; a:=ayFX volume value
     252.  00:7080  C9                  		ret											; Return
     253.  00:7081                      
     254.  00:7081                      ;AYfx_ROUT:	
     255.  00:7081                      
     256.  00:7081  AF                  		XOR A
     257.  00:7082                      	
     258.  00:7082                      ;ROUT_A0:											; --- FIXES BITS 6 AND 7 OF MIXER ---
     259.  00:7082                      				
     260.  00:7082  21 D4 C2            		LD	HL,ayFX_REGS+AR_Mixer
     261.  00:7085  CB FE               		set	7,[hl]
     262.  00:7087  CB B6               		res	6,[hl]
     263.  00:7089                      
     264.  00:7089  0E A0               		LD C,$A0
     265.  00:708B  21 CD C2            		LD HL,ayFX_REGS
     266.  00:708E                      
     267.  00:708E                      ;.LOUT:	
     268.  00:708E                      
     269.  00:708E  ED 79               		OUT [C],A
     270.  00:7090  0C                  		INC C
     271.  00:7091  ED A3               		OUTI 
     272.  00:7093  0D                  		DEC C
     273.  00:7094  3C                  		INC A
     274.  00:7095  FE 0D               		CP 13
     275.  00:7097  20 F5               		JR NZ,ROUT_A0.LOUT
     276.  00:7099  ED 79               		OUT [C],A
     277.  00:709B  7E                  		LD A,[HL]
     278.  00:709C                      	
     279.  00:709C  A7                  		AND A
     280.  00:709D  F8                  		RET M
     281.  00:709E  0C                  		INC C
     282.  00:709F  ED 79               		OUT [C],A
     283.  00:70A1  C9                  		RET
