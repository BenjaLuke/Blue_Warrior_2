       1.  00:7FA6                      ; ------------------------------------------------------------
       2.  00:7FA6                      ; INICIA_MUSICA_COMUN
       3.  00:7FA6                      ;
       4.  00:7FA6                      ; Entrada:
       5.  00:7FA6                      ;   A  = banco donde está la música
       6.  00:7FA6                      ;   HL = dirección de la música
       7.  00:7FA6                      ;
       8.  00:7FA6                      ; Ejemplo:
       9.  00:7FA6                      ;   ld  a,39
      10.  00:7FA6                      ;   ld  hl,M_PUENTE
      11.  00:7FA6                      ;   call INICIA_MUSICA_COMUN
      12.  00:7FA6                      ;
      13.  00:7FA6                      ; IMPORTANTE:
      14.  00:7FA6                      ;   Esta rutina NO debe estar en el segmento que cambia
      15.  00:7FA6                      ;   CHANGE_BANK_2, porque si cambia el banco donde está
      16.  00:7FA6                      ;   ejecutándose, el MSX se pega el castañazo padre.
      17.  00:7FA6                      ; ------------------------------------------------------------
