       8.  00:4518                      	
       9.  00:4518                      FM_ENCONTRADO:
      10.  00:4518                      
      11.  00:4518  FE FF               			cp		0FFh
      12.  00:451A  C8                  			ret		z 														; No FM!!!
      13.  00:451B                      			
      14.  00:451B  4F                  			ld		c,a														; Slot
      15.  00:451C  C5                  			push	bc														; C ->slot FM
      16.  00:451D                      			
      17.  00:451D  3E 01               			ld		a,1
      18.  00:451F  32 5A C0            			ld		(FMPAC_DESCONECTADO),a
      19.  00:4522                      		
      20.  00:4522  3A E3 C2            			ld		a,(chips)												; Cargamos en A el valor de chips
      21.  00:4525  CB CF               			set		1,a														; Lo convierte en xxxxxx1x para indicar que es estero
      22.  00:4527  32 E3 C2            			ld		(chips),a												; Lo salva para futuros usos
      23.  00:452A                      					
      24.  00:452A  79                  			ld		a,c														; Slot
      25.  00:452B  21 F6 7F            			ld		hl,#7FF6
      26.  00:452E  CD 0C 00            			call	RDSLT
      27.  00:4531                      			
      28.  00:4531  F6 01               			or		00000001B		
      29.  00:4533  5F                  			ld		e,a														; Valor a escribir
      30.  00:4534                      
      31.  00:4534  C1                  			pop		bc
      32.  00:4535  79                  			ld		a,c
      33.  00:4536  21 F6 7F            			ld		hl,#7FF6
      34.  00:4539  CD 14 00            			call	WRSLT
      35.  00:453C                      			
      36.  00:453C  C9                  			ret
