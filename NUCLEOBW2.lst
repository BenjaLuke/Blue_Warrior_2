    1646.  00:4B7A                      
    1647.  00:4B7A                      ; -----------------------------------------------------------------------------
    1648.  00:4B7A                      ; Limpia las franjas que deja Chuminix al desplazarse.
    1649.  00:4B7A                      ; Se llama DESPUES de pintar el copy nuevo.
    1650.  00:4B7A                      ;
    1651.  00:4B7A                      ; VARIABLE_UN_USO  = X anterior
    1652.  00:4B7A                      ; VARIABLE_UN_USO2 = Y anterior
    1653.  00:4B7A                      ;
    1654.  00:4B7A                      ; Horizontal:
    1655.  00:4B7A                      ;   X crece   -> rellena X-delta, Y, ancho delta, alto 48
    1656.  00:4B7A                      ;   X decrece -> rellena X+128,   Y, ancho delta, alto 48
    1657.  00:4B7A                      ;
    1658.  00:4B7A                      ; Vertical:
    1659.  00:4B7A                      ;   Y crece   -> rellena X menor, Y-delta, ancho 128+deltaX, alto delta
    1660.  00:4B7A                      ;   Y decrece -> rellena X menor, Y+48,    ancho 128+deltaX, alto delta
    1661.  00:4B7A                      ;   Asi cubrimos el rastro cuando Chuminix se mueve en diagonal.
    1662.  00:4B7A                      ; -----------------------------------------------------------------------------
    1663.  00:4B7A                      BORRA_RASTRO_CHUMINIX_PELEA_BOSS_3:
