    2441.  00:4EEC  32 28 C6                    ld      (ROTATIVO_REPETICION_LETRA_PRESENTACION),a
    2442.  00:4EEF  32 29 C6                    ld      (ROTATIVO_MODO_SALIDA_PRESENTACION),a
    2443.  00:4EF2                      
    2444.  00:4EF2  3E 2B                       ld      a,ROTATIVO_ESPACIOS_SALIDA_PRESENTACION
    2445.  00:4EF4  32 2A C6                    ld      (ROTATIVO_PASOS_SALIDA_PRESENTACION),a
    2446.  00:4EF7                      
