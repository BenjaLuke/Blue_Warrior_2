       1.  00:7FB3                      ; ------------------------------------------------------------
       2.  00:7FB3                      ; INICIA_MUSICA_COMUN
       3.  00:7FB3                      ;
       4.  00:7FB3                      ; Entrada:
       5.  00:7FB3                      ;   A  = banco donde está la música
       6.  00:7FB3                      ;   HL = dirección de la música
       7.  00:7FB3                      ;
       8.  00:7FB3                      ; Ejemplo:
       9.  00:7FB3                      ;   ld  a,39
      10.  00:7FB3                      ;   ld  hl,M_PUENTE
      11.  00:7FB3                      ;   call INICIA_MUSICA_COMUN
      12.  00:7FB3                      ;
      13.  00:7FB3                      ; IMPORTANTE:
      14.  00:7FB3                      ;   Esta rutina NO debe estar en el segmento que cambia
      15.  00:7FB3                      ;   CHANGE_BANK_2, porque si cambia el banco donde está
      16.  00:7FB3                      ;   ejecutándose, el MSX se pega el castañazo padre.
      17.  00:7FB3                      ; ------------------------------------------------------------
      18.  00:7FB3                      
