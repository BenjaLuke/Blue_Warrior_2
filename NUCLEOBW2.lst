     226.  00:7047  22 D2 C2            		ld	[ayFX_REGS+2],hl						; copied in to ayFX_REGS (channel B tone)
     227.  00:704A  C9                  		ret											; Return
     228.  00:704B                      
     229.  00:704B                      ;.CHK3:												; --- Check if playing channel was 3 ---
     230.  00:704B                      
     231.  00:704B  CB 0A               		rrc	d										; Rotate right AND mask
     232.  00:704D  CB 0F               		rrc	a										; Rotate right OR mask
     233.  00:704F                      
     234.  00:704F                      ;.PLAY_A:											; --- Play ayFX stream on channel A ---
