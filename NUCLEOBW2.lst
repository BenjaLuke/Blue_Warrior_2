    2940.  00:6F0E                      
    2941.  00:6F0E  3A 0D C1            		ld		a,(CORAZONES)
    2942.  00:6F11  3D                  		dec		a
    2943.  00:6F12  32 0D C1            		ld		(CORAZONES),a
    2944.  00:6F15  28 12               		jr		z,.MUERE_DEPH_EN_BOSS_COMUN
    2945.  00:6F17                      
    2946.  00:6F17  3E 03               		ld		a,3
    2947.  00:6F19  0E 01               		ld		c,1
    2948.  00:6F1B  CD E4 6D            		call	A_31_DESDE_10
    2949.  00:6F1E                      
    2950.  00:6F1E  3E 96               		ld		a,150
    2951.  00:6F20  32 1B C1            		ld		(INMUNE),a
