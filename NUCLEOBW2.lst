    1266.  00:4607                      MUEVE_CHUMINIX_BOSS_3:
    1267.  00:4607                      
    1268.  00:4607                      		; Control completo de Chuminix durante la pelea.
    1269.  00:4607                      		; Secuencia 1: patrulla libre X/Y con frames 3-6.
