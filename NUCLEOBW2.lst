    2402.  00:4EC7                      PINTA_LETRA_MENU_ROTATIVO_PARCIAL_EN_DESTINO:
    2403.  00:4EC7                      
    2404.  00:4EC7                              ; Entrada:
    2405.  00:4EC7                              ;   A  = caracter a pintar
    2406.  00:4EC7                              ;   HL = X destino: 254, 252 o 250
    2407.  00:4EC7                              ;   DE = Y destino con page incluida
    2408.  00:4EC7                              ;
    2409.  00:4EC7                              ; Copiamos solo la parte visible de la letra:
    2410.  00:4EC7                              ;   repeticion 0 -> ancho 2
    2411.  00:4EC7                              ;   repeticion 1 -> ancho 4
    2412.  00:4EC7                              ;   repeticion 2 -> ancho 6
    2413.  00:4EC7                              ;
    2414.  00:4EC7                              ; Así respetamos la entrada progresiva sin escribir fuera de X=255.
    2415.  00:4EC7                      
