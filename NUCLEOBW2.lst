    2563.  00:532F  28 02               		jr		z,.GUARDA_PAGE_ORIGEN_MUERTE_AGONIX_BOSS_1
    2564.  00:5331                      
    2565.  00:5331  3E 01               		ld		a,AGONIX_MOVIMIENTO_PAG_IZQUIERDA_BOSS_1
    2566.  00:5333                      
