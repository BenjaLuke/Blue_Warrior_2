       1.  00:4515                      BUSCAMOS_FM_PAC:
       2.  00:4515                      
       3.  00:4515                      			;Output: 
       4.  00:4515                      			;	A=0 No se encontró el FM
       5.  00:4515                      			;	A=1 Sí se encontró el FM
       6.  00:4515                      
       7.  00:4515  CD 3D 45            			call	BUSCANDO_LA_CADENA_OPLL
       8.  00:4518                      	
       9.  00:4518                      FM_ENCONTRADO:
      10.  00:4518                      
      11.  00:4518  FE FF               			cp		0FFh
      12.  00:451A  C8                  			ret		z 														; No FM!!!
      13.  00:451B                      			
      14.  00:451B  4F                  			ld		c,a														; Slot
      15.  00:451C  C5                  			push	bc														; C ->slot FM
      16.  00:451D                      			
      17.  00:451D  3E 01               			ld		a,1
      18.  00:451F  32 5A C0            			ld		(FMPAC_DESCONECTADO),a
      19.  00:4522                      		
      20.  00:4522  3A E4 C2            			ld		a,(chips)												; Cargamos en A el valor de chips
      21.  00:4525  CB CF               			set		1,a														; Lo convierte en xxxxxx1x para indicar que es estero
      22.  00:4527  32 E4 C2            			ld		(chips),a												; Lo salva para futuros usos
      23.  00:452A                      					
      24.  00:452A  79                  			ld		a,c														; Slot
      25.  00:452B  21 F6 7F            			ld		hl,#7FF6
      26.  00:452E  CD 0C 00            			call	RDSLT
      27.  00:4531                      			
      28.  00:4531  F6 01               			or		00000001B		
      29.  00:4533  5F                  			ld		e,a														; Valor a escribir
      30.  00:4534                      
      31.  00:4534  C1                  			pop		bc
      32.  00:4535  79                  			ld		a,c
      33.  00:4536  21 F6 7F            			ld		hl,#7FF6
      34.  00:4539  CD 14 00            			call	WRSLT
      35.  00:453C                      			
      36.  00:453C  C9                  			ret
      37.  00:453D                      
      38.  00:453D                      BUSCANDO_LA_CADENA_OPLL:	
      39.  00:453D                      	
      40.  00:453D  01 00 04            			ld		bc,00400h 												; Bucle DJNZ. Metemos 4 en B para mirar los 4 slots
      41.  00:4540  21 C1 FC            			ld		hl,0fcc1h 												; En RAM ->EXPTBL 
      42.  00:4543                      
      43.  00:4543                      SIGUIENTE_SLOT:
      44.  00:4543  C5                  			push	bc
      45.  00:4544  E5                  			push	hl
      46.  00:4545  7E                  			ld		a,(hl)
      47.  00:4546  CB 7F               			bit		7,a														; Slot expandido?
      48.  00:4548  20 06               			jr		nz,EXPANSION_1
      49.  00:454A  79                  			ld		a,c
      50.  00:454B  CD 71 45            			call	COTEJA_CARACTERES_FM
      51.  00:454E  18 03               			jr		SIGUIENTE_SLOT_3
      52.  00:4550                      EXPANSION_1:
      53.  00:4550  CD 5E 45            			call	EXPANSION
      54.  00:4553                      
      55.  00:4553                      SIGUIENTE_SLOT_3:
      56.  00:4553                      
      57.  00:4553  79                  			ld		a,c														; Slot
      58.  00:4554  E1                  			pop		hl
      59.  00:4555  C1                  			pop		bc
      60.  00:4556  C8                  			ret		z														; Si es diferente de FFh -> Encontrado!!!
      61.  00:4557  23                  			inc		hl
      62.  00:4558  0C                  			inc		c
      63.  00:4559  10 E8               			djnz	SIGUIENTE_SLOT
      64.  00:455B  3E FF               			ld		a,0FFh													; El FM no ha sido encontrado, por tanto->A=0FFh
      65.  00:455D  C9                  			ret
      66.  00:455E                      
      67.  00:455E                      EXPANSION:
      68.  00:455E                      
      69.  00:455E  E6 80               			and		080h
      70.  00:4560  B1                  			or		c
      71.  00:4561  4F                  			ld		c,a														; Slot más expandido o no
      72.  00:4562  06 04               			ld		b,4
      73.  00:4564                      SIGUIENTE_SLOT_4:
      74.  00:4564                      
      75.  00:4564  C5                  			push	bc
      76.  00:4565  CD 71 45            			call	COTEJA_CARACTERES_FM
      77.  00:4568  C1                  			pop		bc
      78.  00:4569  C8                  			ret		z														; Si es diferente de FFh -> Encontrado!!!
      79.  00:456A  79                  			ld		a,c
      80.  00:456B  C6 04               			add		a,04
      81.  00:456D  4F                  			ld		c,a
      82.  00:456E  10 F4               			djnz	SIGUIENTE_SLOT_4
      83.  00:4570                      
      84.  00:4570  C9                  	ret
