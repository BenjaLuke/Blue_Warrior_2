    2570.  00:5367                      
    2571.  00:5367                      		; Animación de muerte:
    2572.  00:5367                      		; copiamos siempre desde el primer recuadro de la page fuente
    2573.  00:5367                      		; hacia page 2, recortando altura y bajando destino.
    2574.  00:5367                      		;
    2575.  00:5367                      		; derecha  -> page 3
    2576.  00:5367                      		; izquierda -> page 1
    2577.  00:5367                      
    2578.  00:5367  DD 21 F5 56         		ld		ix,BOSS_1_COPY_MOVIMIENTO_AGONIX
    2579.  00:536B  FD 21 A9 C2         		ld		iy,DATAS_COPY_RECUP_SCROLL
    2580.  00:536F  CD B7 43            		call	RUTINA_BOSS_1.BUCLE_PINTA_DATAS
    2581.  00:5372                      
    2582.  00:5372  FD 21 A9 C2         		ld		iy,DATAS_COPY_RECUP_SCROLL
    2583.  00:5376                      
    2584.  00:5376                      		; Página fuente según dirección.
    2585.  00:5376                      
    2586.  00:5376  3A 7A C6            		ld		a,(AGONIX_BOSS_1_DIRECCION)
    2587.  00:5379  B7                  		or		a
    2588.  00:537A  3E 03               		ld		a,AGONIX_MOVIMIENTO_PAG_DERECHA_BOSS_1
    2589.  00:537C  28 02               		jr		z,.GUARDA_PAGE_ORIGEN_MUERTE_AGONIX_BOSS_1
    2590.  00:537E                      
    2591.  00:537E  3E 01               		ld		a,AGONIX_MOVIMIENTO_PAG_IZQUIERDA_BOSS_1
    2592.  00:5380                      
    2593.  00:5380                      .GUARDA_PAGE_ORIGEN_MUERTE_AGONIX_BOSS_1:
    2594.  00:5380                      
    2595.  00:5380  FD 77 03            		ld		(iy+3),a							; page origen: 3 o 1
    2596.  00:5383                      
    2597.  00:5383                      
    2598.  00:5383                      		; Origen: primer recuadro arriba izquierda.
    2599.  00:5383                      		; x=0, y=0. La page ya la hemos puesto en iy+3.
    2600.  00:5383                      
    2601.  00:5383  AF                  		xor		a
    2602.  00:5384  FD 77 00            		ld		(iy),a								; origen x low
    2603.  00:5387  FD 77 01            		ld		(iy+1),a							; origen x high
    2604.  00:538A  FD 77 02            		ld		(iy+2),a							; origen y low
    2605.  00:538D                      
    2606.  00:538D                      
    2607.  00:538D                      		; Destino X: posición actual de Agonix en page 2.
    2608.  00:538D                      
    2609.  00:538D  3A 79 C6            		ld		a,(AGONIX_BOSS_1_X)
    2610.  00:5390  FD 77 04            		ld		(iy+4),a							; destino x low
    2611.  00:5393  AF                  		xor		a
    2612.  00:5394  FD 77 05            		ld		(iy+5),a							; destino x high
    2613.  00:5397                      
    2614.  00:5397                      
    2615.  00:5397                      		; Recuperamos el contador externo del bucle.
    2616.  00:5397                      		; B = altura actual que vamos a copiar.
    2617.  00:5397                      		; Primera vuelta: B = 48.
    2618.  00:5397                      		; Última vuelta: B = 1.
    2619.  00:5397                      		; Cuando B llega a 0, el djnz de fuera termina la animación.
    2620.  00:5397                      
    2621.  00:5397  C1                  		pop		bc
    2622.  00:5398  C5                  		push	bc
    2623.  00:5399                      
    2624.  00:5399                      		; offset = altura inicial - altura actual.
    2625.  00:5399                      		; Este offset baja el destino.
    2626.  00:5399                      
    2627.  00:5399  3E 30               		ld		a,AGONIX_MUERTE_ALTO_BOSS_1
    2628.  00:539B  90                  		sub		b
    2629.  00:539C  4F                  		ld		c,a									; C = offset vertical
    2630.  00:539D                      
    2631.  00:539D                      
    2632.  00:539D                      		; Destino Y = y actual de Agonix + offset.
