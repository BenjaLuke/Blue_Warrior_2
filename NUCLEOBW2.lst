    2769.  00:50A0                      DATOS_NEGRO_ROTATIVO_EN_PAGE_0:
    2770.  00:50A0                      
    2771.  00:50A0                              ; Rectángulo negro en page 0.
    2772.  00:50A0                              ; X=0, Y=ROTATIVO_Y_PRESENTACION, ancho 256, alto 8.
    2773.  00:50A0                      
    2774.  00:50A0  00 00 00 00                 dw      #0000,#0000
    2775.  00:50A4  00 00 C3 00                 dw      #0000,#0000+ROTATIVO_Y_PRESENTACION
