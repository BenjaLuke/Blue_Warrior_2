    2360.  00:50F6                              ;
    2361.  00:50F6                              ; Copiamos solo la parte visible de la letra:
    2362.  00:50F6                              ;   repeticion 0 -> ancho 2
    2363.  00:50F6                              ;   repeticion 1 -> ancho 4
    2364.  00:50F6                              ;   repeticion 2 -> ancho 6
    2365.  00:50F6                              ;
