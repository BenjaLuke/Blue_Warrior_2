       2.  00:7F95                      ; INICIA_MUSICA_COMUN
       3.  00:7F95                      ;
       4.  00:7F95                      ; Entrada:
       5.  00:7F95                      ;   A  = banco donde está la música
       6.  00:7F95                      ;   HL = dirección de la música
       7.  00:7F95                      ;
       8.  00:7F95                      ; Ejemplo:
       9.  00:7F95                      ;   ld  a,39
      10.  00:7F95                      ;   ld  hl,M_PUENTE
      11.  00:7F95                      ;   call INICIA_MUSICA_COMUN
      12.  00:7F95                      ;
      13.  00:7F95                      ; IMPORTANTE:
      14.  00:7F95                      ;   Esta rutina NO debe estar en el segmento que cambia
      15.  00:7F95                      ;   CHANGE_BANK_2, porque si cambia el banco donde está
      16.  00:7F95                      ;   ejecutándose, el MSX se pega el castañazo padre.
      17.  00:7F95                      ; ------------------------------------------------------------
