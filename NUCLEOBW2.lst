       2.  00:72F0                      ;INICIAMOS_MUSICA:
       3.  00:72F0                      
       4.  00:72F0  AF                  		xor		a														;le damos 0 a la posicion de arranque de la música
       5.  00:72F1  32 E9 C2            		ld		(pos),a
       6.  00:72F4  3E 01               		ld		a,1
