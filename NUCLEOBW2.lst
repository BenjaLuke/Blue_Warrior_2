    2507.  00:532E                      
    2508.  00:532E                      		; Comprueba borde superior reducido:
    2509.  00:532E                      		; Deph abajo >= Errecenyx arriba + 20
    2510.  00:532E  3A 65 C0            		ld		a,(Y_DEPH)
    2511.  00:5331  C6 14               		add		20
    2512.  00:5333  FE 30               		cp		ERRECENYX_MOVIMIENTO_Y_BOSS_4+20
    2513.  00:5335  D8                  		ret		c
    2514.  00:5336                      
    2515.  00:5336                      		; Comprueba borde inferior reducido:
    2516.  00:5336                      		; Deph arriba < Errecenyx abajo - 20
    2517.  00:5336  3A 65 C0            		ld		a,(Y_DEPH)
    2518.  00:5339  FE 46               		cp		ERRECENYX_MOVIMIENTO_Y_BOSS_4+ERRECENYX_MOVIMIENTO_ALTO_BOSS_4-20
    2519.  00:533B  D0                  		ret		nc
