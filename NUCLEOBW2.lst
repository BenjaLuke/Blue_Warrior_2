    2572.  00:536A                      		; Animación de muerte:
    2573.  00:536A                      		; copiamos siempre desde el primer recuadro de la page fuente
    2574.  00:536A                      		; hacia page 2, recortando altura y bajando destino.
    2575.  00:536A                      		;
    2576.  00:536A                      		; derecha  -> page 3
    2577.  00:536A                      		; izquierda -> page 1
    2578.  00:536A                      
