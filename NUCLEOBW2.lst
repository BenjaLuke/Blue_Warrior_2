     482.  00:4274                      
     483.  00:4274                      		; Los dos patrones anteriores al super disparo quedan reservados para la
     484.  00:4274                      		; explosion de impacto: 92 y 96. NO se cargan aqui: ya estan
     485.  00:4274                      		; en VRAM en el sitio adecuado.
     486.  00:4274                      		; El super disparo empieza en los patrones del barro: 100,104,108.
     487.  00:4274  21 40 9E            		ld		hl,SUPER_DISPARO
     488.  00:4277  11 20 43            		ld		de,PATRONES_SPRITES_VRAM_BOSS_5+BARRO_PATRON_INICIAL_BOSS_5*8
     489.  00:427A  01 60 00            		ld		bc,8*4*SUPER_DISPARO_CANTIDAD_BOSS_5
     490.  00:427D  CD 58 5F            		call	PON_COLOR_2.sin_bc_impuesta
