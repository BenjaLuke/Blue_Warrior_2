    2147.  00:4FE2  (00:00C3)           ROTATIVO_Y_PRESENTACION                  equ     195
    2148.  00:4FE2                      
    2149.  00:4FE2                      ; Cada cuántos frames se actualiza el rotativo.
    2150.  00:4FE2                      ; 1 = cada frame, 2 = cada dos frames, etc.
    2151.  00:4FE2  (00:0003)           ROTATIVO_VELOCIDAD_PRESENTACION          equ     3
    2152.  00:4FE2                      
    2153.  00:4FE2                      ; El nuevo rotativo avanza copiando la franja 2 píxeles a la izquierda.
    2154.  00:4FE2                      ; Cada letra mide 6 píxeles, así que se introduce en 3 pasos:
    2155.  00:4FE2                      ;   paso 0 -> X=254
    2156.  00:4FE2                      ;   paso 1 -> X=252
    2157.  00:4FE2                      ;   paso 2 -> X=250
    2158.  00:4FE2  (00:0002)           ROTATIVO_PIXELES_POR_PASO_PRESENTACION   equ     2
    2159.  00:4FE2  (00:0003)           ROTATIVO_PASOS_POR_LETRA_PRESENTACION    equ     3
    2160.  00:4FE2  (00:00FE)           ROTATIVO_X_ENTRADA_PRESENTACION          equ     254
    2161.  00:4FE2  (00:00FE)           ROTATIVO_ANCHO_SCROLL_PRESENTACION       equ     254
    2162.  00:4FE2  (00:0008)           ROTATIVO_ALTO_PRESENTACION               equ     8
    2163.  00:4FE2                      
    2164.  00:4FE2                      ; Cuando se acaba el texto, metemos espacios hasta que toda la cola sale
    2165.  00:4FE2                      ; por la izquierda. 43 espacios * 6 píxeles = 258 píxeles.
    2166.  00:4FE2  (00:002B)           ROTATIVO_ESPACIOS_SALIDA_PRESENTACION    equ     43
