    2260.  00:4FF2  32 14 C6                    ld      (ROTATIVO_PAGINA_VISIBLE_PRESENTACION),a
    2261.  00:4FF5  32 17 C6                    ld      (ROTATIVO_REPETICION_LETRA_PRESENTACION),a
    2262.  00:4FF8  32 18 C6                    ld      (ROTATIVO_MODO_SALIDA_PRESENTACION),a
    2263.  00:4FFB                      
    2264.  00:4FFB  3E 2B                       ld      a,ROTATIVO_ESPACIOS_SALIDA_PRESENTACION
    2265.  00:4FFD  32 19 C6                    ld      (ROTATIVO_PASOS_SALIDA_PRESENTACION),a
