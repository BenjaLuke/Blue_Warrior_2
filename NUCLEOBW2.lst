      56:  00:59AB                      ; -----------------------------------------------------------------------------
      57:  00:59AB                      ; Copys de la animacion de entrada de Chuminix.
      58:  00:59AB                      ;
      59:  00:59AB                      ; SCREEN 5 / DOCOPY:
      60:  00:59AB                      ; Cuando hablamos de page N (x,y), aqui se traduce a coordenadas absolutas
      61:  00:59AB                      ; de VDP: X=x, Y=PAGE_N_VRAM_Y_BOSS_3+y. No se corrigen los origenes por
      62:  00:59AB                      ; tamanyo ni por centrado; se usan exactamente las coordenadas indicadas.
      63:  00:59AB                      ;
      64:  00:59AB                      ; Frame 0 se salva desde page 2 a page 0 (zona oculta en y=150).
      65:  00:59AB                      ; Los demas fotogramas se leen desde page 1 y se copian centrados a page 2.
      66:  00:59AB                      ; -----------------------------------------------------------------------------
      67:  00:59AB                      BOSS_3_COPY_GUARDA_FRAME_0_CHUMINIX:
      68:  00:59AB                      
      69:  00:59AB                      		; Guarda el fondo visible donde aparecera Chuminix.
      70:  00:59AB                      		; Origen:  page 2 (64,78)  -> X=#0040, Y=#0200+#004E = #024E
      71:  00:59AB                      		; Destino: page 0 (0,150)  -> X=#0000, Y=#0096
      72:  00:59AB  40 00 4E 02         		dw		#0040,#024E
      73:  00:59AF  00 00 96 00         		dw		#0000,#0096
      74:  00:59B3  80 00 30 00         		dw		CHUMINIX_APARICION_ANCHO_BOSS_3,CHUMINIX_APARICION_ALTO_BOSS_3
      75:  00:59B7  00 00 90            		db		#00,#00,10010000b
      76:  00:59BA                      
      77:  00:59BA                      BOSS_3_COPY_APARICION_CHUMINIX_FRAME_0:
      78:  00:59BA                      
      79:  00:59BA                      		; Recupera exactamente el frame 0 desde donde se guardo: page 0 (0,150).
      80:  00:59BA  00 00 96 00         		dw		#0000,#0096
      81:  00:59BE  40 00 4E 02         		dw		#0040,#024E
      82:  00:59C2  80 00 30 00         		dw		CHUMINIX_APARICION_ANCHO_BOSS_3,CHUMINIX_APARICION_ALTO_BOSS_3
      83:  00:59C6  00 00 90            		db		#00,#00,10010000b
      84:  00:59C9                      
      85:  00:59C9                      BOSS_3_COPY_APARICION_CHUMINIX_FRAME_1:
      86:  00:59C9                      
      87:  00:59C9                      		; Origen: page 1 (0,96) -> X=#0000, Y=#0100+96 = #0160
      88:  00:59C9  00 00 60 01         		dw		#0000,#0160
      89:  00:59CD  40 00 4E 02         		dw		#0040,#024E
      90:  00:59D1  80 00 30 00         		dw		CHUMINIX_APARICION_ANCHO_BOSS_3,CHUMINIX_APARICION_ALTO_BOSS_3
      91:  00:59D5  00 00 90            		db		#00,#00,10010000b
      92:  00:59D8                      
      93:  00:59D8                      BOSS_3_COPY_APARICION_CHUMINIX_FRAME_2:
      94:  00:59D8                      
      95:  00:59D8                      		; Origen: page 1 (128,96) -> X=#0080, Y=#0100+96 = #0160
      96:  00:59D8  80 00 60 01         		dw		#0080,#0160
      97:  00:59DC  40 00 4E 02         		dw		#0040,#024E
      98:  00:59E0  80 00 30 00         		dw		CHUMINIX_APARICION_ANCHO_BOSS_3,CHUMINIX_APARICION_ALTO_BOSS_3
      99:  00:59E4  00 00 90            		db		#00,#00,10010000b
