    2103.  00:4D83                      		db		"The story of Gamourla isn't exactly as ",0
    2103.  00:4D83  54 68 65 20 73 74 6F 72 79 20 6F 66 20 47 61 6D 
    2103.  00:4D93  6F 75 72 6C 61 20 69 73 6E 27 74 20 65 78 61 63 
    2103.  00:4DA3  74 6C 79 20 61 73 20 00 
    2104.  00:4DAB                      TEXTO_CINEMATICA_1_2:
    2105.  00:4DAB                      		db		"you were told. Although it's a ",0
    2105.  00:4DAB  79 6F 75 20 77 65 72 65 20 74 6F 6C 64 2E 20 41 
    2105.  00:4DBB  6C 74 68 6F 75 67 68 20 69 74 27 73 20 61 20 00 
    2106.  00:4DCB                      TEXTO_CINEMATICA_1_3:
    2107.  00:4DCB                      		db		"prosperous village, the fear of the past",0
    2107.  00:4DCB  70 72 6F 73 70 65 72 6F 75 73 20 76 69 6C 6C 61 
    2107.  00:4DDB  67 65 2C 20 74 68 65 20 66 65 61 72 20 6F 66 20 
    2107.  00:4DEB  74 68 65 20 70 61 73 74 00 
    2108.  00:4DF4                      TEXTO_CINEMATICA_1_4:
    2109.  00:4DF4                      		db		"still lingers.",0
    2109.  00:4DF4  73 74 69 6C 6C 20 6C 69 6E 67 65 72 73 2E 00 
    2110.  00:4E03                      
    2111.  00:4E03                      TEXTO_CINEMATICA_2_1:
    2112.  00:4E03                      		db		"And Deph Kurgan, hero of past ",0
    2112.  00:4E03  41 6E 64 20 44 65 70 68 20 4B 75 72 67 61 6E 2C 
    2112.  00:4E13  20 68 65 72 6F 20 6F 66 20 70 61 73 74 20 00 
    2113.  00:4E22                      TEXTO_CINEMATICA_2_2:
    2114.  00:4E22                      		db		"adventures, feels in his bones how",0
    2114.  00:4E22  61 64 76 65 6E 74 75 72 65 73 2C 20 66 65 65 6C 
    2114.  00:4E32  73 20 69 6E 20 68 69 73 20 62 6F 6E 65 73 20 68 
    2114.  00:4E42  6F 77 00 
