     102.  00:457D                      ;			or		080h												;EXPANSION
     103.  00:457D  CD 0C 00            			call	RDSLT												; Lee el valor de otro slot
     104.  00:4580  C1                  			pop		bc
     105.  00:4581  D1                  			pop		de
     106.  00:4582  EB                  			ex		de,hl
     107.  00:4583  BE                  			cp		(hl)
     108.  00:4584  EB                  			ex		de,hl
     109.  00:4585  C0                  			ret		nz
     110.  00:4586  23                  			inc		hl
     111.  00:4587  13                  			inc		de
     112.  00:4588  10 F0               			djnz	SIGUIENTE_CARACTER_FM
     113.  00:458A  AF                  			xor		a 													; Z set
     114.  00:458B  C9                  			ret
