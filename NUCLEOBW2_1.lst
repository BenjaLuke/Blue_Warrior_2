    2514.  00:52E7                      
    2515.  00:52E7                      		; Tamaño destino/fuente:
    2516.  00:52E7                      		; ancho fijo, altura decreciendo.
    2517.  00:52E7                      
    2518.  00:52E7  78                  		ld		a,b
    2519.  00:52E8  FD 77 0A            		ld		(iy+10),a							; alto low = B
    2520.  00:52EB  AF                  		xor		a
    2521.  00:52EC  FD 77 0B            		ld		(iy+11),a							; alto high = 0
