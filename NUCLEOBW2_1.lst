     469.  00:424C  11 E0 43                    ld      de,PATRONES_SPRITES_VRAM_BOSS_4+BUBBLES_PATRON_INICIAL_BOSS_4*8
     470.  00:424F  01 40 00                    ld      bc,8*4*BUBBLES_PATRON_CANT_BOSS_4
     471.  00:4252  CD 42 5F                    call    PON_COLOR_2.sin_bc_impuesta
