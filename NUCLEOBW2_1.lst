    2566.  00:532D                      
    2567.  00:532D  3E 0B                       ld      a,11
    2568.  00:532F  0E 00                       ld      c,0
    2569.  00:5331  CD 71 52                    call    TIRA_FX_BOSS_1
    2570.  00:5334                      
    2571.  00:5334                              ; Pintamos el rectángulo
    2572.  00:5334                      
