    1700.  00:4EE8                      REVISAMOS_COLISION_CON_AGONIX_Y_DEPH:
    1701.  00:4EE8                      
    1702.  00:4EE8                      		; Hitbox Agonix reducido 20 px por cada lado.
    1703.  00:4EE8                      		; Deph se sigue tratando como caja aproximada de 20x20.
    1704.  00:4EE8                      		;
    1705.  00:4EE8                      		; Agonix original:
    1706.  00:4EE8                      		; X = AGONIX_BOSS_1_X
    1707.  00:4EE8                      		; W = AGONIX_MOVIMIENTO_ANCHO_BOSS_1
    1708.  00:4EE8                      		; Y = AGONIX_MOVIMIENTO_Y_BOSS_1
    1709.  00:4EE8                      		; H = AGONIX_MOVIMIENTO_ALTO_BOSS_1
    1710.  00:4EE8                      		;
    1711.  00:4EE8                      		; Agonix reducido:
    1712.  00:4EE8                      		; X izquierda = X + 20
    1713.  00:4EE8                      		; X derecha   = X + ancho - 20
    1714.  00:4EE8                      		; Y arriba    = Y + 20
    1715.  00:4EE8                      		; Y abajo     = Y + alto - 20
    1716.  00:4EE8                      
    1717.  00:4EE8  3A BF C5            		ld		a,(AGONIX_BOSS_1_X)
    1718.  00:4EEB  C6 14               		add		20
    1719.  00:4EED  4F                  		ld		c,a
    1720.  00:4EEE  3A 64 C0            		ld		a,(X_DEPH)
    1721.  00:4EF1  C6 14               		add		20
    1722.  00:4EF3  B9                  		cp		c
    1723.  00:4EF4  D8                  		ret		c
    1724.  00:4EF5                      
    1725.  00:4EF5  3A BF C5            		ld		a,(AGONIX_BOSS_1_X)
    1726.  00:4EF8  C6 6E               		add		AGONIX_MOVIMIENTO_ANCHO_BOSS_1-20
    1727.  00:4EFA  4F                  		ld		c,a
    1728.  00:4EFB  3A 64 C0            		ld		a,(X_DEPH)
    1729.  00:4EFE  B9                  		cp		c
    1730.  00:4EFF  D0                  		ret		nc
    1731.  00:4F00                      
    1732.  00:4F00  3A 65 C0            		ld		a,(Y_DEPH)
