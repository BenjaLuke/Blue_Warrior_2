       1.  00:72F0                      ;INICIAMOS_MUSICA:
       2.  00:72F0                      
       3.  00:72F0  AF                  		xor		a														;le damos 0 a la posicion de arranque de la música
       4.  00:72F1  32 B1 C2            		ld		(pos),a
       5.  00:72F4  3E 01               		ld		a,1
       6.  00:72F6  32 C0 C2            		ld		(modval),a
