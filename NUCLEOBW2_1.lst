    2240.  00:5199                      REVISAMOS_COLISION_CON_ERRECENYX_Y_DEPH:
    2241.  00:5199                      
    2242.  00:5199                      		; Hitbox Errecenyx/Herrecenix reducido 20 px por cada lado.
    2243.  00:5199                      		; Deph se sigue tratando como caja aproximada de 20x20.
    2244.  00:5199                      		;
    2245.  00:5199                      		; X original visible:
    2246.  00:5199                      		;   izquierda = VARIABLE_UN_USO3
    2247.  00:5199                      		;   ancho     = VARIABLE_UN_USO2
    2248.  00:5199                      		;
    2249.  00:5199                      		; X reducido:
    2250.  00:5199                      		;   izquierda = VARIABLE_UN_USO3 + 20
    2251.  00:5199                      		;   derecha   = VARIABLE_UN_USO3 + VARIABLE_UN_USO2 - 20
    2252.  00:5199                      		;
    2253.  00:5199                      		; Y original:
    2254.  00:5199                      		;   arriba = ERRECENYX_MOVIMIENTO_Y_BOSS_4
    2255.  00:5199                      		;   alto   = ERRECENYX_MOVIMIENTO_ALTO_BOSS_4
    2256.  00:5199                      		;
    2257.  00:5199                      		; Y reducido:
    2258.  00:5199                      		;   arriba = ERRECENYX_MOVIMIENTO_Y_BOSS_4 + 20
    2259.  00:5199                      		;   abajo  = ERRECENYX_MOVIMIENTO_Y_BOSS_4 + ERRECENYX_MOVIMIENTO_ALTO_BOSS_4 - 20
    2260.  00:5199                      
    2261.  00:5199  CD A2 4D            		call	CALCULA_RECORTE_ERRECENYX_BOSS_4
    2262.  00:519C                      
    2263.  00:519C                      		; Si el ancho visible es 40 o menos, al meter 20 por cada lado
    2264.  00:519C                      		; no queda hitbox real.
    2265.  00:519C  3A 72 C2            		ld		a,(VARIABLE_UN_USO2)
    2266.  00:519F  FE 29               		cp		41
    2267.  00:51A1  D8                  		ret		c
    2268.  00:51A2                      
    2269.  00:51A2                      		; Comprueba borde izquierdo reducido:
    2270.  00:51A2                      		; Deph derecha >= Errecenyx izquierda + 20
    2271.  00:51A2  3A 73 C2            		ld		a,(VARIABLE_UN_USO3)
    2272.  00:51A5  C6 14               		add		20
    2273.  00:51A7  4F                  		ld		c,a
    2274.  00:51A8  3A 64 C0            		ld		a,(X_DEPH)
    2275.  00:51AB  C6 14               		add		20
    2276.  00:51AD  B9                  		cp		c
    2277.  00:51AE  D8                  		ret		c
    2278.  00:51AF                      
    2279.  00:51AF                      		; Comprueba borde derecho reducido:
    2280.  00:51AF                      		; Deph izquierda < Errecenyx derecha - 20
    2281.  00:51AF  3A 73 C2            		ld		a,(VARIABLE_UN_USO3)
    2282.  00:51B2  4F                  		ld		c,a
    2283.  00:51B3  3A 72 C2            		ld		a,(VARIABLE_UN_USO2)
    2284.  00:51B6  81                  		add		c
    2285.  00:51B7  D6 14               		sub		20
    2286.  00:51B9  4F                  		ld		c,a
    2287.  00:51BA  3A 64 C0            		ld		a,(X_DEPH)
    2288.  00:51BD  B9                  		cp		c
    2289.  00:51BE  D0                  		ret		nc
    2290.  00:51BF                      
    2291.  00:51BF                      		; Comprueba borde superior reducido:
    2292.  00:51BF                      		; Deph abajo >= Errecenyx arriba + 20
    2293.  00:51BF  3A 65 C0            		ld		a,(Y_DEPH)
    2294.  00:51C2  C6 14               		add		20
    2295.  00:51C4  FE 30               		cp		ERRECENYX_MOVIMIENTO_Y_BOSS_4+20
    2296.  00:51C6  D8                  		ret		c
    2297.  00:51C7                      
    2298.  00:51C7                      		; Comprueba borde inferior reducido:
    2299.  00:51C7                      		; Deph arriba < Errecenyx abajo - 20
    2300.  00:51C7  3A 65 C0            		ld		a,(Y_DEPH)
    2301.  00:51CA  FE 46               		cp		ERRECENYX_MOVIMIENTO_Y_BOSS_4+ERRECENYX_MOVIMIENTO_ALTO_BOSS_4-20
    2302.  00:51CC  D0                  		ret		nc
    2303.  00:51CD                      
    2304.  00:51CD  CD D1 51            		call	DANO_DEPH_EN_BOSS_4
    2305.  00:51D0  C9                  		ret
