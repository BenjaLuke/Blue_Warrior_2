     236.  00:707E  32 A4 C2            		ld	[ayFX_REGS+8],a							; Volume copied in to ayFX_REGS (channel A volume)
     237.  00:7081  CB 41               		bit	0,c										; If tone is off...
     238.  00:7083  C0                  		ret	nz										; ...return
     239.  00:7084  2A 97 C2            		ld	hl,[ayFX_TONE]							; ayFX tone value
     240.  00:7087  22 9C C2            		ld	[ayFX_REGS+0],hl						; copied in to ayFX_REGS (channel A tone)
     241.  00:708A  C9                  		ret											; Return
     242.  00:708B                      
     243.  00:708B                      ;.SETMIXER:											; --- Set PSG mixer value ---
     244.  00:708B                      
     245.  00:708B  4F                  		ld	c,a										; c:=OR mask
     246.  00:708C  3A A3 C2            		ld	a,[ayFX_REGS+7]							; a:=PSG mixer value
     247.  00:708F  A2                  		and	d										; AND mask
     248.  00:7090  B1                  		or	c										; OR mask
     249.  00:7091  32 A3 C2            		ld	[ayFX_REGS+7],a							; PSG mixer value updated
     250.  00:7094  3A 9A C2            		ld	a,[ayFX_VOLUME]							; a:=ayFX volume value
     251.  00:7097  C9                  		ret											; Return
