      10.  00:5E0A  0F                  		rrca
      11.  00:5E0B  E6 03               		and 	3
      12.  00:5E0D  4F                  		ld 		c,a
      13.  00:5E0E  06 00               		ld 		b,0
      14.  00:5E10  21 C1 FC            		ld 		hl,0FCC1h
      15.  00:5E13  09                  		add 	hl,bc
      16.  00:5E14  7E                  		ld 		a,(hl)
      17.  00:5E15  E6 80               		and 	080h
      18.  00:5E17  B1                  		or 		c
      19.  00:5E18  4F                  		ld 		c,a
      20.  00:5E19  23                  		inc 	hl
      21.  00:5E1A  23                  		inc 	hl
      22.  00:5E1B  23                  		inc 	hl
      23.  00:5E1C  23                  		inc	 	hl
      24.  00:5E1D  7E                  		ld 		a,(hl)
      25.  00:5E1E  E6 0C               		and 	0Ch
      26.  00:5E20  B1                  		or 		c
      27.  00:5E21  26 80               		ld 		h,080h
      28.  00:5E23  32 00 C0            		ld 		(SLOTVAR),a
      29.  00:5E26                      				
      30.  00:5E26  C9                  		ret
