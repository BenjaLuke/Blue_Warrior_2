     441.  00:422E                      ; Carga de patrones y colores del barro.
     442.  00:422E                      ; OJO: debe ir DESPUES de RUTINA_BOSS_4 para que la entrada del banco
     443.  00:422E                      ; siga empezando en RUTINA_BOSS_4. Si se coloca antes, el boss puede entrar
     444.  00:422E                      ; por esta rutina y colgarse antes de iniciar el flujo normal.
     445.  00:422E                      ; -----------------------------------------------------------------------------
     446.  00:422E                      CARGA_SPRITES_BARRO_BOSS_4:
     447.  00:422E                      		
     448.  00:422E  CD FF 6D            		call	PAGE_32_A_SEGMENT_2
     449.  00:4231                      
     450.  00:4231                      		; Los dos patrones anteriores al barro quedan reservados para la
     451.  00:4231                      		; explosion de impacto: 92 y 96. NO se cargan aqui: ya estan
     452.  00:4231                      		; en VRAM en el sitio adecuado.
     453.  00:4231                      		; Barro empieza en 100: 100,104,108,112.
     454.  00:4231  21 80 9D            		ld		hl,SPRITE_BARRO
     455.  00:4234  11 20 43            		ld		de,PATRONES_SPRITES_VRAM_BOSS_4+BARRO_PATRON_INICIAL_BOSS_4*8
     456.  00:4237  01 80 00            		ld		bc,8*4*BARRO_CANTIDAD_BOSS_4
     457.  00:423A  CD 42 5F            		call	PON_COLOR_2.sin_bc_impuesta
     458.  00:423D                      
     459.  00:423D                      		; Los COVIDs se cargan despues de los cuatro patrones de barro:
     460.  00:423D                      		; COVID queda en 116 y 120.
