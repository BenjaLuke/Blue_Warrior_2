    1692.  00:4846  C3 B7 48            		jp		MOVIMIENTO_DEPH_EN_BOSS_4
    1693.  00:4849                      
    1694.  00:4849                      .DEPH_EN_LODO_BOSS_4:
    1695.  00:4849                      
    1696.  00:4849  CD 53 48            		call	ACTIVA_SPRITES_DEPH_LODO_BOSS_4
    1697.  00:484C  CD B7 48            		call	MOVIMIENTO_DEPH_EN_BOSS_4
    1698.  00:484F                      		; La rutina comun puede reponer colores normales al pintar a Deph.
    1699.  00:484F                      		; Por eso, en lodo los colores de pies se vuelcan despues del movimiento.
