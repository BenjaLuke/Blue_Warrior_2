     225.  00:7073  22 9E C2            		ld	[ayFX_REGS+2],hl						; copied in to ayFX_REGS (channel B tone)
     226.  00:7076  C9                  		ret											; Return
     227.  00:7077                      
     228.  00:7077                      ;.CHK3:												; --- Check if playing channel was 3 ---
     229.  00:7077                      
     230.  00:7077  CB 0A               		rrc	d										; Rotate right AND mask
     231.  00:7079  CB 0F               		rrc	a										; Rotate right OR mask
