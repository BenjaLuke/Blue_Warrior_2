     442.  00:4233                      ; -----------------------------------------------------------------------------
     443.  00:4233                      ; Carga de patrones y colores del barro.
     444.  00:4233                      ; OJO: debe ir DESPUES de RUTINA_BOSS_5 para que la entrada del banco
     445.  00:4233                      ; siga empezando en RUTINA_BOSS_5. Si se coloca antes, el boss puede entrar
     446.  00:4233                      ; por esta rutina y colgarse antes de iniciar el flujo normal.
     447.  00:4233                      ; -----------------------------------------------------------------------------
     448.  00:4233                      CARGA_SPRITES_BARRO_BOSS_5:
     449.  00:4233                      		
     450.  00:4233  CD FF 6D            		call	PAGE_32_A_SEGMENT_2
     451.  00:4236                      
     452.  00:4236                      		; Los dos patrones anteriores al super disparo quedan reservados para la
     453.  00:4236                      		; explosion de impacto: 92 y 96. NO se cargan aqui: ya estan
     454.  00:4236                      		; en VRAM en el sitio adecuado.
     455.  00:4236                      		; El super disparo empieza en los patrones del barro: 100,104,108.
     456.  00:4236  21 40 9E            		ld		hl,SUPER_DISPARO
     457.  00:4239  11 20 43            		ld		de,PATRONES_SPRITES_VRAM_BOSS_5+BARRO_PATRON_INICIAL_BOSS_5*8
     458.  00:423C  01 60 00            		ld		bc,8*4*SUPER_DISPARO_CANTIDAD_BOSS_5
     459.  00:423F  CD 42 5F            		call	PON_COLOR_2.sin_bc_impuesta
     460.  00:4242                      
     461.  00:4242                              ; Los BUBBLES quedan despues del barro.
     462.  00:4242  21 00 9E                    ld      hl,SPRITE_BUBBLES
     463.  00:4245  11 A0 43                    ld      de,PATRONES_SPRITES_VRAM_BOSS_5+BUBBLES_PATRON_INICIAL_BOSS_5*8
     464.  00:4248  01 40 00                    ld      bc,8*4*BUBBLES_PATRON_CANT_BOSS_5
     465.  00:424B  CD 42 5F                    call    PON_COLOR_2.sin_bc_impuesta
     466.  00:424E                      
     467.  00:424E  21 60 97            		ld		hl,SPRITES_COVID
     468.  00:4251  11 E0 43            		ld		de,PATRONES_SPRITES_VRAM_BOSS_5+COVID_PATRON_INICIAL_BOSS_5*8
     469.  00:4254  01 40 00            		ld		bc,8*4*COVID_PATRON_CANT_BOSS_5
     470.  00:4257  CD 42 5F            		call	PON_COLOR_2.sin_bc_impuesta
     471.  00:425A                      
     472.  00:425A                      		; El color de sprites en SCREEN 7 va por NUMERO DE SPRITE,
     473.  00:425A                      		; no por patron. Los proyectiles usan los sprites 22-29,
     474.  00:425A                      		; asi que sus colores deben arrancar en #4800 + 22*16 = #4960.
     475.  00:425A  11 60 49            		ld		de,PROYECTIL_BOSS_5_COLOR_VRAM
     476.  00:425D  06 08               		ld		b,PROYECTILES_BOSS_5_CANTIDAD
