      63   00:403F                      CREAMOS_UN_MEGAROM:
      64   00:403F                      
      65   00:403F  21 DF F3            		ld      hl,VDP_0												; Copia los ajustes de los registros del VDP a la matriz VDP ...
      66   00:4042  11 01 C0                    ld      de,VDP													; Después, lee los registros de VDP con LD A, (VDP + r) ...
      67   00:4045  01 08 00                    ld      bc,8													; Esto debe colocarse al comienzo del programa 
      68   00:4048  ED B0                       ldir															; 
      69   00:404A  21 DF FF                    ld      hl,VDP_8												; 
      70   00:404D  11 09 C0                    ld      de,VDP+8												; 
      71   00:4050  01 11 00                    ld      bc,17													; 
      72   00:4053  ED B0                       ldir
      73   00:4055                      		              																				
      74   00:4055  CD 00 5E            		call	SEARCH_SLOT_SET											; La CPU vera esta ROM en la pagina 2		
      75   00:4058  AF                  		xor		a
      76   00:4059  32 00 60            		ld	    (DIRPA1),a  											; Banco 1, pagina 0 del MEGAROM
      77   00:405C  3E 01               		ld		a,1
      78   00:405E  32 00 70            		ld	    (DIRPA2),a	    										; Banco 2, pagina 1 del MEGAROM
