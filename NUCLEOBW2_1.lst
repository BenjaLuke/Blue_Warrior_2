    2469.  00:52C2                      
    2470.  00:52C2                      		; Origen: primer recuadro arriba izquierda.
    2471.  00:52C2                      		; x=0, y=0. La page ya la hemos puesto en iy+3.
    2472.  00:52C2                      
    2473.  00:52C2  AF                  		xor		a
    2474.  00:52C3  FD 77 00            		ld		(iy),a								; origen x low
    2475.  00:52C6  FD 77 01            		ld		(iy+1),a							; origen x high
    2476.  00:52C9  FD 77 02            		ld		(iy+2),a							; origen y low
    2477.  00:52CC                      
    2478.  00:52CC                      
    2479.  00:52CC                      		; Destino X: posición actual de Agonix en page 2.
    2480.  00:52CC                      
    2481.  00:52CC  3A 89 C5            		ld		a,(AGONIX_BOSS_1_X)
    2482.  00:52CF  FD 77 04            		ld		(iy+4),a							; destino x low
    2483.  00:52D2  AF                  		xor		a
    2484.  00:52D3  FD 77 05            		ld		(iy+5),a							; destino x high
    2485.  00:52D6                      
    2486.  00:52D6                      
    2487.  00:52D6                      		; Recuperamos el contador externo del bucle.
    2488.  00:52D6                      		; B = altura actual que vamos a copiar.
    2489.  00:52D6                      		; Primera vuelta: B = 48.
    2490.  00:52D6                      		; Última vuelta: B = 1.
    2491.  00:52D6                      		; Cuando B llega a 0, el djnz de fuera termina la animación.
    2492.  00:52D6                      
    2493.  00:52D6  C1                  		pop		bc
    2494.  00:52D7  C5                  		push	bc
    2495.  00:52D8                      
    2496.  00:52D8                      		; offset = altura inicial - altura actual.
    2497.  00:52D8                      		; Este offset baja el destino.
    2498.  00:52D8                      
    2499.  00:52D8  3E 30               		ld		a,AGONIX_MUERTE_ALTO_BOSS_1
    2500.  00:52DA  90                  		sub		b
    2501.  00:52DB  4F                  		ld		c,a									; C = offset vertical
    2502.  00:52DC                      
    2503.  00:52DC                      
    2504.  00:52DC                      		; Destino Y = y actual de Agonix + offset.
