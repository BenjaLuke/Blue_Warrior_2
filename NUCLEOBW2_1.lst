      96.  00:5EC9                      ;LDIRVM2:																; Entra con A a 0 para las primeras 128k a escribir
      97.  00:5EC9                      																		; BIOS:	5Ch
      98.  00:5EC9                      																		; IN: HL= Dirección origen RAM
      99.  00:5EC9                      																		; DE = Dirección destino VRAM
     100.  00:5EC9                      																		; BC = Cantidad de bytes a transferir	
     101.  00:5EC9  EB                  		ex		de,hl
     102.  00:5ECA  CD DE 5E            		call	SetVdp_Write
     103.  00:5ECD  EB                  		ex		de,hl
     104.  00:5ECE  79                  		ld		a,c
     105.  00:5ECF  B7                  		or		a
     106.  00:5ED0  78                  		ld		a,b
     107.  00:5ED1  41                  		ld		b,c
     108.  00:5ED2  28 01               		jr		z,blk_VRAM_0
     109.  00:5ED4  3C                  		inc		a
     110.  00:5ED5                      				
     111.  00:5ED5                      ;blk_VRAM_0:
     112.  00:5ED5                      
     113.  00:5ED5  0E 98               		ld		c,098h
