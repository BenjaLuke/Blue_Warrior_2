    2554.  00:5321                      
    2555.  00:5321  F5                          push    af
    2556.  00:5322                      
    2557.  00:5322                              ; Cambiamos la Y destino del COPY.
    2558.  00:5322                              ; El dato Y está en el cuarto word del bloque:
    2559.  00:5322                              ; bytes 6 y 7 dentro de DATAS_COPY_RECUP_SCROLL.
    2560.  00:5322                      
