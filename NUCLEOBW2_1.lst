    2443.  00:52AB                      		; Animación de muerte:
    2444.  00:52AB                      		; copiamos siempre desde el primer recuadro de la page fuente
    2445.  00:52AB                      		; hacia page 2, recortando altura y bajando destino.
    2446.  00:52AB                      		;
    2447.  00:52AB                      		; derecha  -> page 3
    2448.  00:52AB                      		; izquierda -> page 1
    2449.  00:52AB                      
    2450.  00:52AB  DD 21 90 55         		ld		ix,BOSS_1_COPY_MOVIMIENTO_AGONIX
    2451.  00:52AF  FD 21 75 C2         		ld		iy,DATAS_COPY_RECUP_SCROLL
    2452.  00:52B3  CD 36 43            		call	RUTINA_BOSS_1.BUCLE_PINTA_DATAS
    2453.  00:52B6                      
    2454.  00:52B6  FD 21 75 C2         		ld		iy,DATAS_COPY_RECUP_SCROLL
    2455.  00:52BA                      
    2456.  00:52BA                      		; Página fuente según dirección.
    2457.  00:52BA                      
    2458.  00:52BA  3A C0 C5            		ld		a,(AGONIX_BOSS_1_DIRECCION)
    2459.  00:52BD  B7                  		or		a
    2460.  00:52BE  3E 03               		ld		a,AGONIX_MOVIMIENTO_PAG_DERECHA_BOSS_1
    2461.  00:52C0  28 02               		jr		z,.GUARDA_PAGE_ORIGEN_MUERTE_AGONIX_BOSS_1
    2462.  00:52C2                      
    2463.  00:52C2  3E 01               		ld		a,AGONIX_MOVIMIENTO_PAG_IZQUIERDA_BOSS_1
    2464.  00:52C4                      
    2465.  00:52C4                      .GUARDA_PAGE_ORIGEN_MUERTE_AGONIX_BOSS_1:
    2466.  00:52C4                      
    2467.  00:52C4  FD 77 03            		ld		(iy+3),a							; page origen: 3 o 1
    2468.  00:52C7                      
    2469.  00:52C7                      
    2470.  00:52C7                      		; Origen: primer recuadro arriba izquierda.
    2471.  00:52C7                      		; x=0, y=0. La page ya la hemos puesto en iy+3.
    2472.  00:52C7                      
    2473.  00:52C7  AF                  		xor		a
    2474.  00:52C8  FD 77 00            		ld		(iy),a								; origen x low
    2475.  00:52CB  FD 77 01            		ld		(iy+1),a							; origen x high
    2476.  00:52CE  FD 77 02            		ld		(iy+2),a							; origen y low
    2477.  00:52D1                      
    2478.  00:52D1                      
    2479.  00:52D1                      		; Destino X: posición actual de Agonix en page 2.
    2480.  00:52D1                      
    2481.  00:52D1  3A BF C5            		ld		a,(AGONIX_BOSS_1_X)
    2482.  00:52D4  FD 77 04            		ld		(iy+4),a							; destino x low
    2483.  00:52D7  AF                  		xor		a
    2484.  00:52D8  FD 77 05            		ld		(iy+5),a							; destino x high
    2485.  00:52DB                      
    2486.  00:52DB                      
    2487.  00:52DB                      		; Recuperamos el contador externo del bucle.
    2488.  00:52DB                      		; B = altura actual que vamos a copiar.
    2489.  00:52DB                      		; Primera vuelta: B = 48.
    2490.  00:52DB                      		; Última vuelta: B = 1.
    2491.  00:52DB                      		; Cuando B llega a 0, el djnz de fuera termina la animación.
    2492.  00:52DB                      
    2493.  00:52DB  C1                  		pop		bc
    2494.  00:52DC  C5                  		push	bc
    2495.  00:52DD                      
    2496.  00:52DD                      		; offset = altura inicial - altura actual.
    2497.  00:52DD                      		; Este offset baja el destino.
    2498.  00:52DD                      
    2499.  00:52DD  3E 30               		ld		a,AGONIX_MUERTE_ALTO_BOSS_1
    2500.  00:52DF  90                  		sub		b
    2501.  00:52E0  4F                  		ld		c,a									; C = offset vertical
    2502.  00:52E1                      
    2503.  00:52E1                      
    2504.  00:52E1                      		; Destino Y = y actual de Agonix + offset.
    2505.  00:52E1                      		; Page destino sigue siendo page 2.
    2506.  00:52E1                      
    2507.  00:52E1  3E 42               		ld		a,AGONIX_MOVIMIENTO_Y_BOSS_1
    2508.  00:52E3  81                  		add		c
    2509.  00:52E4  FD 77 06            		ld		(iy+6),a							; destino y low
    2510.  00:52E7                      
    2511.  00:52E7  3E 02               		ld		a,PAGE_2_VRAM_Y_BOSS_1 / 256
    2512.  00:52E9  FD 77 07            		ld		(iy+7),a							; destino page 2
    2513.  00:52EC                      
    2514.  00:52EC                      
    2515.  00:52EC                      		; Tamaño destino/fuente:
    2516.  00:52EC                      		; ancho fijo, altura decreciendo.
    2517.  00:52EC                      
    2518.  00:52EC  78                  		ld		a,b
    2519.  00:52ED  FD 77 0A            		ld		(iy+10),a							; alto low = B
    2520.  00:52F0  AF                  		xor		a
    2521.  00:52F1  FD 77 0B            		ld		(iy+11),a							; alto high = 0
    2522.  00:52F4                      
