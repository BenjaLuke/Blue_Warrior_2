      49.  00:5E3A  D3 99               		out		(#99),a
      50.  00:5E3C  DB 99               		in		a,(#99)
      51.  00:5E3E  1F                  		rra
      52.  00:5E3F  3E 00               		ld 		a,0										; Regresa a s#0, activa interrupciones
      53.  00:5E41  D3 99               		out		(#99),a
      54.  00:5E43  3E 8F               		ld		a,15+128
      55.  00:5E45  D3 99               		out		(#99),a									; Loop si el VDP no está listo
