     119   00:4092  01 FF FF                    ld	    bc,#ffff						                        ; bc	= longitud del area a rellenar con el dato A
     120   00:4095  21 00 00                    ld	    hl,#0000						                        ; hl	= dirección en la que empieza a pintar
