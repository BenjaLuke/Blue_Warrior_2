    1700.  00:4EE3                      REVISAMOS_COLISION_CON_AGONIX_Y_DEPH:
    1701.  00:4EE3                      
    1702.  00:4EE3                      		; Hitbox Agonix reducido 20 px por cada lado.
    1703.  00:4EE3                      		; Deph se sigue tratando como caja aproximada de 20x20.
    1704.  00:4EE3                      		;
    1705.  00:4EE3                      		; Agonix original:
    1706.  00:4EE3                      		; X = AGONIX_BOSS_1_X
    1707.  00:4EE3                      		; W = AGONIX_MOVIMIENTO_ANCHO_BOSS_1
    1708.  00:4EE3                      		; Y = AGONIX_MOVIMIENTO_Y_BOSS_1
    1709.  00:4EE3                      		; H = AGONIX_MOVIMIENTO_ALTO_BOSS_1
    1710.  00:4EE3                      		;
    1711.  00:4EE3                      		; Agonix reducido:
    1712.  00:4EE3                      		; X izquierda = X + 20
    1713.  00:4EE3                      		; X derecha   = X + ancho - 20
    1714.  00:4EE3                      		; Y arriba    = Y + 20
    1715.  00:4EE3                      		; Y abajo     = Y + alto - 20
    1716.  00:4EE3                      
    1717.  00:4EE3  3A 89 C5            		ld		a,(AGONIX_BOSS_1_X)
    1718.  00:4EE6  C6 14               		add		20
    1719.  00:4EE8  4F                  		ld		c,a
    1720.  00:4EE9  3A 64 C0            		ld		a,(X_DEPH)
    1721.  00:4EEC  C6 14               		add		20
    1722.  00:4EEE  B9                  		cp		c
    1723.  00:4EEF  D8                  		ret		c
    1724.  00:4EF0                      
    1725.  00:4EF0  3A 89 C5            		ld		a,(AGONIX_BOSS_1_X)
    1726.  00:4EF3  C6 6E               		add		AGONIX_MOVIMIENTO_ANCHO_BOSS_1-20
    1727.  00:4EF5  4F                  		ld		c,a
    1728.  00:4EF6  3A 64 C0            		ld		a,(X_DEPH)
    1729.  00:4EF9  B9                  		cp		c
    1730.  00:4EFA  D0                  		ret		nc
    1731.  00:4EFB                      
    1732.  00:4EFB  3A 65 C0            		ld		a,(Y_DEPH)
    1733.  00:4EFE  C6 14               		add		20
    1734.  00:4F00  FE 56               		cp		AGONIX_MOVIMIENTO_Y_BOSS_1+20
    1735.  00:4F02  D8                  		ret		c
    1736.  00:4F03                      
    1737.  00:4F03  3A 65 C0            		ld		a,(Y_DEPH)
    1738.  00:4F06  FE 5E               		cp		AGONIX_MOVIMIENTO_Y_BOSS_1+AGONIX_MOVIMIENTO_ALTO_BOSS_1-20
    1739.  00:4F08  D0                  		ret		nc
    1740.  00:4F09                      
    1741.  00:4F09  CD 0D 4F            		call	DANO_DEPH_EN_BOSS_1
    1742.  00:4F0C  C9                  		ret
