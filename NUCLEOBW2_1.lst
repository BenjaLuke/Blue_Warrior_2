    3224   00:6F4C                      		include "AUDIOS/LANZADOR EFECTOS PSG (sin etiquetas).asm"
       1.  00:6F4C                      													; --- ayFX REPLAYER v2.0M ---
       2.  00:6F4C                      
       3.  00:6F4C                      													; --- v2.0T  New ayFX replayer routine. T -> Triple FX replayer
       4.  00:6F4C                      
       5.  00:6F4C                      ;ayFX_SETUP:											; ---          ayFX replayer setup          ---
       6.  00:6F4C                      													; --- INPUT: HL -> pointer to the ayFX bank ---
       7.  00:6F4C  22 8C C2            		ld	[ayFX_BANK],hl							; Current ayFX bank
       8.  00:6F4F                      ;ayFX_STOP:	
       9.  00:6F4F                      		
      10.  00:6F4F  3E FF               		ld	a,255									; Lowest ayFX priority
      11.  00:6F51  32 8E C2            		ld	[ayFX_C1],a								; First channel minimum priority
      12.  00:6F54  32 91 C2            		ld	[ayFX_C2],a								; First channel minimum priority
      13.  00:6F57  32 94 C2            		ld	[ayFX_C3],a								; First channel minimum priority
      14.  00:6F5A  C9                  		ret											; Return
      15.  00:6F5B                      ;ayFX_END:											; --- End of an ayFX stream ---
      16.  00:6F5B                      
      17.  00:6F5B  DD 36 00 FF         		ld	[IX],255								; Priority saved (not playing ayFX stream)
      18.  00:6F5F  C9                  		ret											; Return
      19.  00:6F60                      
      20.  00:6F60                      ;ayFX_INIT:											; ---     INIT A NEW ayFX STREAM     ---
      21.  00:6F60                      													; --- INPUT: A -> sound to be played ---
      22.  00:6F60                      													; ---        C -> sound priority     ---
      23.  00:6F60                      													; --- Checks the priorities of playing ayFX streams to place ---
      24.  00:6F60                      													; --- the new one on the channel with lowest priority        ---
      25.  00:6F60  C5                  		push	bc									; Store bc in stack
      26.  00:6F61  D5                  		push	de									; Store de in stack
      27.  00:6F62  E5                  		push	hl									; Store hl in stack
      28.  00:6F63  DD E5               		push	IX									; Store IX in stack
      29.  00:6F65                      													; --- Check if the index is in the bank ---
      30.  00:6F65  47                  		ld	b,a										; b:=a (new ayFX stream index)
      31.  00:6F66  2A 8C C2            		ld	hl,[ayFX_BANK]							; Current ayFX BANK
      32.  00:6F69  7E                  		ld	a,[hl]									; Number of samples in the bank
      33.  00:6F6A  B7                  		or	a										; If zero (means 256 samples)...
      34.  00:6F6B  CA 75 6F            		jp	z,ayFX_INIT.CHECK_PRI							; ...goto .CHECK_PRI
      35.  00:6F6E                      													; The bank has less than 256 samples
      36.  00:6F6E  78                  		ld	a,b										; a:=b (new ayFX stream index)
      37.  00:6F6F  BE                  		cp	[hl]									; If new index is not in the bank...
      38.  00:6F70  3E 02               		ld	a,2										; a:=2 (error 2: Sample not in the bank)
      39.  00:6F72  D2 D4 6F            		jp	nc,ayFX_INIT.INIT_END							; ...we can't init it
      40.  00:6F75                      
      41.  00:6F75                      ;.CHECK_PRI:											; --- Places the data on the correct channel                  ---
      42.  00:6F75                      													; ---   Remember: 0 = highest priority, 15 = lowest priority  ---
      43.  00:6F75                      													; --- Checks channel 1 ---
      44.  00:6F75  3A 8E C2            		ld	a,[ayFX_C1]								; Priority of ayFX Stream being played on channel 1
      45.  00:6F78  FE FF               		cp	255										; If there's no Stream being played...
      46.  00:6F7A  28 39               		jr	z,ayFX_INIT.TOC1									; ...place the new Stream on channel 1
      47.  00:6F7C  5F                  		ld	e,a										; Minimum priority of Streams being played
      48.  00:6F7D  16 01               		ld	d,1										; On channel 1
      49.  00:6F7F                      													; --- Checks channel 2 ---
      50.  00:6F7F  3A 91 C2            		ld	a,[ayFX_C2]								; Priority of ayFX Stream being played on channel 2
      51.  00:6F82  FE FF               		cp	255										; If there's no Stream being played...
      52.  00:6F84  28 29               		jr	z,ayFX_INIT.TOC2									; ...place the new Stream on channel 2
      53.  00:6F86  BB                  		cp	e										; Compare priority with minimum one
      54.  00:6F87  30 03               		jr	nc,ayFX_INIT.CHECKC3								; If P(C2) > min, go to .CHECKC3
      55.  00:6F89  5F                  		ld	e,a										; Minimum priority of Streams being played
      56.  00:6F8A  16 02               		ld	d,2										; On channel 2
      57.  00:6F8C                      
      58.  00:6F8C                      ;.CHECKC3:											; --- Checks channel 3 ---
      59.  00:6F8C                      
      60.  00:6F8C  3A 94 C2            		ld	a,[ayFX_C3]								; Priority of ayFX Stream being played on channel 3
      61.  00:6F8F  FE FF               		cp	255										; If there's no stream being played
      62.  00:6F91  28 16               		jr	z,ayFX_INIT.TOC3									; ...place the new Stream on channel 3
      63.  00:6F93  BB                  		cp	e										; Compare priority with minimum one
      64.  00:6F94  30 03               		jr	nc,ayFX_INIT.CHECKMIN							; If P(C3) > min, go to .CHECKMIN
      65.  00:6F96  5F                  		ld	e,a										; Minimum priority of Streams being played
      66.  00:6F97  16 03               		ld	d,3										; On channel 3
      67.  00:6F99                      
      68.  00:6F99                      ;.CHECKMIN:											; --- Checks if minimum priority is lower than priority of the new Stream ---
      69.  00:6F99                      
      70.  00:6F99  79                  		ld	a,c										; Priority of the new Stream
      71.  00:6F9A  BB                  		cp	e										; Minimum priority of Streams being played
      72.  00:6F9B  3E 01               		ld	a,1										; a:=1 (error 1: A sample with higher priority is being played)
      73.  00:6F9D  D2 D4 6F            		jp	nc,ayFX_INIT.INIT_END							; ...we can't play the new ayFX Stream
      74.  00:6FA0                      													; --- The new stream substitues the minimum priority Stream being played ---
      75.  00:6FA0  7A                  		ld	a,d										; Channel of minimum priority
      76.  00:6FA1  FE 01               		cp	1										; If it's 1...
      77.  00:6FA3  28 10               		jr	z,ayFX_INIT.TOC1									; ...send Stream to channel 1
      78.  00:6FA5  FE 02               		cp	2										; If it's 2...
      79.  00:6FA7  28 06               		jr	z,ayFX_INIT.TOC2									; ...send Stream to channel 2
      80.  00:6FA9                      
      81.  00:6FA9                      ;.TOC3:												; --- Stream will be played on channel 3
      82.  00:6FA9                      
      83.  00:6FA9  DD 21 94 C2         		ld	IX,ayFX_C3								; Pointer to the chanel data
      84.  00:6FAD  18 0A               		jr	ayFX_INIT.SETDATA								; Go to .SETDATA
      85.  00:6FAF                      
      86.  00:6FAF                      ;.TOC2:												; --- Stream will be played on channel 2
      87.  00:6FAF                      
      88.  00:6FAF  DD 21 91 C2         		ld	IX,ayFX_C2								; Pointer to the channel data
      89.  00:6FB3  18 04               		jr	ayFX_INIT.SETDATA								; Go to .SETDATA
      90.  00:6FB5                      
      91.  00:6FB5                      ;.TOC1:												; --- Stream will be played on channel 1
      92.  00:6FB5                      		
      93.  00:6FB5  DD 21 8E C2         		ld	IX,ayFX_C1								; Pointer to the chanel data
      94.  00:6FB9                      
      95.  00:6FB9                      ;.SETDATA:											; --- Set data on the correct channel ---
      96.  00:6FB9                      											
      97.  00:6FB9  79                  		ld	a,c										; a:=New priority
      98.  00:6FBA  E6 0F               		and	$0F										; We mask the priority
      99.  00:6FBC  DD 77 00            		ld	[IX],a									; new ayFX stream priority saved in RAM
     100.  00:6FBF                      													; --- Calculate the pointer to the new ayFX stream ---
     101.  00:6FBF  ED 5B 8C C2         		ld	de,[ayFX_BANK]							; de:=Current ayFX bank
     102.  00:6FC3  13                  		inc	de										; de points to the increments table of the bank
     103.  00:6FC4  68                  		ld	l,b										; l:=b (new ayFX stream index)
     104.  00:6FC5  26 00               		ld	h,0										; hl:=b (new ayFX stream index)
     105.  00:6FC7  29                  		add	hl,hl									; hl:=hl*2
     106.  00:6FC8  19                  		add	hl,de									; hl:=hl+de (hl points to the correct increment)
     107.  00:6FC9  5E                  		ld	e,[hl]									; e:=lower byte of the increment
     108.  00:6FCA  23                  		inc	hl										; hl points to the higher byte of the correct increment
     109.  00:6FCB  56                  		ld	d,[hl]									; de:=increment
     110.  00:6FCC  19                  		add	hl,de									; hl:=hl+de (hl points to the new ayFX stream)
     111.  00:6FCD  DD 75 01            		ld	[IX+1],l								; Pointer lower byte saved in RAM
     112.  00:6FD0  DD 74 02            		ld	[IX+2],h								; Pointer higher byte saved in RAM
     113.  00:6FD3  AF                  		xor	a										; a:=0 (no errors)
     114.  00:6FD4                      
     115.  00:6FD4                      ;.INIT_END:	
     116.  00:6FD4                      
     117.  00:6FD4  DD E1               		pop	IX										; Retrieve IX from stack
     118.  00:6FD6  E1                  		pop	hl										; Retrieve hl from stack
     119.  00:6FD7  D1                  		pop	de										; Retrieve de from stack
     120.  00:6FD8  C1                  		pop	bc										; Retrieve bc from stack
     121.  00:6FD9  C9                  		ret											; Return
     122.  00:6FDA                      
     123.  00:6FDA                      ;ayFX_PLAY:											; --- Plays next frame of each ayFX Stream ---
     124.  00:6FDA                      			
     125.  00:6FDA  21 00 00            		ld	hl,0									; hl:=0
     126.  00:6FDD  22 A3 C2            		ld	[ayFX_REGS+7],hl						; Clears mixer and volume of channel A
     127.  00:6FE0  22 A5 C2            		ld	[ayFX_REGS+9],hl						; Clears volume of channels B and C
     128.  00:6FE3  DD 21 8E C2         		ld	IX,ayFX_C1								; Channel 1
     129.  00:6FE7  3E 01               		ld	a,1										; a:=1
     130.  00:6FE9  CD FB 6F            		call	ayFX_PLAY.ayFX_PlayChannel					; Play Channel 1
     131.  00:6FEC  DD 21 91 C2         		ld	IX,ayFX_C2								; Channel 2
     132.  00:6FF0  3E 02               		ld	a,2										; a:=2
     133.  00:6FF2  CD FB 6F            		call	ayFX_PLAY.ayFX_PlayChannel					; Play Channel 2
     134.  00:6FF5  DD 21 94 C2         		ld	IX,ayFX_C3								; Channel 3
     135.  00:6FF9  3E 03               		ld	a,3										; a:=3
     136.  00:6FFB                      ;.ayFX_PlayChannel:									; --- Plays a channel stream ---
     137.  00:6FFB  32 9B C2            		ld	[ayFX_CHANNEL],a						; Sets current channel
     138.  00:6FFE  DD 7E 00            		ld	a,[IX]									; a:=Current ayFX stream priority
     139.  00:7001  B7                  		or	a										; If priority has bit 7 on...
     140.  00:7002  F8                  		ret	m										; ...return
     141.  00:7003                      													; --- Extract control byte from stream ---
     142.  00:7003  DD 6E 01            		ld	l,[IX+1]								; Pointer to the current ayFX stream (lower byte)
     143.  00:7006  DD 66 02            		ld	h,[IX+2]								; Pointer to the current ayFX stream (higher byte)
     144.  00:7009  4E                  		ld	c,[hl]									; c:=Control byte
     145.  00:700A  23                  		inc	hl										; Increment pointer
     146.  00:700B                      													; --- Check if there's new tone on stream ---
     147.  00:700B  CB 69               		bit	5,c										; If bit 5 c is off...
     148.  00:700D  CA 18 70            		jp	z,ayFX_PLAY.CHECK_NN								; ...jump to .CHECK_NN (no new tone)
     149.  00:7010                      													; --- Extract new tone from stream ---
     150.  00:7010  5E                  		ld	e,[hl]									; e:=lower byte of new tone
     151.  00:7011  23                  		inc	hl										; Increment pointer
     152.  00:7012  56                  		ld	d,[hl]									; d:=higher byte of new tone
     153.  00:7013  23                  		inc	hl										; Increment pointer
     154.  00:7014  ED 53 97 C2         		ld	[ayFX_TONE],de							; ayFX tone updated
     155.  00:7018                      
     156.  00:7018                      ;.CHECK_NN:											; --- Check if there's new noise on stream ---
     157.  00:7018                      
     158.  00:7018  CB 71               		bit	6,c										; if bit 6 c is off...
     159.  00:701A  CA 27 70            		jp	z,ayFX_PLAY.SETPOINTER							; ...jump to .SETPOINTER (no new noise)
     160.  00:701D                      													; --- Extract new noise from stream ---
     161.  00:701D  7E                  		ld	a,[hl]									; a:=New noise
     162.  00:701E  23                  		inc	hl										; Increment pointer
     163.  00:701F  FE 20               		cp	$20										; If it's an illegal value of noise (used to mark end of stream)...
     164.  00:7021  CA 5B 6F            		jp	z,ayFX_END								; ...jump to ayFX_END
     165.  00:7024  32 99 C2            		ld	[ayFX_NOISE],a							; ayFX noise updated
     166.  00:7027                      
     167.  00:7027                      ;.SETPOINTER:										; --- Update ayFX pointer ---
     168.  00:7027                      
     169.  00:7027  DD 75 01            		ld	[IX+1],l								; Pointer lower byte saved in RAM
     170.  00:702A  DD 74 02            		ld	[IX+2],h								; Pointer higher byte saved in RAM
     171.  00:702D                      													; --- Extract volume ---
     172.  00:702D  79                  		ld	a,c										; a:=Control byte
     173.  00:702E  E6 0F               		and	$0F										; lower nibble
     174.  00:7030  32 9A C2            		ld	[ayFX_VOLUME],a							; ayFX volume updated
     175.  00:7033  C8                  		ret	z										; Return if volume is zero (don't copy ayFX values in to ayFX_REGS)
     176.  00:7034                      													; -------------------------------------
     177.  00:7034                      													; --- COPY ayFX VALUES IN TO ayFX_REGS ---
     178.  00:7034                      													; -------------------------------------
     179.  00:7034                      													; --- Set noise channel ---
     180.  00:7034  CB 79               		bit	7,c										; If noise is off...
     181.  00:7036  C2 3F 70            		jp	nz,ayFX_PLAY.SETMASKS							; ...jump to .SETMASKS
     182.  00:7039  3A 99 C2            		ld	a,[ayFX_NOISE]							; ayFX noise value
     183.  00:703C  32 A2 C2            		ld	[ayFX_REGS+6],a							; copied in to ayFX_REGS (noise channel)
     184.  00:703F                      
     185.  00:703F                      ;.SETMASKS:											; --- Set mixer masks ---
     186.  00:703F                      
     187.  00:703F  79                  		ld	a,c										; a:=Control byte
     188.  00:7040  E6 90               		and	$90										; Only bits 7 and 4 (noise and tone mask for psg reg 7)
     189.  00:7042  FE 90               		cp	$90										; If no noise and no tone...
     190.  00:7044  C8                  		ret	z										; ...return (don't copy ayFX values in to ayFX_REGS)
     191.  00:7045                      													; --- Copy ayFX values in to ayFX_REGS ---
     192.  00:7045  CB 0F               		rrc	a										; Rotate a to the right (1 TIME)
     193.  00:7047  CB 0F               		rrc	a										; Rotate a to the right (2 TIMES) (OR mask)
     194.  00:7049  16 DB               		ld	d,$DB									; d:=Mask for psg mixer (AND mask)
     195.  00:704B  21 9B C2            		ld	hl,ayFX_CHANNEL							; ayFX playing channel
     196.  00:704E  46                  		ld	b,[hl]									; Channel counter
     197.  00:704F                      
     198.  00:704F                      ;.CHK1:												; --- Check if playing channel was 1 ---
     199.  00:704F                      
     200.  00:704F  10 10               		djnz	ayFX_PLAY.CHK2								; Decrement and jump if channel was not 1
     201.  00:7051                      
