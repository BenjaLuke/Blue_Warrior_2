      81   00:4061                      
      82   00:4061  3A 2D 00            		ld		a,[#002D]										        ; Si se trata de un msx2+ O INFERIOR no conectamos el R800
      83   00:4064  FE 03               		cp		3
      84   00:4066  C2 71 40            		jp	    nz,PREPARANDO_FMPAC  
      85   00:4069                      /*
      86   00:4069                    ~ 		ld	    a,10000010B		                                        ; Conectamos el R800
      87   00:4069                    ~                                                                         ; Bit 7 enciende el led
