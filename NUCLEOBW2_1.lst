     225.  00:707A  22 9E C2            		ld	[ayFX_REGS+2],hl						; copied in to ayFX_REGS (channel B tone)
     226.  00:707D  C9                  		ret											; Return
     227.  00:707E                      
     228.  00:707E                      ;.CHK3:												; --- Check if playing channel was 3 ---
     229.  00:707E                      
     230.  00:707E  CB 0A               		rrc	d										; Rotate right AND mask
     231.  00:7080  CB 0F               		rrc	a										; Rotate right OR mask
     232.  00:7082                      
     233.  00:7082                      ;.PLAY_A:											; --- Play ayFX stream on channel A ---
