     115.  00:5ED7                      ;blk_VRAM_Loop:
     116.  00:5ED7                      
     117.  00:5ED7  ED B3               		otir
     118.  00:5ED9  3D                  		dec		a
     119.  00:5EDA  20 FB               		jr		nz,blk_VRAM_Loop
     120.  00:5EDC  EB                  		ex		de,hl
     121.  00:5EDD                      				
     122.  00:5EDD  C9                  		ret
     123.  00:5EDE                      
     124.  00:5EDE                      ;Set VDP address counter to write from address AHL (17-bit)
     125.  00:5EDE                      ;Enables the interrupts
     126.  00:5EDE                      
     127.  00:5EDE                      ;SetVdp_Write:
     128.  00:5EDE                      ;SETWRT_in_RAM:															; BIOS: 53h
     129.  00:5EDE                      	
     130.  00:5EDE  F5                  		push	af
     131.  00:5EDF  E5                  		push	hl
     132.  00:5EE0  AF                  		xor		a														; 16 kbytes
     133.  00:5EE1  A7                  		and		a	
     134.  00:5EE2  CB 04               		rlc		h
     135.  00:5EE4  17                  		rla
     136.  00:5EE5  CB 04               		rlc		h
     137.  00:5EE7  17                  		rla
     138.  00:5EE8  CB 3C               		srl		h
