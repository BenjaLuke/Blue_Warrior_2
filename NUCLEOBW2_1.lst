      96.  00:5EC9                      ;LDIRVM2:																; Entra con A a 0 para las primeras 128k a escribir
      97.  00:5EC9                      																		; BIOS:	5Ch
      98.  00:5EC9                      																		; IN: HL= Dirección origen RAM
      99.  00:5EC9                      																		; DE = Dirección destino VRAM
     100.  00:5EC9                      																		; BC = Cantidad de bytes a transferir	
