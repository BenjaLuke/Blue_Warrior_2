     145.  00:5EF4  00                  		nop
     146.  00:5EF5  D3 99               		out		(#99),a
     147.  00:5EF7  7C                  		ld		a,h
     148.  00:5EF8  F6 40               		or		64
     149.  00:5EFA  FB                  		ei
     150.  00:5EFB  D3 99               		out		(#99),a
