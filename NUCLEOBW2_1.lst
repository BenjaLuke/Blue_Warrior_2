     164.  00:5F04                      				
     165.  00:5F04  78                  		ld		a,b
     166.  00:5F05                      				
     167.  00:5F05                      ;OUT_VDP_REG1:	
     168.  00:5F05                      
     169.  00:5F05  D3 99               		out		(099h),a
     170.  00:5F07  79                  		ld		a,c
