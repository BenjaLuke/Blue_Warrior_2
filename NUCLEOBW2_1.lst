    2255.  00:4FFA                      ; Editar estas lineas al sacar una version nueva.
    2256.  00:4FFA                      ; Regla del porcentaje: cada fase vale 2, cada enemigo y bloque auxiliar vale 1.
    2257.  00:4FFA                      ; EN TOTAL HAY 
    2258.  00:4FFA                      ; 5 PUNTOS DE 2(FASES) 4 HECHOS
    2259.  00:4FFA                      ; 6 PUNTOS DE 2(ENEMIGOS) 4 HECHOS
    2260.  00:4FFA                      ; 4 PUNTOS DE 1(LOGO, MENU, ANIMACION PRESENTACION Y ANIMACION CIERRE) 3 HECHO
    2261.  00:4FFA                      ; PUNTOS ACTUALES = (4+4)*2 + 3*1 = 19, PORCENTAJE ACTUAL = 19/26 = 73% APROXIMADAMENTE
    2262.  00:4FFA                      
