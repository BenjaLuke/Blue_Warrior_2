     150   00:4552                              include "AUDIOS/FMPAC FOUND.asm"
       1.  00:4552                      BUSCAMOS_FM_PAC:
       2.  00:4552                      
       3.  00:4552                      			;Output: 
       4.  00:4552                      			;	A=0 No se encontró el FM
       5.  00:4552                      			;	A=1 Sí se encontró el FM
       6.  00:4552                      
       7.  00:4552  CD 7A 45            			call	BUSCANDO_LA_CADENA_OPLL
       8.  00:4555                      	
       9.  00:4555                      FM_ENCONTRADO:
      10.  00:4555                      
      11.  00:4555  FE FF               			cp		0FFh
      12.  00:4557  C8                  			ret		z 														; No FM!!!
      13.  00:4558                      			
      14.  00:4558  4F                  			ld		c,a														; Slot
      15.  00:4559  C5                  			push	bc														; C ->slot FM
      16.  00:455A                      			
      17.  00:455A  3E 01               			ld		a,1
      18.  00:455C  32 5A C0            			ld		(FMPAC_DESCONECTADO),a
      19.  00:455F                      		
      20.  00:455F  3A AC C2            			ld		a,(chips)												; Cargamos en A el valor de chips
      21.  00:4562  CB CF               			set		1,a														; Lo convierte en xxxxxx1x para indicar que es estero
      22.  00:4564  32 AC C2            			ld		(chips),a												; Lo salva para futuros usos
      23.  00:4567                      					
      24.  00:4567  79                  			ld		a,c														; Slot
      25.  00:4568  21 F6 7F            			ld		hl,#7FF6
      26.  00:456B  CD 0C 00            			call	RDSLT
      27.  00:456E                      			
      28.  00:456E  F6 01               			or		00000001B		
      29.  00:4570  5F                  			ld		e,a														; Valor a escribir
      30.  00:4571                      
      31.  00:4571  C1                  			pop		bc
      32.  00:4572  79                  			ld		a,c
      33.  00:4573  21 F6 7F            			ld		hl,#7FF6
      34.  00:4576  CD 14 00            			call	WRSLT
      35.  00:4579                      			
      36.  00:4579  C9                  			ret
      37.  00:457A                      
      38.  00:457A                      BUSCANDO_LA_CADENA_OPLL:	
      39.  00:457A                      	
      40.  00:457A  01 00 04            			ld		bc,00400h 												; Bucle DJNZ. Metemos 4 en B para mirar los 4 slots
      41.  00:457D  21 C1 FC            			ld		hl,0fcc1h 												; En RAM ->EXPTBL 
      42.  00:4580                      
      43.  00:4580                      SIGUIENTE_SLOT:
      44.  00:4580  C5                  			push	bc
      45.  00:4581  E5                  			push	hl
      46.  00:4582  7E                  			ld		a,(hl)
      47.  00:4583  CB 7F               			bit		7,a														; Slot expandido?
      48.  00:4585  20 06               			jr		nz,EXPANSION_1
      49.  00:4587  79                  			ld		a,c
      50.  00:4588  CD AE 45            			call	COTEJA_CARACTERES_FM
      51.  00:458B  18 03               			jr		SIGUIENTE_SLOT_3
      52.  00:458D                      EXPANSION_1:
      53.  00:458D  CD 9B 45            			call	EXPANSION
      54.  00:4590                      
      55.  00:4590                      SIGUIENTE_SLOT_3:
      56.  00:4590                      
      57.  00:4590  79                  			ld		a,c														; Slot
      58.  00:4591  E1                  			pop		hl
      59.  00:4592  C1                  			pop		bc
      60.  00:4593  C8                  			ret		z														; Si es diferente de FFh -> Encontrado!!!
      61.  00:4594  23                  			inc		hl
      62.  00:4595  0C                  			inc		c
      63.  00:4596  10 E8               			djnz	SIGUIENTE_SLOT
      64.  00:4598  3E FF               			ld		a,0FFh													; El FM no ha sido encontrado, por tanto->A=0FFh
      65.  00:459A  C9                  			ret
      66.  00:459B                      
      67.  00:459B                      EXPANSION:
      68.  00:459B                      
