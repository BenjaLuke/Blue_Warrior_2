     180.  00:5F0F                      		
     181.  00:5F0F  3E 07               		ld		a,7														; Compare register 7
     182.  00:5F11  B9                  		cp		c
     183.  00:5F12  21 DF FF            		ld		hl,RG8SAV-8
     184.  00:5F15  38 03               		jr		c,save_new_register
     185.  00:5F17  21 DF F3            		ld		hl,RG0SAV
     186.  00:5F1A                      				
     187.  00:5F1A                      ;save_new_register:
     188.  00:5F1A                      
